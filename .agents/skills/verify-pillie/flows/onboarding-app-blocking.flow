# The app-blocking onboarding step (AppBlockingSetupView) on its own: empty,
# selected, and recovery phases, all via debug deep links. FamilyControls tokens
# cannot be picked on the simulator, so "selected" and "recovery" are QA seams,
# not real interactions — see features/onboarding.md Gotchas.
launch

# Jumps straight to the appBlocking step: sets Plus true, no selection override,
# clears the recovery flag. PillieApp.swift:515-544.
openurl "pillie://debug/plus-app-blocking-setup?lang=en"

# Empty phase. appBlockingEmptyStateCard: AppBlockingSetupView.swift:349.
# Title onboarding.blocking_setup.title ("Pick the apps to pause").
wait id blockingRehearsalBanner 15
shot app-blocking-empty

# A paid entitlement unlocks setup without a trial, so the trial line stays off.
expect-not id appBlockingTrialLine

# terms=hard drops the entitlement and starts a fresh reverse trial
# (OnboardingHardPaywallDebugScenario), the state a new user is in here.
# AppBlockingSetupPhase.showsTrialLine; ENG-139.
openurl "pillie://debug/plus-app-blocking-setup?terms=hard&lang=en"
wait id appBlockingTrialLine 15
shot app-blocking-trial-empty

openurl "pillie://debug/plus-app-blocking-setup?terms=hard&selected=4&lang=en"
wait id blockingRehearsalPicksCard 30
expect id appBlockingTrialLine
shot app-blocking-trial-selected

# Fakes a 4-app FamilyControls selection (the exact example from the source
# comment). AppBlockingManager.swift:36-40 debugSelectionCountOverride;
# PillieApp.swift:539-543 reads the `selected` query item.
openurl "pillie://debug/plus-app-blocking-setup?selected=4&lang=en"

# Selected phase. selectedSummaryLabel text "Apps selected"
# (onboarding.blocking_setup.selected_summary). No accessibility id on this
# card; AppBlockingSetupView.swift:392-437.
wait id blockingRehearsalPicksCard 30
shot app-blocking-selected

# The simulator approves Screen Time on its own, so the refusal is forced.
openurl "pillie://debug/screen-time-refused?reason=cancelled&lang=en"
openurl "pillie://debug/plus-app-blocking-setup?lang=en"
wait id blockingRehearsalCheckedInPill 30
tap --id blockingRehearsalPrimary
wait id blockingRehearsalRemindersOnly 15
shot app-blocking-refused
openurl "pillie://debug/screen-time-refused?reason=none&lang=en"
