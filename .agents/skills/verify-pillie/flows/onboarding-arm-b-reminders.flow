# ENG-207: arm B of the onboarding paywall test has no in-app trial, so a user
# without the StoreKit trial or a purchase gets no notifications at all. Walks a
# fresh install to the reminder plan (reminders are first queued when the
# notification prompt is allowed), then dumps the pending queue to app.log after
# each state. Every dump starts with `Pillie QA auth status: … arm=`; grep
# `Pillie QA pending requests:` for the count.
#   1. arm unassigned (Debug flags never load): reminders queued, as in arm A.
#   2. arm B assigned late, no Plus: 0 pending (the queued reminders are cancelled).
#   3. arm B starts the trial (Plus on, renewing): reminders queued again.
#   4. arm B cancels the trial, Plus ends in 3 days: no reminder fires after then.
#   5. arm B trial lapses (Plus off): 0 pending.
# The shield side reads the same end date: after step 4, the App Group key
# `pillie_plus_access_valid_until` holds that moment instead of the far future.

fresh
launch
sleep 6  # the welcome CTA ignores taps while the splash fades
log start

wait id protectionPlanPrimaryCTA
tap --id protectionPlanPrimaryCTA

wait id protectionPlanEarlyValueProofView
tap --label "Not now" --element-type Button

wait text "What’s in the way?"
tap --label TikTok
tap --label "A simpler routine"
tap --id protectionPlanPrimaryCTA

wait text "How often do you miss your pill?"
tap --label Rarely
tap --label "Right after the reminder"
tap --id protectionPlanPrimaryCTA

wait text "Where did you find Pillie?"
tap --id acquisitionSource.tiktok
tap --id protectionPlanPrimaryCTA

wait text "Pick your method."
tap --id protectionPlanPrimaryCTA

wait text "Tap the pill you’re on today."
tap --id packTile.12
wait id todayPillQuestion
tap --id todayPillYes
wait id todayPillLogged
tap --id protectionPlanPrimaryCTA

wait text "Pick a time."
tap --label Evening
wait text "Pill 12 · taken"
tap --id protectionPlanPrimaryCTA
tap --label Allow  # iOS notification permission alert

wait id protectionPlanPrimaryCTA 15
sleep 2  # let the 0.25 s reschedule debounce and the center writes finish
note 1 arm unassigned
openurl "pillie://debug/dump-pending-notifications"
sleep 2

openurl "pillie://debug/onboarding-paywall-arm?arm=hard_trial"
sleep 3
note 2 arm B, no Plus
openurl "pillie://debug/dump-pending-notifications"
sleep 2
shot arm-b-no-plus

openurl "pillie://debug/plus-entitlement?state=on"
sleep 3
note 3 arm B, trial started
openurl "pillie://debug/dump-pending-notifications"
sleep 2

openurl "pillie://debug/plus-entitlement?state=ends&days=3"
sleep 3
note 4 arm B, trial cancelled, ends in 3 days
openurl "pillie://debug/dump-pending-notifications"
sleep 2

openurl "pillie://debug/plus-entitlement?state=off"
sleep 3
note 5 arm B, trial lapsed
openurl "pillie://debug/dump-pending-notifications"
sleep 2

log stop
openurl "pillie://debug/onboarding-paywall-arm?arm=clear"
