# Settings > Method opens ProtocolEditor, which reuses the onboarding schedule
# modules: TodayPillCard (pack card, Change sheet, "taken yet?") for pill and
# RoutineDialCard (patch segments + dial, ring dial) for patch and ring.
# The editor seats the user at today's position, so Save works without a tap.
# The method card's Switch opens the method picker; picking swaps the module in
# place, picking the current method just closes it. The line above the pinned Save
# says what saving clears, and Save goes straight through with no alert.
fresh
launch
wait text "Get started" 15
openurl pillie://debug/plus-home?lang=en
wait text Today 15
tap --label Settings
wait id settingsLanguageRow
tap --label "Method, Pill (Standard)"
wait id todayPillChangeButton
expect id protocolEditorMethodCard
expect id protocolEditorSave
wait text "restarts from pill"
shot pill-seeded

tap --id packTile.5
wait id todayPillQuestion
shot pill-tapped

tap --id todayPillChangeButton
wait id packSheet.24_4
shot pack-sheet
tap --id packSheet.24_4
gone id packSheetTitle
wait text "24/4"
shot pill-24-4

tap --id protocolEditorSwitch
wait id methodPicker.patch
shot method-picker
tap --id methodPicker.pill
gone id methodPicker.patch
wait id todayPillChangeButton

tap --id protocolEditorSwitch
tap --id methodPicker.patch
gone id methodPicker.pill
wait id routineDial
wait text "switches you to Patch"
wait text "How long has this patch been on?"
expect id routineDialSegment.4
shot patch-day-1

tap --id routineDialSegment.2
wait id routineDialQuestion
shot patch-segment-2

tap --id protocolEditorSwitch
tap --id methodPicker.ring
gone id methodPicker.pill
wait id routineDial
gone id routineDialSegment.1
wait id routineDialQuestion
wait text "How long has this ring been in?"
shot ring-day-1

tap --id routineDialYes
wait id routineDialStatus
tap --id protocolEditorSave
gone id routineDial
wait text "Method, Ring"
shot saved-ring

# An established patch routine on day 10 opens on patch 2, day 3, with no question.
openurl "pillie://debug/routine-day?method=patch&day=10&lang=en"
tap --label Settings
wait id settingsLanguageRow
tap --label "Method, Patch"
wait id routineDialResult
gone id routineDialQuestion
wait text "restarts from day 10"
shot patch-seeded-day-10

# The close button leaves without saving.
tap --id protocolEditorClose
gone id routineDial
wait text "Method, Patch"
