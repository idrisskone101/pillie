# ENG-173: a tapped slot 3 win-back push re-raises the 7-day extend card once
# after "Not now", and a second tap does not. Slot 1 opens the plain wall.
# `pillie://debug/winback-open?slot=N` runs the banner-tap path (the
# simulator cannot tap a banner). app.log carries the analytics mirror:
# winback_notification_opened, paywall_viewed with source winback.
launch
openurl pillie://debug/plus-home?lang=en
wait text Today 15
log start
openurl pillie://debug/trial-end-extend?trigger=cancel&notifications=on&clear=1&lang=en
wait id extendOfferTitle 20
tap --id extendOfferNotNowButton
wait text "Get your reminders and app blocking back." 10
sleep 1
shot not-now-plans

openurl pillie://debug/winback-open?slot=3
wait id extendOfferTitle 20
expect text "Start my free week"
sleep 1
shot slot3-second-chance

tap --id extendOfferNotNowButton
wait text "Get your reminders and app blocking back." 10
openurl pillie://debug/winback-open?slot=3
sleep 5
expect-not id extendOfferTitle
shot slot3-spent

openurl pillie://debug/winback-open?slot=1
sleep 3
expect text "Get your reminders and app blocking back."
shot slot1-wall
log stop
openurl pillie://debug/trial-clear?lang=en
