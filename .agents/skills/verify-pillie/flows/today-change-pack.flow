# Change the pack type from the Home pack card's "…" menu (HomePackCard). It
# runs the same reset as the Settings schedule editor: "Clear your history?"
# (ScheduleCriticalSettingChange, day 1), then PillStore.resetAndStartFresh, so
# the new pack starts at pill 1 today and history clears.
fresh
launch
wait text "Get started" 15
openurl "pillie://debug/plus-home?lang=en"
openurl pillie://debug/trial-grant?lang=en
openurl pillie://debug/fixed-now?at=2026-09-28T16:00:00Z
openurl pillie://debug/trial-eve-of-break?lang=en
wait text "Pill 21 of 28" 10
shot before

# Cancel keeps the pack as it was.
tap --id homePackOptions
wait id homePackChangeType 5
tap --id homePackChangeType
wait id packSheet.custom 10
shot sheet
tap --id packSheet.24_4
wait text "Clear your history?" 10
shot reset-confirmation
tap --label Cancel
gone text "Clear your history?" 5
expect text "Pill 21 of 28"

# Confirm starts the 24 + 4 pack at pill 1 today.
tap --id homePackOptions
wait id homePackChangeType 5
tap --id homePackChangeType
wait id packSheet.custom 10
tap --id packSheet.24_4
wait text "Clear your history?" 10
tap --label "Clear and save"
wait text "Pill 1 of 28" 10
expect text "New pack · 24/4"
gone text "Late · still time until" 2
shot after-24-4

# A pack started after the day's reminder is not late before its first reminder.
openurl pillie://debug/fixed-now?at=2026-09-29T11:00:00Z
wait text "Pill 1 of 28" 10
expect text "New pack · 24/4"
shot before-first-reminder

# The first reminder closes pill 1's window unlogged.
openurl pillie://debug/fixed-now?at=2026-09-29T13:00:00Z
wait text "Pill 1 not checked in yesterday" 10
expect text "Pill 2 of 28"
shot missed-at-first-reminder

# A pack started before the day's reminder puts pill 1 on that reminder, not on
# yesterday's already-passed one, so it is not late (no catch-up, no shields).
openurl pillie://debug/fixed-now?at=2026-09-30T06:30:00Z
tap --id homePackOptions
wait id homePackChangeType 5
tap --id homePackChangeType
wait id packSheet.custom 10
tap --id packSheet.21_7
wait text "Clear your history?" 10
tap --label "Clear and save"
wait text "New pack · 21/7" 10
expect text "Pill 1 of 28"
gone text "Late · still time until" 2
shot new-pack-before-reminder
openurl pillie://debug/fixed-now?at=off
