# An expired hard-paywall trial stops every reminder (ENG-162), so Home says
# so (ENG-167). wall=off holds the mandatory wall down; without it the wall
# covers this Home.
launch
wait text Today 15
openurl pillie://debug/trial-end-paywall?wall=off&lang=en
wait id homeRemindersOffCard 20
expect text "Your daily reminders are off"
expect text "Pillie isn’t sending reminders"
expect-not text "Your reminders are on"
shot reminders-off

openurl pillie://debug/trial-end-paywall?wall=off&cohort=blocker&lang=en
wait id homeRemindersOffCard 20
expect-not id homeProtectionOffCard
shot reminders-off-blocker

openurl pillie://debug/trial-end-paywall?lang=en
wait text "Your Pillie Plus trial is over." 20
expect text "Your daily reminders and app blocking are off."
shot hard-wall-reminders-off
openurl pillie://debug/trial-clear
