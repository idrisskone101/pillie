# Patch users' V4 countdown card (HomeCountdownCard, ENG-149) through one
# cycle. /routine-day seeds an established 21 + 7 patch routine on a cycle
# day (DebugQA.applyRoutineDay, no start-day grace). The clock is pinned to
# midday EDT, past the default 8:00 AM reminder, so an untaken task is late.
fresh
launch
wait text "Get started" 15
openurl "pillie://debug/plus-home?lang=en"
openurl pillie://debug/fixed-now?at=2026-09-28T16:00:00Z

openurl "pillie://debug/routine-day?method=patch&day=10&lang=en"
# The app-blocking card sits above the countdown card on a fresh install; close it so the card is fully in view.
tap --id homeBlockingStatusCardDismiss
gone id homeBlockingStatusCard 10
wait text "until you change it" 10
expect text "Patch 2 of 3"
expect text "Day 10 of 28"
expect id homeCountdownDays
shot wearing

openurl "pillie://debug/routine-day?method=patch&day=15&lang=en"
wait text "Change to patch 3" 10
expect id homeCountdownHeadline
expect text "Until tomorrow 8:00 AM"
shot late-change

# The real log path: floating CTA, then Shake to Confirm's tap fallback.
tap --label "Change patch"
wait id shakeTapToConfirmFallback 10
tap --id shakeTapToConfirmFallback
wait text "On today" 15
expect text "until you take it off"
shot logged-change

# One live day after an unlogged change: missed, and Home's button can still log it late.
openurl "pillie://debug/routine-day?method=patch&day=15&lang=en"
wait text "Change to patch 3" 10
openurl pillie://debug/fixed-now?at=2026-09-29T16:00:00Z
wait text "Change to patch 3 now" 10
expect text "Was due yesterday"
expect text "Day 16 of 28"
expect text "Change patch"
shot missed-change

openurl pillie://debug/fixed-now?at=2026-09-28T16:00:00Z
openurl "pillie://debug/routine-day?method=patch&day=22&lang=en"
wait text "Take patch 3 off" 10
shot late-off-day

openurl "pillie://debug/routine-day?method=patch&day=25&lang=en"
wait text "until a new patch" 10
expect text "Patch-free week"
shot patch-free-week

# Past day 28 the engine wants a new cycle; the card has no due time.
openurl "pillie://debug/routine-day?method=patch&day=28&lang=en"
wait text "until a new patch" 10
openurl pillie://debug/fixed-now?at=2026-09-29T16:00:00Z
wait text "Day 29 · new cycle" 10
expect text "New pack"
shot new-cycle-due

# Home's own button starts the new cycle. A pack started after today's
# reminder gets the start-day grace, so patch 1 reads due, not late.
tap --label "Start new"
wait text "Start a new cycle?" 10
# The alert's "Start new" shares its label with the banner and CTA behind it; tap it by point.
tap -x 275 -y 497
gone text "Start a new cycle?" 10
wait text "Put on patch 1" 10
expect text "Due 8:00 AM"
shot put-on-due
openurl pillie://debug/fixed-now?at=off
