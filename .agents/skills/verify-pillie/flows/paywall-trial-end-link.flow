# /trial-end-paywall opens both trial-end walls straight from Home, with no
# relaunch: a relaunch drops the debug clock that keeps the trial expired.
launch
wait text Today 15
openurl pillie://debug/trial-end-paywall?lang=en
wait text "Get your reminders and app blocking back." 20
expect text "Your setup is saved."
expect-not text "streak are saved"
expect text "Now I don’t even have to think about it!"
expect-not text "customer support"
expect id paywallRestoreButton
expect-not text "Continue with free reminders"
shot hard-wall

openurl pillie://debug/trial-clear
launch
wait text Today 15
openurl pillie://debug/trial-end-paywall?terms=soft&lang=en
wait text "Continue with free reminders" 20
expect id paywallRestoreButton
shot soft-wall
openurl pillie://debug/trial-clear
