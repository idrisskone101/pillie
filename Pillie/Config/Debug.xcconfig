// Debug build configuration for the Pillie app target.
//
// Carries local-only secrets for development/QA builds via the gitignored
// Secrets.xcconfig (same mechanism as Release.xcconfig). Today that is just the
// AppsFlyer dev key, so an install fired from a Debug simulator build can be
// verified end-to-end against the AppsFlyer dashboard. Without Secrets.xcconfig the
// key resolves empty and the AppsFlyer SDK simply no-ops (logs a fault) — the app
// still builds and runs.
//
// Empty default so $(APPSFLYER_DEV_KEY) substitution in Info.plist never leaks a
// literal token; Secrets.xcconfig overrides this with the real key.
APPSFLYER_DEV_KEY =

#include? "Secrets.xcconfig"

// After Secrets so a blank local override cannot hide the experiment token.
// Same write-only ingestion key as Release. Filter with `debug_build=true`.
POSTHOG_HOST = https:/$()/us.i.posthog.com
POSTHOG_PROJECT_TOKEN = phc_uoo2fMUsqKo7YUVXxXAk37AzovUceX8BJCg7EJEmafvJ
