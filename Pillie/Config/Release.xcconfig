POSTHOG_HOST = https:/$()/us.i.posthog.com

// PostHog Project API Key (phc_...). Committed on purpose: it is a write-only public
// ingestion key, safe to ship in the client binary, and Xcode Cloud builds from a
// fresh clone where the gitignored Secrets.xcconfig does not exist — leaving this
// empty shipped 2.0.1 with no analytics at all (every event dropped for the lifetime
// of the binary; see #140 for the earlier ~25% variant of the same failure). Debug
// builds intentionally omit it (no dev analytics, no production pollution).
// Secrets.xcconfig (gitignored) can still override per environment.
POSTHOG_PROJECT_TOKEN = phc_uoo2fMUsqKo7YUVXxXAk37AzovUceX8BJCg7EJEmafvJ

// AppsFlyer dev key (account-level). Committed for the same reason as the PostHog
// key: it ships in (and is extractable from) every release binary regardless, and
// keeping it only in the gitignored Secrets.xcconfig meant Xcode Cloud builds had no
// attribution. Empty means the AppsFlyer SDK no-ops loudly
// (AppsFlyerManager.didFailConfiguration) rather than sending malformed installs.
APPSFLYER_DEV_KEY = rUohFRQezcXERXXLgVf36g

#include? "Secrets.xcconfig"
