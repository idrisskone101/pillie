{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.blocking_setup.subscriber_disclosure": {
      "comment": "Paid subscriber status on the app-blocking onboarding surface [subscription]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus is active on this account. Set up app blocking whenever you’re ready."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus è attivo su questo account. Configura il blocco delle app quando vuoi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ist für dieses Konto aktiv. Richte die App-Pause ein, wenn du bereit bist."
          }
        }
      }
    },
    "commerce.access_verification.title": {
      "comment": "Access verification gate title [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking your Pillie Plus access"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica dell’accesso a Pillie Plus"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie-Plus-Zugang wird geprüft"
          }
        }
      }
    },
    "commerce.access_verification.body": {
      "comment": "Access verification gate guidance [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the internet so Pillie can verify your purchases before opening the app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti a internet così Pillie può verificare i tuoi acquisti prima di aprire l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit dem Internet, damit Pillie deine Käufe prüfen kann, bevor die App geöffnet wird."
          }
        }
      }
    },
    "commerce.access_verification.error": {
      "comment": "Access verification retry guidance [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t verify your access. Check your connection, try again, or restore purchases."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare l’accesso. Controlla la connessione, riprova o ripristina gli acquisti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Zugang konnte nicht geprüft werden. Prüfe die Verbindung, versuche es erneut oder stelle Käufe wieder her."
          }
        }
      }
    },
    "onboarding.blocking_setup.plus_locked": {
      "comment": "Entitlement statement [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App blocking is a Pillie Plus feature you can set up after upgrading."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco delle app è una funzione di Pillie Plus configurabile dopo l’upgrade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Pause ist eine Pillie-Plus-Funktion, die du nach dem Upgrade einrichten kannst."
          }
        }
      }
    },
    "onboarding.blocking_setup.hard_paywall_locked_detail": {
      "comment": "Paid-access requirement shown when a hard-cohort trial expires during onboarding [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose monthly, annual, or lifetime to keep using Pillie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il piano mensile, annuale o a vita per continuare a usare Pillie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Monats-, Jahres- oder Lifetime-Tarif, um Pillie weiter zu nutzen."
          }
        }
      }
    },
    "onboarding.demo.free_body": {
      "comment": "Free entitlement statement [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily reminders, logging and history are included in the free plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria quotidiani, registrazione e cronologia sono inclusi nel piano gratuito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tägliche Erinnerungen, Protokollierung und Verlauf sind im kostenlosen Tarif enthalten."
          }
        }
      }
    },
    "paywall.title": {
      "comment": "No adherence guarantee [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one ping with Pillie Plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più di un ping con Pillie Plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr als ein Ping mit Pillie Plus."
          }
        }
      }
    },
    "paywall.subtitle": {
      "comment": "Functionality only [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus keeps pinging until you log today, and can pause apps until you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus continua a mandare ping finché non registri oggi, e può mettere in pausa le app fino al check-in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus pingt weiter, bis du heute einträgst, und kann Apps bis zum Check-in pausieren."
          }
        }
      }
    },
