    },
    "trial.granted.warning.detail": {
      "comment": "Detail for the pre-expiry warning [trial granted]",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "We'll remind you before your trial ends. No surprises." } },
        "it": { "stringUnit": { "state": "translated", "value": "Ti avviseremo prima della fine della prova. Nessuna sorpresa." } },
        "de": { "stringUnit": { "state": "translated", "value": "Bevor deine Testphase endet, geben wir dir rechtzeitig Bescheid. Ohne Überraschungen." } }
      }
    },
    "trial.granted.choice.label": {
      "comment": "Day label for the post-trial choice [trial granted]",
