    "trial.end.legacy.subtitle": {
      "comment": "Legacy trial-end subtitle [ENG-71]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your 14 active days ended, so app blocking is off. Reminders stay free forever."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine 14 aktiven Tage sind um, also ist die App-Sperre aus. Erinnerungen bleiben für immer kostenlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi 14 giorni attivi sono finiti, quindi il blocco app è disattivato. I promemoria restano gratis per sempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes 14 jours actifs sont terminés, donc le blocage d’apps est désactivé. Les rappels restent gratuits pour toujours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus 14 días activos terminaron, así que el bloqueo de apps está desactivado. Los recordatorios siguen gratis para siempre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus 14 dias ativos acabaram, então o bloqueio de apps está desligado. Os lembretes continuam grátis para sempre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je 14 actieve dagen zijn om, dus appblokkering staat uit. Herinneringen blijven altijd gratis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina 14 aktiva dagar är slut, så appblockering är av. Påminnelserna förblir gratis för alltid."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine 14 aktive dage er gået, så appblokering er slået fra. Påmindelserne forbliver gratis for altid."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De 14 aktive dagene dine er over, så appblokkering er av. Påminnelsene forblir gratis for alltid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "14 aktiivista päivääsi päättyi, joten sovellusesto on pois päältä. Muistutukset pysyvät ilmaisina aina."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus 14 dias ativos terminaram, por isso o bloqueio de apps está desligado. Os lembretes continuam grátis para sempre."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus 14 dies actius s’han acabat, així que el bloqueig d’apps està desactivat. Els recordatoris continuen sent gratis per sempre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje 14 dni aktywnych minęło, więc blokowanie aplikacji jest wyłączone. Przypomnienia zostają bezpłatne na zawsze."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvých 14 aktivních dní skončilo, takže blokování aplikací je vypnuté. Připomínky zůstávají zdarma navždy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои 14 активных дней прошли, поэтому блокировка приложений выключена. Напоминания останутся бесплатными навсегда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твої 14 активних днів минули, тому блокування застосунків вимкнено. Нагадування лишаться безкоштовними назавжди."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "服用14日間が終わったので、アプリブロックはオフです。リマインダーはずっと無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복용 14일이 끝나서 앱 차단이 꺼졌어요. 알림은 영원히 무료예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "14 hari aktif kamu sudah tamat, jadi sekatan apl dimatikan. Peringatan kekal percuma selamanya."
