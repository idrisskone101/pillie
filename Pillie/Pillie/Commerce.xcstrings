    "trial.end.extend.last_day.body": {
      "comment": "Extend offer timeline caption when notifications are off; the day is that stop's date [paywall]",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات متوقفة، لذا لا يمكننا تذكيرك. ألغي من الإعدادات قبل نهاية ذلك اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটিফিকেশন বন্ধ আছে, তাই আমরা মনে করিয়ে দিতে পারব না। সেই দিন শেষ হওয়ার আগে সেটিংসে বাতিল করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notificacions estan desactivades, així que no et podem avisar. Cancel·la a Configuració abans que acabi el dia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení máš vypnutá, takže ti to nemůžeme připomenout. Zruš předplatné v Nastavení do konce dne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer er slået fra, så vi kan ikke minde dig om det. Opsig i Indstillinger, inden dagen er omme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind aus, also können wir dich nicht erinnern. Kündige bis zum Ende des Tages in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ειδοποιήσεις είναι απενεργοποιημένες, οπότε δεν μπορούμε να σου το θυμίσουμε. Ακύρωσε στις Ρυθμίσεις μέχρι το τέλος της μέρας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off, so we can’t remind you. Cancel in Settings by the end of the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas, así que no podemos avisarte. Cancela en Ajustes antes de que termine el día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset ovat pois päältä, joten emme voi muistuttaa sinua. Peru Asetuksissa ennen päivän loppua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées, donc on ne peut pas te prévenir. Annule dans Réglages avant la fin de la journée."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નોટિફિકેશન બંધ છે, એટલે અમે તમને યાદ નહીં અપાવી શકીએ. તે દિવસ પૂરો થાય તે પહેલાં સેટિંગ્સમાં રદ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתראות כבויות, אז לא נוכל להזכיר לך. בטלי בהגדרות עד סוף היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोटिफ़िकेशन बंद हैं, इसलिए हम आपको याद नहीं दिला सकते। उस दिन के ख़त्म होने से पहले सेटिंग्स में रद्द करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti su isključene pa te ne možemo podsjetiti. Otkaži u Postavkama do kraja dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések ki vannak kapcsolva, így nem tudunk emlékeztetni. Mondd le a Beállításokban még a nap vége előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi mati, jadi kami tidak bisa mengingatkanmu. Batalkan di Pengaturan sebelum hari itu berakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate, quindi non possiamo avvisarti. Disdici in Impostazioni entro la fine della giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフのため、お知らせできません。その日のうちに設定から解約してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಧಿಸೂಚನೆಗಳು ಆಫ್ ಆಗಿವೆ, ಹಾಗಾಗಿ ನಿಮಗೆ ನೆನಪಿಸಲು ನಮಗೆ ಆಗುವುದಿಲ್ಲ. ಆ ದಿನ ಮುಗಿಯುವ ಮೊದಲು ಸೆಟ್ಟಿಂಗ್ಸ್‌ನಲ್ಲಿ ರದ್ದುಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있어 미리 알려 드릴 수 없어요. 그날이 끝나기 전에 설정에서 해지하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അറിയിപ്പുകൾ ഓഫാണ്, അതിനാൽ ഞങ്ങൾക്ക് ഓർമ്മിപ്പിക്കാൻ കഴിയില്ല. ആ ദിവസം കഴിയുന്നതിന് മുമ്പ് സെറ്റിംഗ്‌സിൽ റദ്ദാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना बंद आहेत, त्यामुळे आम्ही तुम्हाला आठवण करून देऊ शकत नाही. तो दिवस संपण्यापूर्वी सेटिंग्जमध्ये रद्द करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan dimatikan, jadi kami tidak dapat mengingatkan kamu. Batal dalam Tetapan sebelum hari itu berakhir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler er slått av, så vi kan ikke minne deg på det. Si opp i Innstillinger før dagen er omme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen staan uit, dus we kunnen je niet herinneren. Zeg vóór het einde van die dag op in Instellingen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନୋଟିଫିକେସନ୍ ବନ୍ଦ ଅଛି, ତେଣୁ ଆମେ ଆପଣଙ୍କୁ ମନେ ପକାଇ ପାରିବୁ ନାହିଁ। ସେହି ଦିନ ଶେଷ ହେବା ପୂର୍ବରୁ ସେଟିଂସରେ ବାତିଲ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨੋਟੀਫ਼ਿਕੇਸ਼ਨ ਬੰਦ ਹਨ, ਇਸ ਲਈ ਅਸੀਂ ਤੁਹਾਨੂੰ ਯਾਦ ਨਹੀਂ ਕਰਾ ਸਕਦੇ। ਉਸ ਦਿਨ ਦੇ ਖ਼ਤਮ ਹੋਣ ਤੋਂ ਪਹਿਲਾਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਰੱਦ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone, więc nie możemy ci przypomnieć. Anuluj w Ustawieniach do końca tego dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas, então não conseguimos avisar você. Cancele em Ajustes até o fim do dia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas, por isso não te conseguimos avisar. Cancela nas Definições até ao fim do dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările sunt dezactivate, așa că nu-ți putem aminti. Anulează din Configurări până la sfârșitul zilei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления выключены, поэтому мы не сможем напомнить. Отмени в Настройках до конца дня."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámenia máš vypnuté, takže ti to nemôžeme pripomenúť. Zruš v Nastaveniach do konca dňa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvestila so izklopljena, zato te ne moremo opomniti. Prekliči v Nastavitvah do konca dneva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiser är avstängda, så vi kan inte påminna dig. Avsluta i Inställningar innan dagen är slut."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிவிப்புகள் ஆஃப் ஆக உள்ளன, எனவே எங்களால் உங்களுக்கு நினைவூட்ட முடியாது. அந்த நாள் முடிவதற்குள் அமைப்புகளில் ரத்துசெய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నోటిఫికేషన్లు ఆఫ్‌లో ఉన్నాయి, కాబట్టి మేము గుర్తు చేయలేము. ఆ రోజు ముగిసేలోపు సెట్టింగ్స్‌లో రద్దు చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนปิดอยู่ เราจึงเตือนคุณไม่ได้ ยกเลิกในการตั้งค่าก่อนสิ้นวันนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler kapalı, bu yüzden sana hatırlatamayız. O gün bitmeden Ayarlar’dan iptal et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення вимкнено, тому ми не зможемо нагадати. Скасуй у Параметрах до кінця дня."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نوٹیفکیشن بند ہیں، اس لیے ہم آپ کو یاد نہیں دلا سکتے۔ اس دن کے ختم ہونے سے پہلے سیٹنگز میں منسوخ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo đang tắt nên chúng mình không thể nhắc bạn. Hãy hủy trong Cài đặt trước khi hết ngày đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭，我们无法提醒你。请在当天结束前到设置中取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已關閉，我們無法提醒你。請在當天結束前到設定中取消。"
          }
        }
      }
    },
    "trial.end.extend.charge.body": {
      "comment": "Extend offer timeline, caption under the price on the charge date [paywall]",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدفع بعد أيامك المجانية السبعة. يتجدد كل سنة حتى تلغي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার 7 দিন ফ্রি শেষ হলে চার্জ হবে। বাতিল না করা পর্যন্ত প্রতি বছর রিনিউ হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobrament després dels teus 7 dies gratis. Es renova cada any fins que el cancel·lis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platba až po tvých 7 dnech zdarma. Obnovuje se každý rok, dokud ho nezrušíš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bliver opkrævet efter dine 7 gratis dage. Fornyes hvert år, indtil du opsiger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbuchung nach deinen 7 Gratistagen. Verlängert sich jedes Jahr, bis du kündigst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρέωση μετά τις 7 δωρεάν μέρες σου. Ανανεώνεται κάθε χρόνο μέχρι να ακυρώσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charged after your 7 free days. Renews every year until you cancel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobro después de tus 7 días gratis. Se renueva cada año hasta que canceles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Veloitus vasta 7 ilmaisen päiväsi jälkeen. Uusiutuu vuosittain, kunnes perut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prélèvement après tes 7 jours gratuits. Se renouvelle chaque année jusqu’à ce que tu annules."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા 7 મફત દિવસ પૂરા થયા પછી ચાર્જ થશે. તમે રદ ન કરો ત્યાં સુધી દર વર્ષે રિન્યૂ થશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיוב אחרי 7 ימי החינם שלך. מתחדש כל שנה עד שתבטלי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके 7 मुफ़्त दिनों के बाद भुगतान होगा। जब तक आप रद्द न करें, हर साल रिन्यू होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naplata nakon tvojih 7 besplatnih dana. Obnavlja se svake godine dok ne otkažeš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A terhelés a 7 ingyenes napod után történik. Minden évben megújul, amíg le nem mondod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu ditagih setelah 7 hari gratismu berakhir. Diperpanjang setiap tahun sampai kamu batalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Addebito dopo i tuoi 7 giorni gratis. Si rinnova ogni anno finché non disdici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "請求は7日間の無料期間が終わってからです。解約するまで毎年自動で更新されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ 7 ಉಚಿತ ದಿನಗಳ ನಂತರ ಶುಲ್ಕ ವಿಧಿಸಲಾಗುತ್ತದೆ. ನೀವು ರದ್ದುಮಾಡುವವರೆಗೆ ಪ್ರತಿ ವರ್ಷ ನವೀಕರಣವಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제는 7일 무료 이용이 끝난 뒤에 돼요. 해지할 때까지 매년 갱신돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ 7 സൗജന്യ ദിവസങ്ങൾക്ക് ശേഷം ചാർജ് ചെയ്യും. നിങ്ങൾ റദ്ദാക്കുന്നത് വരെ എല്ലാ വർഷവും പുതുക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे 7 मोफत दिवस संपल्यानंतर शुल्क घेतले जाईल. तुम्ही रद्द करेपर्यंत दरवर्षी रिन्यू होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu dicaj selepas 7 hari percuma kamu tamat. Diperbaharui setiap tahun sehingga kamu batal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du belastes etter de 7 gratisdagene dine. Fornyes hvert år til du sier opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je betaalt pas na je 7 gratis dagen. Verlengt elk jaar tot je opzegt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ 7 ଦିନ ମାଗଣା ଶେଷ ହେବା ପରେ ଚାର୍ଜ ହେବ। ଆପଣ ବାତିଲ୍ ନକରିବା ପର୍ଯ୍ୟନ୍ତ ପ୍ରତିବର୍ଷ ନବୀକରଣ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ 7 ਮੁਫ਼ਤ ਦਿਨਾਂ ਤੋਂ ਬਾਅਦ ਚਾਰਜ ਹੋਵੇਗਾ। ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਰੱਦ ਨਹੀਂ ਕਰਦੇ, ਹਰ ਸਾਲ ਰੀਨਿਊ ਹੋਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobranie płatności po twoich 7 darmowych dniach. Odnawia się co roku, dopóki nie anulujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobrança depois dos seus 7 dias grátis. Renova todo ano até você cancelar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobrança depois dos teus 7 dias grátis. Renova todos os anos até cancelares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plata după cele 7 zile gratuite. Se reînnoiește în fiecare an până anulezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Списание после твоих 7 бесплатных дней. Продлевается каждый год, пока не отменишь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platba až po tvojich 7 dňoch zadarmo. Obnovuje sa každý rok, kým ho nezrušíš."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plačilo po tvojih 7 brezplačnih dneh. Podaljša se vsako leto, dokler ne prekličeš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du debiteras efter dina 7 gratisdagar. Förnyas varje år tills du avslutar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் 7 இலவச நாட்களுக்குப் பிறகு கட்டணம் வசூலிக்கப்படும். நீங்கள் ரத்துசெய்யும் வரை ஒவ்வொரு ஆண்டும் புதுப்பிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ 7 ఉచిత రోజుల తర్వాత ఛార్జ్ అవుతుంది. మీరు రద్దు చేసే వరకు ప్రతి సంవత్సరం పునరుద్ధరించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียกเก็บเงินหลังจากใช้ฟรีครบ 7 วัน ต่ออายุทุกปีจนกว่าคุณจะยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme, 7 ücretsiz gününden sonra alınır. İptal edene kadar her yıl yenilenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Списання після твоїх 7 безкоштовних днів. Продовжується щороку, доки не скасуєш."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے 7 مفت دنوں کے بعد چارج ہوگا۔ جب تک آپ منسوخ نہ کریں، ہر سال رینیو ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn bị tính phí sau 7 ngày miễn phí. Tự gia hạn mỗi năm cho đến khi bạn hủy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天免费期结束后扣费。每年自动续订，直到你取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天免費期結束後扣款。每年自動續訂，直到你取消。"
          }
        }
      }
    },
