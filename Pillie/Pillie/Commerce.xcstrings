            "state": "translated",
            "value": "จัดการหรือยกเลิกได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可随时在设置中管理或取消"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स में कभी भी मैनेज या रद्द करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravljaj ili otkaži bilo kada u Postavkama"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor kezelhető vagy lemondható a Beállításokban"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar’dan istediğin an yönet veya iptal et"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகளில் எப்போது வேண்டுமானாலும் நிர்வகிக்கலாம் அல்லது ரத்துசெய்யலாம்"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola atau batalkan kapan saja di Pengaturan"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أديري اشتراكك أو ألغيه في أي وقت من الإعدادات"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לנהל או לבטל בכל עת בהגדרות"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý hoặc hủy bất cứ lúc nào trong Cài đặt"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংসে যেকোনো সময় ম্যানেজ বা বাতিল করুন"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیٹنگز میں کبھی بھی مینیج یا منسوخ کریں"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravljaj ali prekliči kadar koli v Nastavitvah"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαχείριση ή ακύρωση όποτε θέλεις στις Ρυθμίσεις"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెట్టింగ్స్‌లో ఎప్పుడైనా నిర్వహించవచ్చు లేదా రద్దు చేయవచ్చు"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可隨時在設定中管理或取消"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સેટિંગ્સમાં ગમે ત્યારે મેનેજ કરો અથવા રદ કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೆಟ್ಟಿಂಗ್ಸ್‌ನಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ ನಿರ್ವಹಿಸಬಹುದು ಅಥವಾ ರದ್ದುಮಾಡಬಹುದು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സെറ്റിംഗ്‌സിൽ എപ്പോൾ വേണമെങ്കിലും മാനേജ് ചെയ്യാം അല്ലെങ്കിൽ റദ്ദാക്കാം"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्जमध्ये कधीही मॅनेज करा किंवा रद्द करा"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସେଟିଂସରେ ଯେକୌଣସି ସମୟରେ ପରିଚାଳନା କିମ୍ବା ବାତିଲ୍ କରନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਕਦੇ ਵੀ ਪ੍ਰਬੰਧ ਕਰੋ ਜਾਂ ਰੱਦ ਕਰੋ"
          }
        }
      }
    },
