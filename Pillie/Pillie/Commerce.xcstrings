    "paywall.board.get_plus.subtitle": {
      "comment": "'check in' = log the dose in Pillie. Use the same verb the app already uses for check in.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pauses the apps you choose until you check in, and keeps reminding you until you do."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pausiert die Apps, die du auswählst, bis du abhakst, und erinnert dich weiter, bis du es tust."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus mette in pausa le app che scegli finché non confermi, e continua a ricordartelo finché non lo fai."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus met en pause les apps que tu choisis jusqu’à ce que tu valides, et continue de te le rappeler tant que ce n’est pas fait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pausa las apps que elijas hasta que marques lo de hoy, y te lo sigue recordando hasta que lo hagas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Plus pausa os apps que você escolher até você registrar, e continua te lembrando até lá."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Plus põe em pausa as apps que escolheres até registares, e continua a lembrar-te até o fazeres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pauzeert de apps die je kiest tot je afvinkt, en blijft je herinneren tot je dat doet."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Plus posa en pausa les apps que triïs fins que confirmis, i t’ho continua recordant fins que ho facis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus sætter de apps, du vælger, på pause, indtil du krydser af, og bliver ved med at minde dig om det, indtil du gør det."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pausar apparna du väljer tills du bockar av, och fortsätter påminna dig tills du gör det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pauser appene du velger til du krysser av, og fortsetter å minne deg på det til du gjør det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus laittaa valitsemasi sovellukset tauolle, kunnes kuittaat, ja muistuttaa, kunnes teet sen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus wstrzymuje wybrane aplikacje, dopóki nie odhaczysz dnia, i przypomina, dopóki tego nie zrobisz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pozastaví vybrané aplikace, dokud neodškrtneš dnešek, a připomíná ti to, dokud to neuděláš."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pozastaví vybrané aplikácie, kým neodškrtneš dnešok, a pripomína ti to, kým to neurobíš."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pauzira aplikacije koje odabereš dok se ne javiš i podsjeća te sve dok to ne učiniš."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus začasno zaustavi izbrane aplikacije, dokler ne odkljukaš, in te opominja, dokler tega ne narediš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Plus szünetelteti a kiválasztott appokat, amíg ki nem pipálod, és addig emlékeztet, amíg meg nem teszed."
