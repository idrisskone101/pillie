    "paywall.story.trial_ended.returning.hard.subtitle": {
      "comment": "Returning expired-trial paywall",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App blocking and follow-up reminders stay off until you turn Plus back on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Sperre und Folgeerinnerungen bleiben aus, bis du Plus wieder einschaltest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco app e i promemoria ripetuti restano disattivati finché non riattivi Plus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى حظر التطبيقات وتذكيرات المتابعة غير مفعّلين حتى تعيدي تفعيل Plus."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus আবার চালু না করা পর্যন্ত অ্যাপ ব্লকিং আর ফলো-আপ রিমাইন্ডার বন্ধ থাকবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueig d’apps i els recordatoris de seguiment es queden desactivats fins que tornis a activar el Plus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokování aplikací a následné připomínky zůstanou vypnuté, dokud Plus znovu nezapneš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblokering og opfølgende påmindelser forbliver slået fra, indtil du slår Plus til igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αποκλεισμός εφαρμογών και οι επαναληπτικές υπενθυμίσεις μένουν ανενεργά μέχρι να ενεργοποιήσεις ξανά το Plus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo de apps y los recordatorios de seguimiento siguen desactivados hasta que reactives Plus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellusesto ja jatkomuistutukset pysyvät pois päältä, kunnes otat Plusin taas käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le blocage d’apps et les rappels de relance restent désactivés jusqu’à ce que tu réactives Plus."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે Plus ફરી ચાલુ ન કરો ત્યાં સુધી ઍપ બ્લૉકિંગ અને ફૉલો-અપ રિમાઇન્ડર બંધ રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חסימת אפליקציות ותזכורות המשך נשארות כבויות עד שתפעילי את Plus מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus फिर से चालू करने तक ऐप ब्लॉकिंग और फ़ॉलो-अप रिमाइंडर बंद रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje aplikacija i ponovni podsjetnici ostaju isključeni dok ponovno ne uključiš Plus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appblokkolás és az ismétlő emlékeztetők kikapcsolva maradnak, amíg vissza nem kapcsolod a Plust."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokir aplikasi dan pengingat lanjutan tetap mati sampai kamu mengaktifkan Plus lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusを再開するまで、アプリブロックとフォローアップリマインダーはオフのままです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು Plus ಅನ್ನು ಮತ್ತೆ ಆನ್ ಮಾಡುವವರೆಗೆ ಆ್ಯಪ್ ನಿರ್ಬಂಧ ಮತ್ತು ಮರು ಜ್ಞಾಪನೆಗಳು ಆಫ್ ಆಗಿಯೇ ಇರುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus를 다시 켤 때까지 앱 차단과 후속 알림은 꺼져 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ Plus വീണ്ടും ഓണാക്കുന്നതുവരെ ആപ്പ് ബ്ലോക്കിംഗും ഫോളോ-അപ്പ് റിമൈൻഡറുകളും ഓഫായിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus पुन्हा सुरू करेपर्यंत ॲप ब्लॉकिंग आणि फॉलो-अप रिमाइंडर बंद राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekatan apl dan peringatan susulan kekal mati sehingga kamu hidupkan Plus semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblokkering og oppfølgingspåminnelser er av til du slår på Plus igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblokkering en vervolgherinneringen blijven uit tot je Plus weer aanzet."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ Plus ପୁଣି ଚାଲୁ ନକରିବା ପର୍ଯ୍ୟନ୍ତ ଆପ୍ ବ୍ଲକିଂ ଓ ଫଲୋ-ଅପ୍ ରିମାଇଣ୍ଡର୍ ବନ୍ଦ ରହିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ Plus ਮੁੜ ਚਾਲੂ ਨਹੀਂ ਕਰਦੇ, ਐਪ ਬਲੌਕਿੰਗ ਅਤੇ ਫ਼ਾਲੋ-ਅੱਪ ਰਿਮਾਈਂਡਰ ਬੰਦ ਰਹਿਣਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokowanie aplikacji i ponowne przypomnienia pozostaną wyłączone, dopóki nie włączysz ponownie Plus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio de apps e os lembretes de acompanhamento ficam desligados até você reativar o Plus."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio de apps e os lembretes de seguimento ficam desligados até voltares a ativar o Plus."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocarea aplicațiilor și mementourile repetate rămân oprite până reactivezi Plus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка приложений и повторные напоминания выключены, пока ты снова не включишь Plus."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokovanie aplikácií a následné pripomienky ostanú vypnuté, kým Plus znova nezapneš."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje aplikacij in ponovni opomniki ostanejo izklopljeni, dokler znova ne vklopiš Plus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblockering och uppföljande påminnelser förblir av tills du slår på Plus igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் Plus-ஐ மீண்டும் இயக்கும் வரை ஆப் தடுப்பும் தொடர் நினைவூட்டல்களும் ஆஃப் ஆகவே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు Plus మళ్లీ ఆన్ చేసే వరకు యాప్ బ్లాకింగ్, ఫాలో-అప్ రిమైండర్లు ఆఫ్‌లోనే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบล็อกแอปและการแจ้งเตือนซ้ำจะปิดอยู่จนกว่าคุณจะเปิด Plus อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama engelleme ve takip hatırlatmaları, Plus’ı yeniden açana kadar kapalı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокування застосунків і повторні нагадування вимкнені, доки ти знову не ввімкнеш Plus."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus دوبارہ آن کرنے تک ایپ بلاکنگ اور فالو اپ یاد دہانیاں بند رہتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chặn ứng dụng và lời nhắc lặp lại vẫn tắt cho đến khi bạn bật lại Plus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你重新开启 Plus 之前，应用屏蔽和后续提醒会保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你重新開啟 Plus 之前，App 封鎖和後續提醒會維持關閉。"
          }
        }
      }
    },
