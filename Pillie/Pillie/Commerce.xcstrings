        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Pillie Plus యాక్సెస్ తనిఖీ చేస్తున్నాము"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查你的 Pillie Plus 權限"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી Pillie Plus ઍક્સેસ ચકાસી રહ્યા છીએ"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ Pillie Plus ಪ್ರವೇಶವನ್ನು ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ Pillie Plus ആക്‌സസ് പരിശോധിക്കുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा Pillie Plus ॲक्सेस तपासत आहोत"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ Pillie Plus ଆକ୍ସେସ୍ ଯାଞ୍ଚ ହେଉଛି"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ Pillie Plus ਪਹੁੰਚ ਦੀ ਜਾਂਚ ਹੋ ਰਹੀ ਹੈ"
          }
        }
      }
    },
    "commerce.access_verification.body": {
      "comment": "Access verification gate guidance [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the internet so Pillie can verify your purchases before opening the app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti a internet così Pillie può verificare i tuoi acquisti prima di aprire l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit dem Internet, damit Pillie deine Käufe prüfen kann, bevor die App geöffnet wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à Internet pour que Pillie vérifie tes achats avant d’ouvrir l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a internet para que Pillie verifique tus compras antes de abrir la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se à internet para o Pillie verificar suas compras antes de abrir o app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak verbinding met internet zodat Pillie je aankopen kan verifiëren voordat de app opent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut till internet så att Pillie kan verifiera dina köp innan appen öppnas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå online, så Pillie kan bekræfte dine køb, før appen åbner."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til internett så Pillie kan bekrefte kjøpene dine før appen åpnes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä internetiin, jotta Pillie voi vahvistaa ostosi ennen sovelluksen avaamista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga-te à internet para que o Pillie possa verificar as tuas compras antes de abrir a app."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecta’t a internet perquè Pillie pugui verificar les teves compres abans d’obrir l’app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z internetem, aby Pillie mogło sprawdzić twoje zakupy przed otwarciem aplikacji."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připoj se k internetu, aby Pillie mohla před otevřením aplikace ověřit tvoje nákupy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключись к интернету: Pillie нужно проверить твои покупки перед запуском приложения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключися до інтернету: Pillie потрібно перевірити твої покупки перед запуском застосунку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開く前にPillieが購入を確認できるよう、インターネットに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열기 전에 Pillie가 구매를 확인할 수 있도록 인터넷에 연결해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambung ke internet supaya Pillie boleh mengesahkan pembelian kamu sebelum membuka apl."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te la internet ca Pillie să-ți poată verifica achizițiile înainte de a deschide aplicația."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripoj sa na internet, aby Pillie mohla pred otvorením aplikácie overiť tvoje nákupy."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่ออินเทอร์เน็ตเพื่อให้ Pillie ตรวจสอบการซื้อของคุณก่อนเปิดแอป"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接互联网，以便 Pillie 在打开应用前验证你的购买。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरनेट से जुड़ें, ताकि ऐप खुलने से पहले Pillie आपकी ख़रीदारी की पुष्टि कर सके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoji se na internet da Pillie može provjeriti tvoje kupnje prije otvaranja aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakozz az internethez, hogy a Pillie ellenőrizhesse a vásárlásaidat az app megnyitása előtt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie’nin uygulamayı açmadan önce satın alımlarını doğrulayabilmesi için internete bağlan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப்பைத் திறப்பதற்கு முன் Pillie உங்கள் கொள்முதல்களைச் சரிபார்க்க, இணையத்துடன் இணையுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan ke internet agar Pillie bisa memverifikasi pembelianmu sebelum membuka aplikasi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصلي بالإنترنت ليتمكن Pillie من التحقق من مشترياتك قبل فتح التطبيق."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחברי לאינטרנט כדי ש-Pillie תוכל לאמת את הרכישות שלך לפני פתיחת האפליקציה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối internet để Pillie xác minh giao dịch của bạn trước khi mở ứng dụng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ খোলার আগে Pillie যেন আপনার কেনাকাটা যাচাই করতে পারে, সেজন্য ইন্টারনেটে সংযুক্ত হন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انٹرنیٹ سے جڑیں، تاکہ ایپ کھلنے سے پہلے Pillie آپ کی خریداریوں کی تصدیق کر سکے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poveži se z internetom, da lahko Pillie preveri tvoje nakupe, preden odpre aplikacijo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέσου στο διαδίκτυο για να επαληθεύσει το Pillie τις αγορές σου πριν ανοίξει η εφαρμογή."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్ తెరిచే ముందు Pillie మీ కొనుగోళ్లను ధృవీకరించడానికి, ఇంటర్నెట్‌కు కనెక్ట్ అవ్వండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請連上網路，讓 Pillie 在開啟 App 前驗證你的購買項目。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપ ખોલતાં પહેલાં Pillie તમારી ખરીદી ચકાસી શકે તે માટે ઇન્ટરનેટ સાથે જોડાઓ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್ ತೆರೆಯುವ ಮೊದಲು Pillie ನಿಮ್ಮ ಖರೀದಿಗಳನ್ನು ಪರಿಶೀಲಿಸಲು, ಇಂಟರ್ನೆಟ್‌ಗೆ ಸಂಪರ್ಕಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് തുറക്കുന്നതിന് മുമ്പ് Pillie-ക്ക് നിങ്ങളുടെ വാങ്ങലുകൾ പരിശോധിക്കാൻ, ഇന്റർനെറ്റിലേക്ക് കണക്റ്റ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरनेटशी कनेक्ट करा, म्हणजे ॲप उघडण्याआधी Pillie तुमच्या खरेदीची पडताळणी करू शकेल."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପ୍ ଖୋଲିବା ପୂର୍ବରୁ Pillie ଆପଣଙ୍କ କ୍ରୟ ଯାଞ୍ଚ କରିପାରିବା ପାଇଁ ଇଣ୍ଟରନେଟ୍ ସହ ସଂଯୋଗ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੰਟਰਨੈੱਟ ਨਾਲ ਜੁੜੋ ਤਾਂ ਜੋ ਐਪ ਖੋਲ੍ਹਣ ਤੋਂ ਪਹਿਲਾਂ Pillie ਤੁਹਾਡੀਆਂ ਖ਼ਰੀਦਾਂ ਦੀ ਪੁਸ਼ਟੀ ਕਰ ਸਕੇ।"
          }
        }
      }
    },
    "commerce.access_verification.error": {
      "comment": "Access verification retry guidance [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t verify your access. Check your connection, try again, or restore purchases."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare l’accesso. Controlla la connessione, riprova o ripristina gli acquisti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Zugang konnte nicht geprüft werden. Prüfe die Verbindung, versuche es erneut oder stelle Käufe wieder her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier ton accès. Vérifie ta connexion, réessaie ou restaure tes achats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos verificar tu acceso. Revisa tu conexión, inténtalo de nuevo o restaura tus compras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar seu acesso. Verifique a conexão, tente de novo ou restaure suas compras."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden je toegang niet verifiëren. Controleer je verbinding, probeer opnieuw of herstel aankopen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunde inte verifiera din åtkomst. Kontrollera anslutningen, försök igen eller återställ köp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke bekræfte din adgang. Tjek din forbindelse, prøv igen, eller gendan køb."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fikk ikke bekreftet tilgangen din. Sjekk tilkoblingen, prøv igjen eller gjenopprett kjøp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttöoikeuttasi ei voitu vahvistaa. Tarkista yhteys, yritä uudelleen tai palauta ostot."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos verificar o teu acesso. Verifica a ligação, tenta de novo ou restaura as compras."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hem pogut verificar el teu accés. Revisa la connexió, torna-ho a provar o restaura les compres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się sprawdzić dostępu. Sprawdź połączenie, spróbuj ponownie lub przywróć zakupy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup se nepodařilo ověřit. Zkontroluj připojení, zkus to znovu nebo obnov nákupy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить доступ. Проверь соединение, попробуй ещё раз или восстанови покупки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити доступ. Перевір з’єднання, спробуй ще раз або віднови покупки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスを確認できませんでした。接続を確認してもう一度試すか、購入を復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이용 권한을 확인할 수 없었어요. 연결을 확인하고 다시 시도하거나 구매를 복원하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak dapat mengesahkan akses kamu. Semak sambungan, cuba lagi, atau pulihkan pembelian."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut verifica accesul tău. Verifică conexiunea, încearcă din nou sau restabilește achizițiile."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa overiť tvoj prístup. Skontroluj pripojenie, skús to znova alebo obnov nákupy."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราตรวจสอบสิทธิ์ของคุณไม่ได้ ตรวจสอบการเชื่อมต่อ ลองอีกครั้ง หรือกู้คืนการซื้อ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证你的权限。检查网络连接后再试一次，或恢复购买。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपका ऐक्सेस जाँच नहीं पाए। अपना कनेक्शन देखें, फिर कोशिश करें, या ख़रीदारी रीस्टोर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nismo mogli provjeriti tvoj pristup. Provjeri vezu, pokušaj ponovno ili obnovi kupnje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült ellenőrizni a hozzáférésedet. Ellenőrizd a kapcsolatot, próbáld újra, vagy állítsd vissza a vásárlásokat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişimini doğrulayamadık. Bağlantını kontrol et, tekrar dene veya satın alımları geri yükle."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அணுகலை எங்களால் சரிபார்க்க முடியவில்லை. இணைப்பைச் சரிபாருங்கள், மீண்டும் முயலுங்கள், அல்லது கொள்முதல்களை மீட்டெடுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak bisa memverifikasi aksesmu. Periksa koneksi, coba lagi, atau pulihkan pembelian."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نتمكن من التحقق من وصولك. تحققي من الاتصال، أو أعيدي المحاولة، أو استعيدي المشتريات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לאמת את הגישה שלך. בדקי את החיבור, נסי שוב או שחזרי רכישות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xác minh được quyền truy cập của bạn. Kiểm tra kết nối, thử lại hoặc khôi phục giao dịch."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাক্সেস যাচাই করা যায়নি। সংযোগ দেখে নিন, আবার চেষ্টা করুন, অথবা কেনাকাটা ফিরিয়ে আনুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم آپ کی رسائی کی تصدیق نہیں کر سکے۔ اپنا کنکشن دیکھیں، دوبارہ کوشش کریں، یا خریداریاں بحال کریں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostopa ni bilo mogoče preveriti. Preveri povezavo, poskusi znova ali obnovi nakupe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορέσαμε να επαληθεύσουμε την πρόσβασή σου. Έλεγξε τη σύνδεση, δοκίμασε ξανά ή κάνε επαναφορά αγορών."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ యాక్సెస్‌ను మేము ధృవీకరించలేకపోయాము. మీ కనెక్షన్ చెక్ చేయండి, మళ్లీ ప్రయత్నించండి, లేదా కొనుగోళ్లను పునరుద్ధరించండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證你的權限。請檢查網路連線、再試一次，或回復購買。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અમે તમારી ઍક્સેસ ચકાસી શક્યા નહીં. તમારું કનેક્શન તપાસો, ફરી પ્રયાસ કરો, અથવા ખરીદી પુનઃસ્થાપિત કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪ್ರವೇಶವನ್ನು ನಮಗೆ ಪರಿಶೀಲಿಸಲು ಆಗಲಿಲ್ಲ. ನಿಮ್ಮ ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ, ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ, ಅಥವಾ ಖರೀದಿಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞങ്ങൾക്ക് നിങ്ങളുടെ ആക്‌സസ് പരിശോധിക്കാനായില്ല. നിങ്ങളുടെ കണക്ഷൻ പരിശോധിക്കൂ, വീണ്ടും ശ്രമിക്കൂ, അല്ലെങ്കിൽ വാങ്ങലുകൾ പുനഃസ്ഥാപിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आम्ही तुमचा ॲक्सेस तपासू शकलो नाही. तुमचे कनेक्शन तपासा, पुन्हा प्रयत्न करा, किंवा खरेदी रिस्टोअर करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆମେ ଆପଣଙ୍କ ଆକ୍ସେସ୍ ଯାଞ୍ଚ କରିପାରିଲୁ ନାହିଁ। ସଂଯୋଗ ଯାଞ୍ଚ କରନ୍ତୁ, ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ, କିମ୍ବା କ୍ରୟ ପୁନରୁଦ୍ଧାର କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਸੀਂ ਤੁਹਾਡੀ ਪਹੁੰਚ ਦੀ ਪੁਸ਼ਟੀ ਨਹੀਂ ਕਰ ਸਕੇ। ਆਪਣਾ ਕਨੈਕਸ਼ਨ ਦੇਖੋ, ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ, ਜਾਂ ਖ਼ਰੀਦਾਂ ਰੀਸਟੋਰ ਕਰੋ।"
          }
        }
      }
    },
