    "paywall.upsell.custom_messages.body": {
      "comment": "Custom reminder messages plus-gate body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write your reminders in your own words. With Plus you can change the daily reminder and the follow-up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe deine Erinnerungen mit deinen eigenen Worten. Mit Plus kannst du die tägliche Erinnerung und die Folgeerinnerung ändern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi i promemoria con le tue parole. Con Plus puoi cambiare il promemoria giornaliero e quello successivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris tes rappels avec tes mots. Avec Plus, tu peux modifier le rappel quotidien et la relance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe tus recordatorios con tus palabras. Con Plus puedes cambiar el recordatorio diario y el de seguimiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva seus lembretes com suas palavras. Com o Plus, você pode mudar o lembrete diário e o de acompanhamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf je herinneringen in je eigen woorden. Met Plus pas je de dagelijkse herinnering en de vervolgherinnering aan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv dina påminnelser med dina egna ord. Med Plus kan du ändra den dagliga påminnelsen och den uppföljande."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv dine påmindelser med dine egne ord. Med Plus kan du ændre den daglige påmindelse og den opfølgende."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv påminnelsene med dine egne ord. Med Plus kan du endre den daglige påminnelsen og oppfølgingen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita muistutukset omin sanoin. Plusilla voit muuttaa päivittäisen muistutuksen ja jatkomuistutuksen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve os teus lembretes por palavras tuas. Com o Plus, podes alterar o lembrete diário e o de seguimento."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriu els recordatoris amb les teves paraules. Amb el Plus pots canviar el recordatori diari i el de seguiment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz przypomnienia własnymi słowami. Z Plus zmienisz codzienne przypomnienie i to ponowne."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiš si připomínky vlastními slovy. S Plus změníš denní i následnou připomínku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пиши напоминания своими словами. С Plus можно изменить ежедневное напоминание и повторное."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пиши нагадування своїми словами. З Plus можна змінити щоденне нагадування й повторне."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーを自分の言葉で書けます。Plusなら、毎日のリマインダーとフォローアップの文言を変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 내 말로 직접 써 보세요. Plus에서는 매일 알림과 후속 알림 문구를 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis peringatan dengan kata-kata kamu sendiri. Dengan Plus, kamu boleh tukar peringatan harian dan peringatan susulan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrie mementourile cu cuvintele tale. Cu Plus poți schimba mementoul zilnic și pe cel repetat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíš si pripomienky vlastnými slovami. S Plus zmeníš dennú aj následnú pripomienku."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนการแจ้งเตือนด้วยคำของคุณเอง เมื่อมี Plus คุณเปลี่ยนได้ทั้งการแจ้งเตือนประจำวันและการแจ้งเตือนซ้ำ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你自己的话写提醒。有了 Plus，你可以修改每日提醒和后续提醒。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने रिमाइंडर अपने शब्दों में लिखें। Plus के साथ रोज़ का रिमाइंडर और फ़ॉलो-अप, दोनों बदले जा सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiši svoje podsjetnike svojim riječima. S Plusom možeš promijeniti dnevni i ponovni podsjetnik."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd meg az emlékeztetőidet a saját szavaiddal. A Plusszal a napi és az ismétlő emlékeztetőt is módosíthatod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatmalarını kendi kelimelerinle yaz. Plus ile günlük hatırlatmayı ve takip hatırlatmasını değiştirebilirsin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நினைவூட்டல்களை உங்கள் சொந்த வார்த்தைகளில் எழுதுங்கள். Plus மூலம் தினசரி நினைவூட்டலையும் தொடர் நினைவூட்டலையும் மாற்றலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis pengingat dengan kata-katamu sendiri. Dengan Plus, kamu bisa mengubah pengingat harian dan pengingat lanjutan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتبي تذكيراتك بكلماتك. مع Plus يمكنك تغيير التذكير اليومي وتذكير المتابعة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתבי את התזכורות במילים שלך. עם Plus אפשר לשנות את התזכורת היומית ואת תזכורת ההמשך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết lời nhắc theo cách của bạn. Với Plus, bạn có thể đổi lời nhắc hàng ngày và lời nhắc lặp lại."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডার নিজের ভাষায় লিখুন। Plus থাকলে দৈনিক রিমাইন্ডার আর ফলো-আপ দুটোই বদলাতে পারবেন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی یاد دہانیاں اپنے الفاظ میں لکھیں۔ Plus کے ساتھ روزانہ کی یاد دہانی اور فالو اپ، دونوں بدلے جا سکتے ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiši opomnike s svojimi besedami. S Plus lahko spremeniš dnevni in ponovni opomnik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γράψε τις υπενθυμίσεις σου με τα δικά σου λόγια. Με το Plus αλλάζεις την καθημερινή και την επαναληπτική υπενθύμιση."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రిమైండర్లను మీ సొంత మాటల్లో రాయండి. Plusతో రోజువారీ రిమైండర్‌ను, ఫాలో-అప్‌ను మార్చవచ్చు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用你自己的話寫提醒。有了 Plus，你可以修改每日提醒和後續提醒。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારાં રિમાઇન્ડર તમારા પોતાના શબ્દોમાં લખો. Plus સાથે તમે રોજનું રિમાઇન્ડર અને ફૉલો-અપ બદલી શકો છો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಜ್ಞಾಪನೆಗಳನ್ನು ನಿಮ್ಮದೇ ಮಾತುಗಳಲ್ಲಿ ಬರೆಯಿರಿ. Plus ಜೊತೆ ನೀವು ದೈನಂದಿನ ಜ್ಞಾಪನೆಯನ್ನು ಮತ್ತು ಮರು ಜ್ಞಾಪನೆಯನ್ನು ಬದಲಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ റിമൈൻഡറുകൾ നിങ്ങളുടെ സ്വന്തം വാക്കുകളിൽ എഴുതൂ. Plus ഉപയോഗിച്ച് ദൈനംദിന റിമൈൻഡറും ഫോളോ-അപ്പും മാറ്റാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे रिमाइंडर तुमच्या शब्दांत लिहा. Plus सह रोजचा रिमाइंडर आणि फॉलो-अप, दोन्ही बदलता येतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ରିମାଇଣ୍ଡର୍ ନିଜ ଶବ୍ଦରେ ଲେଖନ୍ତୁ। Plus ସହ ଆପଣ ଦୈନିକ ରିମାଇଣ୍ଡର୍ ଓ ଫଲୋ-ଅପ୍ ବଦଳାଇପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਰਿਮਾਈਂਡਰ ਆਪਣੇ ਸ਼ਬਦਾਂ ਵਿੱਚ ਲਿਖੋ। Plus ਨਾਲ ਤੁਸੀਂ ਰੋਜ਼ਾਨਾ ਰਿਮਾਈਂਡਰ ਅਤੇ ਫ਼ਾਲੋ-ਅੱਪ ਬਦਲ ਸਕਦੇ ਹੋ।"
          }
        }
      }
    },
