    "paywall.story.trial_ended.subtitle": {
      "comment": "",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay on Pillie Plus to keep follow-up reminders and app blocking."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibe bei Pillie Plus, um Folgeerinnerungen und die App-Sperre zu behalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta su Pillie Plus per tenere i promemoria ripetuti e il blocco app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابقي على Pillie Plus لتحتفظي بتذكيرات المتابعة وحظر التطبيقات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফলো-আপ রিমাইন্ডার আর অ্যাপ ব্লকিং রাখতে Pillie Plus চালু রাখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua amb Pillie Plus per conservar els recordatoris de seguiment i el bloqueig d’apps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstaň u Pillie Plus a následné připomínky i blokování aplikací ti zůstanou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt med Pillie Plus for at beholde opfølgende påmindelser og appblokering."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μείνε στο Pillie Plus για να κρατήσεις τις επαναληπτικές υπενθυμίσεις και τον αποκλεισμό εφαρμογών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue con Pillie Plus para conservar los recordatorios de seguimiento y el bloqueo de apps."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka Pillie Plusilla, niin jatkomuistutukset ja sovellusesto säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde Pillie Plus pour conserver les rappels de relance et le blocage d’apps."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફૉલો-અપ રિમાઇન્ડર અને ઍપ બ્લૉકિંગ રાખવા Pillie Plus ચાલુ રાખો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הישארי עם Pillie Plus כדי לשמור על תזכורות המשך וחסימת אפליקציות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉलो-अप रिमाइंडर और ऐप ब्लॉकिंग के लिए Pillie Plus जारी रखें।"
