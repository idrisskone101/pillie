          "stringUnit": {
            "state": "translated",
            "value": "कुछ गड़बड़ हो गई। थोड़ी देर में फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nešto je pošlo po zlu. Pokušaj ponovno za trenutak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valami hiba történt. Próbáld újra egy kicsit később."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şeyler ters gitti. Birazdan tekrar dene."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏதோ தவறு நடந்தது. சிறிது நேரத்தில் மீண்டும் முயலுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan. Coba lagi sebentar lagi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما. أعيدي المحاولة بعد قليل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש. נסי שוב בעוד רגע."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có lỗi xảy ra. Thử lại sau giây lát."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু একটা সমস্যা হয়েছে। একটু পরে আবার চেষ্টা করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ گڑبڑ ہو گئی۔ تھوڑی دیر میں دوبارہ کوشش کریں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekaj je šlo narobe. Poskusi znova čez trenutek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι πήγε στραβά. Δοκίμασε ξανά σε λίγο."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదో తప్పు జరిగింది. కాసేపటి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生錯誤。稍後再試一次。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંઈક ખોટું થયું. થોડી વારમાં ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನೋ ತಪ್ಪಾಗಿದೆ. ಸ್ವಲ್ಪ ಸಮಯದ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്തോ പിഴവ് സംഭവിച്ചു. അൽപ്പസമയത്തിന് ശേഷം വീണ്ടും ശ്രമിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीतरी बिघडले. थोड्या वेळाने पुन्हा प्रयत्न करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କିଛି ଭୁଲ ହେଲା। ଟିକେ ପରେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਗੜਬੜ ਹੋ ਗਈ। ਥੋੜ੍ਹੀ ਦੇਰ ਬਾਅਦ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        }
      }
    },
