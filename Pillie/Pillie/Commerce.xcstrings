    "paywall.subtitle": {
      "comment": "Functionality only [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus keeps pinging until you log today, and can pause apps until you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus continua a mandare ping e può pausare le app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pingt weiter und kann Apps pausieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus continue de ping jusqu'à ce que tu inscrives aujourd'hui, et peut mettre les apps en pause jusqu'au check-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus sigue avisando hasta que registres hoy, y puede pausar apps hasta que hagas el check-in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie Plus continua enviando pings até você registrar hoje e pode pausar apps até o check-in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus blijft pingen tot je vandaag bijhoudt, en kan apps pauzeren tot je incheckt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus fortsätter puffa tills du loggar idag, och kan pausa appar tills du checkar in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus prikker til dig, indtil du logger i dag, og kan sætte apps på pause, indtil du tjekker ind."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus fortsetter å plinge til du har logget i dag, og kan pause apper til du sjekker inn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus pingaa, kunnes kirjaat päivän, ja voi laittaa sovellukset tauolle, kunnes kuittaat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie Plus continua a avisar até registares o dia de hoje e pode pausar apps até registares."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus continua avisant fins que registres el dia d’avui, i pot pausar apps fins que registres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus przypomina, aż zapiszesz dzisiejszą czynność, i może wstrzymać aplikacje, aż potwierdzisz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus připomíná, dokud dnešní akci nezaznamenáš, a umí pozastavit aplikace, dokud nepotvrdíš."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus напоминает, пока ты не отметишь сегодняшний день, и может ставить приложения на паузу до отметки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus нагадує, доки ти не відмітиш сьогоднішній день, і може ставити застосунки на паузу до відмітки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plusは今日の記録が済むまで通知を続け、チェックインまでアプリを一時停止できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus는 오늘 기록을 마칠 때까지 계속 알려 주고, 체크인할 때까지 앱을 일시 중지할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus terus mengingatkan sehingga kamu rekod hari ini, dan boleh menjeda apl sehingga kamu sahkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus continuă să-ți amintească până înregistrezi ziua de azi și poate pune aplicațiile pe pauză până confirmi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus pripomína ďalej, kým dnešok nezaznamenáš, a vie pozastaviť aplikácie, kým to nepotvrdíš."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus จะเตือนซ้ำจนกว่าคุณจะบันทึกของวันนี้ และพักแอปได้จนกว่าคุณจะเช็กอิน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus 会持续提醒，直到你记录今天的操作，还能暂停应用直到你完成打卡。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus तब तक पिंग करता रहता है जब तक तुम आज का लॉग नहीं करते, और चेक-इन तक ऐप्स रोक सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus pinga dok ne zabilježiš današnji dan i može pauzirati aplikacije dok ne potvrdiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie Plus addig jelez, amíg nem rögzíted a mai napot, és szüneteltetni tudja az appokat a bejelölésig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus bugünü kaydedene kadar uyarmaya devam eder ve kaydını yapana kadar uygulamaları duraklatabilir."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்று நீ பதிவு செய்யும் வரை Pillie Plus பிங் செய்யும், செக்-இன் வரை ஆப்ஸையும் இடைநிறுத்தலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus terus mengingatkan sampai kamu mencatat hari ini, dan bisa menjeda aplikasi sampai kamu check-in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يواصل Pillie Plus التنبيه حتى تسجّلي اليوم، ويمكنه إيقاف التطبيقات مؤقتًا حتى تسجّلي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ממשיך להזכיר עד שתרשמי את היום, ויכול להשהות אפליקציות עד שתדווחי."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus nhắc liên tục đến khi bạn ghi lại hôm nay, và có thể tạm dừng ứng dụng đến khi bạn điểm danh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ লগ না করা পর্যন্ত Pillie Plus পিং করতে থাকে, আর চেক-ইন না করা পর্যন্ত অ্যাপ পজ করতে পারে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus تب تک پنگ کرتا رہتا ہے جب تک تم آج لاگ نہ کرو، اور چیک اِن تک ایپس روک سکتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus opominja, dokler ne zabeležiš današnjega dejanja, in lahko ustavi aplikacije, dokler ne potrdiš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pillie Plus συνεχίζει να σε ειδοποιεί μέχρι να καταγράψεις τη σημερινή ενέργεια και μπορεί να βάλει εφαρμογές σε παύση μέχρι να επιβεβαιώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు నువ్వు నమోదు చేసేదాకా Pillie Plus పింగ్ చేస్తూనే ఉంటుంది, చెక్-ఇన్ దాకా యాప్‌లనూ పాజ్ చేయగలదు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus 會持續提醒，直到你記錄今天的動作，還能暫停應用程式直到你完成打卡。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus તું આજ નોંધે ત્યાં સુધી પિંગ કરે, અને ચેક-ઇન સુધી ઍપ્સ થોભાવી શકે છે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈರೋಜು ನೀನು ನೋಂದಣಿ ಚೇಸೇದಾಕಾ Pillie Plus ಪಿಂಗ್ ಚೇಸ್ತೂನೇ ಉಂಟುಂದಿ, ಚೆಕ್-ಇನ್ ದಾಕಾ ಆ್ಯಾಪ್ನೂ ಪಾಜ್ ಚೇಯಗಲದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്ന് രേഖപ്പെടുത്തുന്നതുവരെ Pillie Plus പിംഗ് ചെയ്‌തുകൊണ്ടിരിക്കും, ചെക്ക്-ഇൻ വരെ ആപ്പുകൾ പോസ് ചെയ്യാനും കഴിയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus तब पर्यंत पिंग करता रहता आहे जेव्हा पर्यंत तू आज का नोंद नाही करते, आणि नोंद पर्यंत अॅप्स थांबव सकता आहे."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଜି ଲଗ୍ ନହେବା ଯାଏଁ Pillie Plus ପିଙ୍ଗ୍ କରେ, ଓ ଚେକ୍-ଇନ୍ ଯାଏଁ ଆପ୍ ବିରାମ କରିପାରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ਤਬ ਤੱਕ ਪਿਂਗ ਕਰਤਾ ਰਹਤਾ ਹੈ ਜਦ ਤੱਕ ਤੂੰ ਅੱਜ ਦਾ ਲਾਗ ਨਹੀਂ ਕਰਤੇ, ਤੇ ਚੇਕ-ਇਨ ਤੱਕ ਐਪਾਂ ਰੋਕ ਸਕਦਾ ਹੈ।"
          }
        }
      }
    },
