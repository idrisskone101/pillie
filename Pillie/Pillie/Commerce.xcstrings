        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप ब्लॉकिंग अब बंद है। तुम्हारे स्टैंडर्ड रिमाइंडर उपलब्ध रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje aplikacija sada je isključeno. Tvoji standardni podsjetnici ostaju dostupni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appblokkolás most ki van kapcsolva. Az alap emlékeztetőid továbbra is elérhetők."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama duraklatma artık kapalı. Standart hatırlatmaların kullanılabilir kalır."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப் இடைநிறுத்தம் இப்போது ஆஃப். உன் வழக்கமான நினைவூட்டல்கள் தொடர்ந்து கிடைக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeda aplikasi sekarang mati. Pengingat standarmu tetap tersedia."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف التطبيقات غير مفعّل الآن. تذكيراتك العادية تبقى متاحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השהיית האפליקציות כבויה עכשיו. התזכורות הרגילות שלך נשארות זמינות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chặn ứng dụng giờ đã tắt. Lời nhắc tiêu chuẩn của bạn vẫn dùng được."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ ব্লকিং এখন বন্ধ। তোমার সাধারণ রিমাইন্ডার চালু থাকছে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ بلاکنگ اب بند ہے۔ تمہاری معیاری یاد دہانیاں دستیاب رہیں گی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje aplikacij je zdaj izklopljeno. Tvoji običajni opomniki ostanejo na voljo."
