            "value": "आठवण आली की तुझे अॅप्स थांबतात, रिंग बदलेपर्यंत."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ସମୟରେ ତୁମର ଆପ୍ ବିରାମ ହୁଏ, ରିଙ୍ଗ ବଦଳାଇବା ଯାଏଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਇਂਡਰ ਆਨੇ ਪਰ ਤੇਰੇ ਐਪਾਂ ਰੁਕ ਜਾਂਦੀਆਂ ਹਨ, ਜਦ ਤੱਕ ਤੂੰ ਰਿਂਗ ਨਹੀਂ ਬਦਲਤੇ।"
          }
        }
      }
    },
    "paywall.upsell.app_blocking.body.ring.remove": {
      "comment": "App blocking plus-gate body, remove ring [ENG-67]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your apps pause when the reminder is due, until you remove your ring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apps pausieren, wenn die Erinnerung kommt, bis du den Ring rausnimmst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue app vanno in pausa quando arriva il promemoria, finché non togli l'anello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes apps sont en pause quand le rappel arrive, jusqu'à ce que tu retires ton anneau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus apps se pausan cuando toca el recordatorio, hasta que quites tu anillo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus apps pausam quando o lembrete chega, até você remover seu anel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je apps pauzeren wanneer de herinnering klaarstaat, tot je je ring verwijdert."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina appar pausas när påminnelsen är aktuell, tills du tar ut din ring."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine apps sættes på pause, når påmindelsen er aktuel, indtil du fjerner din ring."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appene dine pauses når påminnelsen forfaller, til du har tatt ut ringen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksesi menevät tauolle, kun muistutus on ajankohtainen, kunnes poistat renkaasi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas apps ficam em pausa quando o lembrete chega, até retirares o anel."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves apps es pausen quan toca el recordatori, fins que et treus l’anell."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje wstrzymują się, gdy nadejdzie przypomnienie, aż wyjmiesz krążek."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přijde připomínka, tvoje aplikace se pozastaví, dokud si nevyjmeš kroužek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения ставятся на паузу, когда приходит напоминание, пока ты не извлечёшь кольцо."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунки стають на паузу, коли надходить нагадування, доки ти не виймеш кільце."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーの時間になるとアプリが一時停止し、リングを外すまで続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 시간이 되면 링을 제거할 때까지 앱이 일시 중지돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl kamu dijeda apabila peringatan tiba, sehingga kamu keluarkan cincin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile tale intră în pauză când e timpul mementoului, până îți scoți inelul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď príde čas pripomienky, tvoje aplikácie sa pozastavia, kým si nevyberieš krúžok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปของคุณจะพักเมื่อถึงเวลาแจ้งเตือน จนกว่าคุณจะถอดวงแหวนออก"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒到点时，你的应用会暂停，直到你取出阴道环。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर आने पर तुम्हारे ऐप्स रुक जाते हैं, जब तक तुम रिंग नहीं निकालते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikacije se pauziraju kad stigne podsjetnik, dok ne izvadiš prsten."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appjaid szünetelnek, amikor esedékes az emlékeztető, amíg ki nem veszed a gyűrűt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatma zamanı geldiğinde uygulamaların duraklar, halkanı çıkarana kadar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நினைவூட்டல் நேரம் வந்ததும் உன் ஆப்ஸ் இடைநிறுத்தப்படும், நீ ரிங் அகற்றும் வரை."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasimu dijeda saat pengingat tiba, sampai kamu melepas cincin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف تطبيقاتك مؤقتًا عند حلول موعد التذكير، حتى تزيلي حلقتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציות שלך מושהות כשמגיע זמן התזכורת, עד שתוציאי את הטבעת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng của bạn tạm dừng khi đến giờ nhắc, cho đến khi bạn tháo vòng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডারের সময় হলে তোমার অ্যাপগুলো পজ হয়, যতক্ষণ না তুমি রিং খোলো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی کا وقت آنے پر تمہاری ایپس رک جاتی ہیں، جب تک تم رِنگ نہ نکال لو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je čas za opomnik, se tvoje aplikacije ustavijo, dokler ne odstraniš obročka."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές σου μπαίνουν σε παύση όταν έρθει η ώρα της υπενθύμισης, μέχρι να αφαιρέσεις τον δακτύλιό σου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిమైండర్ సమయం రాగానే నీ యాప్‌లు పాజ్ అవుతాయి, నువ్వు రింగ్ తీసేసేదాకా."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒到的時候，你的應用程式會暫停，直到你取出陰道環。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇંડર આને પર તારા ઍપ્સ રુક જાતે છે, જ્યારે સુધી તું રિંગ નહીં નિકાલતે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜ್ಞಾಪನೆ ಸಮಯಂ ರಾಗಾನೇ ನಿನ್ನ ಆ್ಯಾಪ್‌ಗಳು ಪಾಜ್ ಅವುತಾಯಿ, ನೀನು ರಿಂಗ್ ತೀಸೇಸೇದಾಕಾ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിന്റെ ആപ്പുകൾ നിൽക്കും, റിംഗ് നീക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आठवण आली की तुझे अॅप्स थांबतात, रिंग काढेपर्यंत."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ସମୟରେ ତୁମର ଆପ୍ ବିରାମ ହୁଏ, ରିଙ୍ଗ କାଢ଼ିବା ଯାଏଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਇਂਡਰ ਆਨੇ ਪਰ ਤੇਰੇ ਐਪਾਂ ਰੁਕ ਜਾਂਦੀਆਂ ਹਨ, ਜਦ ਤੱਕ ਤੂੰ ਰਿਂਗ ਨਹੀਂ ਨਿਕਾਲਤੇ।"
          }
        }
      }
    },
