    "paywall.upsell.smart_reminders.body": {
      "comment": "Smart Reminders plus-gate body [ENG-66]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps pinging until you log today. You pick how often, how many, and the last ping."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pingt weiter, bis du heute einträgst. Du wählst wie oft, wie viele, und den letzten Ping."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a mandare ping finché non registri oggi. Scegli ogni quanto, quanti, e l'ultimo ping."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue de ping jusqu'à ce que tu inscrives aujourd'hui. Tu choisis la fréquence, le nombre et le dernier ping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue avisando hasta que registres hoy. Tú eliges la frecuencia, cuántos y el último aviso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua enviando pings até você registrar hoje. Você escolhe a frequência, a quantidade e o último ping."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijft pingen tot je vandaag bijhoudt. Jij kiest hoe vaak, hoeveel en de laatste ping."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätter puffa tills du loggar idag. Du väljer hur ofta, hur många och den sista puffen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikker til dig, indtil du logger i dag. Du vælger hvor ofte, hvor mange og det sidste prik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsetter å plinge til du har logget i dag. Du velger hvor ofte, hvor mange og siste pling."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pingaa, kunnes kirjaat päivän. Sinä valitset, kuinka usein, kuinka monta ja viimeisen pingauksen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a avisar até registares o dia de hoje. Tu escolhes com que frequência, quantas vezes e o último aviso."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua avisant fins que registres el dia d’avui. Tu tries amb quina freqüència, quants cops i l’últim avís."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomina, aż zapiszesz dzisiejszą czynność. Ty wybierasz, jak często, ile razy i kiedy ostatni sygnał."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připomíná, dokud dnešní akci nezaznamenáš. Ty určíš, jak často, kolikrát a kdy přijde poslední upozornění."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминает, пока ты не отметишь сегодняшний день. Ты выбираешь, как часто, сколько раз и когда последний сигнал."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадує, доки ти не відмітиш сьогоднішній день. Ти вибираєш, як часто, скільки разів і коли останній сигнал."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の記録が済むまで通知を続けます。頻度、回数、最後の通知はあなたが決められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 기록을 마칠 때까지 계속 알려 줘요. 얼마나 자주, 몇 번, 마지막 알림까지 직접 정할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terus mengingatkan sehingga kamu rekod hari ini. Kamu pilih berapa kerap, berapa banyak dan peringatan terakhir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuă să-ți amintească până înregistrezi ziua de azi. Tu alegi cât de des, câte și ultimul semnal."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomína ďalej, kým dnešok nezaznamenáš. Ty si vyberieš, ako často, koľkokrát a kedy príde posledné pripomenutie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตือนซ้ำจนกว่าคุณจะบันทึกของวันนี้ คุณเลือกได้ว่าบ่อยแค่ไหน กี่ครั้ง และเตือนครั้งสุดท้ายเมื่อไร"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持续提醒，直到你记录今天的操作。频率、次数和最后一次提醒都由你决定。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का लॉग होने तक पिंग करता रहता है। तुम चुनो कितनी बार, कितने, और आख़िरी पिंग कब।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinga dok ne zabilježiš današnji dan. Ti biraš koliko često, koliko puta i kad je zadnji ping."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Addig jelez, amíg nem rögzíted a mai napot. Te választod meg, milyen gyakran, hányszor, és mikor jöjjön az utolsó jelzés."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünü kaydedene kadar uyarmaya devam eder. Ne sıklıkla, kaç kez ve son uyarıyı sen seçersin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்று நீ பதிவு செய்யும் வரை பிங் செய்யும். எவ்வளவு அடிக்கடி, எத்தனை முறை, கடைசி பிங் எப்போது என்று நீ முடிவு செய்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terus mengingatkan sampai kamu mencatat hari ini. Kamu tentukan seberapa sering, berapa kali, dan pengingat terakhirnya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يواصل التنبيه حتى تسجّلي اليوم. أنتِ تحددين الفاصل، وعدد التنبيهات، وموعد التنبيه الأخير."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממשיך להזכיר עד שתרשמי את היום. את בוחרת כל כמה זמן, כמה פעמים, ומתי התזכורת האחרונה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc liên tục đến khi bạn ghi lại hôm nay. Bạn chọn tần suất, số lần và lời nhắc cuối."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ লগ না করা পর্যন্ত পিং করতে থাকে। কত ঘন ঘন, কতবার আর শেষ পিং — তুমিই ঠিক করো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج لاگ کرنے تک پنگ کرتا رہتا ہے۔ کتنی بار، کتنے، اور آخری پنگ — تم چُنو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opominja, dokler ne zabeležiš današnjega dejanja. Ti izbereš, kako pogosto, kolikokrat in kdaj je zadnji opomnik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίζει να σε ειδοποιεί μέχρι να καταγράψεις τη σημερινή ενέργεια. Εσύ διαλέγεις πόσο συχνά, πόσες φορές και την τελευταία ειδοποίηση."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు నువ్వు నమోదు చేసేదాకా పింగ్ చేస్తూనే ఉంటుంది. ఎంత తరచుగా, ఎన్నిసార్లు, చివరి పింగ్ ఎప్పుడో నువ్వే ఎంచుకో."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "持續提醒，直到你記錄今天的動作。頻率、次數和最後一次提醒都由你決定。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજ કા લૉગ હોને સુધી પિંગ કરતા રહતા છે। તું ચુનો કિતની બાર, કિતને, અને આખ઼િરી પિંગ કબ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈರೋಜು ನೀನು ನೋಂದಣಿ ಚೇಸೇದಾಕಾ ಪಿಂಗ್ ಚೇಸ್ತೂನೇ ಉಂಟುಂದಿ. ಎಂತ ತರಚುಗಾ, ಎನ್ನಿಸಾರ್ಲು, ಚಿವರಿ ಪಿಂಗ್ ಎಪ್ಪುಡೋ ನುವ್ವೇ ಎಂಚುಕೋ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്ന് രേഖപ്പെടുത്തുന്നതുവരെ Pillie Plus പിംഗ് ചെയ്‌തുകൊണ്ടിരിക്കും. അവസാന പിംഗ് നീ തിരഞ്ഞെടുക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आज नोंद होईपर्यंत पिंग सुरू राहतो. किती वेळा, किती, शेवटचा पिंग तू ठरव."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଜି ଲଗ୍ ନହେବା ଯାଏଁ ପିଙ୍ଗ୍ କରେ। କେତେଥର, କେତେଟି ଓ ଶେଷ ପିଙ୍ଗ୍ ତୁମେ ବାଛ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
