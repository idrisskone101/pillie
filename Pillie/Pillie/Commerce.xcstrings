    "trial.granted.choice.detail": {
      "comment": "Detail explaining the post-trial choice [trial granted]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep reminders free, or choose whether to continue with Plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria restano gratis, oppure decidi se continuare con Plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen bleiben kostenlos. Plus behältst du nur, wenn du möchtest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les rappels gratuits, ou choisis de continuer avec Plus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quédate con los recordatorios gratis o elige si continuar con Plus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue com os lembretes grátis ou escolha se quer seguir com o Plus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen blijven gratis. Plus houd je alleen als je wilt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll påminnelserna gratis, eller välj om du vill fortsätta med Plus."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold påmindelserne gratis, eller vælg, om du vil fortsætte med Plus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold påminnelsene gratis, eller velg om du vil fortsette med Plus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä muistutukset ilmaisina tai valitse, jatkatko Plusilla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém os lembretes grátis ou escolhe se queres continuar com o Plus."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén els recordatoris gratuïts o tria si vols continuar amb el Plus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaw bezpłatne przypomnienia albo zdecyduj, czy zostajesz z Plus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nech si připomínky zdarma, nebo se rozhodni, jestli pokračovat s Plus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставь напоминания бесплатно или реши, продолжать ли с Plus."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лиши нагадування безкоштовно або виріши, чи продовжувати з Plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーは無料のまま使えます。Plusを続けるかはあなたが選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 무료로 유지하고, Plus를 계속할지는 직접 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekalkan peringatan secara percuma, atau pilih sama ada mahu teruskan dengan Plus."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrezi mementourile gratuit sau alegi dacă vrei să continui cu Plus."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechaj si pripomienky zdarma alebo sa rozhodni, či pokračovať s Plus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้การแจ้งเตือนฟรีต่อไป หรือเลือกว่าจะใช้ Plus ต่อหรือไม่"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续免费使用提醒，或自行选择是否继续使用 Plus。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर मुफ़्त रखें, या तय करें कि Plus जारी रखना है या नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadrži besplatne podsjetnike ili odluči želiš li nastaviti s Plusom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Maradj az ingyenes emlékeztetőknél, vagy döntsd el, folytatod-e a Plusszal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatmaları ücretsiz tut ya da Plus ile devam etmeyi seç."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நினைவூட்டல்களை இலவசமாகவே வைத்திருங்கள், அல்லது Plus-உடன் தொடரலாமா என்று தேர்ந்தெடுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap pakai pengingat gratis, atau pilih apakah mau lanjut dengan Plus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظي بالتذكيرات مجانًا، أو اختاري ما إذا كنتِ ستتابعين مع Plus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאירי את התזכורות בחינם, או בחרי אם להמשיך עם Plus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ lời nhắc miễn phí, hoặc chọn tiếp tục với Plus."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডার ফ্রিতে রাখুন, অথবা Plus চালিয়ে যাবেন কি না ঠিক করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانیاں مفت رکھیں، یا طے کریں کہ Plus جاری رکھنا ہے یا نہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obdrži brezplačne opomnike ali se odloči, ali nadaljuješ s Plus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτα τις υπενθυμίσεις δωρεάν ή διάλεξε αν θα συνεχίσεις με το Plus."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిమైండర్లను ఉచితంగానే ఉంచుకోండి, లేదా Plusతో కొనసాగాలో లేదో ఎంచుకోండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續免費使用提醒，或自行選擇是否繼續使用 Plus。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇન્ડર મફત રાખો, અથવા Plus ચાલુ રાખવું કે નહીં તે પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜ್ಞಾಪನೆಗಳನ್ನು ಉಚಿತವಾಗಿಯೇ ಇರಿಸಿಕೊಳ್ಳಿ, ಅಥವಾ Plus ಜೊತೆ ಮುಂದುವರಿಯಬೇಕೇ ಎಂದು ಆರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിമൈൻഡറുകൾ സൗജന്യമായി നിലനിർത്തൂ, അല്ലെങ്കിൽ Plus-ൽ തുടരണോ എന്ന് തിരഞ്ഞെടുക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर मोफत ठेवा, किंवा Plus सुरू ठेवायचे की नाही ते ठरवा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ମାଗଣା ରଖନ୍ତୁ, କିମ୍ବା Plus ସହ ଜାରି ରଖିବେ କି ନାହିଁ ବାଛନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਈਂਡਰ ਮੁਫ਼ਤ ਰੱਖੋ, ਜਾਂ ਚੁਣੋ ਕਿ Plus ਨਾਲ ਜਾਰੀ ਰੱਖਣਾ ਹੈ ਜਾਂ ਨਹੀਂ।"
          }
        }
      }
    },
    "trial.granted.choice.detail.hard_paywall": {
      "comment": "Day 14 paid-access requirement for hard-paywall cohorts [trial granted]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose monthly, annual, or lifetime to keep using Pillie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il piano mensile, annuale o a vita per continuare a usare Pillie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Monats-, Jahres- oder Lifetime-Tarif, um Pillie weiter zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis mensuel, annuel ou à vie pour continuer à utiliser Pillie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige mensual, anual o de por vida para seguir usando Pillie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha mensal, anual ou vitalício para continuar usando o Pillie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies maandelijks, jaarlijks of lifetime om Pillie te blijven gebruiken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj månadsvis, årsvis eller livstid för att fortsätta använda Pillie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg månedligt, årligt eller livstid for at fortsætte med at bruge Pillie."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg månedlig, årlig eller livstid for å fortsette å bruke Pillie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kuukausi-, vuosi- tai kertamaksu, niin voit jatkaa Pillien käyttöä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe mensal, anual ou vitalício para continuares a usar o Pillie."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria mensual, anual o vitalici per continuar fent servir Pillie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz plan miesięczny, roczny albo na zawsze, aby dalej korzystać z Pillie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber měsíční, roční nebo trvalý plán a používej Pillie dál."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери ежемесячный, годовой или пожизненный план, чтобы продолжить пользоваться Pillie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери щомісячний, річний або довічний план, щоб і далі користуватися Pillie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieを続けて使うには、月額、年額、または買い切りを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie를 계속 사용하려면 월간, 연간 또는 평생 이용권을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bulanan, tahunan atau seumur hidup untuk terus menggunakan Pillie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege lunar, anual sau pe viață pentru a continua să folosești Pillie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chceš Pillie používať ďalej, vyber mesačný, ročný alebo doživotný plán."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแบบรายเดือน รายปี หรือตลอดชีพ เพื่อใช้ Pillie ต่อ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择月付、年付或终身版，继续使用 Pillie。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie इस्तेमाल करते रहने के लिए मासिक, सालाना या लाइफ़टाइम चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi mjesečno, godišnje ili doživotno da nastaviš koristiti Pillie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz havi, éves vagy örökös csomagot, hogy tovább használhasd a Pillie-t."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie’yi kullanmaya devam etmek için aylık, yıllık veya ömür boyu seç."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie-ஐத் தொடர்ந்து பயன்படுத்த மாதாந்திர, ஆண்டு அல்லது வாழ்நாள் திட்டத்தைத் தேர்ந்தெடுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bulanan, tahunan, atau seumur hidup untuk terus memakai Pillie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختاري الاشتراك الشهري أو السنوي أو مدى الحياة لمتابعة استخدام Pillie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרי חודשי, שנתי או לתמיד כדי להמשיך להשתמש ב-Pillie."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn gói hàng tháng, hàng năm hoặc trọn đời để tiếp tục dùng Pillie."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ব্যবহার চালিয়ে যেতে মাসিক, বার্ষিক বা লাইফটাইম বেছে নিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie استعمال کرتے رہنے کے لیے ماہانہ، سالانہ یا لائف ٹائم چنیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi mesečno, letno ali trajno možnost, da lahko Pillie uporabljaš še naprej."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε μηνιαία, ετήσια ή εφ' όρου ζωής για να συνεχίσεις να χρησιμοποιείς το Pillie."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie వాడటం కొనసాగించడానికి నెలవారీ, వార్షిక లేదా జీవితకాల ప్లాన్ ఎంచుకోండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇月繳、年繳或終身版，繼續使用 Pillie。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie વાપરવાનું ચાલુ રાખવા માસિક, વાર્ષિક અથવા લાઇફટાઇમ પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ಬಳಸುವುದನ್ನು ಮುಂದುವರಿಸಲು ಮಾಸಿಕ, ವಾರ್ಷಿಕ ಅಥವಾ ಜೀವಮಾನದ ಯೋಜನೆಯನ್ನು ಆರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie തുടർന്നും ഉപയോഗിക്കാൻ പ്രതിമാസ, വാർഷിക അല്ലെങ്കിൽ ആജീവനാന്ത പ്ലാൻ തിരഞ്ഞെടുക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie वापरत राहण्यासाठी मासिक, वार्षिक किंवा लाइफटाइम निवडा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ବ୍ୟବହାର ଜାରି ରଖିବାକୁ ମାସିକ, ବାର୍ଷିକ କିମ୍ବା ଆଜୀବନ ବାଛନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ਵਰਤਦੇ ਰਹਿਣ ਲਈ ਮਹੀਨਾਵਾਰ, ਸਾਲਾਨਾ ਜਾਂ ਲਾਈਫ਼ਟਾਈਮ ਚੁਣੋ।"
          }
        }
      }
    },
