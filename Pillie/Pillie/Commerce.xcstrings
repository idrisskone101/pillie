            "value": "Zamkni si aplikácie, kým si nevezmeš tabletku."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaključaj aplikacije dok ne uzmeš pilulu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakleni aplikacije, dokler ne vzameš tabletke."
