          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਬਲੌਕਿੰਗ Pillie Plus ਦੀ ਸਹੂਲਤ ਹੈ, ਜੋ ਤੁਸੀਂ ਅੱਪਗ੍ਰੇਡ ਕਰਨ ਤੋਂ ਬਾਅਦ ਸੈੱਟ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        }
      }
    },
    "onboarding.blocking_setup.hard_paywall_locked_detail": {
      "comment": "Paid-access requirement shown when a hard-cohort trial expires during onboarding [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose monthly, annual, or lifetime to keep using Pillie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il piano mensile, annuale o a vita per continuare a usare Pillie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Monats-, Jahres- oder Lifetime-Tarif, um Pillie weiter zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis mensuel, annuel ou à vie pour continuer à utiliser Pillie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige mensual, anual o de por vida para seguir usando Pillie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha mensal, anual ou vitalício para continuar usando o Pillie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies maandelijks, jaarlijks of lifetime om Pillie te blijven gebruiken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj månadsvis, årsvis eller livstid för att fortsätta använda Pillie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg månedligt, årligt eller livstid for at fortsætte med at bruge Pillie."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg månedlig, årlig eller livstid for å fortsette å bruke Pillie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kuukausi-, vuosi- tai kertamaksu, niin voit jatkaa Pillien käyttöä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe mensal, anual ou vitalício para continuares a usar o Pillie."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria mensual, anual o vitalici per continuar fent servir Pillie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz plan miesięczny, roczny albo na zawsze, aby dalej korzystać z Pillie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber měsíční, roční nebo trvalý plán a používej Pillie dál."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери ежемесячный, годовой или пожизненный план, чтобы продолжить пользоваться Pillie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери щомісячний, річний або довічний план, щоб і далі користуватися Pillie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieを続けて使うには、月額、年額、または買い切りを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie를 계속 사용하려면 월간, 연간 또는 평생 이용권을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bulanan, tahunan atau seumur hidup untuk terus menggunakan Pillie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege lunar, anual sau pe viață pentru a continua să folosești Pillie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chceš Pillie používať ďalej, vyber mesačný, ročný alebo doživotný plán."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแบบรายเดือน รายปี หรือตลอดชีพ เพื่อใช้ Pillie ต่อ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择月付、年付或终身版，继续使用 Pillie。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie इस्तेमाल करते रहने के लिए मासिक, सालाना या लाइफ़टाइम चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi mjesečno, godišnje ili doživotno da nastaviš koristiti Pillie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz havi, éves vagy örökös csomagot, hogy tovább használhasd a Pillie-t."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie’yi kullanmaya devam etmek için aylık, yıllık veya ömür boyu seç."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie-ஐத் தொடர்ந்து பயன்படுத்த மாதாந்திர, ஆண்டு அல்லது வாழ்நாள் திட்டத்தைத் தேர்ந்தெடுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bulanan, tahunan, atau seumur hidup untuk terus memakai Pillie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختاري الاشتراك الشهري أو السنوي أو مدى الحياة لمتابعة استخدام Pillie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרי חודשי, שנתי או לתמיד כדי להמשיך להשתמש ב-Pillie."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn gói hàng tháng, hàng năm hoặc trọn đời để tiếp tục dùng Pillie."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ব্যবহার চালিয়ে যেতে মাসিক, বার্ষিক বা লাইফটাইম বেছে নিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie استعمال کرتے رہنے کے لیے ماہانہ، سالانہ یا لائف ٹائم چنیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi mesečno, letno ali trajno možnost, da lahko Pillie uporabljaš še naprej."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε μηνιαία, ετήσια ή εφ' όρου ζωής για να συνεχίσεις να χρησιμοποιείς το Pillie."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie వాడటం కొనసాగించడానికి నెలవారీ, వార్షిక లేదా జీవితకాల ప్లాన్ ఎంచుకోండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇月繳、年繳或終身版，繼續使用 Pillie。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie વાપરવાનું ચાલુ રાખવા માસિક, વાર્ષિક અથવા લાઇફટાઇમ પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ಬಳಸುವುದನ್ನು ಮುಂದುವರಿಸಲು ಮಾಸಿಕ, ವಾರ್ಷಿಕ ಅಥವಾ ಜೀವಮಾನದ ಯೋಜನೆಯನ್ನು ಆರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie തുടർന്നും ഉപയോഗിക്കാൻ പ്രതിമാസ, വാർഷിക അല്ലെങ്കിൽ ആജീവനാന്ത പ്ലാൻ തിരഞ്ഞെടുക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie वापरत राहण्यासाठी मासिक, वार्षिक किंवा लाइफटाइम निवडा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ବ୍ୟବହାର ଜାରି ରଖିବାକୁ ମାସିକ, ବାର୍ଷିକ କିମ୍ବା ଆଜୀବନ ବାଛନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ਵਰਤਦੇ ਰਹਿਣ ਲਈ ਮਹੀਨਾਵਾਰ, ਸਾਲਾਨਾ ਜਾਂ ਲਾਈਫ਼ਟਾਈਮ ਚੁਣੋ।"
          }
        }
      }
    },
    "onboarding.blocking_setup.trial_line": {
      "comment": "Line above Allow pausing / Not now on the app-blocking onboarding step, where the 14-day reverse trial starts. %lld is the trial length in active days [trial granted]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus is on for your next %lld active days, free. No card. We’ll remind you before it ends."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus مفعّل مجانًا خلال الأيام الـ%lld النشطة القادمة. بدون بطاقة. سنذكّرك قبل انتهاء الفترة التجريبية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus পরের %lld সক্রিয় দিন ফ্রি। কার্ড লাগবে না। ট্রায়াল শেষ হওয়ার আগে আমরা মনে করিয়ে দেব।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tens Pillie Plus gratis els propers %lld dies actius. Sense targeta. T’avisarem abans que s’acabi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus máš zdarma na dalších %lld aktivních dní. Bez karty. Před koncem ti dáme vědět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus er gratis de næste %lld aktive dage. Intet kort. Vi minder dig om det, før det udløber."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ist die nächsten %lld aktiven Tage gratis. Keine Karte. Wir erinnern dich vor dem Ende."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχεις Pillie Plus δωρεάν για %lld ενεργές ημέρες. Χωρίς κάρτα. Σε ειδοποιούμε πριν λήξει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes Pillie Plus gratis los próximos %lld días activos. Sin tarjeta. Te avisamos antes del final."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus on ilmainen seuraavat %lld aktiivista päivää. Ei korttia. Muistutamme ennen loppua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus est gratuit pour tes %lld prochains jours actifs. Sans carte. On te préviendra avant la fin."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus આગામી %lld સક્રિય દિવસ મફત છે. કાર્ડની જરૂર નથી. ટ્રાયલ પૂરી થાય તે પહેલાં અમે યાદ અપાવીશું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לך Pillie Plus בחינם ל-%lld הימים הפעילים הבאים. בלי כרטיס. נזכיר לך לפני סוף הניסיון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus अगले %lld सक्रिय दिन मुफ़्त है। कार्ड की ज़रूरत नहीं। ट्रायल ख़त्म होने से पहले हम याद दिला देंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus imaš besplatno sljedećih %lld aktivnih dana. Bez kartice. Podsjetit ćemo te prije kraja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie Plus ingyenes a következő %lld aktív napon át. Kártya nélkül. Lejárat előtt emlékeztetünk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus gratis %lld hari aktif ke depan. Tanpa kartu. Kami ingatkan sebelum uji coba berakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai Pillie Plus gratis per i prossimi %lld giorni attivi. Nessuna carta. Ti avviseremo prima che finisca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これから服用%lld日間、Pillie Plusが無料。カード不要。トライアル終了前にお知らせします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ಮುಂದಿನ %lld ಸಕ್ರಿಯ ದಿನಗಳು ಉಚಿತ. ಕಾರ್ಡ್ ಬೇಕಿಲ್ಲ. ಟ್ರಯಲ್ ಮುಗಿಯುವ ಮುನ್ನ ನೆನಪಿಸುತ್ತೇವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 복용 %lld일 동안 Pillie Plus를 무료로 쓸 수 있어요. 카드 불필요. 체험이 끝나기 전에 알려 드릴게요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus അടുത്ത %lld സജീവ ദിനങ്ങൾ സൗജന്യം. കാർഡ് വേണ്ട. ട്രയൽ തീരും മുമ്പ് ഓർമ്മിപ്പിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus पुढचे %lld सक्रिय दिवस मोफत आहे. कार्डची गरज नाही. ट्रायल संपण्याआधी आम्ही आठवण करून देऊ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus percuma %lld hari aktif lagi. Tanpa kad. Kami ingatkan sebelum percubaan tamat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har Pillie Plus gratis de neste %lld aktive dagene. Uten kort. Vi minner deg på det før det slutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus is de komende %lld actieve dagen gratis. Geen kaart. We herinneren je vóór het einde."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପରବର୍ତ୍ତୀ %lld ସକ୍ରିୟ ଦିନ Pillie Plus ମାଗଣା। କାର୍ଡ ଦରକାର ନାହିଁ। ଟ୍ରାୟାଲ୍ ଶେଷ ହେବା ଆଗରୁ ଆପଣଙ୍କୁ ମନେ ପକାଇବୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਗਲੇ %lld ਸਰਗਰਮ ਦਿਨ Pillie Plus ਮੁਫ਼ਤ ਹੈ। ਕਾਰਡ ਦੀ ਲੋੜ ਨਹੀਂ। ਟ੍ਰਾਇਲ ਖ਼ਤਮ ਹੋਣ ਤੋਂ ਪਹਿਲਾਂ ਅਸੀਂ ਯਾਦ ਕਰਾਵਾਂਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz Pillie Plus za darmo przez %lld dni aktywnych. Bez karty. Przypomnimy ci przed końcem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem o Pillie Plus grátis nos próximos %lld dias ativos. Sem cartão. Vamos avisar antes do fim."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie Plus é grátis nos próximos %lld dias ativos. Sem cartão. Avisamos-te antes do fim."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai Pillie Plus gratuit în următoarele %lld zile active. Fără card. Îți vom aminti înainte să se termine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus бесплатно на следующие %lld активных дней. Без карты. Напомним до окончания."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus máš zdarma na ďalších %lld aktívnych dní. Bez karty. Pred koncom ti dáme vedieť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus imaš brezplačno naslednjih %lld aktivnih dni. Brez kartice. Pred koncem te opomnimo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har Pillie Plus gratis i %lld aktiva dagar framåt. Inget kort. Vi påminner dig innan det tar slut."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld செயல் நாட்களுக்கு Pillie Plus இலவசம். கார்டு தேவையில்லை. முடியும் முன் நினைவூட்டுவோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus తదుపరి %lld యాక్టివ్ రోజులు ఉచితం. కార్డ్ అవసరం లేదు. ట్రయల్ ముగిసేలోపు గుర్తు చేస్తాం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus เปิดให้ใช้ฟรีตลอด %lld วันกินยาถัดไป ไม่ต้องใช้บัตร เราจะเตือนคุณก่อนช่วงทดลองใช้สิ้นสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus önümüzdeki %lld aktif gün ücretsiz. Kart gerekmez. Deneme bitmeden hatırlatırız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus безкоштовно на наступні %lld активних днів. Без картки. Нагадаємо перед кінцем."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus اگلے %lld فعال دن مفت ہے۔ کارڈ کی ضرورت نہیں۔ ٹرائل ختم ہونے سے پہلے ہم یاد دلا دیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus miễn phí %lld ngày uống tới. Không cần thẻ. Chúng mình sẽ nhắc trước khi hết dùng thử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来 %lld 个服药日，Pillie Plus 免费开启。无需银行卡。试用结束前我们会提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接下來 %lld 個服藥日，Pillie Plus 免費開啟。不需信用卡。試用結束前我們會提醒你。"
          }
        }
      }
    },
    "onboarding.demo.free_body": {
      "comment": "Free entitlement statement [paywall]",
      "localizations": {
