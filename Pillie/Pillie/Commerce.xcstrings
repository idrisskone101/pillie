    "trial.decline_feedback.optional_note": {
      "comment": "Privacy reassurance on the optional Trial-End decline-feedback surface.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is optional. You can skip and keep using Pillie for free."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è facoltativo. Puoi saltare e continuare a usare Pillie gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist optional. Du kannst überspringen und Pillie weiter kostenlos nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est optionnel. Tu peux passer et continuer à utiliser Pillie gratuitement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es opcional. Puedes saltarlo y seguir usando Pillie gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso é opcional. Você pode pular e continuar usando o Pillie grátis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is optioneel. Je kunt overslaan en Pillie gratis blijven gebruiken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är frivilligt. Du kan hoppa över och fortsätta använda Pillie gratis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er valgfrit. Du kan springe over og fortsætte med at bruge Pillie gratis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er valgfritt. Du kan hoppe over og fortsette å bruke Pillie gratis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on vapaaehtoista. Voit ohittaa ja jatkaa Pillien käyttöä ilmaiseksi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto é opcional. Podes saltar e continuar a usar o Pillie grátis."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això és opcional. Pots saltar-t’ho i continuar fent servir Pillie gratis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To opcjonalne. Możesz pominąć i dalej korzystać z Pillie bezpłatnie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to dobrovolné. Můžeš přeskočit a používat Pillie dál zdarma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это необязательно. Можно пропустить и пользоваться Pillie бесплатно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це необов’язково. Можна пропустити й користуватися Pillie безкоштовно."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。スキップして、Pillieを無料で使い続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 건너뛰고 Pillie를 계속 무료로 사용할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini pilihan. Kamu boleh langkau dan terus guna Pillie secara percuma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "E opțional. Poți sări peste și poți folosi Pillie gratuit în continuare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to dobrovoľné. Môžeš to preskočiť a používať Pillie ďalej zdarma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอบหรือไม่ตอบก็ได้ คุณข้ามและใช้ Pillie ฟรีต่อได้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是可选的。你可以跳过，继续免费使用 Pillie。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वैकल्पिक है। इसे छोड़ा जा सकता है, और Pillie मुफ़्त में चलता रहेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo nije obavezno. Možeš preskočiti i nastaviti besplatno koristiti Pillie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem kötelező. Kihagyhatod, és ingyen használhatod tovább a Pillie-t."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu isteğe bağlı. Atlayıp Pillie’yi ücretsiz kullanmaya devam edebilirsin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது விருப்பத்தேர்வு. தவிர்த்து Pillie-ஐ இலவசமாகத் தொடர்ந்து பயன்படுத்தலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini opsional. Kamu bisa melewatinya dan terus memakai Pillie gratis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا اختياري. يمكنك التخطي ومتابعة استخدام Pillie مجانًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה אופציונלי. אפשר לדלג ולהמשיך להשתמש ב-Pillie בחינם."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bắt buộc. Bạn có thể bỏ qua và tiếp tục dùng Pillie miễn phí."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ঐচ্ছিক। এড়িয়ে গিয়ে ফ্রিতে Pillie ব্যবহার চালিয়ে যেতে পারেন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اختیاری ہے۔ اسے چھوڑا جا سکتا ہے، اور Pillie مفت میں چلتا رہے گا۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ni obvezno. Lahko preskočiš in Pillie še naprej uporabljaš brezplačno."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι προαιρετικό. Μπορείς να το παραλείψεις και να συνεχίσεις να χρησιμοποιείς το Pillie δωρεάν."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ఐచ్ఛికం. దాటవేసి Pillieని ఉచితంగా వాడడం కొనసాగించవచ్చు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是選填的。你可以略過，繼續免費使用 Pillie。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ વૈકલ્પિક છે. તમે છોડીને Pillie મફતમાં વાપરવાનું ચાલુ રાખી શકો છો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಐಚ್ಛಿಕ. ನೀವು ಇದನ್ನು ಬಿಟ್ಟು Pillie ಅನ್ನು ಉಚಿತವಾಗಿ ಬಳಸುತ್ತಿರಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് ഓപ്ഷണലാണ്. നിങ്ങൾക്ക് ഇത് ഒഴിവാക്കി Pillie സൗജന്യമായി ഉപയോഗിക്കുന്നത് തുടരാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे ऐच्छिक आहे. तुम्ही हे वगळून Pillie मोफत वापरत राहू शकता."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା ଇଚ୍ଛାଧୀନ। ଆପଣ ଛାଡ଼ି Pillie ମାଗଣାରେ ବ୍ୟବହାର ଜାରି ରଖିପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਵਿਕਲਪਿਕ ਹੈ। ਤੁਸੀਂ ਛੱਡ ਕੇ Pillie ਮੁਫ਼ਤ ਵਿੱਚ ਵਰਤਦੇ ਰਹਿ ਸਕਦੇ ਹੋ।"
          }
        }
      }
    },
