          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Pillie Plus অ্যাক্সেস যাচাই করা হচ্ছে"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی Pillie Plus رسائی جانچی جا رہی ہے"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverjanje dostopa do Pillie Plus"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλεγχος της πρόσβασής σου στο Pillie Plus"
