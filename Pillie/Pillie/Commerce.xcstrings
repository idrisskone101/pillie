    },
    "trial.granted.choice.title": {
      "comment": "Title for the post-trial choice [trial granted]",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "You choose" } },
        "it": { "stringUnit": { "state": "translated", "value": "Decidi tu" } },
        "de": { "stringUnit": { "state": "translated", "value": "Du entscheidest" } }
      }
    },
    "trial.granted.choice.detail": {
      "comment": "Detail explaining the post-trial choice [trial granted]",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Keep reminders free, or choose whether to continue with Plus." } },
        "it": { "stringUnit": { "state": "translated", "value": "I promemoria restano gratuiti. Decidi tu se mantenere Plus." } },
        "de": { "stringUnit": { "state": "translated", "value": "Erinnerungen bleiben kostenlos. Plus behältst du nur, wenn du möchtest." } }
      }
    },
    "trial.granted.cta": {
      "comment": "Continue button leading to app-blocking setup [trial granted]",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Continue to app blocking" } },
