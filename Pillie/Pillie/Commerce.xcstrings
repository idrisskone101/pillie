          "stringUnit": {
            "state": "translated",
            "value": "আজই চার্জ করা হবে। সেটিংসে যেকোনো সময় বাতিল করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ادائیگی آج ہو گی۔ سیٹنگز میں کبھی بھی منسوخ کریں۔"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आज पेमेंट घेतले जाईल. सेटिंग्जमध्ये कधीही रद्द करा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்றே கட்டணம் வசூலிக்கப்படும். அமைப்புகளில் எப்போது வேண்டுமானாலும் ரத்துசெய்யலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu ditagih hari ini. Batalkan kapan saja di Pengaturan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu dicaj hari ini. Batal bila-bila masa dalam Tetapan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ bị tính phí hôm nay. Hủy bất cứ lúc nào trong Cài đặt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบจะเรียกเก็บเงินวันนี้ ยกเลิกได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日請求されます。設定からいつでも解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 결제돼요. 설정에서 언제든 해지할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天扣费。可随时在设置中取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天扣款。可隨時在設定中取消。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજે ચાર્જ થશે. સેટિંગ્સમાં ગમે ત્યારે રદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಂದೇ ಶುಲ್ಕ ವಿಧಿಸಲಾಗುತ್ತದೆ. ಸೆಟ್ಟಿಂಗ್ಸ್‌ನಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ ರದ್ದುಮಾಡಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്ന് ചാർജ് ചെയ്യും. സെറ്റിംഗ്‌സിൽ എപ്പോൾ വേണമെങ്കിലും റദ്ദാക്കാം."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଜି ଚାର୍ଜ ହେବ। ସେଟିଂସରେ ଯେକୌଣସି ସମୟରେ ବାତିଲ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੱਜ ਚਾਰਜ ਹੋਵੇਗਾ। ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਕਦੇ ਵੀ ਰੱਦ ਕਰੋ।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజే ఛార్జ్ చేయబడుతుంది. సెట్టింగ్స్‌లో ఎప్పుడైనా రద్దు చేయవచ్చు."
          }
        }
      }
    },
