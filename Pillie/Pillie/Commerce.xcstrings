        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ସମୟରେ ତୁମର ଆପ୍ ବିରାମ ହୁଏ, ପ୍ୟାଚ୍ କାଢ଼ିବା ଯାଏଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਇਂਡਰ ਆਨੇ ਪਰ ਤੇਰੇ ਐਪਾਂ ਰੁਕ ਜਾਂਦੀਆਂ ਹਨ, ਜਦ ਤੱਕ ਤੂੰ ਪੈਚ ਨਹੀਂ ਹਟਾਤੇ।"
          }
        }
      }
    },
    "paywall.upsell.app_blocking.body.ring.insert": {
      "comment": "App blocking plus-gate body, insert ring [ENG-67]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your apps pause when the reminder is due, until you insert your ring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apps pausieren, wenn die Erinnerung kommt, bis du den Ring einsetzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue app vanno in pausa quando arriva il promemoria, finché non inserisci l'anello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes apps sont en pause quand le rappel arrive, jusqu'à ce que tu insères ton anneau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus apps se pausan cuando toca el recordatorio, hasta que insertes tu anillo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus apps pausam quando o lembrete chega, até você inserir seu anel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je apps pauzeren wanneer de herinnering klaarstaat, tot je je ring inbrengt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina appar pausas när påminnelsen är aktuell, tills du sätter in din ring."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine apps sættes på pause, når påmindelsen er aktuel, indtil du indsætter din ring."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appene dine pauses når påminnelsen forfaller, til du har satt inn ringen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksesi menevät tauolle, kun muistutus on ajankohtainen, kunnes asetat renkaasi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas apps ficam em pausa quando o lembrete chega, até inserires o anel."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves apps es pausen quan toca el recordatori, fins que insereixes l’anell."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje wstrzymują się, gdy nadejdzie przypomnienie, aż założysz krążek."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přijde připomínka, tvoje aplikace se pozastaví, dokud si nezavedeš kroužek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения ставятся на паузу, когда приходит напоминание, пока ты не введёшь кольцо."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунки стають на паузу, коли надходить нагадування, доки ти не введеш кільце."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーの時間になるとアプリが一時停止し、リングを入れるまで続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 시간이 되면 링을 삽입할 때까지 앱이 일시 중지돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl kamu dijeda apabila peringatan tiba, sehingga kamu masukkan cincin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile tale intră în pauză când e timpul mementoului, până îți introduci inelul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď príde čas pripomienky, tvoje aplikácie sa pozastavia, kým si nezavedieš krúžok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปของคุณจะพักเมื่อถึงเวลาแจ้งเตือน จนกว่าคุณจะใส่วงแหวน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒到点时，你的应用会暂停，直到你放入阴道环。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर आने पर तुम्हारे ऐप्स रुक जाते हैं, जब तक तुम रिंग नहीं लगाते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikacije se pauziraju kad stigne podsjetnik, dok ne umetneš prsten."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appjaid szünetelnek, amikor esedékes az emlékeztető, amíg be nem helyezed a gyűrűt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatma zamanı geldiğinde uygulamaların duraklar, halkanı yerleştirene kadar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நினைவூட்டல் நேரம் வந்ததும் உன் ஆப்ஸ் இடைநிறுத்தப்படும், நீ ரிங் செருகும் வரை."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasimu dijeda saat pengingat tiba, sampai kamu memasang cincin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف تطبيقاتك مؤقتًا عند حلول موعد التذكير، حتى تُدخلي حلقتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציות שלך מושהות כשמגיע זמן התזכורת, עד שתכניסי את הטבעת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng của bạn tạm dừng khi đến giờ nhắc, cho đến khi bạn đặt vòng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডারের সময় হলে তোমার অ্যাপগুলো পজ হয়, যতক্ষণ না তুমি রিং লাগাও।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی کا وقت آنے پر تمہاری ایپس رک جاتی ہیں، جب تک تم رِنگ نہ لگا لو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je čas za opomnik, se tvoje aplikacije ustavijo, dokler ne vstaviš obročka."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές σου μπαίνουν σε παύση όταν έρθει η ώρα της υπενθύμισης, μέχρι να τοποθετήσεις τον δακτύλιό σου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిమైండర్ సమయం రాగానే నీ యాప్‌లు పాజ్ అవుతాయి, నువ్వు రింగ్ పెట్టుకునేదాకా."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒到的時候，你的應用程式會暫停，直到你放入陰道環。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇંડર આને પર તારા ઍપ્સ રુક જાતે છે, જ્યારે સુધી તું રિંગ નહીં લગાતે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜ್ಞಾಪನೆ ಸಮಯಂ ರಾಗಾನೇ ನಿನ್ನ ಆ್ಯಾಪ್‌ಗಳು ಪಾಜ್ ಅವುತಾಯಿ, ನೀನು ರಿಂಗ್ ಪೆಟ್ಟುಕುನೇದಾಕಾ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിന്റെ ആപ്പുകൾ നിൽക്കും, റിംഗ് ഇടൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आठवण आली की तुझे अॅप्स थांबतात, रिंग घालेपर्यंत."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ସମୟରେ ତୁମର ଆପ୍ ବିରାମ ହୁଏ, ରିଙ୍ଗ ଲଗାଇବା ଯାଏଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਇਂਡਰ ਆਨੇ ਪਰ ਤੇਰੇ ਐਪਾਂ ਰੁਕ ਜਾਂਦੀਆਂ ਹਨ, ਜਦ ਤੱਕ ਤੂੰ ਰਿਂਗ ਨਹੀਂ ਲਗਾਤੇ।"
          }
        }
      }
    },
