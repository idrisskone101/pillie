            "value": "App-pauze staat nu uit. Je standaardherinneringen blijven beschikbaar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblockering är nu av. Dina vanliga påminnelser finns kvar."
