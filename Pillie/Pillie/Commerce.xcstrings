    "trial.granted.subtitle": {
      "comment": "No “full” overclaim [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Pillie Plus trial starts now. Here’s what’s included."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prova di Pillie Plus inizia ora. Ecco cosa include."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pillie-Plus-Testphase startet jetzt. Das ist dabei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton essai Pillie Plus commence maintenant. Voici ce qui est inclus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba de Pillie Plus empieza ahora. Esto es lo que incluye."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu período de teste do Pillie Plus começa agora. Veja o que está incluído."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Pillie Plus-proefperiode start nu. Dit zit erin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din provperiod med Pillie Plus börjar nu. Här är vad som ingår."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din prøveperiode med Pillie Plus starter nu. Her er, hvad der er med."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus-prøveperioden din starter nå. Her er det som er inkludert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus -kokeilusi alkaa nyt. Tässä on, mitä siihen sisältyy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu período de teste do Pillie Plus começa agora. Vê o que está incluído."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva prova de Pillie Plus comença ara. Això és el que inclou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój okres próbny Pillie Plus zaczyna się teraz. Oto, co obejmuje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje zkušební období Pillie Plus začíná teď. Tady je, co zahrnuje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой пробный период Pillie Plus начинается сейчас. Вот что в него входит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій пробний період Pillie Plus починається зараз. Ось що в нього входить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plusのトライアルが始まりました。含まれる内容はこちらです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus 체험이 지금 시작돼요. 포함된 내용을 확인해 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percubaan Pillie Plus kamu bermula sekarang. Ini yang termasuk."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Perioada ta de probă Pillie Plus începe acum. Iată ce include."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje skúšobné obdobie Pillie Plus sa začína teraz. Toto je v ňom zahrnuté."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงทดลองใช้ Pillie Plus ของคุณเริ่มแล้ว นี่คือสิ่งที่รวมอยู่"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Pillie Plus 试用现在开始。以下是包含的内容。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Pillie Plus ट्रायल अभी शुरू होता है। इसमें यह सब शामिल है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje probno razdoblje Pillie Plusa počinje sada. Evo što uključuje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie Plus próbaidőszakod most kezdődik. Íme, mit tartalmaz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus deneme süren şimdi başlıyor. İşte dahil olanlar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Pillie Plus சோதனைக் காலம் இப்போது தொடங்குகிறது. இதில் அடங்குபவை இதோ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Uji coba Pillie Plus kamu dimulai sekarang. Ini yang kamu dapatkan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ فترتك التجريبية في Pillie Plus الآن. إليك ما هو مضمّن."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקופת הניסיון של Pillie Plus מתחילה עכשיו. הנה מה שכלול."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dùng thử Pillie Plus của bạn bắt đầu ngay bây giờ. Đây là những gì được bao gồm."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Pillie Plus ট্রায়াল এখন শুরু। এতে যা যা থাকছে।"
