        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランを選べば、今夜のピルの前に元どおりになります。設定は保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플랜을 고르면 오늘 밤 피임약 전에 다시 켜져요. 설정은 저장돼 있어요."
          }
