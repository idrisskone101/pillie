        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "14 सक्रिय दिनों तक आपके पास फ़ॉलो-अप रिमाइंडर थे। उन्हें बनाए रखने के लिए Plus जारी रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijekom 14 aktivnih dana uključeni su ti bili ponovni podsjetnici. Zadrži Plus da ti ostanu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "14 aktív napig ismétlő emlékeztetőid voltak. Tartsd meg a Plust, hogy megmaradjanak."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 aktif gün boyunca takip hatırlatmaların vardı. Onları korumak için Plus ile devam et."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "14 செயல் நாட்கள் உங்களுக்குத் தொடர் நினைவூட்டல்கள் இருந்தன. அவற்றை வைத்துக்கொள்ள Plus-ஐத் தொடருங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama 14 hari aktif kamu punya pengingat lanjutan. Pertahankan Plus untuk tetap memilikinya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمدة 14 يومًا نشطًا كانت لديكِ تذكيرات المتابعة. احتفظي بـ Plus لتبقى لديكِ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במשך 14 ימים פעילים היו לך תזכורות המשך. השאירי את Plus כדי לשמור עליהן."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong 14 ngày uống, bạn đã có lời nhắc lặp lại. Giữ Plus để tiếp tục có chúng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "14 সক্রিয় দিন ধরে আপনি ফলো-আপ রিমাইন্ডার পেয়েছেন। সেগুলো রাখতে Plus রাখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "14 فعال دنوں تک آپ کے پاس فالو اپ یاد دہانیاں تھیں۔ انہیں برقرار رکھنے کے لیے Plus جاری رکھیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V 14 aktivnih dneh so bili vklopljeni ponovni opomniki. Obdrži Plus, da ti ostanejo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για 14 ενεργές ημέρες είχες επαναληπτικές υπενθυμίσεις. Κράτα το Plus για να συνεχίσεις να τις έχεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "14 యాక్టివ్ రోజులు మీకు ఫాలో-అప్ రిమైండర్లు ఉన్నాయి. వాటిని ఉంచుకోవడానికి Plus కొనసాగించండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這 14 個服藥日裡，你用了後續提醒。保留 Plus，就能繼續使用。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "14 સક્રિય દિવસ સુધી તમારી પાસે ફૉલો-અપ રિમાઇન્ડર હતાં. તે રાખવા Plus રાખો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "14 ಸಕ್ರಿಯ ದಿನಗಳ ಕಾಲ ನಿಮಗೆ ಮರು ಜ್ಞಾಪನೆಗಳು ಇದ್ದವು. ಅವುಗಳನ್ನು ಉಳಿಸಿಕೊಳ್ಳಲು Plus ಮುಂದುವರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "14 സജീവ ദിനങ്ങൾ നിങ്ങൾക്ക് ഫോളോ-അപ്പ് റിമൈൻഡറുകൾ ഉണ്ടായിരുന്നു. അവ നിലനിർത്താൻ Plus തുടരൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 सक्रिय दिवस तुमच्याकडे फॉलो-अप रिमाइंडर होते. ते ठेवण्यासाठी Plus सुरू ठेवा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "14 ସକ୍ରିୟ ଦିନ ଆପଣଙ୍କ ପାଖରେ ଫଲୋ-ଅପ୍ ରିମାଇଣ୍ଡର୍ ଥିଲା। ସେଗୁଡ଼ିକ ରଖିବାକୁ Plus ରଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "14 ਸਰਗਰਮ ਦਿਨ ਤੁਹਾਡੇ ਕੋਲ ਫ਼ਾਲੋ-ਅੱਪ ਰਿਮਾਈਂਡਰ ਸਨ। ਉਹਨਾਂ ਨੂੰ ਰੱਖਣ ਲਈ Plus ਰੱਖੋ।"
          }
        }
      }
    },
