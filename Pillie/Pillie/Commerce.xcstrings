        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan vælge månedligt, årligt eller livstid for at fortsætte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan velge månedlig, årlig eller livstid for å fortsette."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit jatkaa valitsemalla kuukausi-, vuosi- tai kertamaksun."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes escolher mensal, anual ou vitalício para continuar."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots triar mensual, anual o vitalici per continuar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby kontynuować, wybierz plan miesięczny, roczny albo na zawsze."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro pokračování můžeš vybrat měsíční, roční nebo trvalý plán."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы продолжить, можно выбрать ежемесячный, годовой или пожизненный план."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб продовжити, можна вибрати щомісячний, річний або довічний план."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けるには月額、年額、または買い切りを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 월간, 연간 또는 평생 이용권을 선택할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu boleh pilih bulanan, tahunan atau seumur hidup untuk teruskan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți alege lunar, anual sau pe viață pentru a continua."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chceš pokračovať, môžeš si vybrať mesačný, ročný alebo doživotný plán."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเลือกแบบรายเดือน รายปี หรือตลอดชีพ เพื่อใช้ต่อได้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以选择月付、年付或终身版来继续。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए मासिक, सालाना या लाइफ़टाइम चुना जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za nastavak možeš odabrati mjesečno, godišnje ili doživotno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A folytatáshoz havi, éves vagy örökös csomagot választhatsz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmek için aylık, yıllık veya ömür boyu seçebilirsin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர மாதாந்திர, ஆண்டு அல்லது வாழ்நாள் திட்டத்தைத் தேர்ந்தெடுக்கலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa pilih bulanan, tahunan, atau seumur hidup untuk lanjut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك اختيار الاشتراك الشهري أو السنوي أو مدى الحياة للمتابعة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לבחור חודשי, שנתי או לתמיד כדי להמשיך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể chọn gói hàng tháng, hàng năm hoặc trọn đời để tiếp tục."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালিয়ে যেতে মাসিক, বার্ষিক বা লাইফটাইম বেছে নিতে পারেন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاری رکھنے کے لیے ماہانہ، سالانہ یا لائف ٹائم چنا جا سکتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za nadaljevanje lahko izbereš mesečno, letno ali trajno možnost."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να διαλέξεις μηνιαία, ετήσια ή εφ' όρου ζωής για να συνεχίσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొనసాగడానికి నెలవారీ, వార్షిక లేదా జీవితకాల ప్లాన్ ఎంచుకోవచ్చు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以選擇月繳、年繳或終身版來繼續。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચાલુ રાખવા તમે માસિક, વાર્ષિક અથવા લાઇફટાઇમ પસંદ કરી શકો છો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂದುವರಿಯಲು ನೀವು ಮಾಸಿಕ, ವಾರ್ಷಿಕ ಅಥವಾ ಜೀವಮಾನದ ಯೋಜನೆಯನ್ನು ಆರಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തുടരാൻ നിങ്ങൾക്ക് പ്രതിമാസ, വാർഷിക അല്ലെങ്കിൽ ആജീവനാന്ത പ്ലാൻ തിരഞ്ഞെടുക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुढे सुरू ठेवण्यासाठी मासिक, वार्षिक किंवा लाइफटाइम निवडता येईल."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଜାରି ରଖିବାକୁ ଆପଣ ମାସିକ, ବାର୍ଷିକ କିମ୍ବା ଆଜୀବନ ବାଛିପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਾਰੀ ਰੱਖਣ ਲਈ ਤੁਸੀਂ ਮਹੀਨਾਵਾਰ, ਸਾਲਾਨਾ ਜਾਂ ਲਾਈਫ਼ਟਾਈਮ ਚੁਣ ਸਕਦੇ ਹੋ।"
          }
        }
      }
    },
