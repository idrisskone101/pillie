          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisto è andato a buon fine, ma Pillie Plus non si è attivato. Riprova o ripristina gli acquisti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
