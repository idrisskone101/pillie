        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ Apple એકાઉન્ટ માટે અમને કોઈ સક્રિય સબ્સ્ક્રિપ્શન મળ્યું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ Apple ಖಾತೆಗೆ ಯಾವುದೇ ಸಕ್ರಿಯ ಚಂದಾದಾರಿಕೆ ನಮಗೆ ಸಿಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ Apple അക്കൗണ്ടിൽ സജീവമായ സബ്‌സ്‌ക്രിപ്‌ഷൻ ഒന്നും ഞങ്ങൾ കണ്ടെത്തിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या Apple खात्यासाठी कोणतेही चालू सबस्क्रिप्शन सापडले नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି Apple ଆକାଉଣ୍ଟ ପାଇଁ ଆମେ କୌଣସି ସକ୍ରିୟ ସବସ୍କ୍ରିପସନ୍ ପାଇଲୁ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ Apple ਖਾਤੇ ਲਈ ਸਾਨੂੰ ਕੋਈ ਸਰਗਰਮ ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਨਹੀਂ ਮਿਲੀ।"
          }
        }
