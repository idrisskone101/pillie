    "paywall.board.trial_ended.subtitle.pill": {
      "comment": "'they' = the reminders and app blocking. Pill users.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a plan and they’re back before tonight’s pill. Your setup is saved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl einen Tarif, dann sind sie vor deiner Pille heute Abend wieder da. Deine Einrichtung bleibt gespeichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un piano e tornano prima della pillola di stasera. La tua configurazione resta salvata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une formule et ils reviennent avant ta pilule de ce soir. Ta configuration reste enregistrée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un plan y vuelven antes de tu píldora de esta noche. Tu configuración está guardada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um plano e eles voltam antes da pílula de hoje à noite. Sua configuração está salva."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um plano e voltam antes da pílula de hoje à noite. A tua configuração fica guardada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een plan en ze zijn terug vóór je pil van vanavond. Je instellingen blijven bewaard."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria un pla i tornen abans de la píndola d’aquesta nit. La teva configuració queda desada."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en plan, så er de tilbage før aftenens p-pille. Din opsætning er gemt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en plan så är de tillbaka före kvällens p-piller. Dina inställningar finns kvar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en plan, så er de tilbake før kveldens pille. Oppsettet ditt er lagret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse paketti, niin ne palaavat ennen illan pilleriä. Asetuksesi ovat tallessa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz plan, a wrócą przed dzisiejszą wieczorną tabletką. Twoje ustawienia są zapisane."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber si plán a vrátí se ještě před dnešní večerní pilulkou. Tvoje nastavení zůstává uložené."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber si plán a vrátia sa ešte pred dnešnou večernou tabletkou. Tvoje nastavenia zostávajú uložené."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi plan i vratit će se prije večerašnje pilule. Tvoje postavke ostaju spremljene."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi paket in vrnejo se še pred nocojšnjo tabletko. Tvoje nastavitve ostanejo shranjene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz csomagot, és a ma esti tabletta előtt visszakapod őket. A beállításaid mentve vannak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un plan și revin înainte de pilula de diseară. Configurarea ta rămâne salvată."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε πρόγραμμα και επιστρέφουν πριν από το αποψινό χάπι. Οι ρυθμίσεις σου μένουν αποθηκευμένες."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir plan seç, bu akşamki hapından önce geri gelirler. Kurulumun kayıtlı."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери план, и они вернутся до вечерней таблетки. Твои настройки сохранены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обери план, і вони повернуться до вечірньої таблетки. Твої налаштування збережені."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختاري خطة وستعود قبل حبة الليلة. إعداداتك محفوظة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרי תוכנית והן יחזרו לפני הגלולה של הערב. ההגדרות שלך שמורות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लान चुनें और आज रात की गोली से पहले ये वापस आ जाएँगे। आपका सेटअप सेव है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি প্ল্যান বেছে নিন, আজ রাতের পিলের আগেই এগুলো ফিরে আসবে। আপনার সেটআপ সেভ আছে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پلان چنیں اور یہ آج رات کی گولی سے پہلے واپس آ جائیں گی۔ آپ کا سیٹ اپ محفوظ ہے۔"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लॅन निवडा, आणि आज रात्रीच्या गोळीआधी ते परत येतील. तुमचा सेटअप सेव्ह आहे."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு திட்டத்தைத் தேர்ந்தெடுங்கள், இன்றிரவு மாத்திரைக்கு முன்பே அவை திரும்பி வரும். உங்கள் அமைப்புகள் சேமிக்கப்பட்டுள்ளன."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih paket dan semuanya kembali sebelum pil malam ini. Pengaturanmu tetap tersimpan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih pelan dan semuanya kembali sebelum pil malam ini. Tetapan kamu kekal disimpan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một gói và chúng sẽ trở lại trước viên thuốc tối nay. Thiết lập của bạn vẫn được lưu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแพ็กเกจแล้วทุกอย่างจะกลับมาก่อนกินยาคืนนี้ การตั้งค่าของคุณยังถูกบันทึกอยู่"
          }
