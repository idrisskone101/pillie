    "paywall.story.settings_free.subtitle": {
      "comment": "",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus adds follow-up reminders and app blocking."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus bringt Folgeerinnerungen und die App-Sperre dazu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus aggiunge i promemoria ripetuti e il blocco app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف Pillie Plus تذكيرات المتابعة وحظر التطبيقات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus-এ যোগ হয় ফলো-আপ রিমাইন্ডার আর অ্যাপ ব্লকিং।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus afegeix recordatoris de seguiment i bloqueig d’apps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus přidává následné připomínky a blokování aplikací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus giver dig opfølgende påmindelser og appblokering."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pillie Plus προσθέτει επαναληπτικές υπενθυμίσεις και αποκλεισμό εφαρμογών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus añade recordatorios de seguimiento y bloqueo de apps."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus tuo mukaan jatkomuistutukset ja sovelluseston."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ajoute les rappels de relance et le blocage d’apps."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ફૉલો-અપ રિમાઇન્ડર અને ઍપ બ્લૉકિંગ ઉમેરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus מוסיף תזכורות המשך וחסימת אפליקציות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus में फ़ॉलो-अप रिमाइंडर और ऐप ब्लॉकिंग जुड़ते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus dodaje ponovne podsjetnike i blokiranje aplikacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie Plus ismétlő emlékeztetőket és appblokkolást ad hozzá."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus menambahkan pengingat lanjutan dan blokir aplikasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plusでは、フォローアップリマインダーとアプリブロックが使えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ಮರು ಜ್ಞಾಪನೆಗಳನ್ನು ಮತ್ತು ಆ್ಯಪ್ ನಿರ್ಬಂಧವನ್ನು ಸೇರಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus에서는 후속 알림과 앱 차단을 쓸 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ഫോളോ-അപ്പ് റിമൈൻഡറുകളും ആപ്പ് ബ്ലോക്കിംഗും ചേർക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus मध्ये फॉलो-अप रिमाइंडर आणि ॲप ब्लॉकिंग मिळते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus menambah peringatan susulan dan sekatan apl."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus gir deg oppfølgingspåminnelser og appblokkering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus voegt vervolgherinneringen en appblokkering toe."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ଫଲୋ-ଅପ୍ ରିମାଇଣ୍ଡର୍ ଓ ଆପ୍ ବ୍ଲକିଂ ଯୋଡ଼େ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ਫ਼ਾਲੋ-ਅੱਪ ਰਿਮਾਈਂਡਰ ਅਤੇ ਐਪ ਬਲੌਕਿੰਗ ਜੋੜਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus dodaje ponowne przypomnienia i blokowanie aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie Plus adiciona lembretes de acompanhamento e bloqueio de apps."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie Plus acrescenta os lembretes de seguimento e o bloqueio de apps."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus adaugă mementouri repetate și blocarea aplicațiilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus добавляет повторные напоминания и блокировку приложений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus pridáva následné pripomienky a blokovanie aplikácií."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus doda ponovne opomnike in blokiranje aplikacij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ger dig uppföljande påminnelser och appblockering."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus தொடர் நினைவூட்டல்களையும் ஆப் தடுப்பையும் சேர்க்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ఫాలో-అప్ రిమైండర్లను, యాప్ బ్లాకింగ్‌ను జోడిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus เพิ่มการแจ้งเตือนซ้ำและการบล็อกแอป"
          }
        },
        "tr": {
          "stringUnit": {
