        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దయచేసి వ్యక్తిగత ఆరోగ్య వివరాలు చేర్చవద్దు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
