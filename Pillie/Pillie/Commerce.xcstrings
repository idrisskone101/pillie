    "paywall.story.trial_ended.returning.legacy.subtitle": {
      "comment": "Returning expired-trial paywall",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trial ended. Daily reminders stay free."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Testphase ist vorbei. Tägliche Erinnerungen bleiben kostenlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova è finita. I promemoria giornalieri restano gratis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت فترتك التجريبية. تبقى التذكيرات اليومية مجانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ট্রায়াল শেষ হয়েছে। দৈনিক রিমাইন্ডার ফ্রি-ই থাকবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova s’ha acabat. Els recordatoris diaris es queden de franc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební období skončilo. Denní připomínky zůstanou zdarma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din prøveperiode er slut. Daglige påmindelser forbliver gratis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δοκιμή τελείωσε. Οι καθημερινές υπενθυμίσεις μένουν δωρεάν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba ha terminado. Los recordatorios diarios siguen siendo gratis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilu loppui. Päivittäiset muistutukset pysyvät ilmaisia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton essai est terminé. Les rappels quotidiens restent gratuits."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ટ્રાયલ પૂરી થઈ. રોજનાં રિમાઇન્ડર મફત જ રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקופת הניסיון הסתיימה. התזכורות היומיות נשארות בחינם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका ट्रायल ख़त्म हो गया। रोज़ के रिमाइंडर मुफ़्त रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Probno razdoblje je gotovo. Dnevni podsjetnici ostaju besplatni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A próbaidőszakod véget ért. A napi emlékeztetők ingyenesek maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa uji cobamu berakhir. Pengingat harian tetap gratis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルは終了しました。毎日のリマインダーは引き続き無料です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಟ್ರಯಲ್ ಮುಗಿದಿದೆ. ದೈನಂದಿನ ಜ್ಞಾಪನೆಗಳು ಉಚಿತವಾಗಿಯೇ ಇರುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험이 끝났어요. 매일 알림은 계속 무료예요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ട്രയൽ അവസാനിച്ചു. ദൈനംദിന റിമൈൻഡറുകൾ സൗജന്യമായി തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा ट्रायल संपला. रोजचे रिमाइंडर मोफत राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percubaan kamu sudah tamat. Peringatan harian kekal percuma."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøveperioden din er over. Daglige påminnelser forblir gratis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je proefperiode is voorbij. Dagelijkse herinneringen blijven gratis."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଟ୍ରାୟାଲ୍ ଶେଷ ହେଲା। ଦୈନିକ ରିମାଇଣ୍ଡର୍ ମାଗଣା ରହିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਟ੍ਰਾਇਲ ਖ਼ਤਮ ਹੋ ਗਿਆ। ਰੋਜ਼ਾਨਾ ਰਿਮਾਈਂਡਰ ਮੁਫ਼ਤ ਹੀ ਰਹਿਣਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okres próbny się skończył. Codzienne przypomnienia zostają za darmo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste acabou. Os lembretes diários continuam grátis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu período de teste terminou. Os lembretes diários continuam grátis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Perioada de probă s-a încheiat. Mementourile zilnice rămân gratuite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробный период закончился. Ежедневные напоминания остаются бесплатными."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúšobné obdobie sa skončilo. Denné pripomienky ostanú zdarma."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preizkus je končan. Dnevni opomniki ostanejo brezplačni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din provperiod är slut. Dagliga påminnelser är fortfarande gratis."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சோதனைக் காலம் முடிந்தது. தினசரி நினைவூட்டல்கள் இலவசமாகவே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ట్రయల్ ముగిసింది. రోజువారీ రిమైండర్లు ఉచితంగానే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงทดลองใช้จบแล้ว การแจ้งเตือนประจำวันยังฟรี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme süren bitti. Günlük hatırlatmalar ücretsiz kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробний період скінчився. Щоденні нагадування лишаються безкоштовними."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ٹرائل ختم ہو گیا۔ روزانہ کی یاد دہانیاں مفت رہتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dùng thử đã kết thúc. Lời nhắc hàng ngày vẫn miễn phí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的试用已结束。每日提醒继续免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的試用已結束。每日提醒繼續免費。"
          }
        }
      }
    },
