{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.blocking_setup.subscriber_disclosure": {
      "comment": "Paid subscriber status on the app-blocking onboarding surface [subscription]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus is active on this account. Set up app blocking whenever you’re ready."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus è attivo su questo account. Configura il blocco delle app quando vuoi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ist für dieses Konto aktiv. Richte die App-Pause ein, wenn du bereit bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus est actif sur ce compte. Configure la pause d'apps quand tu es prêt·e."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus está activo en esta cuenta. Configura el bloqueo de apps cuando estés listo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie Plus está ativo nesta conta. Configure o bloqueio de apps quando quiser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus is actief op dit account. Stel app-pauze in wanneer je er klaar voor bent."
          }
        }
      }
    },
    "commerce.access_verification.title": {
      "comment": "Access verification gate title [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking your Pillie Plus access"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica dell’accesso a Pillie Plus"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie-Plus-Zugang wird geprüft"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification de ton accès Pillie Plus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando tu acceso a Pillie Plus"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando seu acesso ao Pillie Plus"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Pillie Plus-toegang wordt gecontroleerd"
          }
        }
      }
    },
    "commerce.access_verification.body": {
      "comment": "Access verification gate guidance [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the internet so Pillie can verify your purchases before opening the app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti a internet così Pillie può verificare i tuoi acquisti prima di aprire l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit dem Internet, damit Pillie deine Käufe prüfen kann, bevor die App geöffnet wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à Internet pour que Pillie vérifie tes achats avant d'ouvrir l'app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a internet para que Pillie verifique tus compras antes de abrir la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se à internet para o Pillie verificar suas compras antes de abrir o app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak verbinding met internet zodat Pillie je aankopen kan verifiëren voordat de app opent."
          }
        }
      }
    },
    "commerce.access_verification.error": {
      "comment": "Access verification retry guidance [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t verify your access. Check your connection, try again, or restore purchases."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare l’accesso. Controlla la connessione, riprova o ripristina gli acquisti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Zugang konnte nicht geprüft werden. Prüfe die Verbindung, versuche es erneut oder stelle Käufe wieder her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier ton accès. Vérifie ta connexion, réessaie ou restaure tes achats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos verificar tu acceso. Revisa tu conexión, inténtalo de nuevo o restaura compras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar seu acesso. Verifique a conexão, tente de novo ou restaure compras."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden je toegang niet verifiëren. Controleer je verbinding, probeer opnieuw of herstel aankopen."
          }
        }
      }
    },
    "onboarding.blocking_setup.plus_locked": {
      "comment": "Entitlement statement [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App blocking is a Pillie Plus feature you can set up after upgrading."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco è Plus. Setup dopo l’upgrade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Pause ist Plus. Setup nach dem Upgrade."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pause d'apps est une fonctionnalité Pillie Plus que tu peux configurer après la mise à niveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo de apps es una función de Pillie Plus que puedes configurar después de actualizar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueio de apps é um recurso do Pillie Plus que você pode configurar após assinar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "App-pauze is een Pillie Plus-functie die je na upgraden kunt instellen."
          }
        }
      }
    },
    "onboarding.blocking_setup.hard_paywall_locked_detail": {
      "comment": "Paid-access requirement shown when a hard-cohort trial expires during onboarding [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose monthly, annual, or lifetime to keep using Pillie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il piano mensile, annuale o a vita per continuare a usare Pillie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Monats-, Jahres- oder Lifetime-Tarif, um Pillie weiter zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis Mensuel, Annuel ou à vie pour continuer à utiliser Pillie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Mensual, Anual o de por vida para seguir usando Pillie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Mensal, Anual ou Vitalício para continuar usando o Pillie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies maandelijks, jaarlijks of lifetime om Pillie te blijven gebruiken."
          }
        }
      }
    },
    "onboarding.demo.free_body": {
      "comment": "Free entitlement statement [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily reminders, logging and history are included in the free plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria quotidiani, registrazione e cronologia sono inclusi nel piano gratuito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tägliche Erinnerungen, Protokollierung und Verlauf sind im kostenlosen Tarif enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels quotidiens, l'inscription et l'historique sont inclus dans l'offre gratuite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios diarios, el registro y el historial están incluidos en el plan gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes diários, registro e histórico estão incluídos no plano grátis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagelijkse herinneringen, bijhouden en geschiedenis zitten in het gratis abonnement."
          }
        }
      }
    },
    "paywall.title": {
      "comment": "No adherence guarantee [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one ping with Pillie Plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più di un ping con Pillie Plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr als ein Ping mit Pillie Plus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus qu'un ping avec Pillie Plus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más de un aviso con Pillie Plus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais de um ping com o Pillie Plus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meer dan één ping met Pillie Plus."
          }
        }
      }
    },
    "paywall.subtitle": {
      "comment": "Functionality only [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus keeps pinging until you log today, and can pause apps until you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus continua a mandare ping e può pausare le app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pingt weiter und kann Apps pausieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus continue de ping jusqu'à ce que tu inscrives aujourd'hui, et peut mettre les apps en pause jusqu'au check-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus sigue avisando hasta que registres hoy, y puede pausar apps hasta que hagas el check-in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie Plus continua enviando pings até você registrar hoje e pode pausar apps até o check-in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus blijft pingen tot je vandaag bijhoudt, en kan apps pauzeren tot je incheckt."
          }
        }
      }
    },
