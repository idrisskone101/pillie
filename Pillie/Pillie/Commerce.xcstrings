        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje besplatno probno razdoblje traje 14 aktivnih dana. Kartica nije potrebna. Nakon toga odaberi mjesečno, godišnje ili doživotno da zadržiš Plus."
