    "trial.decline_feedback.detail.privacy": {
      "comment": "Adjacent warning that the optional detail field must not contain personal health details.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please don’t include personal health details."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non includere dettagli personali sulla salute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte gib keine persönlichen Gesundheitsdetails an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de ne pas inclure de détails de santé personnels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No incluyas detalles personales de salud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não inclua detalhes pessoais de saúde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg geen persoonlijke gezondheidsdetails toe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta inte med personliga hälsouppgifter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undlad at skrive personlige helbredsoplysninger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke ta med personlige helseopplysninger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä sisällytä henkilökohtaisia terveystietoja."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, não incluas detalhes pessoais de saúde."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si us plau, no incloguis dades personals de salut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie podawaj prywatnych informacji o zdrowiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuváděj prosím osobní zdravotní údaje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, не указывай личные медицинские данные."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, не вказуй особисті медичні дані."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人的な健康情報は入力しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 건강 정보는 포함하지 말아 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila jangan sertakan butiran kesihatan peribadi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Te rugăm să nu incluzi detalii personale despre sănătate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuvádzaj prosím osobné zdravotné údaje."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
