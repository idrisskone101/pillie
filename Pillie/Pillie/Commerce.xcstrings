    "trial.end.title": {
      "comment": "No fragment styling [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Pillie Plus trial has ended"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova di Pillie Plus è terminata"
          }
        }
      }
    },
    "trial.end.subtitle": {
      "comment": "Entitlement statement [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App blocking is now off. Your standard reminders remain available."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco delle app ora è disattivato. I promemoria standard restano disponibili."
          }
        }
      }
    },
