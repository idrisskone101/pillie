        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellustauko on nyt pois. Tavalliset muistutuksesi ovat edelleen käytettävissä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A pausa de apps está agora desligada. Os teus lembretes normais continuam disponíveis."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La pausa d’apps ara està desactivada. Els teus recordatoris normals continuen disponibles."
