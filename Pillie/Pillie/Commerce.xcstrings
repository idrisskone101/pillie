    "paywall.purchase_error.missing_entitlement": {
      "comment": "Purchase completed without activating Plus [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase went through, but Pillie Plus didn’t turn on. Try again, or restore purchases."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisto è andato a buon fine, ma Pillie Plus non si è attivato. Riprova o ripristina gli acquisti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf hat geklappt, aber Pillie Plus wurde nicht eingeschaltet. Versuch es noch mal oder stell deine Käufe wieder her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton achat est passé, mais Pillie Plus ne s’est pas activé. Réessaie, ou restaure tes achats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra se realizó, pero Pillie Plus no se activó. Inténtalo de nuevo o restaura tus compras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra foi concluída, mas o Pillie Plus não ativou. Tente de novo ou restaure suas compras."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop is gelukt, maar Pillie Plus is niet ingeschakeld. Probeer het opnieuw of herstel je aankopen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpet gick igenom, men Pillie Plus slogs inte på. Försök igen eller återställ köp."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb gik igennem, men Pillie Plus blev ikke slået til. Prøv igen, eller gendan køb."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet gikk gjennom, men Pillie Plus ble ikke slått på. Prøv igjen, eller gjenopprett kjøp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostos onnistui, mutta Pillie Plus ei mennyt päälle. Yritä uudelleen tai palauta ostot."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua compra foi concluída, mas o Pillie Plus não ficou ativo. Tenta de novo ou restaura as compras."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra s’ha fet, però Pillie Plus no s’ha activat. Torna-ho a provar o restaura les compres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup się udał, ale Pillie Plus się nie włączyło. Spróbuj ponownie lub przywróć zakupy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup proběhl, ale Pillie Plus se nezapnulo. Zkus to znovu nebo obnov nákupy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка прошла, но Pillie Plus не включился. Попробуй ещё раз или восстанови покупки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка пройшла, але Pillie Plus не ввімкнувся. Спробуй ще раз або віднови покупки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は完了しましたが、Pillie Plusが有効になりませんでした。もう一度試すか、購入を復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매는 완료됐지만 Pillie Plus가 활성화되지 않았어요. 다시 시도하거나 구매를 복원하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian kamu berjaya, tetapi Pillie Plus tidak dihidupkan. Cuba lagi, atau pulihkan pembelian."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția s-a efectuat, dar Pillie Plus nu s-a activat. Încearcă din nou sau restabilește achizițiile."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup prebehol, ale Pillie Plus sa nezaplo. Skús to znova alebo obnov nákupy."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อของคุณสำเร็จแล้ว แต่ Pillie Plus ยังไม่เปิด ลองอีกครั้ง หรือกู้คืนการซื้อ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买已完成，但 Pillie Plus 没有开启。再试一次，或恢复购买。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी ख़रीदारी हो गई, लेकिन Pillie Plus चालू नहीं हुआ। फिर कोशिश करें, या ख़रीदारी रीस्टोर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupnja je prošla, ali Pillie Plus se nije uključio. Pokušaj ponovno ili obnovi kupnje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlás sikerült, de a Pillie Plus nem kapcsolt be. Próbáld újra, vagy állítsd vissza a vásárlásokat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alman tamamlandı ama Pillie Plus açılmadı. Tekrar dene ya da satın alımları geri yükle."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கொள்முதல் முடிந்தது, ஆனால் Pillie Plus இயங்கவில்லை. மீண்டும் முயலுங்கள், அல்லது கொள்முதல்களை மீட்டெடுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelianmu berhasil, tapi Pillie Plus belum aktif. Coba lagi, atau pulihkan pembelian."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمّت عملية الشراء، لكن Pillie Plus لم يُفعَّل. أعيدي المحاولة، أو استعيدي المشتريات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרכישה עברה, אבל Pillie Plus לא הופעל. נסי שוב או שחזרי רכישות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch của bạn đã xong nhưng Pillie Plus chưa bật. Thử lại hoặc khôi phục giao dịch."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কেনা সম্পন্ন হয়েছে, কিন্তু Pillie Plus চালু হয়নি। আবার চেষ্টা করুন, অথবা কেনাকাটা ফিরিয়ে আনুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی خریداری ہو گئی، لیکن Pillie Plus آن نہیں ہوا۔ دوبارہ کوشش کریں، یا خریداریاں بحال کریں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakup je uspel, a Pillie Plus se ni vklopil. Poskusi znova ali obnovi nakupe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αγορά σου ολοκληρώθηκε, αλλά το Pillie Plus δεν ενεργοποιήθηκε. Δοκίμασε ξανά ή κάνε επαναφορά αγορών."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కొనుగోలు పూర్తయింది, కానీ Pillie Plus ఆన్ కాలేదు. మళ్లీ ప్రయత్నించండి, లేదా కొనుగోళ్లను పునరుద్ధరించండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買已完成，但 Pillie Plus 沒有開啟。再試一次，或回復購買。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ખરીદી થઈ ગઈ, પણ Pillie Plus ચાલુ થયું નથી. ફરી પ્રયાસ કરો, અથવા ખરીદી પુનઃસ્થાપિત કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಖರೀದಿ ಪೂರ್ಣಗೊಂಡಿದೆ, ಆದರೆ Pillie Plus ಆನ್ ಆಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ, ಅಥವಾ ಖರೀದಿಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വാങ്ങൽ പൂർത്തിയായി, പക്ഷേ Pillie Plus ഓണായില്ല. വീണ്ടും ശ്രമിക്കൂ, അല്ലെങ്കിൽ വാങ്ങലുകൾ പുനഃസ്ഥാപിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची खरेदी झाली, पण Pillie Plus सुरू झाले नाही. पुन्हा प्रयत्न करा, किंवा खरेदी रिस्टोअर करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ କ୍ରୟ ସରିଲା, କିନ୍ତୁ Pillie Plus ଚାଲୁ ହେଲା ନାହିଁ। ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ, କିମ୍ବା କ୍ରୟ ପୁନରୁଦ୍ଧାର କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਖ਼ਰੀਦ ਹੋ ਗਈ, ਪਰ Pillie Plus ਚਾਲੂ ਨਹੀਂ ਹੋਇਆ। ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ, ਜਾਂ ਖ਼ਰੀਦਾਂ ਰੀਸਟੋਰ ਕਰੋ।"
          }
        }
      }
    },
