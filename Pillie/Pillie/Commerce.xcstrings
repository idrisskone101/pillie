    "trial.end.subtitle.hard": {
      "comment": "Hard trial-end subtitle with blocking",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You had extra pings and paused apps for 14 days. Keep Plus if you want that to stay on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hattest extra Pings und pausierte Apps für 14 Tage. Behalt Plus, wenn das so bleiben soll."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai avuto ping extra e app in pausa per 14 giorni. Tieni plus se vuoi che resti così."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as eu des pings supplémentaires et des apps en pause pendant 14 jours. Garde Plus si tu veux que ça continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuviste avisos extra y apps en pausa durante 14 días. Conserva Plus si quieres que siga activo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você teve pings extras e apps pausados por 14 dias. Mantenha o Plus se quiser que isso continue."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je had 14 dagen extra pings en gepauzeerde apps. Houd Plus als je dat wilt behouden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hade extra puffar och pausade appar i 14 dagar. Behåll Plus om du vill att det ska fortsätta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du havde ekstra prik og apps på pause i 14 dage. Behold Plus, hvis det skal blive ved."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hadde ekstra pling og pausede apper i 14 dager. Behold Plus hvis du vil at det skal fortsette."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sait lisäpingauksia ja sovellustaukoja 14 päivän ajan. Pidä Plus, jos haluat, että se jatkuu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiveste avisos extra e apps em pausa durante 14 dias. Mantém o Plus se quiseres que isso continue."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has tingut avisos extra i apps en pausa durant 14 dies. Conserva el Plus si vols que continuï així."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przez 14 dni dodatkowe sygnały i wstrzymywanie aplikacji były twoje. Zachowaj Plus, jeśli mają zostać."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po 14 dní ti fungovala extra upozornění a pozastavení aplikací. Nech si Plus, pokud to tak má zůstat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "14 дней у тебя были дополнительные напоминания и пауза приложений. Оставь Plus, если хочешь, чтобы так и было."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "14 днів у тебе були додаткові нагадування й пауза застосунків. Лиши Plus, якщо хочеш, щоб так і було."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "14日間、追加の通知とアプリの一時停止を使いました。このまま続けたいならPlusをキープしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "14일 동안 추가 알림과 앱 일시 중지를 사용했어요. 계속 유지하고 싶다면 Plus를 이어가세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu dapat peringatan tambahan dan apl dijeda selama 14 hari. Kekalkan Plus jika kamu mahu ia terus hidup."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai avut semnale suplimentare și aplicații pe pauză timp de 14 zile. Păstrează Plus dacă vrei să rămână așa."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "14 dní extra pripomenutí a pozastavených aplikácií máš za sebou. Nechaj si Plus, ak to tak má zostať."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณได้เตือนซ้ำและพักแอปมา 14 วันแล้ว ใช้ Plus ต่อถ้าอยากให้เป็นแบบนี้ต่อไป"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这 14 天里，你享有额外提醒和应用暂停。想保持下去，就保留 Plus。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "14 दिन तुम्हें अतिरिक्त पिंग और रुके हुए ऐप्स मिले। अगर यह चालू रखना है, तो Plus रखो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imala si dodatne pingove i pauzirane aplikacije 14 dana. Zadrži Plus ako želiš da tako ostane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "14 napig extra jelzéseid és szüneteltetett appjaid voltak. Tartsd meg a Plust, ha ez így maradjon."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 gün boyunca ekstra uyarılar ve duraklatılan uygulamalar kullandın. Böyle kalmasını istiyorsan Plus'ı tut."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "14 நாட்களாக கூடுதல் பிங்குகளும் இடைநிறுத்தப்பட்ட ஆப்ஸும் உனக்கு இருந்தன. அது தொடர வேண்டுமெனில் Plus-ஐ வைத்துக்கொள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama 14 hari kamu dapat pengingat ekstra dan aplikasi dijeda. Pertahankan Plus kalau ingin itu tetap berjalan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حصلتِ على تنبيهات إضافية وتطبيقات متوقفة لمدة 14 يومًا. احتفظي بـ Plus إذا أردتِ أن يستمر ذلك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היו לך תזכורות נוספות ואפליקציות מושהות במשך 14 ימים. השאירי את Plus אם את רוצה שזה יימשך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã có thêm lời nhắc và tạm dừng ứng dụng trong 14 ngày. Giữ Plus nếu bạn muốn duy trì."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "14 দিন তুমি অতিরিক্ত পিং ও পজ করা অ্যাপ পেয়েছ। এভাবেই চালু রাখতে চাইলে Plus রাখো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "14 دن تمہارے پاس اضافی پنگ اور رکی ہوئی ایپس رہیں۔ اگر یہ آن رکھنا ہے تو Plus رکھو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadnjih 14 dni: dodatni opomniki in ustavljene aplikacije. Obdrži Plus, če želiš, da tako ostane."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είχες επιπλέον ειδοποιήσεις και εφαρμογές σε παύση για 14 ημέρες. Κράτα το Plus αν θέλεις να συνεχιστεί."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "14 రోజులు నీకు అదనపు పింగ్‌లు, పాజ్ అయిన యాప్‌లు ఉన్నాయి. అది అలాగే ఉండాలంటే Plus ఉంచుకో."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這 14 天裡，你享有額外提醒和應用程式暫停。想維持下去，就保留 Plus。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "14 દિન તું્હેં અતિરિક્ત પિંગ અને રુકે હુએ ઍપ્સ મિલે। અગર આ ચાલૂ રખના છે, તો Plus રખો।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "14 ರೋಜುಲು ನೀಕು ಅದನಪು ಪಿಂಗ್‌ಲು, ಪಾಜ್ ಅಯಿನ ಆ್ಯಾಪ್‌ಗಳು ಉನ್ನಾಯಿ. ಅದಿ ಅಲಾಗೇ ಉಂಡಾಲಂಟೇ Plus ಉಂಚುಕೋ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "14 ദിവസം അധിക പിംഗും നിർത്തിയ ആപ്പും. വേണമെങ്കിൽ Plus നിലനിർത്തൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 दिवस अतिरिक्त पिंग आणि थांबलेले अॅप्स होते. ते ठेवायचे तर Plus ठेव."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "14 ଦିନ ତୁମକୁ ଅତିରିକ୍ତ ପିଙ୍ଗ୍ ଓ ବିରାମ ଆପ୍ ମିଳିଲା। ଏହା ଚାଲୁ ରଖିବାକୁ Plus ରଖ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "14 ਦਿਨ ਤੈਨੂੰ ਅਤਿਰਿਕ੍ਤ ਪਿਂਗ ਤੇ ਰੁਦੇ ਹੁਏ ਐਪਾਂ ਮਿਲੇ। ਅਗਰ ਯਹ ਚਾਲੂ ਰਖਨਾ ਹੈ, ਤੋ Plus ਰੱਖ।"
          }
        }
      }
