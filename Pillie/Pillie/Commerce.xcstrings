    "trial.end.legacy.subtitle": {
      "comment": "Legacy trial-end subtitle [ENG-71]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your 14 days ended, so app blocking is off. Reminders stay free forever."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine 14 Tage sind um, also ist App-Pause aus. Erinnerungen bleiben für immer kostenlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi 14 giorni sono finiti, quindi il blocco app è spento. I promemoria restano gratis per sempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes 14 jours sont passés, donc la pause d'apps est désactivée. Les rappels restent gratuits pour toujours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus 14 días terminaron, así que el bloqueo de apps está desactivado. Los recordatorios siguen gratis para siempre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus 14 dias acabaram, então bloqueio de apps está desligado. Lembretes continuam grátis para sempre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je 14 dagen zijn om, dus app-pauze staat uit. Herinneringen blijven gratis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina 14 dagar är slut, så appblockering är av. Påminnelserna förblir gratis för alltid."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine 14 dage er gået, så appblokering er slået fra. Påmindelserne forbliver gratis for altid."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De 14 dagene dine er over, så app-pause er av. Påminnelsene forblir gratis for alltid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "14 päivääsi päättyivät, joten sovellustauko on pois. Muistutukset pysyvät ilmaisina aina."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus 14 dias terminaram, por isso a pausa de apps está desligada. Os lembretes continuam grátis para sempre."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus 14 dies s’han acabat, així que la pausa d’apps està desactivada. Els recordatoris continuen sent gratuïts per sempre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje 14 dni minęło, więc blokowanie aplikacji jest wyłączone. Przypomnienia zostają bezpłatne na zawsze."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvých 14 dní skončilo, takže blokování aplikací je vypnuté. Připomínky zůstávají zdarma navždy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои 14 дней прошли, поэтому блокировка приложений выключена. Напоминания останутся бесплатными навсегда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твої 14 днів минули, тому блокування застосунків вимкнено. Нагадування лишаться безкоштовними назавжди."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "14日間が終わったので、アプリブロックはオフです。リマインダーはずっと無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "14일이 끝나서 앱 차단이 꺼졌어요. 알림은 영원히 무료예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "14 hari kamu sudah tamat, jadi sekatan apl dimatikan. Peringatan kekal percuma selamanya."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cele 14 zile s-au terminat, așa că blocarea aplicațiilor e oprită. Mementourile rămân gratuite pentru totdeauna."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvojich 14 dní uplynulo, takže blokovanie aplikácií je vypnuté. Pripomienky zostávajú zdarma navždy."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "14 วันของคุณครบแล้ว การพักแอปจึงปิด ส่วนการแจ้งเตือนฟรีตลอดไป"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 14 天已结束，所以应用屏蔽已关闭。提醒永久免费。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारे 14 दिन ख़त्म हुए, इसलिए ऐप ब्लॉकिंग बंद है। रिमाइंडर हमेशा मुफ़्त रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvojih 14 dana je prošlo, pa je blokiranje aplikacija isključeno. Podsjetnici ostaju besplatni zauvijek."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A 14 napod lejárt, így az appblokkolás kikapcsolt. Az emlékeztetők örökre ingyenesek maradnak."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 günün bitti, bu yüzden uygulama duraklatma kapalı. Hatırlatmalar sonsuza kadar ücretsiz."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் 14 நாட்கள் முடிந்தன, அதனால் ஆப் இடைநிறுத்தம் ஆஃப். நினைவூட்டல்கள் என்றென்றும் இலவசம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "14 harimu sudah habis, jadi jeda aplikasi mati. Pengingat tetap gratis selamanya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت أيامك الـ 14، لذا إيقاف التطبيقات غير مفعّل. تبقى التذكيرات مجانية إلى الأبد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "14 הימים שלך הסתיימו, אז השהיית האפליקציות כבויה. התזכורות נשארות בחינם לתמיד."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "14 ngày của bạn đã hết, nên chặn ứng dụng đã tắt. Lời nhắc vẫn miễn phí mãi mãi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার 14 দিন শেষ, তাই অ্যাপ ব্লকিং বন্ধ। রিমাইন্ডার চিরকাল ফ্রি থাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہارے 14 دن ختم ہو گئے، اس لیے ایپ بلاکنگ بند ہے۔ یاد دہانیاں ہمیشہ مفت رہتی ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvojih 14 dni je minilo, zato je blokiranje aplikacij izklopljeno. Opomniki ostanejo brezplačni za vedno."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι 14 ημέρες σου τελείωσαν, οπότε η παύση εφαρμογών είναι ανενεργή. Οι υπενθυμίσεις μένουν δωρεάν για πάντα."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ 14 రోజులు ముగిశాయి, అందుకే యాప్ పాజ్ ఆఫ్‌లో ఉంది. రిమైండర్లు ఎప్పటికీ ఉచితం."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 14 天已結束，所以應用程式封鎖已關閉。提醒永久免費。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તારા 14 દિવસ પૂરા થયા, એતલે ઍપ થોભાવ બંધ છે। રિમાઇન્ડર હમેશા મફત રહે છે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ 14 ರೋಜುಲು ಮುಗಿಶಾಯಿ, ಅಂದುಕೇ ಯಾಪ್ ಪಾಜ್ ಆಫ್‌ಲೋ ಉಂದಿ. ಜ್ಞಾಪನೆಲು ಎಪ್ಪಟಿಕೀ ಉಚಿತಂ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "14 ദിവസം കഴിഞ്ഞു, ആപ്പ് ബ്ലോക്കിംഗ് ഓഫ്. റിമൈൻഡറുകൾ സൗജന്യമായി തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 दिवस संपले, अॅप थांबवणे बंद. आठवणी कायम मोफत."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର 14 ଦିନ ଶେଷ, ତେଣୁ ଆପ୍ ବିରାମ ବନ୍ଦ। ରିମାଇଣ୍ଡର୍ ସବୁଦିନ ମାଗଣା।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੇਰੇ 14 ਦਿਨ ਖ਼ਤ੍ਮ ਹੁਏ, ਇਸਲਿਏ ਐਪ ਬ੍ਲਾਕਿਂਗ ਬਂਦ ਹੈ। ਰਿਮਾਇਂਡਰ ਹਮੇਸ਼ਾ ਮੁਫ਼੍ਤ ਰਹਤੇ ਹੈਂ।"
          }
        }
      }
    },
