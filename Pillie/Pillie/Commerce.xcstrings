        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "14 فعال دن مفت، کارڈ کی ضرورت نہیں۔ ٹرائل کے بعد ایپ بلاکنگ بند ہو جاتی ہے۔ یاد دہانیاں مفت رہتی ہیں۔"
