    "paywall.plan.cancel_anytime": {
      "comment": "Subscription management [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can manage or cancel anytime in settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi gestire o disdire quando vuoi dalle impostazioni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jederzeit in den Einstellungen verwalten oder kündigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux gérer ou annuler à tout moment dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes administrar o cancelar cuando quieras en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode gerenciar ou cancelar a qualquer momento em Ajustes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt altijd beheren of opzeggen in instellingen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan hantera eller avsluta när du vill i inställningarna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan administrere eller opsige når som helst i indstillingerne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan administrere eller avslutte når som helst i innstillingene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit hallita tai peruuttaa tilauksen milloin tahansa asetuksista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes gerir ou cancelar a qualquer momento nas definições."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots gestionar-ho o cancel·lar-ho quan vulguis a la configuració."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz zarządzać lub anulować w każdej chwili w ustawieniach."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatné můžeš kdykoliv spravovat nebo zrušit v nastavení."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управлять подпиской или отменить её можно в любой момент в настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керувати підпискою або скасувати її можна будь-коли в параметрах."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定からいつでも管理・解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 언제든 관리하거나 해지할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu boleh urus atau batalkan bila-bila masa dalam tetapan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți gestiona sau anula oricând din configurări."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedykoľvek môžeš spravovať alebo zrušiť v nastaveniach."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดการหรือยกเลิกได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你随时可以在设置中管理或取消。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम सेटिंग्स में कभी भी मैनेज या रद्द कर सकते हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U postavkama možeš upravljati ili otkazati kad god želiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor kezelheted vagy lemondhatod a beállításokban."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlardan istediğin zaman yönetebilir veya iptal edebilirsin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகளில் எப்போது வேண்டுமானாலும் நிர்வகிக்கலாம் அல்லது ரத்து செய்யலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa mengelola atau membatalkan kapan saja di pengaturan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الإدارة أو الإلغاء في أي وقت من الإعدادات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לנהל או לבטל בכל עת בהגדרות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể quản lý hoặc hủy bất cứ lúc nào trong cài đặt."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংস থেকে যখন খুশি ম্যানেজ বা বাতিল করতে পারো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیٹنگز میں کبھی بھی منظم یا منسوخ کیا جا سکتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V nastavitvah lahko kadar koli upravljaš ali prekličeš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να διαχειριστείς ή να ακυρώσεις όποτε θέλεις από τις ρυθμίσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెట్టింగ్‌లలో ఎప్పుడైనా నిర్వహించుకోవచ్చు లేదా రద్దు చేసుకోవచ్చు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你隨時可以在設定中管理或取消。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તું સેટિંગ્સ મેં ક્યારેય મૈનેજ યા રદ્દ કર શકો છો।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೆಟ್ಟಿಂಗ್‌ಲಲೋ ಎಪ್ಪುಡೈನಾ ನಿರ್ವಹಿಂಚುಕೋವಚ್ಚು ಲೇದಾ ರದ್ದು ಚೇಸುಕೋವಚ್ಚು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സെറ്റിംഗ്‌സിൽ എപ്പോൾ വേണമെങ്കിലും മാനേജ് ചെയ്യാം അല്ലെങ്കിൽ റദ്ദാക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तू सेटिंग्ज मध्ये कभी भी मैनेज किंवा रद्द कर शकतोस।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମେ ସେଟିଂସ୍‌ରେ ଯେକୌଣସି ସମୟରେ ପରିଚାଳନା ବା ବାତିଲ୍ କରିପାରିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੂੰ ਸੇਟਿਂਗ੍ਸ ਵਿੱਚ ਕਭੀ ਭੀ ਮੈਨੇਜ ਯਾ ਰਦ੍ਦ ਕਰ ਸਕਦੀ ਹੈਂ।"
          }
        }
      }
    },
