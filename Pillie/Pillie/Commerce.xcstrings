    "onboarding.blocking_setup.hard_paywall_locked_detail": {
      "comment": "Paid-access requirement shown when a hard-cohort trial expires during onboarding [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose monthly, annual, or lifetime to keep using Pillie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il piano mensile, annuale o a vita per continuare a usare Pillie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Monats-, Jahres- oder Lifetime-Tarif, um Pillie weiter zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis Mensuel, Annuel ou à vie pour continuer à utiliser Pillie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Mensual, Anual o de por vida para seguir usando Pillie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Mensal, Anual ou Vitalício para continuar usando o Pillie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies maandelijks, jaarlijks of lifetime om Pillie te blijven gebruiken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj månadsvis, årsvis eller livstid för att fortsätta använda Pillie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg månedligt, årligt eller livstid for at fortsætte med at bruge Pillie."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg månedlig, årlig eller livstid for å fortsette å bruke Pillie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kuukausittain, vuosittain tai kertamaksu jatkaaksesi Pillien käyttöä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe mensal, anual ou vitalício para continuares a usar o Pillie."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria mensual, anual o vitalici per continuar fent servir Pillie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz plan miesięczny, roczny albo na zawsze, aby dalej korzystać z Pillie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber měsíční, roční nebo trvalý plán a používej Pillie dál."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери ежемесячный, годовой или пожизненный план, чтобы продолжить пользоваться Pillie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери щомісячний, річний або довічний план, щоб і далі користуватися Pillie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieを続けて使うには、月額、年額、または買い切りを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie를 계속 사용하려면 월간, 연간 또는 평생 이용권을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bulanan, tahunan atau seumur hidup untuk terus menggunakan Pillie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege lunar, anual sau pe viață pentru a continua să folosești Pillie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chceš Pillie používať ďalej, vyber mesačný, ročný alebo doživotný plán."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแบบรายเดือน รายปี หรือตลอดชีพ เพื่อใช้ Pillie ต่อ"
