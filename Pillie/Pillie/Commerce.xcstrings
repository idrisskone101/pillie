          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "14 दिन मुफ़्त, कार्ड की ज़रूरत नहीं। ट्रायल के बाद ऐप ब्लॉकिंग बंद हो जाती है। रिमाइंडर मुफ़्त रहते हैं।"
