    "paywall.story.trial_active.subtitle": {
      "comment": "",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Plus to have follow-up reminders and app blocking after your trial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte Plus, damit du nach der Testphase weiter Folgeerinnerungen und die App-Sperre hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni Plus per avere promemoria ripetuti e blocco app anche dopo la prova."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظي بـ Plus لتبقى لديكِ تذكيرات المتابعة وحظر التطبيقات بعد الفترة التجريبية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রায়ালের পরেও ফলো-আপ রিমাইন্ডার আর অ্যাপ ব্লকিং পেতে Plus রাখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva el Plus per tenir recordatoris de seguiment i bloqueig d’apps després de la prova."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nech si Plus a následné připomínky i blokování aplikací ti zůstanou i po zkušebním období."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold Plus for at have opfølgende påmindelser og appblokering efter din prøveperiode."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτα το Plus για να έχεις επαναληπτικές υπενθυμίσεις και αποκλεισμό εφαρμογών και μετά τη δοκιμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quédate con Plus para seguir teniendo recordatorios de seguimiento y bloqueo de apps después de la prueba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä Plus, niin jatkomuistutukset ja sovellusesto jatkuvat kokeilun jälkeenkin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde Plus pour conserver les rappels de relance et le blocage d’apps après ton essai."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટ્રાયલ પછી પણ ફૉલો-અપ રિમાઇન્ડર અને ઍપ બ્લૉકિંગ માટે Plus રાખો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאירי את Plus כדי שתזכורות המשך וחסימת אפליקציות יישארו גם אחרי תקופת הניסיון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रायल के बाद भी फ़ॉलो-अप रिमाइंडर और ऐप ब्लॉकिंग के लिए Plus जारी रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadrži Plus da ti ponovni podsjetnici i blokiranje aplikacija ostanu i nakon probnog razdoblja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd meg a Plust, hogy a próbaidőszak után is megmaradjanak az ismétlő emlékeztetők és az appblokkolás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertahankan Plus agar tetap punya pengingat lanjutan dan blokir aplikasi setelah masa uji coba."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusを続ければ、トライアル後もフォローアップリマインダーとアプリブロックを使えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟ್ರಯಲ್ ನಂತರವೂ ಮರು ಜ್ಞಾಪನೆಗಳು ಮತ್ತು ಆ್ಯಪ್ ನಿರ್ಬಂಧ ಬೇಕಾದರೆ, Plus ಮುಂದುವರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus를 유지하면 체험 후에도 후속 알림과 앱 차단을 쓸 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ട്രയലിന് ശേഷവും ഫോളോ-അപ്പ് റിമൈൻഡറുകളും ആപ്പ് ബ്ലോക്കിംഗും വേണമെങ്കിൽ, Plus തുടരൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रायलनंतरही फॉलो-अप रिमाइंडर आणि ॲप ब्लॉकिंगसाठी Plus सुरू ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekalkan Plus untuk terus dapat peringatan susulan dan sekatan apl selepas percubaan kamu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold Plus for å ha oppfølgingspåminnelser og appblokkering etter prøveperioden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf bij Plus om na je proefperiode vervolgherinneringen en appblokkering te houden."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଟ୍ରାୟାଲ୍ ପରେ ବି ଫଲୋ-ଅପ୍ ରିମାଇଣ୍ଡର୍ ଓ ଆପ୍ ବ୍ଲକିଂ ପାଇଁ Plus ରଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟ੍ਰਾਇਲ ਤੋਂ ਬਾਅਦ ਵੀ ਫ਼ਾਲੋ-ਅੱਪ ਰਿਮਾਈਂਡਰ ਅਤੇ ਐਪ ਬਲੌਕਿੰਗ ਲਈ Plus ਰੱਖੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostań z Plus, aby po okresie próbnym dalej mieć ponowne przypomnienia i blokowanie aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o Plus para ter lembretes de acompanhamento e bloqueio de apps depois do teste."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica com o Plus para manteres os lembretes de seguimento e o bloqueio de apps depois do teste."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează Plus ca să ai mementouri repetate și blocarea aplicațiilor și după perioada de probă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставь Plus, чтобы повторные напоминания и блокировка приложений работали и после пробного периода."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechaj si Plus a následné pripomienky aj blokovanie aplikácií ti ostanú aj po skúšobnom období."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obdrži Plus, da ponovni opomniki in blokiranje aplikacij ostanejo tudi po preizkusu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll Plus för att ha uppföljande påminnelser och appblockering efter din provperiod."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சோதனைக் காலத்திற்குப் பிறகும் தொடர் நினைவூட்டல்களும் ஆப் தடுப்பும் வேண்டுமெனில், Plus-ஐத் தொடருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రయల్ తర్వాత కూడా ఫాలో-అప్ రిమైండర్లు, యాప్ బ్లాకింగ్ కావాలంటే Plus కొనసాగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ Plus ต่อเพื่อให้มีการแจ้งเตือนซ้ำและการบล็อกแอปหลังช่วงทดลองใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme süren bittikten sonra da takip hatırlatmaları ve uygulama engelleme için Plus ile devam et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиш Plus, щоб повторні нагадування і блокування застосунків працювали й після пробного періоду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرائل کے بعد بھی فالو اپ یاد دہانیوں اور ایپ بلاکنگ کے لیے Plus جاری رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ Plus để tiếp tục có lời nhắc lặp lại và chặn ứng dụng sau khi dùng thử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 Plus，试用结束后也能继续使用后续提醒和应用屏蔽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 Plus，試用結束後也能繼續使用後續提醒和 App 封鎖。"
          }
        }
      }
    },
