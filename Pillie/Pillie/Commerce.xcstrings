            "value": "ରିମାଇଣ୍ଡର୍ ସମୟରେ ତୁମର ଆପ୍ ବିରାମ ହୁଏ, ପ୍ୟାଚ୍ ଲଗାଇବା ଯାଏଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਇਂਡਰ ਆਨੇ ਪਰ ਤੇਰੇ ਐਪਾਂ ਰੁਕ ਜਾਂਦੀਆਂ ਹਨ, ਜਦ ਤੱਕ ਤੂੰ ਪੈਚ ਨਹੀਂ ਲਗਾਤੇ।"
          }
        }
      }
    },
    "paywall.upsell.app_blocking.body.patch.change": {
      "comment": "App blocking plus-gate body, change patch [ENG-67]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your apps pause when the reminder is due, until you change your patch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apps pausieren, wenn die Erinnerung kommt, bis du das Pflaster wechselst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue app vanno in pausa quando arriva il promemoria, finché non cambi il cerotto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes apps sont en pause quand le rappel arrive, jusqu'à ce que tu changes ton patch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus apps se pausan cuando toca el recordatorio, hasta que cambies tu parche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus apps pausam quando o lembrete chega, até você trocar seu adesivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je apps pauzeren wanneer de herinnering klaarstaat, tot je je pleister wisselt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina appar pausas när påminnelsen är aktuell, tills du byter ditt plåster."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine apps sættes på pause, når påmindelsen er aktuel, indtil du skifter dit plaster."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appene dine pauses når påminnelsen forfaller, til du har byttet plasteret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksesi menevät tauolle, kun muistutus on ajankohtainen, kunnes vaihdat laastarisi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas apps ficam em pausa quando o lembrete chega, até mudares o adesivo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves apps es pausen quan toca el recordatori, fins que canvies el pegat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje wstrzymują się, gdy nadejdzie przypomnienie, aż zmienisz plaster."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přijde připomínka, tvoje aplikace se pozastaví, dokud si nevyměníš náplast."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения ставятся на паузу, когда приходит напоминание, пока ты не сменишь пластырь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунки стають на паузу, коли надходить нагадування, доки ти не зміниш пластир."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーの時間になるとアプリが一時停止し、パッチを貼り替えるまで続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 시간이 되면 패치를 교체할 때까지 앱이 일시 중지돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl kamu dijeda apabila peringatan tiba, sehingga kamu tukar tampalan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile tale intră în pauză când e timpul mementoului, până îți schimbi plasturele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď príde čas pripomienky, tvoje aplikácie sa pozastavia, kým si nevymeníš náplasť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปของคุณจะพักเมื่อถึงเวลาแจ้งเตือน จนกว่าคุณจะเปลี่ยนแผ่นแปะ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒到点时，你的应用会暂停，直到你更换贴片。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर आने पर तुम्हारे ऐप्स रुक जाते हैं, जब तक तुम पैच नहीं बदलते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikacije se pauziraju kad stigne podsjetnik, dok ne promijeniš flaster."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appjaid szünetelnek, amikor esedékes az emlékeztető, amíg ki nem cseréled a tapaszt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatma zamanı geldiğinde uygulamaların duraklar, bandını değiştirene kadar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நினைவூட்டல் நேரம் வந்ததும் உன் ஆப்ஸ் இடைநிறுத்தப்படும், நீ பேட்ச் மாற்றும் வரை."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasimu dijeda saat pengingat tiba, sampai kamu mengganti koyo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف تطبيقاتك مؤقتًا عند حلول موعد التذكير، حتى تغيّري لصقتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציות שלך מושהות כשמגיע זמן התזכורת, עד שתחליפי את המדבקה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng của bạn tạm dừng khi đến giờ nhắc, cho đến khi bạn thay miếng dán."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডারের সময় হলে তোমার অ্যাপগুলো পজ হয়, যতক্ষণ না তুমি প্যাচ বদলাও।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی کا وقت آنے پر تمہاری ایپس رک جاتی ہیں، جب تک تم پیچ نہ بدل لو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je čas za opomnik, se tvoje aplikacije ustavijo, dokler ne zamenjaš obliža."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές σου μπαίνουν σε παύση όταν έρθει η ώρα της υπενθύμισης, μέχρι να αλλάξεις το αυτοκόλλητό σου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిమైండర్ సమయం రాగానే నీ యాప్‌లు పాజ్ అవుతాయి, నువ్వు ప్యాచ్ మార్చేదాకా."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒到的時候，你的應用程式會暫停，直到你更換貼片。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇંડર આને પર તારા ઍપ્સ રુક જાતે છે, જ્યારે સુધી તું પૈચ નહીં બદલતે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜ್ಞಾಪನೆ ಸಮಯಂ ರಾಗಾನೇ ನಿನ್ನ ಆ್ಯಾಪ್‌ಗಳು ಪಾಜ್ ಅವುತಾಯಿ, ನೀನು ಪ್ಯಾಚ್ ಮಾರ್ಚೇದಾಕಾ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിന്റെ ആപ്പുകൾ നിൽക്കും, പാച്ച് മാറ്റൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आठवण आली की तुझे अॅप्स थांबतात, पॅच बदलेपर्यंत."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ସମୟରେ ତୁମର ଆପ୍ ବିରାମ ହୁଏ, ପ୍ୟାଚ୍ ବଦଳାଇବା ଯାଏଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਇਂਡਰ ਆਨੇ ਪਰ ਤੇਰੇ ਐਪਾਂ ਰੁਕ ਜਾਂਦੀਆਂ ਹਨ, ਜਦ ਤੱਕ ਤੂੰ ਪੈਚ ਨਹੀਂ ਬਦਲਤੇ।"
          }
        }
      }
    },
