        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్ పాజ్ ఇప్పుడు ఆఫ్‌లో ఉంది. నీ సాధారణ రిమైండర్లు అందుబాటులోనే ఉంటాయి."
          }
        },
