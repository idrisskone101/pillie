{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.blocking_setup.plus_locked": {
      "comment": "Entitlement statement [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App blocking is a Pillie Plus feature you can set up after upgrading."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco delle app è una funzione di Pillie Plus configurabile dopo l’upgrade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Pause ist eine Pillie-Plus-Funktion, die du nach dem Upgrade einrichten kannst."
          }
        }
      }
    },
    "onboarding.demo.free_body": {
      "comment": "Free entitlement statement [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily reminders, logging and history are included in the free plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria quotidiani, registrazione e cronologia sono inclusi nel piano gratuito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tägliche Erinnerungen, Protokollierung und Verlauf sind im kostenlosen Tarif enthalten."
          }
        }
      }
    },
    "paywall.title": {
      "comment": "No adherence guarantee [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay on top of your routine with Pillie Plus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni sotto controllo la routine con Pillie Plus"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte deine Routine mit Pillie Plus im Blick"
          }
        }
      }
    },
    "paywall.subtitle": {
      "comment": "Functionality only [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause selected apps when a reminder is due, for days when one prompt is not enough."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in pausa le app selezionate quando arriva un promemoria, nei giorni in cui un solo avviso non basta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiere ausgewählte Apps, wenn eine Erinnerung fällig ist — für Tage, an denen ein Hinweis nicht genügt."
          }
        }
      }
    },
