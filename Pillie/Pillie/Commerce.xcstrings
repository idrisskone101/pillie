    "paywall.upsell.custom_messages.body": {
      "comment": "Custom reminder messages plus-gate body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write the ping in your own words. Plus lets you change the daily one and the last one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib den Ping in deinen Worten. Plus ändert den täglichen und den letzten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi il ping con le tue parole. Plus cambia quello giornaliero e l'ultimo."
