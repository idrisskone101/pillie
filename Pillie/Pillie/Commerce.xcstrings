        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गोळी घेईपर्यंत तुमची ॲप्स लॉक ठेवा."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாத்திரை எடுக்கும் வரை உங்கள் ஆப்ஸைப் பூட்டுங்கள்."
          }
        },
        "id": {
