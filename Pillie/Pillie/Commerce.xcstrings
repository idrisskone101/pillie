        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गोली लेने तक अपने ऐप्स लॉक रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিল না খাওয়া পর্যন্ত আপনার অ্যাপগুলো লক রাখুন।"
