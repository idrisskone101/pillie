          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokování aplikací je teď vypnuté. Standardní připomínky máš dál k dispozici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка приложений теперь выключена. Обычные напоминания остаются доступны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокування застосунків тепер вимкнено. Звичайні нагадування лишаються доступними."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
