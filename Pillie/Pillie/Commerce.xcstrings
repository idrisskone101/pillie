    "paywall.upsell.smart_reminders.body": {
      "comment": "Smart Reminders plus-gate body [ENG-66]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps pinging until you log today. You pick how often, how many, and the last ping."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pingt weiter, bis du heute einträgst. Du wählst wie oft, wie viele, und den letzten Ping."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a mandare ping finché non registri oggi. Scegli ogni quanto, quanti, e l'ultimo ping."
          }
        }
      }
    },
    "paywall.upsell.app_blocking.body.pill": {
      "comment": "App blocking plus-gate body, pill [ENG-67]",
