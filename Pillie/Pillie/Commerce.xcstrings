{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.blocking_setup.subscriber_disclosure": {
      "comment": "Paid subscriber status on the app-blocking onboarding surface [subscription]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus is active on this account. Set up app blocking whenever you’re ready."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus è attivo su questo account. Configura il blocco delle app quando vuoi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus ist für dieses Konto aktiv. Richte die App-Pause ein, wenn du bereit bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus est actif sur ce compte. Configure la pause d'apps quand tu es prêt·e."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus está activo en esta cuenta. Configura el bloqueo de apps cuando estés listo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie Plus está ativo nesta conta. Configure o bloqueio de apps quando quiser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus is actief op dit account. Stel app-pauze in wanneer je er klaar voor bent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus är aktivt på det här kontot. Ställ in appblockering när du är redo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus er aktivt på denne konto. Sæt appblokering op, når du er klar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus er aktivt på denne kontoen. Sett opp app-pause når du er klar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus on aktiivinen tällä tilillä. Ota sovellustauko käyttöön, kun olet valmis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie Plus está ativo nesta conta. Configura a pausa de apps quando quiseres."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus està actiu en aquest compte. Configura la pausa d’apps quan vulguis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus jest aktywne na tym koncie. Skonfiguruj blokowanie aplikacji, kiedy zechcesz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus je na tomto účtu aktivní. Blokování aplikací nastav, kdykoliv budeš chtít."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus активен в этом аккаунте. Настрой блокировку приложений, когда захочешь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus активний у цьому обліковому записі. Налаштуй блокування застосунків, коли захочеш."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントではPillie Plusが有効です。準備ができたらいつでもアプリブロックを設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에서 Pillie Plus가 활성화되어 있어요. 준비되면 언제든 앱 차단을 설정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus aktif pada akaun ini. Sediakan sekatan apl bila-bila kamu bersedia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus e activ pe acest cont. Configurează blocarea aplicațiilor când ești gata."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus je na tomto účte aktívne. Blokovanie aplikácií si nastav, keď budeš chcieť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus เปิดใช้งานอยู่ในบัญชีนี้ ตั้งค่าการพักแอปได้เมื่อคุณพร้อม"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户已启用 Pillie Plus。准备好后随时可以设置应用屏蔽。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अकाउंट पर Pillie Plus सक्रिय है। जब तैयार हो, ऐप ब्लॉकिंग सेट कर लो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus aktivan je na ovom računu. Postavi blokiranje aplikacija kad budeš spremna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie Plus aktív ezen a fiókon. Állítsd be az appblokkolást, amikor készen állsz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus bu hesapta etkin. Uygulama duraklatmayı hazır olduğunda kur."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கணக்கில் Pillie Plus செயலில் உள்ளது. நீ தயாரானதும் ஆப் இடைநிறுத்தத்தை அமை."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus aktif di akun ini. Atur jeda aplikasi kapan pun kamu siap."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus مفعّل على هذا الحساب. أعدّي إيقاف التطبيقات متى كنتِ مستعدة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus פעיל בחשבון הזה. הגדירי השהיית אפליקציות כשתהיי מוכנה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus đang hoạt động trên tài khoản này. Thiết lập chặn ứng dụng khi bạn sẵn sàng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্টে Pillie Plus সক্রিয়। যখন প্রস্তুত, অ্যাপ ব্লকিং সেট করো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اکاؤنٹ پر Pillie Plus فعال ہے۔ جب تیار ہو، ایپ بلاکنگ سیٹ اپ کرو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus je aktiven v tem računu. Blokiranje aplikacij nastavi, kadar želiš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pillie Plus είναι ενεργό σε αυτόν τον λογαριασμό. Ρύθμισε την παύση εφαρμογών όποτε θέλεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఖాతాలో Pillie Plus యాక్టివ్‌గా ఉంది. నువ్వు సిద్ధమైనప్పుడు యాప్ పాజ్ సెటప్ చేయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳戶已啟用 Pillie Plus。準備好後隨時可以設定應用程式封鎖。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઇસ અકાઉંટ પર Pillie Plus સક્રિય છે। જ્યારે તૈયાર હો, ઍપ બ્લૉકિંગ સેટ કર લો।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಖಾತಾಲೋ Pillie Plus ಯಾಕ್ಟಿವ್‌ಗಾ ಉಂದಿ. ನೀನು ಸಿದ್ಧಮೈನಪ್ಪುಡು ಯಾಪ್ ಪಾಜ್ ಸೆಟಪ್ ಚೇಯಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ അക്കൗണ്ടിൽ Pillie Plus സജീവമാണ്. തയ്യാറാകുമ്പോൾ ആപ്പ് ബ്ലോക്കിംഗ് സജ്ജമാക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अकाउंट पर Pillie Plus सक्रिय आहे. जेव्हा तैयार हो, अॅप थांबवणे सेट कर घे."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଆକାଉଣ୍ଟରେ Pillie Plus ସକ୍ରିୟ ଅଛି। ତୁମେ ପ୍ରସ୍ତୁତ ହେଲେ ଆପ୍ ବିରାମ ସେଟ୍ କର।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਅਕਾਉਂਟ ਪਰ Pillie Plus ਸਕ੍ਰਿਯ ਹੈ। ਜਦ ਤੈਯਾਰ ਹੋ, ਐਪ ਬ੍ਲਾਕਿਂਗ ਸੇਟ ਕਰ ਲੋ।"
          }
        }
      }
    },
