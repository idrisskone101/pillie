    "paywall.board.during_trial.subtitle": {
      "comment": "%lld = number of hormone-active days left in the trial (2..14). MUST use the same 'active day' wording as the existing trial strings (see active-day tokens). 'day 14' = the last trial day.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %lld active days left. Pick a plan now and nothing turns off on day 14."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast noch %lld aktive Tage. Wähl jetzt einen Tarif, dann schaltet sich an Tag 14 nichts ab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti restano %lld giorni attivi. Scegli un piano ora e il giorno 14 non si spegne niente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il te reste %lld jours actifs. Choisis une formule maintenant et rien ne s’arrête au jour 14."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te quedan %lld días activos. Elige un plan ahora y nada se apaga el día 14."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam %lld dias ativos. Escolha um plano agora e nada desliga no dia 14."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam %lld dias ativos. Escolhe um plano agora e nada se desliga no dia 14."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nog %lld actieve dagen. Kies nu een plan en op dag 14 gaat er niets uit."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Et queden %lld dies actius. Tria un pla ara i el dia 14 no s’apagarà res."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har %lld aktive dage tilbage. Vælg en plan nu, så slukker intet på dag 14."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har %lld aktiva dagar kvar. Välj en plan nu så stängs inget av på dag 14."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har %lld aktive dager igjen. Velg en plan nå, så slås ingenting av på dag 14."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinulla on %lld aktiivista päivää jäljellä. Valitse paketti nyt, niin mikään ei sammu päivänä 14."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostało ci dni aktywnych: %lld. Wybierz plan teraz, a 14. dnia nic się nie wyłączy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývá ti aktivních dní: %lld. Vyber si plán hned a 14. den se nic nevypne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostáva ti aktívnych dní: %lld. Vyber si plán hneď a 14. deň sa nič nevypne."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preostalo ti je aktivnih dana: %lld. Odaberi plan sada i 14. dana ništa se neće isključiti."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preostali aktivni dnevi: %lld. Izberi paket zdaj in 14. dan se nič ne izklopi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még %lld aktív napod van. Válassz most csomagot, és a 14. napon semmi sem kapcsol ki."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai ai %lld zile active. Alege un plan acum și nimic nu se oprește în ziua 14."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σου απομένουν %lld ενεργές ημέρες. Διάλεξε πρόγραμμα τώρα και τίποτα δεν απενεργοποιείται την ημέρα 14."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld aktif günün kaldı. Şimdi bir plan seçersen 14. gün hiçbir şey kapanmaz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осталось активных дней: %lld. Выбери план сейчас, и на 14-й день ничего не отключится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лишилося активних днів: %lld. Обери план зараз, і на 14-й день нічого не вимкнеться."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقّى لديكِ %lld أيام نشطة. اختاري خطة الآن ولن يتوقف شيء في اليوم 14."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשארו לך %lld ימים פעילים. בחרי תוכנית עכשיו ושום דבר לא ייכבה ביום 14."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके %lld सक्रिय दिन बाक़ी हैं। अभी प्लान चुनें, ताकि 14वें दिन कुछ भी बंद न हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার %lld সক্রিয় দিন বাকি। এখনই একটি প্ল্যান বেছে নিন, তাহলে 14তম দিনে কিছুই বন্ধ হবে না।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے %lld فعال دن باقی ہیں۔ ابھی پلان چنیں تاکہ 14ویں دن کچھ بھی بند نہ ہو۔"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे %lld सक्रिय दिवस बाकी आहेत. आत्ताच प्लॅन निवडा, म्हणजे 14व्या दिवशी काहीही बंद होणार नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் %lld செயல் நாட்கள் உள்ளன. இப்போதே ஒரு திட்டத்தைத் தேர்ந்தெடுத்தால், 14ஆம் நாளில் எதுவும் நிற்காது."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu masih punya %lld hari aktif. Pilih paket sekarang agar tidak ada yang mati di hari ke-14."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu ada %lld hari aktif lagi. Pilih pelan sekarang supaya tiada apa yang dimatikan pada hari ke-14."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn còn %lld ngày uống. Chọn gói ngay để không có gì bị tắt vào ngày 14."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเหลืออีก %lld วันกินยา เลือกแพ็กเกจตอนนี้แล้วจะไม่มีอะไรปิดในวันที่ 14"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り%lld服用日です。今プランを選べば、14日目に何もオフになりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복용 %lld일이 남았어요. 지금 플랜을 고르면 14일째에도 아무것도 꺼지지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还剩 %lld 个服药日。现在选择方案，第 14 天什么都不会关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還剩 %lld 個服藥日。現在選擇方案，第 14 天什麼都不會關閉。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા %lld સક્રિય દિવસ બાકી છે. હમણાં જ પ્લાન પસંદ કરો, જેથી 14મા દિવસે કંઈ બંધ ન થાય."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮಗೆ ಇನ್ನೂ %lld ಸಕ್ರಿಯ ದಿನಗಳು ಉಳಿದಿವೆ. ಈಗಲೇ ಪ್ಲಾನ್ ಆರಿಸಿದರೆ, 14ನೇ ದಿನ ಏನೂ ಆಫ್ ಆಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് %lld സജീവ ദിനങ്ങൾ ബാക്കിയുണ്ട്. ഇപ്പോൾ ഒരു പ്ലാൻ തിരഞ്ഞെടുത്താൽ, 14-ാം ദിവസം ഒന്നും ഓഫാകില്ല."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କର %lld ସକ୍ରିୟ ଦିନ ବାକି। ବର୍ତ୍ତମାନ ପ୍ଲାନ୍ ବାଛନ୍ତୁ, ଯେପରି 14ତମ ଦିନରେ କିଛି ବନ୍ଦ ନହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ %lld ਸਰਗਰਮ ਦਿਨ ਬਾਕੀ ਹਨ। ਹੁਣੇ ਪਲਾਨ ਚੁਣੋ, ਤਾਂ ਜੋ 14ਵੇਂ ਦਿਨ ਕੁਝ ਵੀ ਬੰਦ ਨਾ ਹੋਵੇ।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు ఇంకా %lld యాక్టివ్ రోజులు ఉన్నాయి. ఇప్పుడే ప్లాన్ ఎంచుకుంటే, 14వ రోజున ఏదీ ఆఫ్ అవ్వదు."
          }
        }
      }
    },
    "paywall.board.during_trial.subtitle.tonight": {
      "comment": "Last day of the trial.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trial ends tonight. Pick a plan now and nothing turns off tomorrow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Testphase endet heute Nacht. Wähl jetzt einen Tarif, dann schaltet sich morgen nichts ab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova finisce stasera. Scegli un piano ora e domani non si spegne niente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton essai se termine ce soir. Choisis une formule maintenant et rien ne s’arrête demain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba termina esta noche. Elige un plan ahora y mañana no se apaga nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste termina hoje à noite. Escolha um plano agora e nada desliga amanhã."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu teste termina esta noite. Escolhe um plano agora e nada se desliga amanhã."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je proefperiode eindigt vanavond. Kies nu een plan en morgen gaat er niets uit."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova s’acaba aquesta nit. Tria un pla ara i demà no s’apagarà res."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din prøveperiode udløber i aften. Vælg en plan nu, så slukker intet i morgen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din provperiod tar slut i kväll. Välj en plan nu så stängs inget av i morgon."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøveperioden slutter i kveld. Velg en plan nå, så slås ingenting av i morgen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilusi päättyy tänä iltana. Valitse paketti nyt, niin mikään ei sammu huomenna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okres próbny kończy się dziś w nocy. Wybierz plan teraz, a jutro nic się nie wyłączy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební období končí dnes v noci. Vyber si plán hned a zítra se nic nevypne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúšobné obdobie končí dnes v noci. Vyber si plán hneď a zajtra sa nič nevypne."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Probno razdoblje završava večeras. Odaberi plan sada i sutra se ništa neće isključiti."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preizkus se konča nocoj. Izberi paket zdaj in jutri se nič ne izklopi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A próbaidőszakod ma éjjel véget ér. Válassz most csomagot, és holnap semmi sem kapcsol ki."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Perioada de probă se termină diseară. Alege un plan acum și mâine nu se oprește nimic."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δοκιμή σου λήγει απόψε. Διάλεξε πρόγραμμα τώρα και τίποτα δεν απενεργοποιείται αύριο."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denemen bu gece bitiyor. Şimdi bir plan seçersen yarın hiçbir şey kapanmaz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробный период закончится сегодня ночью. Выбери план сейчас, и завтра ничего не отключится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробний період завершиться сьогодні вночі. Обери план зараз, і завтра нічого не вимкнеться."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي فترتك التجريبية الليلة. اختاري خطة الآن ولن يتوقف شيء غدًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקופת הניסיון נגמרת הלילה. בחרי תוכנית עכשיו ושום דבר לא ייכבה מחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका ट्रायल आज रात ख़त्म हो रहा है। अभी प्लान चुनें, ताकि कल कुछ भी बंद न हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ট্রায়াল আজ রাতে শেষ। এখনই একটি প্ল্যান বেছে নিন, তাহলে কাল কিছুই বন্ধ হবে না।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ٹرائل آج رات ختم ہو رہا ہے۔ ابھی پلان چنیں تاکہ کل کچھ بھی بند نہ ہو۔"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा ट्रायल आज रात्री संपेल. आत्ताच प्लॅन निवडा, म्हणजे उद्या काहीही बंद होणार नाही."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சோதனைக் காலம் இன்றிரவு முடிகிறது. இப்போதே ஒரு திட்டத்தைத் தேர்ந்தெடுத்தால், நாளை எதுவும் நிற்காது."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Uji cobamu berakhir malam ini. Pilih paket sekarang agar tidak ada yang mati besok."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percubaan kamu tamat malam ini. Pilih pelan sekarang supaya tiada apa yang dimatikan esok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dùng thử kết thúc tối nay. Chọn gói ngay để ngày mai không có gì bị tắt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงทดลองใช้ของคุณสิ้นสุดคืนนี้ เลือกแพ็กเกจตอนนี้แล้วพรุ่งนี้จะไม่มีอะไรปิด"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルは今夜で終了します。今プランを選べば、明日も何もオフになりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험이 오늘 밤 끝나요. 지금 플랜을 고르면 내일도 아무것도 꺼지지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的试用今晚结束。现在选择方案，明天什么都不会关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的試用今晚結束。現在選擇方案，明天什麼都不會關閉。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ટ્રાયલ આજે રાત્રે પૂરી થાય છે. હમણાં જ પ્લાન પસંદ કરો, જેથી કાલે કંઈ બંધ ન થાય."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಟ್ರಯಲ್ ಇಂದು ರಾತ್ರಿ ಮುಗಿಯುತ್ತದೆ. ಈಗಲೇ ಪ್ಲಾನ್ ಆರಿಸಿದರೆ, ನಾಳೆ ಏನೂ ಆಫ್ ಆಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ട്രയൽ ഇന്ന് രാത്രി അവസാനിക്കും. ഇപ്പോൾ ഒരു പ്ലാൻ തിരഞ്ഞെടുത്താൽ, നാളെ ഒന്നും ഓഫാകില്ല."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଟ୍ରାୟାଲ୍ ଆଜି ରାତିରେ ଶେଷ ହେବ। ବର୍ତ୍ତମାନ ପ୍ଲାନ୍ ବାଛନ୍ତୁ, ଯେପରି କାଲି କିଛି ବନ୍ଦ ନହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਟ੍ਰਾਇਲ ਅੱਜ ਰਾਤ ਖ਼ਤਮ ਹੋ ਰਿਹਾ ਹੈ। ਹੁਣੇ ਪਲਾਨ ਚੁਣੋ, ਤਾਂ ਜੋ ਕੱਲ੍ਹ ਕੁਝ ਵੀ ਬੰਦ ਨਾ ਹੋਵੇ।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ట్రయల్ ఈ రాత్రి ముగుస్తుంది. ఇప్పుడే ప్లాన్ ఎంచుకుంటే, రేపు ఏదీ ఆఫ్ అవ్వదు."
          }
        }
      }
    },
    "paywall.board.get_plus.title.pill": {
      "comment": "Headline for free users. Plus can block chosen apps until the user checks in.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock your apps until you take your pill."
