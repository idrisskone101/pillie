    "paywall.purchase_error.missing_entitlement": {
      "comment": "Purchase completed without activating Plus [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase finished, but Pillie Plus was not activated. Please try again or restore purchases."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisto è stato completato, ma Pillie Plus non è stato attivato. Riprova o ripristina gli acquisti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wurde abgeschlossen, aber Pillie Plus wurde nicht aktiviert. Versuche es erneut oder stelle die Käufe wieder her."
          }
        }
      }
    },
