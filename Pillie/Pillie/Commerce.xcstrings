          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਈਂਡਰ ਆਉਣ ’ਤੇ, ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਪੈਚ ਨਹੀਂ ਬਦਲਦੇ, ਤੁਹਾਡੀਆਂ ਐਪਾਂ ਰੁਕੀਆਂ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        }
      }
    },
    "paywall.upsell.app_blocking.body.patch.remove": {
      "comment": "App blocking plus-gate body, remove patch [ENG-67]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your reminder goes off, your apps pause until you remove your patch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deine Erinnerung kommt, pausieren deine Apps, bis du dein Pflaster abnimmst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando arriva il promemoria, le tue app vanno in pausa finché non togli il cerotto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand ton rappel sonne, tes apps se mettent en pause jusqu’à ce que tu retires ton patch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando suena tu recordatorio, tus apps se pausan hasta que te quites el parche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o lembrete toca, seus apps ficam pausados até você remover seu adesivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je herinnering afgaat, pauzeren je apps tot je je pleister verwijdert."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När din påminnelse kommer pausas dina appar tills du tar av ditt plåster."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når din påmindelse kommer, sættes dine apps på pause, indtil du fjerner dit plaster."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når påminnelsen går av, pauses appene dine til du har tatt av plasteret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun muistutus tulee, sovelluksesi menevät tauolle, kunnes poistat laastarisi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o lembrete toca, as tuas apps ficam em pausa até retirares o adesivo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan sona el recordatori, les teves apps es posen en pausa fins que et treguis el pegat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy przyjdzie przypomnienie, aplikacje zostają wstrzymane, aż zdejmiesz plaster."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přijde připomínka, tvoje aplikace se pozastaví, dokud si nesundáš náplast."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда приходит напоминание, приложения встают на паузу, пока ты не снимешь пластырь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли надходить нагадування, застосунки стають на паузу, доки ти не знімеш пластир."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーが鳴ると、パッチをはがすまでアプリが一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 울리면 패치를 뗄 때까지 앱이 일시 중지돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila peringatan kamu berbunyi, apl kamu dijeda sehingga kamu tanggalkan tampalan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când sună mementoul, aplicațiile tale intră în pauză până îți scoți plasturele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď príde pripomienka, tvoje aplikácie sa pozastavia, kým si neodlepíš náplasť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อการแจ้งเตือนของคุณดังขึ้น แอปของคุณจะหยุดชั่วคราวจนกว่าคุณจะแกะแผ่นแปะออก"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒响起时，你的应用会暂停，直到你取下贴片。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर आने पर आपके ऐप्स तब तक रुके रहते हैं, जब तक आप पैच न हटा लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad stigne podsjetnik, tvoje aplikacije se pauziraju dok ne skineš flaster."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor megszólal az emlékeztető, az appjaid szünetelnek, amíg le nem veszed a tapaszt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatman geldiğinde, bandını çıkarana kadar uygulamaların duraklar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நினைவூட்டல் வரும்போது, நீங்கள் பேட்ச்சை அகற்றும் வரை உங்கள் ஆப்ஸ் இடைநிறுத்தப்படும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat pengingatmu berbunyi, aplikasimu dijeda sampai kamu melepas koyo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يحين تذكيرك، تتوقف تطبيقاتك مؤقتًا حتى تزيلي لصقتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשהתזכורת מגיעה, האפליקציות שלך מושהות עד שתסירי את המדבקה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi lời nhắc của bạn vang lên, ứng dụng của bạn tạm dừng cho đến khi bạn gỡ miếng dán."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডার এলে, প্যাচ না তোলা পর্যন্ত আপনার অ্যাপগুলো পজ থাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی آنے پر آپ کی ایپس تب تک رکی رہتی ہیں، جب تک آپ پیچ نہ اتار لیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko se oglasi opomnik, se tvoje aplikacije zaustavijo, dokler ne odstraniš obliža."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν χτυπήσει η υπενθύμιση, οι εφαρμογές σου μπαίνουν σε παύση μέχρι να βγάλεις το αυτοκόλλητό σου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రిమైండర్ వచ్చినప్పుడు, మీరు మీ ప్యాచ్ తీసివేసే వరకు మీ యాప్‌లు పాజ్ అవుతాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒響起時，你的 App 會暫停，直到你取下貼片。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇન્ડર વાગે ત્યારે, તમે પેચ ન કાઢો ત્યાં સુધી તમારી ઍપ્સ થોભેલી રહે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಜ್ಞಾಪನೆ ಬಂದಾಗ, ನೀವು ನಿಮ್ಮ ಪ್ಯಾಚ್ ತೆಗೆಯುವವರೆಗೆ ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳು ತಡೆಹಿಡಿಯಲ್ಪಡುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ റിമൈൻഡർ വരുമ്പോൾ, നിങ്ങൾ പാച്ച് നീക്കുന്നതുവരെ നിങ്ങളുടെ ആപ്പുകൾ പോസ് ആകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर आल्यावर, तुम्ही पॅच काढेपर्यंत तुमची ॲप्स थांबतात."
