        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت أيامك الـ 14 النشطة، لذا توقف حظر التطبيقات. تبقى التذكيرات مجانية إلى الأبد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "14 הימים הפעילים שלך הסתיימו, אז חסימת האפליקציות כבויה. התזכורות נשארות בחינם לתמיד."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "14 ngày uống của bạn đã hết, nên chặn ứng dụng đã tắt. Lời nhắc vẫn miễn phí mãi mãi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার 14 সক্রিয় দিন শেষ, তাই অ্যাপ ব্লকিং বন্ধ। রিমাইন্ডার সবসময় ফ্রি থাকবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے 14 فعال دن پورے ہو گئے، اس لیے ایپ بلاکنگ بند ہے۔ یاد دہانیاں ہمیشہ مفت رہیں گی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvojih 14 aktivnih dni je minilo, zato je blokiranje aplikacij izklopljeno. Opomniki ostanejo brezplačni za vedno."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι 14 ενεργές ημέρες σου τελείωσαν, οπότε ο αποκλεισμός εφαρμογών είναι ανενεργός. Οι υπενθυμίσεις μένουν δωρεάν για πάντα."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ 14 యాక్టివ్ రోజులు ముగిశాయి, అందుకే యాప్ బ్లాకింగ్ ఆఫ్‌లో ఉంది. రిమైండర్లు ఎప్పటికీ ఉచితం."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 14 個服藥日已結束，所以 App 封鎖已關閉。提醒永久免費。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા 14 સક્રિય દિવસ પૂરા થયા, તેથી ઍપ બ્લૉકિંગ બંધ છે. રિમાઇન્ડર હંમેશાં મફત રહેશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ 14 ಸಕ್ರಿಯ ದಿನಗಳು ಮುಗಿದಿವೆ, ಆದ್ದರಿಂದ ಆ್ಯಪ್ ನಿರ್ಬಂಧ ಆಫ್ ಆಗಿದೆ. ಜ್ಞಾಪನೆಗಳು ಎಂದೆಂದಿಗೂ ಉಚಿತ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ 14 സജീവ ദിനങ്ങൾ അവസാനിച്ചു, അതിനാൽ ആപ്പ് ബ്ലോക്കിംഗ് ഓഫാണ്. റിമൈൻഡറുകൾ എന്നും സൗജന്യമായി തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे 14 सक्रिय दिवस संपले, त्यामुळे ॲप ब्लॉकिंग बंद आहे. रिमाइंडर कायम मोफत राहतील."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ 14 ସକ୍ରିୟ ଦିନ ଶେଷ, ତେଣୁ ଆପ୍ ବ୍ଲକିଂ ବନ୍ଦ। ରିମାଇଣ୍ଡର୍ ସବୁଦିନ ମାଗଣା ରହିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ 14 ਸਰਗਰਮ ਦਿਨ ਖ਼ਤਮ ਹੋ ਗਏ, ਇਸ ਲਈ ਐਪ ਬਲੌਕਿੰਗ ਬੰਦ ਹੈ। ਰਿਮਾਈਂਡਰ ਹਮੇਸ਼ਾ ਮੁਫ਼ਤ ਰਹਿਣਗੇ।"
          }
        }
      }
    },
