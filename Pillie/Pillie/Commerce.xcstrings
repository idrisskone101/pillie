    "paywall.mockup.plus.blocking": {
      "comment": "Decorative phone on the purchase success screen, app blocking set up. %@ = reminder time e.g. 8:00 PM [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At %@ your chosen apps pause until you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %@ le app che hai scelto vanno in pausa finché non confermi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um %@ pausieren deine gewählten Apps, bis du abhakst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À %@, les apps choisies se mettent en pause jusqu’à ce que tu valides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A las %@, las apps que elegiste se pausan hasta que marques lo de hoy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Às %@, os apps escolhidos pausam até você registrar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om %@ pauzeren je gekozen apps tot je afvinkt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kl. %@ pausas dina valda appar tills du bockar av."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kl. %@ sættes dine valgte apps på pause, indtil du krydser af."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kl. %@ pauses appene du har valgt, til du krysser av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Klo %@ valitsemasi sovellukset menevät tauolle, kunnes kuittaat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Às %@, as apps escolhidas ficam em pausa até registares."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A les %@, les apps triades es posen en pausa fins que confirmis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ wybrane aplikacje się wstrzymają, aż odhaczysz dzień."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V %@ se vybrané aplikace pozastaví, dokud neodškrtneš dnešek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %@ выбранные приложения встанут на паузу, пока ты не отметишься."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "О %@ вибрані застосунки стануть на паузу, доки ти не відмітишся."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@になると、選んだアプリは記録するまで一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 선택한 앱이 체크할 때까지 일시 중지돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada pukul %@, apl pilihan kamu dijeda sehingga kamu sahkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La %@, aplicațiile alese intră pe pauză până bifezi ziua."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ sa vybrané aplikácie pozastavia, kým neodškrtneš dnešok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลา %@ แอปที่คุณเลือกจะหยุดชั่วคราวจนกว่าคุณจะเช็กอิน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到 %@ 时，你选的应用会暂停，直到你打卡。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर आपके चुने हुए ऐप्स दर्ज करने तक रुक जाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U %@ odabrane aplikacije pauziraju se dok se ne javiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-kor a kiválasztott appok szünetelnek, amíg ki nem pipálod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat %@ olunca seçtiğin uygulamalar, sen işaretleyene kadar duraklar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ மணிக்கு, நீங்கள் தேர்ந்தெடுத்த ஆப்ஸ் நீங்கள் பதிவு செய்யும் வரை இடைநிறுத்தப்படும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pukul %@, aplikasi pilihanmu dijeda sampai kamu check-in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %@ تتوقف التطبيقات التي اخترتِها مؤقتًا حتى تسجّلي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-%@ האפליקציות שבחרת יושהו עד שתסמני."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúc %@, các ứng dụng bạn chọn sẽ tạm dừng đến khi bạn điểm danh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ আপনার বাছাই করা অ্যাপগুলো টিক না দেওয়া পর্যন্ত পজ থাকবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ پر آپ کی چنی ہوئی ایپس درج کرنے تک رک جائیں گی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob %@ se izbrane aplikacije začasno zaustavijo, dokler ne odkljukaš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στις %@ οι εφαρμογές που επέλεξες μπαίνουν σε παύση μέχρι να το σημειώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@కి మీరు ఎంచుకున్న యాప్‌లు మీరు నమోదు చేసే వరకు పాజ్ అవుతాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到 %@ 時，你選的 App 會暫停，直到你打卡。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ વાગ્યે તમે પસંદ કરેલી ઍપ્સ, તમે નોંધ ન કરો ત્યાં સુધી થોભી જશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಗೆ ನೀವು ಆಯ್ಕೆ ಮಾಡಿದ ಆ್ಯಪ್‌ಗಳು ನೀವು ದಾಖಲಿಸುವವರೆಗೆ ತಡೆಹಿಡಿಯಲ್ಪಡುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ന് നിങ്ങൾ തിരഞ്ഞെടുത്ത ആപ്പുകൾ നിങ്ങൾ രേഖപ്പെടുത്തുന്നതുവരെ പോസ് ചെയ്യും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ वाजता तुम्ही निवडलेली ॲप्स तुम्ही नोंद करेपर्यंत थांबतील."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ରେ ଆପଣ ବାଛିଥିବା ଆପ୍ ଦର୍ଜ କରିବା ପର୍ଯ୍ୟନ୍ତ ବିରାମରେ ରହିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ’ਤੇ ਤੁਹਾਡੀਆਂ ਚੁਣੀਆਂ ਐਪਾਂ ਦਰਜ ਕਰਨ ਤੱਕ ਰੁਕ ਜਾਣਗੀਆਂ।"
          }
        }
      }
    },
    "paywall.mockup.plus.reminders": {
      "comment": "Decorative phone on the purchase success screen, app blocking not set up yet [paywall]",
      "localizations": {
        "en": {
