        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "14 ਸਰਗਰਮ ਦਿਨ ਮੁਫ਼ਤ, ਕਾਰਡ ਦੀ ਲੋੜ ਨਹੀਂ। ਟ੍ਰਾਇਲ ਤੋਂ ਬਾਅਦ ਐਪ ਬਲੌਕਿੰਗ ਬੰਦ ਹੋ ਜਾਂਦੀ ਹੈ। ਰਿਮਾਈਂਡਰ ਮੁਫ਼ਤ ਰਹਿੰਦੇ ਹਨ।"
          }
        }
      }
    },
    "trial.granted.disclosure.hard_paywall": {
      "comment": "Pre-trial duration and paid-access requirement for hard-paywall cohorts [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your free trial lasts 14 active days. No card needed. After it ends, choose monthly, annual, or lifetime to keep Plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova gratuita dura 14 giorni attivi. Non serve la carta. Quando finisce, scegli mensile, annuale o a vita per tenere Plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine kostenlose Testphase dauert 14 aktive Tage. Keine Karte nötig. Danach wählst du einen Monats-, Jahres- oder Lifetime-Tarif, um Plus zu behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton essai gratuit dure 14 jours actifs. Pas besoin de carte. Ensuite, choisis mensuel, annuel ou à vie pour garder Plus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba gratis dura 14 días activos. Sin tarjeta. Cuando termine, elige mensual, anual o de por vida para conservar Plus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste grátis dura 14 dias ativos. Sem cartão. Depois, escolha mensal, anual ou vitalício para manter o Plus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gratis proefperiode duurt 14 actieve dagen. Geen kaart nodig. Daarna kun je maandelijks, jaarlijks of lifetime kiezen om Plus te houden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din gratis provperiod är 14 aktiva dagar. Inget kort behövs. När den är slut väljer du månadsvis, årsvis eller livstid för att behålla Plus."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din gratis prøveperiode varer 14 aktive dage. Intet kort nødvendigt. Når den udløber, vælger du månedligt, årligt eller livstid for at beholde Plus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gratis prøveperioden varer i 14 aktive dager. Du trenger ikke kort. Når den er over, velger du månedlig, årlig eller livstid for å beholde Plus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen kokeilusi kestää 14 aktiivista päivää. Korttia ei tarvita. Kun se päättyy, valitse kuukausi-, vuosi- tai kertamaksu pitääksesi Plusin."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu período de teste grátis dura 14 dias ativos. Sem cartão. Quando terminar, escolhe mensal, anual ou vitalício para manteres o Plus."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva prova gratuïta dura 14 dies actius. No cal targeta. Quan s’acabi, tria mensual, anual o vitalici per conservar el Plus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpłatny okres próbny trwa 14 dni aktywnych. Bez karty. Potem wybierz plan miesięczny, roczny albo na zawsze, aby zachować Plus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební období zdarma trvá 14 aktivních dní. Bez karty. Po jeho skončení vyber měsíční, roční nebo trvalý plán a Plus si nech."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный пробный период длится 14 активных дней. Карта не нужна. После него выбери ежемесячный, годовой или пожизненный план, чтобы оставить Plus."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовний пробний період триває 14 активних днів. Картка не потрібна. Після нього вибери щомісячний, річний або довічний план, щоб лишити Plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアルは服用14日間。カード不要です。終了後は、月額、年額、または買い切りを選んでPlusを続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험은 복용 14일이에요. 카드는 필요 없어요. 체험이 끝나면 월간, 연간 또는 평생 이용권을 선택해 Plus를 유지할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percubaan percuma kamu berlangsung 14 hari aktif. Tanpa kad. Selepas tamat, pilih bulanan, tahunan atau seumur hidup untuk kekalkan Plus."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Perioada ta de probă gratuită durează 14 zile active. Fără card. După ce se termină, alege lunar, anual sau pe viață pentru a păstra Plus."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúšobné obdobie trvá 14 aktívnych dní. Bez karty. Potom si vyber mesačný, ročný alebo doživotný plán, ak si chceš Plus nechať."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงทดลองใช้ฟรีของคุณนาน 14 วันกินยา ไม่ต้องใช้บัตร หลังจากนั้นเลือกแบบรายเดือน รายปี หรือตลอดชีพ เพื่อใช้ Plus ต่อ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费试用为 14 个服药日。无需银行卡。结束后，选择月付、年付或终身版即可保留 Plus。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका मुफ़्त ट्रायल 14 सक्रिय दिनों का है। कार्ड की ज़रूरत नहीं। इसके ख़त्म होने पर, Plus जारी रखने के लिए मासिक, सालाना या लाइफ़टाइम चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje besplatno probno razdoblje traje 14 aktivnih dana. Kartica nije potrebna. Nakon toga odaberi mjesečno, godišnje ili doživotno da zadržiš Plus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ingyenes próbaidőszak 14 aktív napig tart. Kártya nem szükséges. Utána válassz havi, éves vagy örökös csomagot, hogy megtartsd a Plust."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz denemen 14 aktif gün sürer. Kart gerekmez. Bittiğinde Plus ile devam etmek için aylık, yıllık veya ömür boyu seç."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இலவச சோதனைக் காலம் 14 செயல் நாட்கள். கார்டு தேவையில்லை. அது முடிந்ததும், Plus-ஐத் தொடர மாதாந்திர, ஆண்டு அல்லது வாழ்நாள் திட்டத்தைத் தேர்ந்தெடுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Uji coba gratismu berlangsung 14 hari aktif. Tanpa kartu. Setelah berakhir, pilih bulanan, tahunan, atau seumur hidup untuk mempertahankan Plus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستمر فترتك التجريبية المجانية 14 يومًا نشطًا. بدون بطاقة. بعد انتهائها، اختاري الاشتراك الشهري أو السنوي أو مدى الحياة للاحتفاظ بـ Plus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקופת הניסיון החינמית שלך נמשכת 14 ימים פעילים. בלי צורך בכרטיס. בסיומה, בחרי חודשי, שנתי או לתמיד כדי לשמור על Plus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dùng thử miễn phí của bạn kéo dài 14 ngày uống. Không cần thẻ. Sau khi kết thúc, chọn gói hàng tháng, hàng năm hoặc trọn đời để giữ Plus."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফ্রি ট্রায়াল 14 সক্রিয় দিনের। কার্ড লাগবে না। শেষ হলে Plus রাখতে মাসিক, বার্ষিক বা লাইফটাইম বেছে নিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مفت ٹرائل 14 فعال دنوں کا ہے۔ کارڈ کی ضرورت نہیں۔ اس کے ختم ہونے پر، Plus جاری رکھنے کے لیے ماہانہ، سالانہ یا لائف ٹائم چنیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj brezplačni preizkus traja 14 aktivnih dni. Brez kartice. Po koncu izberi mesečno, letno ali trajno možnost, da obdržiš Plus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δωρεάν δοκιμή σου διαρκεί 14 ενεργές ημέρες. Χωρίς κάρτα. Όταν λήξει, διάλεξε μηνιαία, ετήσια ή εφ' όρου ζωής για να κρατήσεις το Plus."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఉచిత ట్రయల్ 14 యాక్టివ్ రోజులు ఉంటుంది. కార్డ్ అవసరం లేదు. అది ముగిశాక, Plus కొనసాగించడానికి నెలవారీ, వార్షిక లేదా జీవితకాల ప్లాన్ ఎంచుకోండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費試用為 14 個服藥日。不需信用卡。結束後，選擇月繳、年繳或終身版即可保留 Plus。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી મફત ટ્રાયલ 14 સક્રિય દિવસ ચાલે છે. કાર્ડની જરૂર નથી. તે પૂરી થાય પછી Plus રાખવા માસિક, વાર્ષિક અથવા લાઇફટાઇમ પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಉಚಿತ ಟ್ರಯಲ್ 14 ಸಕ್ರಿಯ ದಿನಗಳು. ಕಾರ್ಡ್ ಬೇಕಿಲ್ಲ. ಅದು ಮುಗಿದ ನಂತರ, Plus ಮುಂದುವರಿಸಲು ಮಾಸಿಕ, ವಾರ್ಷಿಕ ಅಥವಾ ಜೀವಮಾನದ ಯೋಜನೆಯನ್ನು ಆರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സൗജന്യ ട്രയൽ 14 സജീവ ദിനങ്ങളാണ്. കാർഡ് വേണ്ട. അത് അവസാനിച്ച ശേഷം, Plus തുടരാൻ പ്രതിമാസ, വാർഷിക അല്ലെങ്കിൽ ആജീവനാന്ത പ്ലാൻ തിരഞ്ഞെടുക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा मोफत ट्रायल 14 सक्रिय दिवसांचा आहे. कार्डची गरज नाही. तो संपल्यावर, Plus सुरू ठेवण्यासाठी मासिक, वार्षिक किंवा लाइफटाइम निवडा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ମାଗଣା ଟ୍ରାୟାଲ୍ 14 ସକ୍ରିୟ ଦିନ ଚାଲେ। କାର୍ଡ ଦରକାର ନାହିଁ। ଏହା ଶେଷ ହେବା ପରେ Plus ରଖିବାକୁ ମାସିକ, ବାର୍ଷିକ କିମ୍ବା ଆଜୀବନ ବାଛନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਮੁਫ਼ਤ ਟ੍ਰਾਇਲ 14 ਸਰਗਰਮ ਦਿਨ ਚੱਲਦਾ ਹੈ। ਕਾਰਡ ਦੀ ਲੋੜ ਨਹੀਂ। ਇਸਦੇ ਖ਼ਤਮ ਹੋਣ ਤੋਂ ਬਾਅਦ, Plus ਰੱਖਣ ਲਈ ਮਹੀਨਾਵਾਰ, ਸਾਲਾਨਾ ਜਾਂ ਲਾਈਫ਼ਟਾਈਮ ਚੁਣੋ।"
          }
        }
      }
    },
