    "trial.decline_feedback.thank_you": {
      "comment": "Brief non-blocking acknowledgment after the optional questionnaire is skipped.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks. Your feedback helps us make Pillie better."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie. Il tuo feedback ci aiuta a migliorare Pillie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke. Dein Feedback hilft uns, Pillie besser zu machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci. Ton retour nous aide à améliorer Pillie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias. Tus comentarios nos ayudan a mejorar Pillie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado. Seu feedback nos ajuda a melhorar o Pillie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt. Je feedback helpt ons Pillie beter te maken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack. Din feedback hjälper oss att göra Pillie bättre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak. Din feedback hjælper os med at gøre Pillie bedre."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk. Tilbakemeldingen din hjelper oss å gjøre Pillie bedre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiitos. Palautteesi auttaa meitä tekemään Pilliestä paremman."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado. O teu feedback ajuda-nos a melhorar o Pillie."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gràcies. Els teus comentaris ens ajuden a millorar Pillie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki. Twoja opinia pomaga nam ulepszać Pillie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Díky. Tvoje zpětná vazba nám pomáhá Pillie zlepšovat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо. Твой отзыв помогает нам делать Pillie лучше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дякуємо. Твій відгук допомагає нам робити Pillie кращим."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。フィードバックはPillieの改善に役立てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감사해요. 보내 주신 피드백은 Pillie를 더 좋게 만드는 데 도움이 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih. Maklum balas kamu membantu kami menjadikan Pillie lebih baik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulțumim. Feedbackul tău ne ajută să facem Pillie mai bun."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ďakujeme. Tvoja spätná väzba nám pomáha Pillie zlepšovať."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณ ความคิดเห็นของคุณช่วยให้เราทำให้ Pillie ดีขึ้น"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谢谢。你的反馈能帮助我们把 Pillie 做得更好。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धन्यवाद। आपकी राय से हम Pillie को बेहतर बनाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvala. Tvoje povratne informacije pomažu nam poboljšati Pillie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Köszönjük. A visszajelzésed segít jobbá tenni a Pillie-t."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teşekkürler. Geri bildirimin Pillie’yi daha iyi yapmamıza yardımcı oluyor."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நன்றி. உங்கள் கருத்து Pillie-ஐ மேம்படுத்த எங்களுக்கு உதவுகிறது."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih. Masukanmu membantu kami membuat Pillie lebih baik."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا. ملاحظاتك تساعدنا على تحسين Pillie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תודה. המשוב שלך עוזר לנו לשפר את Pillie."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn bạn. Góp ý của bạn giúp chúng mình làm Pillie tốt hơn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধন্যবাদ। আপনার মতামত Pillie-কে আরও ভালো করতে আমাদের সাহায্য করে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شکریہ۔ آپ کی رائے سے ہم Pillie کو بہتر بناتے ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvala. Tvoje povratne informacije nam pomagajo izboljšati Pillie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστούμε. Τα σχόλιά σου μάς βοηθούν να κάνουμε το Pillie καλύτερο."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ధన్యవాదాలు. మీ అభిప్రాయం Pillieని మెరుగుపరచడానికి మాకు సహాయపడుతుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謝謝。你的意見能幫助我們把 Pillie 做得更好。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આભાર. તમારો પ્રતિભાવ અમને Pillie ને વધુ સારું બનાવવામાં મદદ કરે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಧನ್ಯವಾದಗಳು. ನಿಮ್ಮ ಅಭಿಪ್ರಾಯ Pillie ಅನ್ನು ಉತ್ತಮಗೊಳಿಸಲು ನಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നന്ദി. Pillie മെച്ചപ്പെടുത്താൻ നിങ്ങളുടെ അഭിപ്രായം ഞങ്ങളെ സഹായിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "धन्यवाद. तुमच्या अभिप्रायामुळे आम्हाला Pillie अधिक चांगले करता येते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଧନ୍ୟବାଦ। ଆପଣଙ୍କ ମତାମତ Pillie କୁ ଉନ୍ନତ କରିବାରେ ଆମକୁ ସାହାଯ୍ୟ କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਧੰਨਵਾਦ। ਤੁਹਾਡੀ ਫ਼ੀਡਬੈਕ ਸਾਨੂੰ Pillie ਨੂੰ ਬਿਹਤਰ ਬਣਾਉਣ ਵਿੱਚ ਮਦਦ ਕਰਦੀ ਹੈ।"
          }
        }
      }
    },
    "paywall.upsell.smart_reminders.body": {
      "comment": "Smart Reminders plus-gate body [ENG-66]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie keeps reminding you until you check in. You pick how often and how many times."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie erinnert dich weiter, bis du abhakst. Du wählst den Abstand und die Anzahl."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie continua a ricordartelo finché non confermi. Scegli tu ogni quanto e quante volte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie continue de te rappeler jusqu’à ce que tu valides. Tu choisis la fréquence et le nombre de fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie te lo sigue recordando hasta que marques lo de hoy. Tú eliges cada cuánto y cuántas veces."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie continua te lembrando até você registrar. Você escolhe a frequência e quantas vezes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie blijft je herinneren tot je afvinkt. Jij kiest de tussentijd en het aantal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie fortsätter påminna dig tills du bockar av. Du väljer intervall och antal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie bliver ved med at minde dig om det, indtil du krydser af. Du vælger interval og antal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie fortsetter å minne deg på det til du krysser av. Du velger hvor ofte og hvor mange ganger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie muistuttaa uudelleen, kunnes kuittaat. Sinä valitset, kuinka usein ja kuinka monta kertaa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie continua a lembrar-te até registares. Tu escolhes com que frequência e quantas vezes."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie t’ho continua recordant fins que confirmis. Tu tries cada quant i quantes vegades."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie przypomina, dopóki nie odhaczysz dnia. Ty wybierasz, jak często i ile razy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ti připomíná, dokud neodškrtneš dnešek. Ty určíš, jak často a kolikrát."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie напоминает, пока ты не отметишься. Ты выбираешь, как часто и сколько раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie нагадує, доки ти не відмітишся. Ти обираєш, як часто і скільки разів."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieは記録するまでリマインドを続けます。間隔と回数はあなたが決められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie가 체크할 때까지 계속 알려 줘요. 얼마나 자주, 몇 번 알릴지 직접 정할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie terus mengingatkan kamu sehingga kamu sahkan. Kamu pilih berapa kerap dan berapa kali."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie îți tot amintește până bifezi ziua. Tu alegi cât de des și de câte ori."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ti pripomína, kým neodškrtneš dnešok. Ty si vyberieš, ako často a koľkokrát."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie จะเตือนคุณต่อไปจนกว่าคุณจะเช็กอิน คุณเลือกได้ว่าบ่อยแค่ไหนและกี่ครั้ง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 会一直提醒你，直到你打卡。提醒频率和次数由你决定。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie तब तक याद दिलाता रहता है जब तक आप दर्ज न कर लें। कितनी देर में और कितनी बार, यह आप चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie te podsjeća dok se ne javiš. Ti biraš koliko često i koliko puta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie addig emlékeztet, amíg ki nem pipálod. Te döntöd el, milyen gyakran és hányszor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie sen işaretleyene kadar hatırlatmaya devam eder. Ne sıklıkla ve kaç kez olacağını sen seçersin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பதிவு செய்யும் வரை Pillie நினைவூட்டிக்கொண்டே இருக்கும். எவ்வளவு அடிக்கடி, எத்தனை முறை என்று நீங்களே தேர்ந்தெடுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie terus mengingatkanmu sampai kamu check-in. Kamu yang tentukan seberapa sering dan berapa kali."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يواصل Pillie تذكيرك حتى تسجّلي. أنتِ تحددين الفاصل وعدد المرات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ממשיכה להזכיר לך עד שתסמני. את בוחרת כל כמה זמן וכמה פעמים."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie tiếp tục nhắc bạn đến khi bạn điểm danh. Bạn chọn tần suất và số lần."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টিক না দেওয়া পর্যন্ত Pillie আপনাকে মনে করিয়ে দিতে থাকে। কত ঘন ঘন আর কতবার, তা আপনিই ঠিক করেন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie تب تک یاد دلاتا رہتا ہے جب تک آپ درج نہ کر لیں۔ کتنی دیر بعد اور کتنی بار، یہ آپ چنیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie te opominja, dokler ne odkljukaš. Ti izbereš, kako pogosto in kolikokrat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pillie σού το θυμίζει μέχρι να το σημειώσεις. Εσύ διαλέγεις πόσο συχνά και πόσες φορές."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు నమోదు చేసే వరకు Pillie గుర్తు చేస్తూనే ఉంటుంది. ఎంత తరచుగా, ఎన్నిసార్లు అనేది మీరే ఎంచుకోండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 會一直提醒你，直到你打卡。提醒頻率和次數由你決定。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે નોંધ ન કરો ત્યાં સુધી Pillie યાદ અપાવતું રહે છે. કેટલી વારે અને કેટલી વાર, તે તમે નક્કી કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ದಾಖಲಿಸುವವರೆಗೆ Pillie ನೆನಪಿಸುತ್ತಲೇ ಇರುತ್ತದೆ. ಎಷ್ಟು ಬಾರಿ, ಎಷ್ಟು ಅಂತರದಲ್ಲಿ ಎಂದು ನೀವೇ ಆರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ രേഖപ്പെടുത്തുന്നതുവരെ Pillie ഓർമ്മിപ്പിച്ചുകൊണ്ടിരിക്കും. എത്ര ഇടവിട്ട്, എത്ര തവണ എന്ന് നിങ്ങൾ തന്നെ തിരഞ്ഞെടുക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही नोंद करेपर्यंत Pillie आठवण करून देत राहते. किती अंतराने आणि किती वेळा, हे तुम्ही ठरवा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦର୍ଜ କରିବା ପର୍ଯ୍ୟନ୍ତ Pillie ଆପଣଙ୍କୁ ମନେ ପକାଉଥାଏ। କେତେ ବ୍ୟବଧାନରେ ଓ କେତେ ଥର, ତାହା ଆପଣ ବାଛନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦਰਜ ਕਰਨ ਤੱਕ Pillie ਤੁਹਾਨੂੰ ਯਾਦ ਕਰਾਉਂਦਾ ਰਹਿੰਦਾ ਹੈ। ਕਿੰਨੇ ਸਮੇਂ ਬਾਅਦ ਅਤੇ ਕਿੰਨੀ ਵਾਰ, ਇਹ ਤੁਸੀਂ ਚੁਣਦੇ ਹੋ।"
          }
        }
      }
    },
    "paywall.upsell.app_blocking.body.pill": {
      "comment": "App blocking plus-gate body, pill [ENG-67]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your reminder goes off, your apps pause until you take your pill."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deine Erinnerung kommt, pausieren deine Apps, bis du deine Pille nimmst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando arriva il promemoria, le tue app vanno in pausa finché non prendi la pillola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand ton rappel sonne, tes apps se mettent en pause jusqu’à ce que tu prennes ta pilule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando suena tu recordatorio, tus apps se pausan hasta que tomes tu píldora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o lembrete toca, seus apps ficam pausados até você tomar sua pílula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je herinnering afgaat, pauzeren je apps tot je je pil neemt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När din påminnelse kommer pausas dina appar tills du tar ditt p-piller."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når din påmindelse kommer, sættes dine apps på pause, indtil du tager din p-pille."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når påminnelsen går av, pauses appene dine til du har tatt pillen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun muistutus tulee, sovelluksesi menevät tauolle, kunnes otat pillerisi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o lembrete toca, as tuas apps ficam em pausa até tomares a pílula."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan sona el recordatori, les teves apps es posen en pausa fins que prenguis la píndola."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy przyjdzie przypomnienie, aplikacje zostają wstrzymane, aż weźmiesz tabletkę."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přijde připomínka, tvoje aplikace se pozastaví, dokud si nevezmeš pilulku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда приходит напоминание, приложения встают на паузу, пока ты не примешь таблетку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли надходить нагадування, застосунки стають на паузу, доки ти не приймеш таблетку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーが鳴ると、ピルを飲むまでアプリが一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 울리면 피임약을 복용할 때까지 앱이 일시 중지돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila peringatan kamu berbunyi, apl kamu dijeda sehingga kamu ambil pil."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când sună mementoul, aplicațiile tale intră în pauză până îți iei pilula."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď príde pripomienka, tvoje aplikácie sa pozastavia, kým si nevezmeš tabletku."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อการแจ้งเตือนของคุณดังขึ้น แอปของคุณจะหยุดชั่วคราวจนกว่าคุณจะกินยาคุม"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒响起时，你的应用会暂停，直到你服用避孕药。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर आने पर आपके ऐप्स तब तक रुके रहते हैं, जब तक आप गोली न ले लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad stigne podsjetnik, tvoje aplikacije se pauziraju dok ne uzmeš pilulu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor megszólal az emlékeztető, az appjaid szünetelnek, amíg be nem veszed a tablettát."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatman geldiğinde, hapını alana kadar uygulamaların duraklar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நினைவூட்டல் வரும்போது, நீங்கள் மாத்திரையை எடுக்கும் வரை உங்கள் ஆப்ஸ் இடைநிறுத்தப்படும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat pengingatmu berbunyi, aplikasimu dijeda sampai kamu minum pil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يحين تذكيرك، تتوقف تطبيقاتك مؤقتًا حتى تأخذي حبتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשהתזכורת מגיעה, האפליקציות שלך מושהות עד שתיקחי את הגלולה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi lời nhắc của bạn vang lên, ứng dụng của bạn tạm dừng cho đến khi bạn uống thuốc."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডার এলে, পিল না খাওয়া পর্যন্ত আপনার অ্যাপগুলো পজ থাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی آنے پر آپ کی ایپس تب تک رکی رہتی ہیں، جب تک آپ گولی نہ لے لیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko se oglasi opomnik, se tvoje aplikacije zaustavijo, dokler ne vzameš tabletke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν χτυπήσει η υπενθύμιση, οι εφαρμογές σου μπαίνουν σε παύση μέχρι να πάρεις το χάπι σου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రిమైండర్ వచ్చినప్పుడు, మీరు మీ మాత్ర తీసుకునే వరకు మీ యాప్‌లు పాజ్ అవుతాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒響起時，你的 App 會暫停，直到你服用避孕藥。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇન્ડર વાગે ત્યારે, તમે ગોળી ન લો ત્યાં સુધી તમારી ઍપ્સ થોભેલી રહે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಜ್ಞಾಪನೆ ಬಂದಾಗ, ನೀವು ನಿಮ್ಮ ಮಾತ್ರೆ ತೆಗೆದುಕೊಳ್ಳುವವರೆಗೆ ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳು ತಡೆಹಿಡಿಯಲ್ಪಡುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ റിമൈൻഡർ വരുമ്പോൾ, നിങ്ങൾ ഗുളിക കഴിക്കുന്നതുവരെ നിങ്ങളുടെ ആപ്പുകൾ പോസ് ആകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर आल्यावर, तुम्ही गोळी घेईपर्यंत तुमची ॲप्स थांबतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ଆସିଲେ, ଆପଣ ପିଲ୍ ନଖାଇବା ପର୍ଯ୍ୟନ୍ତ ଆପଣଙ୍କ ଆପ୍ ବିରାମରେ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਈਂਡਰ ਆਉਣ ’ਤੇ, ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਗੋਲੀ ਨਹੀਂ ਲੈਂਦੇ, ਤੁਹਾਡੀਆਂ ਐਪਾਂ ਰੁਕੀਆਂ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        }
      }
    },
    "paywall.upsell.app_blocking.body.patch.apply": {
      "comment": "App blocking plus-gate body, apply patch [ENG-67]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your reminder goes off, your apps pause until you apply your patch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deine Erinnerung kommt, pausieren deine Apps, bis du dein Pflaster aufklebst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando arriva il promemoria, le tue app vanno in pausa finché non applichi il cerotto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand ton rappel sonne, tes apps se mettent en pause jusqu’à ce que tu poses ton patch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando suena tu recordatorio, tus apps se pausan hasta que coloques tu parche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o lembrete toca, seus apps ficam pausados até você aplicar seu adesivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je herinnering afgaat, pauzeren je apps tot je je pleister plakt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När din påminnelse kommer pausas dina appar tills du sätter på ditt plåster."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når din påmindelse kommer, sættes dine apps på pause, indtil du sætter dit plaster på."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når påminnelsen går av, pauses appene dine til du har satt på plasteret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun muistutus tulee, sovelluksesi menevät tauolle, kunnes kiinnität laastarisi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o lembrete toca, as tuas apps ficam em pausa até colocares o adesivo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan sona el recordatori, les teves apps es posen en pausa fins que et posis el pegat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy przyjdzie przypomnienie, aplikacje zostają wstrzymane, aż przykleisz plaster."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přijde připomínka, tvoje aplikace se pozastaví, dokud si nenalepíš náplast."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда приходит напоминание, приложения встают на паузу, пока ты не наклеишь пластырь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли надходить нагадування, застосунки стають на паузу, доки ти не наклеїш пластир."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーが鳴ると、パッチを貼るまでアプリが一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 울리면 패치를 붙일 때까지 앱이 일시 중지돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila peringatan kamu berbunyi, apl kamu dijeda sehingga kamu lekatkan tampalan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când sună mementoul, aplicațiile tale intră în pauză până îți aplici plasturele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď príde pripomienka, tvoje aplikácie sa pozastavia, kým si nenalepíš náplasť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อการแจ้งเตือนของคุณดังขึ้น แอปของคุณจะหยุดชั่วคราวจนกว่าคุณจะแปะแผ่นแปะ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒响起时，你的应用会暂停，直到你贴上贴片。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर आने पर आपके ऐप्स तब तक रुके रहते हैं, जब तक आप पैच न लगा लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad stigne podsjetnik, tvoje aplikacije se pauziraju dok ne nalijepiš flaster."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor megszólal az emlékeztető, az appjaid szünetelnek, amíg fel nem helyezed a tapaszt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatman geldiğinde, bandını yapıştırana kadar uygulamaların duraklar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நினைவூட்டல் வரும்போது, நீங்கள் பேட்ச்சை ஒட்டும் வரை உங்கள் ஆப்ஸ் இடைநிறுத்தப்படும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat pengingatmu berbunyi, aplikasimu dijeda sampai kamu memasang koyo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يحين تذكيرك، تتوقف تطبيقاتك مؤقتًا حتى تضعي لصقتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשהתזכורת מגיעה, האפליקציות שלך מושהות עד שתדביקי את המדבקה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi lời nhắc của bạn vang lên, ứng dụng của bạn tạm dừng cho đến khi bạn dán miếng dán."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডার এলে, প্যাচ না লাগানো পর্যন্ত আপনার অ্যাপগুলো পজ থাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی آنے پر آپ کی ایپس تب تک رکی رہتی ہیں، جب تک آپ پیچ نہ لگا لیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko se oglasi opomnik, se tvoje aplikacije zaustavijo, dokler ne nalepiš obliža."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν χτυπήσει η υπενθύμιση, οι εφαρμογές σου μπαίνουν σε παύση μέχρι να βάλεις το αυτοκόλλητό σου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రిమైండర్ వచ్చినప్పుడు, మీరు మీ ప్యాచ్ అతికించే వరకు మీ యాప్‌లు పాజ్ అవుతాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒響起時，你的 App 會暫停，直到你貼上貼片。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇન્ડર વાગે ત્યારે, તમે પેચ ન લગાવો ત્યાં સુધી તમારી ઍપ્સ થોભેલી રહે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಜ್ಞಾಪನೆ ಬಂದಾಗ, ನೀವು ನಿಮ್ಮ ಪ್ಯಾಚ್ ಅಂಟಿಸುವವರೆಗೆ ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳು ತಡೆಹಿಡಿಯಲ್ಪಡುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ റിമൈൻഡർ വരുമ്പോൾ, നിങ്ങൾ പാച്ച് ഒട്ടിക്കുന്നതുവരെ നിങ്ങളുടെ ആപ്പുകൾ പോസ് ആകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर आल्यावर, तुम्ही पॅच लावेपर्यंत तुमची ॲप्स थांबतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ଆସିଲେ, ଆପଣ ପ୍ୟାଚ୍ ନଲଗାଇବା ପର୍ଯ୍ୟନ୍ତ ଆପଣଙ୍କ ଆପ୍ ବିରାମରେ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਈਂਡਰ ਆਉਣ ’ਤੇ, ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਪੈਚ ਨਹੀਂ ਲਾਉਂਦੇ, ਤੁਹਾਡੀਆਂ ਐਪਾਂ ਰੁਕੀਆਂ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        }
      }
    },
