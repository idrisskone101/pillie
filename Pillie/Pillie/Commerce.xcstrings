        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择月付、年付或终身版，继续使用 Pillie。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie इस्तेमाल करते रहने के लिए मासिक, वार्षिक या लाइफ़टाइम चुनो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi mjesečno, godišnje ili doživotno da nastaviš koristiti Pillie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz havi, éves vagy örökös csomagot, hogy tovább használhasd a Pillie-t."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie'yi kullanmaya devam etmek için aylık, yıllık veya ömür boyu seç."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie-ஐத் தொடர்ந்து பயன்படுத்த மாதாந்திர, ஆண்டு அல்லது வாழ்நாள் திட்டத்தைத் தேர்ந்தெடு."
