    "trial.granted.warning.detail": {
      "comment": "Detail for the pre-expiry warning [trial granted]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll remind you before your trial ends. No surprises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avviseremo prima della fine della prova. Nessuna sorpresa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor deine Testphase endet, geben wir dir rechtzeitig Bescheid. Ohne Überraschungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On te préviendra avant la fin de ton essai. Pas de surprise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisaremos antes de que termine tu prueba. Sin sorpresas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos avisar antes do fim do período de teste. Sem surpresas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We herinneren je voordat je proefperiode eindigt. Geen verrassingen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi påminner dig innan provperioden tar slut. Inga överraskningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi minder dig om det, før din prøveperiode udløber. Ingen overraskelser."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi minner deg på det før prøveperioden slutter. Ingen overraskelser."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistutamme sinua ennen kokeilun päättymistä. Ei yllätyksiä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisamos-te antes de o teu período de teste terminar. Sem surpresas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "T’avisarem abans que s’acabi el teu període de prova. Sense sorpreses."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnimy ci przed końcem okresu próbnego. Bez niespodzianek."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před koncem zkušebního období ti dáme vědět. Žádná překvapení."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы напомним до окончания пробного периода. Без сюрпризов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми нагадаємо до завершення пробного періоду. Без сюрпризів."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアル終了前にお知らせします。突然の変更はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험이 끝나기 전에 알려 드릴게요. 갑작스러운 일은 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan ingatkan kamu sebelum percubaan tamat. Tiada kejutan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți vom aminti înainte să se termine perioada de probă. Fără surprize."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred koncom skúšobného obdobia ti dáme vedieť. Žiadne prekvapenia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะเตือนคุณก่อนช่วงทดลองใช้จะสิ้นสุด ไม่มีเซอร์ไพรส์"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用结束前我们会提醒你。不会有意外。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रायल ख़त्म होने से पहले हम तुम्हें याद दिला देंगे। कोई सरप्राइज़ नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetit ćemo te prije kraja probnog razdoblja. Bez iznenađenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A próbaidőszak vége előtt emlékeztetünk. Nincs meglepetés."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme süren bitmeden önce sana haber veririz. Sürpriz yok."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் சோதனைக் காலம் முடிவதற்கு முன் நினைவூட்டுவோம். ஆச்சரியங்கள் இல்லை."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan mengingatkanmu sebelum masa uji coba berakhir. Tanpa kejutan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنذكّرك قبل انتهاء الفترة التجريبية. بلا مفاجآت."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נזכיר לך לפני שתקופת הניסיון מסתיימת. בלי הפתעות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng mình sẽ nhắc bạn trước khi bản dùng thử kết thúc. Không có bất ngờ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রায়াল শেষ হওয়ার আগে মনে করিয়ে দেব। কোনো চমক নেই।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرائل ختم ہونے سے پہلے ہم تمہیں یاد دلائیں گے۔ کوئی سرپرائز نہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred koncem preizkusa te bomo opomnili. Brez presenečenj."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα σου το θυμίσουμε πριν λήξει η δοκιμή. Χωρίς εκπλήξεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ ట్రయల్ ముగిసేముందు గుర్తు చేస్తాం. ఆశ్చర్యాలు ఉండవు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用結束前我們會提醒你。不會有意外。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટ્રાયલ ખ઼ત્મ હોને સે પહલે હમ તું્હેં યાદ દિલા દેંગે। કોઈ સરપ્રાઇજ઼ નહીં।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ ಟ್ರಯಲ್ ಮುಗಿಸೇಮುಂದು ಗುರ್ತು ಚೇಸ್ತಾಂ. ಆಶ್ಕೆಲಸಾಲು ಉಂಡವು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ട്രയൽ അവസാനിക്കുന്നതിന് മുമ്പ് ഞങ്ങൾ ഓർമ്മിപ്പിക്കും. ആശ്ചര്യങ്ങളില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रायल ख़त्म होने पासून आधी हम तुला याद दिला देंगे। कोई सरप्राइज़ नाही।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଟ୍ରାୟାଲ୍ ଶେଷ ହେବା ଆଗରୁ ଆମେ ମନେ ପକାଇବୁ। କୌଣସି ଚମକ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟ੍ਰਾਯਲ ਖ਼ਤ੍ਮ ਹੋਨੇ ਸੇ ਪਹਲੇ ਹਮ ਤੈਨੂੰ ਯਾਦ ਦਿਲਾ ਦੇਂਗੇ। ਕੋਈ ਸਰਪ੍ਰਾਇਜ਼ ਨਹੀਂ।"
          }
        }
      }
    },
