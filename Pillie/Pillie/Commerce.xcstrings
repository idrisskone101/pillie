      "comment": "Alert body [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No active subscription was found for this account."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato trovato alcun abbonamento attivo per questo account."
          }
        }
      }
    },
    "trial.granted.title": {
      "comment": "Trial duration must match StoreKit offer [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next two weeks with Pillie Plus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prossime due settimane con Pillie Plus"
          }
        }
      }
    },
    "trial.granted.subtitle": {
      "comment": "No “full” overclaim [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Pillie Plus trial starts now. Here is what is included."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova di Pillie Plus inizia ora. Ecco cosa include."
          }
        }
      }
    },
