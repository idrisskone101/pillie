    "paywall.upsell.smart_reminders.body": {
      "comment": "Smart Reminders plus-gate body [ENG-66]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps pinging until you log today. You pick how often, how many, and the last ping."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pingt weiter, bis du heute einträgst. Du wählst wie oft, wie viele, und den letzten Ping."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a mandare ping finché non registri oggi. Scegli ogni quanto, quanti, e l'ultimo ping."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue de ping jusqu'à ce que tu inscrives aujourd'hui. Tu choisis la fréquence, le nombre et le dernier ping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue avisando hasta que registres hoy. Tú eliges la frecuencia, cuántos y el último aviso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua enviando pings até você registrar hoje. Você escolhe a frequência, a quantidade e o último ping."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijft pingen tot je vandaag bijhoudt. Jij kiest hoe vaak, hoeveel en de laatste ping."
          }
        }
      }
    },
    "paywall.upsell.app_blocking.body.pill": {
      "comment": "App blocking plus-gate body, pill [ENG-67]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your apps pause when the reminder is due, until you take your pill."
