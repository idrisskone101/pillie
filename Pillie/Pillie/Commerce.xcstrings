        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple Hesabı için etkin bir abonelik bulamadık."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Apple கணக்கிற்கு செயலில் உள்ள சந்தா எதையும் எங்களால் கண்டறிய முடியவில்லை."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak menemukan langganan aktif untuk Akun Apple ini."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نجد اشتراكًا نشطًا لحساب Apple هذا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא מצאנו מינוי פעיל לחשבון Apple הזה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng mình không tìm thấy gói đăng ký nào đang hoạt động cho Tài khoản Apple này."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Apple অ্যাকাউন্টে কোনো সক্রিয় সাবস্ক্রিপশন খুঁজে পাওয়া যায়নি।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Apple اکاؤنٹ کے لیے کوئی جاری سبسکرپشن نہیں ملی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ta Apple račun nismo našli aktivne naročnine."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρήκαμε ενεργή συνδρομή για αυτόν τον Λογαριασμό Apple."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ Apple ఖాతాకు యాక్టివ్ సబ్‌స్క్రిప్షన్ ఏదీ మాకు కనిపించలేదు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到此 Apple 帳號的有效訂閱。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ Apple એકાઉન્ટ માટે અમને કોઈ સક્રિય સબ્સ્ક્રિપ્શન મળ્યું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ Apple ಖಾತೆಗೆ ಯಾವುದೇ ಸಕ್ರಿಯ ಚಂದಾದಾರಿಕೆ ನಮಗೆ ಸಿಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ Apple അക്കൗണ്ടിൽ സജീവമായ സബ്‌സ്‌ക്രിപ്‌ഷൻ ഒന്നും ഞങ്ങൾ കണ്ടെത്തിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या Apple खात्यासाठी कोणतेही चालू सबस्क्रिप्शन सापडले नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି Apple ଆକାଉଣ୍ଟ ପାଇଁ ଆମେ କୌଣସି ସକ୍ରିୟ ସବସ୍କ୍ରିପସନ୍ ପାଇଲୁ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ Apple ਖਾਤੇ ਲਈ ਸਾਨੂੰ ਕੋਈ ਸਰਗਰਮ ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਨਹੀਂ ਮਿਲੀ।"
          }
        }
      }
    },
