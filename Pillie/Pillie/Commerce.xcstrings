    "paywall.subtitle": {
      "comment": "Functionality only [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus keeps reminding you until you check in, and can pause the apps that distract you."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus continua a ricordartelo finché non confermi e può mettere in pausa le app che ti distraggono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus erinnert dich weiter, bis du abhakst, und kann die Apps pausieren, die dich ablenken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus continue de te rappeler jusqu’à ce que tu valides, et peut mettre en pause les apps qui te distraient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus te lo sigue recordando hasta que marques lo de hoy, y puede pausar las apps que te distraen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Plus continua te lembrando até você registrar e pode pausar os apps que te distraem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus blijft je herinneren tot je afvinkt, en kan de apps pauzeren die je afleiden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus fortsätter påminna dig tills du bockar av, och kan pausa apparna som distraherar dig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus bliver ved med at minde dig om det, indtil du krydser af, og kan sætte de apps, der distraherer dig, på pause."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus fortsetter å minne deg på det til du krysser av, og kan pause appene som distraherer deg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus muistuttaa uudelleen, kunnes kuittaat, ja voi laittaa häiritsevät sovellukset tauolle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Plus continua a lembrar-te até registares e pode pausar as apps que te distraem."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Plus t’ho continua recordant fins que confirmis i pot posar en pausa les apps que et distreuen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus przypomina, dopóki nie odhaczysz dnia, i może wstrzymać aplikacje, które cię rozpraszają."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus ti připomíná, dokud neodškrtneš dnešek, a umí pozastavit aplikace, které tě rozptylují."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus напоминает, пока ты не отметишься, и может ставить на паузу приложения, которые тебя отвлекают."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus нагадує, доки ти не відмітишся, і може ставити на паузу застосунки, які тебе відволікають."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusなら、記録するまでリマインドを続け、気が散るアプリを一時停止することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus는 체크할 때까지 계속 알려 주고, 방해되는 앱을 일시 중지할 수도 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus terus mengingatkan kamu sehingga kamu sahkan, dan boleh menjeda apl yang mengalihkan perhatian kamu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus îți tot amintește până bifezi ziua și poate pune pe pauză aplicațiile care te distrag."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus ti pripomína, kým neodškrtneš dnešok, a vie pozastaviť aplikácie, ktoré ťa rozptyľujú."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus จะเตือนคุณต่อไปจนกว่าคุณจะเช็กอิน และหยุดแอปที่ทำให้คุณเสียสมาธิชั่วคราวได้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus 会一直提醒你，直到你打卡，还能暂停让你分心的应用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus तब तक याद दिलाता रहता है जब तक आप दर्ज न कर लें, और ध्यान भटकाने वाले ऐप्स रोक सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus te podsjeća sve dok se ne javiš i može pauzirati aplikacije koje te ometaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Plus addig emlékeztet, amíg ki nem pipálod, és szüneteltetni tudja a figyelmedet elterelő appokat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus sen işaretleyene kadar hatırlatmaya devam eder ve dikkatini dağıtan uygulamaları duraklatabilir."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பதிவு செய்யும் வரை Plus உங்களுக்கு நினைவூட்டிக்கொண்டே இருக்கும், கவனத்தைச் சிதறடிக்கும் ஆப்ஸையும் இடைநிறுத்தலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus terus mengingatkanmu sampai kamu check-in, dan bisa menjeda aplikasi yang mengalihkan perhatianmu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يواصل Plus تذكيرك حتى تسجّلي، ويمكنه إيقاف التطبيقات التي تشتّتك مؤقتًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus ממשיך להזכיר לך עד שתסמני, ויכול להשהות את האפליקציות שמסיחות את דעתך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tiếp tục nhắc bạn đến khi bạn điểm danh, và có thể tạm dừng các ứng dụng làm bạn xao nhãng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টিক না দেওয়া পর্যন্ত Plus আপনাকে মনে করিয়ে দিতে থাকে, আর মনোযোগ কাড়া অ্যাপগুলো পজ করতে পারে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus تب تک یاد دلاتا رہتا ہے جب تک آپ درج نہ کر لیں، اور توجہ ہٹانے والی ایپس روک سکتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus te opominja, dokler ne odkljukaš, in lahko začasno zaustavi aplikacije, ki te motijo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Plus σού το θυμίζει μέχρι να το σημειώσεις και μπορεί να βάζει σε παύση τις εφαρμογές που σε αποσπούν."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు నమోదు చేసే వరకు Plus మీకు గుర్తు చేస్తూనే ఉంటుంది, దృష్టి మళ్లించే యాప్‌లను పాజ్ కూడా చేయగలదు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus 會一直提醒你，直到你打卡，還能暫停讓你分心的 App。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે નોંધ ન કરો ત્યાં સુધી Plus યાદ અપાવતું રહે છે, અને ધ્યાન ભટકાવતી ઍપ્સ થોભાવી શકે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ದಾಖಲಿಸುವವರೆಗೆ Plus ನಿಮಗೆ ನೆನಪಿಸುತ್ತಲೇ ಇರುತ್ತದೆ, ಮತ್ತು ಗಮನ ಸೆಳೆಯುವ ಆ್ಯಪ್‌ಗಳನ್ನು ತಡೆಹಿಡಿಯಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ രേഖപ്പെടുത്തുന്നതുവരെ Plus നിങ്ങളെ ഓർമ്മിപ്പിച്ചുകൊണ്ടിരിക്കും, ശ്രദ്ധ തിരിക്കുന്ന ആപ്പുകൾ പോസ് ചെയ്യാനും കഴിയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही नोंद करेपर्यंत Plus आठवण करून देत राहते, आणि लक्ष विचलित करणारी ॲप्स थांबवू शकते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦର୍ଜ କରିବା ପର୍ଯ୍ୟନ୍ତ Plus ଆପଣଙ୍କୁ ମନେ ପକାଉଥାଏ, ଏବଂ ଧ୍ୟାନ ଭାଙ୍ଗୁଥିବା ଆପ୍ ବିରାମ କରିପାରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦਰਜ ਕਰਨ ਤੱਕ Plus ਤੁਹਾਨੂੰ ਯਾਦ ਕਰਾਉਂਦਾ ਰਹਿੰਦਾ ਹੈ, ਅਤੇ ਧਿਆਨ ਭਟਕਾਉਣ ਵਾਲੀਆਂ ਐਪਾਂ ਰੋਕ ਸਕਦਾ ਹੈ।"
          }
        }
      }
    },
