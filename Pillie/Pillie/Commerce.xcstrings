        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "14 நாட்கள் இலவசம், கார்டு தேவையில்லை. சோதனைக் காலத்திற்குப் பிறகு ஆப் இடைநிறுத்தம் ஆஃப் ஆகும். நினைவூட்டல்கள் இலவசமாகவே இருக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis 14 hari, tanpa kartu. Jeda aplikasi mati setelah uji coba. Pengingat tetap gratis."
          }
        },
        "ar": {
