        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮರು ಜ್ಞಾಪನೆಗಳು ಮತ್ತು ಆ್ಯಪ್ ನಿರ್ಬಂಧ ಬೇಕಾದರೆ, Pillie Plus ನಲ್ಲಿ ಮುಂದುವರಿಯಿರಿ."
