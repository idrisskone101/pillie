    "notification.followup.body": {
      "comment": "No judgement or urgency [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s action is still open. Log it when you’re ready."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’azione di oggi è ancora da registrare. Fallo quando vuoi."
          }
        }
      }
    },
    "notification.followup.title": {
      "comment": "Neutral title [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
