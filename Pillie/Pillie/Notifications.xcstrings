    "notification.custom.gentle.followup": {
      "comment": "Default preset [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you’re ready, remember to check in today."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando vuoi, ricordati di confermare oggi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du so weit bist, denk daran, heute abzuhaken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu veux, pense à valider aujourd’hui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando puedas, recuerda marcar lo de hoy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando puder, lembre de registrar hoje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je er klaar voor bent, denk eraan om vandaag af te vinken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du är redo, kom ihåg att bocka av i dag."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du er klar, så husk at krydse af i dag."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du er klar, husk å krysse av i dag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun olet valmis, muista kuitata tänään."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando puderes, lembra-te de registar hoje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan estiguis a punt, recorda confirmar avui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy będzie ci pasować, pamiętaj, aby odhaczyć dzisiejszy dzień."
