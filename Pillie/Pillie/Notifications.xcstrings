    "notification.trial_expiry.day10.body": {
      "comment": "Reverse Trial day-10 warning; app-blocking scope only [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App blocking turns off in 5 days. Your daily reminders stay free."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco app si disattiva tra 5 giorni. I promemoria giornalieri restano gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Sperre geht in 5 Tagen aus. Deine täglichen Erinnerungen bleiben kostenlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le blocage d’apps se désactive dans 5 jours. Tes rappels quotidiens restent gratuits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo de apps se desactiva en 5 días. Tus recordatorios diarios siguen siendo gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio de apps desliga em 5 dias. Seus lembretes diários continuam grátis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblokkering gaat over 5 dagen uit. Je dagelijkse herinneringen blijven gratis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblockering stängs av om 5 dagar. Dina dagliga påminnelser är fortfarande gratis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblokering slås fra om 5 dage. Dine daglige påmindelser forbliver gratis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblokkering slås av om 5 dager. De daglige påminnelsene dine forblir gratis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellusesto menee pois päältä 5 päivän kuluttua. Päivittäiset muistutuksesi pysyvät ilmaisina."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio de apps desliga-se daqui a 5 dias. Os teus lembretes diários continuam grátis."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueig d’apps es desactiva d’aquí a 5 dies. Els recordatoris diaris continuen sent gratis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokowanie aplikacji wyłączy się za 5 dni. Codzienne przypomnienia zostają za darmo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokování aplikací se vypne za 5 dní. Denní připomínky zůstávají zdarma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка приложений отключится через 5 дней. Ежедневные напоминания останутся бесплатными."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокування застосунків вимкнеться через 5 днів. Щоденні нагадування лишаться безкоштовними."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリブロックは5日後にオフになります。毎日のリマインダーは引き続き無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 차단이 5일 후에 꺼져요. 매일 알림은 계속 무료예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekatan apl dimatikan dalam 5 hari. Peringatan harian kamu kekal percuma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocarea aplicațiilor se oprește în 5 zile. Mementourile zilnice rămân gratuite."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokovanie aplikácií sa vypne o 5 dní. Denné pripomienky zostávajú zdarma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบล็อกแอปจะปิดในอีก 5 วัน การแจ้งเตือนประจำวันของคุณยังฟรี"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用屏蔽将在 5 天后关闭。你的每日提醒继续免费。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप ब्लॉकिंग 5 दिन में बंद हो जाएगी। आपके रोज़ के रिमाइंडर मुफ़्त रहेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje aplikacija isključuje se za 5 dana. Tvoji dnevni podsjetnici ostaju besplatni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appblokkolás 5 nap múlva kikapcsol. A napi emlékeztetőid ingyenesek maradnak."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama engelleme 5 gün sonra kapanıyor. Günlük hatırlatmaların ücretsiz kalır."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப் தடுப்பு 5 நாட்களில் ஆஃப் ஆகும். உங்கள் தினசரி நினைவூட்டல்கள் இலவசமாகவே இருக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokir aplikasi mati dalam 5 hari. Pengingat harianmu tetap gratis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف حظر التطبيقات بعد 5 أيام. تبقى تذكيراتك اليومية مجانية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חסימת האפליקציות תיכבה בעוד 5 ימים. התזכורות היומיות שלך נשארות בחינם."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chặn ứng dụng sẽ tắt sau 5 ngày. Lời nhắc hàng ngày của bạn vẫn miễn phí."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "5 দিন পর অ্যাপ ব্লকিং বন্ধ হবে। আপনার দৈনিক রিমাইন্ডার ফ্রি-ই থাকবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ بلاکنگ 5 دن میں بند ہو جائے گی۔ آپ کی روزانہ کی یاد دہانیاں مفت رہیں گی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje aplikacij se izklopi čez 5 dni. Tvoji dnevni opomniki ostanejo brezplačni."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αποκλεισμός εφαρμογών απενεργοποιείται σε 5 ημέρες. Οι καθημερινές υπενθυμίσεις σου μένουν δωρεάν."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్ బ్లాకింగ్ 5 రోజుల్లో ఆఫ్ అవుతుంది. మీ రోజువారీ రిమైండర్లు ఉచితంగానే ఉంటాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 封鎖將在 5 天後關閉。你的每日提醒繼續免費。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપ બ્લૉકિંગ 5 દિવસમાં બંધ થશે. તમારાં રોજનાં રિમાઇન્ડર મફત જ રહેશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್ ನಿರ್ಬಂಧ 5 ದಿನಗಳಲ್ಲಿ ಆಫ್ ಆಗುತ್ತದೆ. ನಿಮ್ಮ ದೈನಂದಿನ ಜ್ಞಾಪನೆಗಳು ಉಚಿತವಾಗಿಯೇ ಇರುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് ബ്ലോക്കിംഗ് 5 ദിവസത്തിനുള്ളിൽ ഓഫാകും. നിങ്ങളുടെ ദൈനംദിന റിമൈൻഡറുകൾ സൗജന്യമായി തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ॲप ब्लॉकिंग 5 दिवसांत बंद होईल. तुमचे रोजचे रिमाइंडर मोफत राहतील."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "5 ଦିନ ପରେ ଆପ୍ ବ୍ଲକିଂ ବନ୍ଦ ହେବ। ଆପଣଙ୍କ ଦୈନିକ ରିମାଇଣ୍ଡର୍ ମାଗଣା ରହିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਬਲੌਕਿੰਗ 5 ਦਿਨਾਂ ਵਿੱਚ ਬੰਦ ਹੋ ਜਾਵੇਗੀ। ਤੁਹਾਡੇ ਰੋਜ਼ਾਨਾ ਰਿਮਾਈਂਡਰ ਮੁਫ਼ਤ ਹੀ ਰਹਿਣਗੇ।"
          }
        }
      }
    },
