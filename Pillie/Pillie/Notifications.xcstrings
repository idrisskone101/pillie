    "notification.followup.body": {
      "comment": "No judgement or urgency [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven’t checked in yet. Tap here when you’re done."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora confermato. Tocca qui quando hai fatto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast noch nicht abgehakt. Tippe hier, wenn du fertig bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n’as pas encore validé. Touche ici quand c’est fait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no lo has marcado. Toca aquí cuando termines."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não registrou. Toque aqui quando terminar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt nog niet afgevinkt. Tik hier als je klaar bent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har inte bockat av än. Tryck här när du är klar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke krydset af endnu. Tryk her, når du er færdig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke krysset av ennå. Trykk her når du er ferdig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ole vielä kuitannut. Napauta tästä, kun olet valmis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não registaste. Toca aqui quando terminares."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no has confirmat. Toca aquí quan ho hagis fet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień czeka jeszcze na odhaczenie. Stuknij tutaj, gdy skończysz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnešek ještě není odškrtnutý. Klepni sem, až to budeš mít za sebou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты ещё не отметилась. Коснись здесь, когда закончишь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти ще не відмітилася. Торкнись тут, коли закінчиш."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ記録していません。済んだらここをタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 체크하지 않았어요. 다 했으면 여기를 탭하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu belum sahkan. Ketik di sini apabila sudah selesai."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă n-ai bifat ziua. Atinge aici când ai terminat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnešok ešte nie je odškrtnutý. Ťukni sem, keď to budeš mať za sebou."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังไม่ได้เช็กอิน แตะที่นี่เมื่อทำเสร็จแล้ว"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没打卡。完成后点按这里。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अभी दर्ज नहीं किया। हो जाने पर यहाँ टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema tvog javljanja. Dodirni ovdje kad završiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem pipáltad ki. Koppints ide, ha megvagy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz işaretlemedin. Bitirdiğinde buraya dokun."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இன்னும் பதிவு செய்யவில்லை. முடித்ததும் இங்கே தட்டுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu belum check-in. Ketuk di sini kalau sudah selesai."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تسجّلي بعد. انقري هنا عند الانتهاء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוד לא סימנת. הקישי כאן כשתסיימי."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa điểm danh. Chạm vào đây khi bạn xong nhé."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এখনো টিক দেননি। হয়ে গেলে এখানে ট্যাপ করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے ابھی درج نہیں کیا۔ ہو جانے پر یہاں ٹیپ کریں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kljukice še ni. Tapni tukaj, ko končaš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν το έχεις σημειώσει ακόμα. Πάτα εδώ όταν τελειώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇంకా నమోదు చేయలేదు. పూర్తయ్యాక ఇక్కడ నొక్కండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你還沒打卡。完成後點一下這裡。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે હજુ નોંધ કરી નથી. થઈ જાય એટલે અહીં ટૅપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಇನ್ನೂ ದಾಖಲಿಸಿಲ್ಲ. ಮುಗಿಸಿದ ನಂತರ ಇಲ್ಲಿ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇതുവരെ രേഖപ്പെടുത്തിയിട്ടില്ല. കഴിഞ്ഞാൽ ഇവിടെ ടാപ്പ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची नोंद अजून झालेली नाही. झाल्यावर इथे टॅप करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଏପର୍ଯ୍ୟନ୍ତ ଦର୍ଜ କରିନାହାଁନ୍ତି। ହୋଇଗଲେ ଏଠାରେ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਅਜੇ ਦਰਜ ਨਹੀਂ ਕੀਤਾ। ਹੋ ਜਾਣ ’ਤੇ ਇੱਥੇ ਟੈਪ ਕਰੋ।"
          }
        }
      }
    },
