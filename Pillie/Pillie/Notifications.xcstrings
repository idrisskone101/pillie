    "notification.reminder.pill.body": {
      "comment": "Reminder, not advice [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey, quick check-in. Log your pill when you're done"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehi, check-in veloce. Registrala quando hai finito"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey, kurzer Check-in. Trag deine Pille ein, wenn du fertig bist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey, petit check-in. Inscris ta pilule quand tu as fini"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oye, check-in rápido. Registra tu píldora cuando termines"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei, check-in rápido. Registre sua pílula quando terminar"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey, snelle check-in. Houd je pil bij wanneer je klaar bent"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, snabb incheckning. Logga ditt p-piller när du är klar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, hurtig indtjekning. Log din p-pille, når du er færdig"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei, rask innsjekk. Logg pillen når du har tatt den"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei, nopea kuittaus. Kirjaa pillerisi, kun olet ottanut sen"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá, registo rápido. Regista a tua pílula quando a tomares"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei, registre ràpid. Registra la píndola quan l’hagis pres"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, krótkie potwierdzenie. Zapisz tabletkę, gdy ją weźmiesz"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, rychlé potvrzení. Až si pilulku vezmeš, zaznamenej ji"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привет, быстрая отметка. Отметь таблетку, когда примешь"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Привіт, швидка відмітка. Відміть таблетку, коли приймеш"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こんにちは、さっとチェックイン。飲んだらピルを記録してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕, 짧은 체크인이에요. 다 먹었으면 피임약을 기록해요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei, pengesahan ringkas. Rekod pil kamu selepas selesai"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei, o confirmare rapidă. Înregistrează-ți pilula când ai luat-o"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, rýchle potvrdenie. Zaznamenaj tabletku, keď ju užiješ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฮ้ เช็กอินสั้น ๆ หน่อย บันทึกยาคุมเมื่อกินเสร็จนะ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嘿，快速打卡。服完药后记录一下"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हे, झटपट चेक-इन। गोली लेकर लॉग कर दो"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, kratka potvrda. Zabilježi pilulu kad je uzmeš"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hé, gyors bejelölés. Rögzítsd a tablettát, ha bevetted"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey, kısa kayıt. Bitirdiğinde hapını kaydet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஹே, விரைவு செக்-இன். முடிந்ததும் உன் மாத்திரையைப் பதிவு செய்"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei, check-in singkat. Catat pilmu kalau sudah diminum"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا، تسجيل سريع. سجّلي حبتك عند الانتهاء"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היי, דיווח קצר. רשמי את הגלולה כשסיימת"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Này, điểm danh nhanh nhé. Ghi lại khi bạn uống thuốc xong"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হেই, ছোট চেক-ইন। খাওয়া হলে পিল লগ করো"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہیلو، فوری چیک اِن۔ لے لینے کے بعد اپنی گولی لاگ کرو"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, hitra potrditev. Zabeleži tabletko, ko jo vzameš"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έι, γρήγορη επιβεβαίωση. Καταγράψε το χάπι σου όταν το πάρεις"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హే, త్వరిత చెక్-ఇన్. అయ్యాక నీ మాత్రను నమోదు చేయి"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘿，快速打卡。吃完藥後記錄一下"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હે, ઝટપટ ચેક-ઇન। ગોળી લેકર લૉગ કર દો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೇ, ತ್ವರಿತ ಚೆಕ್-ಇನ್. ಅಯ್ಯಾಕ ನಿನ್ನ ಮಾತ್ರೆನು ನೋಂದಣಿ ಚೇಯಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചെറിയ രേഖ. ഗുളിക കഴിക്കൂ രേഖപ്പെടുത്തൂ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ए, छोटी नोंद. झाल्यावर गोळी नोंद"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ହେ, ଛୋଟ ଚେକ୍-ଇନ୍। ପିଲ୍ ନେଇ ଲଗ୍ କର"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੇ, ਝਟਪਟ ਚੇਕ-ਇਨ। ਗੋਲੀ ਲੇਕਰ ਲਾਗ ਕਰ ਦੋ"
          }
        }
      }
    },
