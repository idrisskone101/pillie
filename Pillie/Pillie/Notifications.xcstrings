        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли будеш готова, не забудь відмітитися сьогодні."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備ができたら、今日の記録を忘れずに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비되면 오늘 체크하는 것 잊지 마세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
