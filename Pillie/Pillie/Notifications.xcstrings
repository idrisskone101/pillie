    "notification.winback.slot2.body": {
      "comment": "ENG-173 win-back push after a hard-paywall trial ends",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت التذكيرات عند انتهاء فترتك التجريبية. انقري لاستعادتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রায়াল শেষ হওয়ায় রিমাইন্ডার থেমে গেছে। ফিরিয়ে আনতে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els recordatoris es van aturar quan es va acabar la prova. Toca per recuperar-los."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připomínky se vypnuly, když skončilo zkušební období. Klepni a vrátíš je."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Påmindelserne stoppede, da din prøveperiode sluttede. Tryk for at få dem tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Ende deiner Testphase haben die Erinnerungen aufgehört. Tippe, um sie zurückzuholen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι υπενθυμίσεις σταμάτησαν όταν τελείωσε η δοκιμή σου. Πάτα για να τις φέρεις πίσω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders stopped when your trial ended. Tap to bring them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios se detuvieron al terminar tu prueba. Toca para recuperarlos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistutukset loppuivat, kun kokeilusi päättyi. Napauta, niin saat ne takaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels se sont arrêtés à la fin de ton essai. Touche pour les réactiver."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટ્રાયલ પૂરી થતાં રિમાઇન્ડર બંધ થયાં. તેમને પાછાં લાવવા ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התזכורות נפסקו כשתקופת הניסיון הסתיימה. הקישי כדי להחזיר אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रायल ख़त्म होने पर रिमाइंडर रुक गए। उन्हें वापस लाने के लिए टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnici su prestali kad je probno razdoblje završilo. Dodirni da ih vratiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emlékeztetők leálltak, amikor lejárt a próbaidőszakod. Koppints, és kapcsold vissza őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat berhenti saat uji cobamu berakhir. Ketuk untuk menyalakannya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria si sono fermati quando è finita la prova. Tocca per farli tornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルの終了とともに、リマインダーは止まりました。タップすると再開できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟ್ರಯಲ್ ಮುಗಿದಾಗ ಜ್ಞಾಪನೆಗಳು ನಿಂತವು. ಅವುಗಳನ್ನು ಮರಳಿ ತರಲು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험이 끝나면서 알림이 멈췄어요. 탭해서 다시 켜세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ട്രയൽ അവസാനിച്ചപ്പോൾ റിമൈൻഡറുകൾ നിലച്ചു. അവ തിരികെ കൊണ്ടുവരാൻ ടാപ്പ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रायल संपल्यावर रिमाइंडर थांबले. ते परत आणण्यासाठी टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan berhenti apabila percubaan kamu tamat. Ketik untuk mendapatkannya semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelsene stoppet da prøveperioden din sluttet. Trykk for å få dem tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herinneringen stopten toen je proefperiode afliep. Tik om ze terug te halen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଟ୍ରାୟାଲ୍ ଶେଷ ହେବାରୁ ରିମାଇଣ୍ଡର୍ ବନ୍ଦ ହୋଇଗଲା। ସେଗୁଡ଼ିକ ଫେରାଇ ଆଣିବାକୁ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟ੍ਰਾਇਲ ਖ਼ਤਮ ਹੋਣ ’ਤੇ ਰਿਮਾਈਂਡਰ ਰੁਕ ਗਏ। ਇਨ੍ਹਾਂ ਨੂੰ ਵਾਪਸ ਲਿਆਉਣ ਲਈ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia wyłączyły się, gdy skończył się okres próbny. Stuknij, aby je przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes pararam quando seu teste terminou. Toque para trazê-los de volta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes pararam quando o teu teste terminou. Toca para os recuperares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mementourile s-au oprit când s-a încheiat proba. Atinge ca să le readuci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания остановились, когда закончился пробный период. Коснись, чтобы вернуть их."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomienky sa vypli, keď sa skončilo skúšobné obdobie. Ťukni a vrátiš ich späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opomniki so se ustavili, ko se je preizkus končal. Tapni, da jih vrneš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelserna slutade när din provperiod tog slut. Tryck för att få tillbaka dem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சோதனைக் காலம் முடிந்ததும் நினைவூட்டல்கள் நின்றுவிட்டன. அவற்றைத் திரும்பப் பெறத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రయల్ ముగిసినప్పుడు రిమైండర్లు ఆగిపోయాయి. వాటిని తిరిగి తేవడానికి నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนหยุดไปเมื่อช่วงทดลองใช้สิ้นสุด แตะเพื่อเปิดกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme süren bitince hatırlatmalar durdu. Geri getirmek için dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування зупинилися, коли завершився пробний період. Торкнись, щоб їх повернути."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرائل ختم ہونے پر یاد دہانیاں رک گئیں۔ انہیں واپس لانے کے لیے ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc đã dừng khi bản dùng thử kết thúc. Chạm để bật lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用结束后，提醒就停止了。点按即可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用結束後，提醒就停止了。點一下即可恢復。"
          }
        }
      }
    },
