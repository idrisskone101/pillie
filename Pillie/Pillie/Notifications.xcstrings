    },
    "notification.custom.gentle.final": {
      "comment": "Default preset [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One last reminder is scheduled for today."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per oggi è programmato un ultimo promemoria."
          }
        }
      }
    },
    "notification.custom.gentle.followup": {
      "comment": "Default preset [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you’re ready, remember to log today’s action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando vuoi, ricorda di registrare l’azione di oggi."
          }
        }
