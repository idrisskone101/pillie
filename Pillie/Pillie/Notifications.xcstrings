        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, den snabba incheckningen är fortfarande öppen. Checka in när du är redo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, den hurtige indtjekning er stadig åben. Tjek ind, når du er klar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei, den raske innsjekken er fortsatt åpen. Sjekk inn når du er klar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei, nopea kuittaus on yhä avoinna. Kuittaa, kun olet valmis"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá, o registo rápido ainda está em aberto. Regista quando estiveres pronta"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei, el registre ràpid encara està pendent. Registra quan estiguis a punt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, krótkie potwierdzenie wciąż czeka. Potwierdź, gdy będzie ci pasować"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, rychlé potvrzení je stále otevřené. Potvrď, až se ti to bude hodit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привет, быстрая отметка ещё не сделана. Отметься, когда будет удобно"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Привіт, швидку відмітку ще не зроблено. Відміться, коли буде зручно"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こんにちは、さっとチェックインがまだです。準備ができたらチェックインしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕, 짧은 체크인이 아직 남아 있어요. 준비되면 체크인해요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei, pengesahan ringkas masih belum selesai. Sahkan bila kamu bersedia"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei, confirmarea rapidă e încă deschisă. Confirmă când ești gata"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, rýchle potvrdenie je stále otvorené. Potvrď, keď budeš mať chvíľu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฮ้ เช็กอินสั้น ๆ ยังค้างอยู่นะ เช็กอินได้เมื่อคุณพร้อม"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嘿，快速打卡还没完成。准备好了就打卡吧"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हे, झटपट चेक-इन अभी बाक़ी है। जब तैयार हो, चेक-इन करो"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, kratka potvrda još je otvorena. Potvrdi kad budeš spremna"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hé, a gyors bejelölés még nyitva van. Jelöld be, amikor készen állsz"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey, kısa kayıt hâlâ açık. Hazır olduğunda kaydını yap"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஹே, விரைவு செக்-இன் இன்னும் நிலுவையில் உள்ளது. தயாரானதும் செக்-இன் செய்"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei, check-in singkatnya masih belum selesai. Check-in kalau sudah siap"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا، التسجيل السريع ما زال مفتوحًا. سجّلي عندما تكونين مستعدة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היי, הדיווח הקצר עדיין פתוח. דווחי כשתהיי מוכנה"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Này, điểm danh nhanh vẫn chưa xong. Điểm danh khi bạn sẵn sàng nhé"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হেই, ছোট চেক-ইনটা এখনো বাকি। প্রস্তুত হলে চেক-ইন করো"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہیلو، فوری چیک اِن ابھی باقی ہے۔ جب تیار ہو، چیک اِن کر لو"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, hitra potrditev je še odprta. Potrdi, kadar ti ustreza"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έι, η γρήγορη επιβεβαίωση είναι ακόμα ανοιχτή. Επιβεβαίωσε όποτε μπορείς"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హే, త్వరిత చెక్-ఇన్ ఇంకా పెండింగ్‌లో ఉంది. సిద్ధమైనప్పుడు చెక్-ఇన్ చేయి"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘿，快速打卡還沒完成。準備好了就打卡吧"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હે, ઝટપટ ચેક-ઇન હમણાં બાક઼ી છે। જ્યારે તૈયાર હો, ચેક-ઇન કર"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೇ, ತ್ವರಿತ ಚೆಕ್-ಇನ್ ಇಂಕಾ ಪೆಂಡಿಂಗ್‌ಲೋ ಉಂದಿ. ಸಿದ್ಧಮೈನಪ್ಪುಡು ಚೆಕ್-ಇನ್ ಚೇಯಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചെറിയ രേഖ ബാക്കി. തയ്യാറാകുമ്പോൾ രേഖപ്പെടുത്തൂ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ए, छोटी नोंद अजून उघडी आहे. तयार झाल्यावर नोंद कर"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ହେ, ଛୋଟ ଚେକ୍-ଇନ୍ ବାକି। ପ୍ରସ୍ତୁତ ହେଲେ ଚେକ୍-ଇନ୍ କର"
