        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מלאי המדבקות שלך מתמעט. הגיע הזמן לתכנן חידוש."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miếng dán của bạn sắp hết. Đến lúc lên kế hoạch mua thêm."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্যাচের মজুত কমে আসছে। নতুন করে কেনার পরিকল্পনা করার সময় হয়েছে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے پیچ کا ذخیرہ کم ہو رہا ہے۔ دوبارہ لانے کی تیاری کر لیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloga obližev ti pohaja. Čas je, da načrtuješ novo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το απόθεμα αυτοκόλλητων σου τελειώνει. Ώρα να φροντίσεις για καινούργιο."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్యాచ్ నిల్వ తగ్గుతోంది. మళ్లీ తెచ్చుకోవడానికి ప్లాన్ చేసుకునే సమయం."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的貼片快用完了。該準備補充了。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો પેચનો સ્ટૉક ઓછો થઈ રહ્યો છે. ફરી લાવવાનું આયોજન કરવાનો સમય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪ್ಯಾಚ್‌ಗಳ ಸಂಗ್ರಹ ಕಡಿಮೆಯಾಗುತ್ತಿದೆ. ಮತ್ತೆ ತರಿಸಿಕೊಳ್ಳಲು ಯೋಜಿಸುವ ಸಮಯ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പാച്ച് സ്‌റ്റോക്ക് കുറഞ്ഞുവരുന്നു. വീണ്ടും വാങ്ങാൻ പ്ലാൻ ചെയ്യാനുള്ള സമയമായി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा पॅचचा साठा कमी होत आहे. पुन्हा आणायची तयारी करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ପ୍ୟାଚ୍ ଷ୍ଟକ୍ କମ୍ ହେଉଛି। ନୂଆ କିଣିବା ପାଇଁ ଯୋଜନା କରିବାର ସମୟ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਪੈਚਾਂ ਦਾ ਸਟਾਕ ਘੱਟ ਹੋ ਰਿਹਾ ਹੈ। ਹੋਰ ਲਿਆਉਣ ਦੀ ਯੋਜਨਾ ਬਣਾਉਣ ਦਾ ਸਮਾਂ ਹੈ।"
          }
        }
      }
    },
