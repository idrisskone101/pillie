        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדביקי את המדבקה, ואז הקישי כאן כדי לסמן."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán miếng dán, rồi chạm vào đây để điểm danh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্যাচ লাগান, তারপর টিক দিতে এখানে ট্যাপ করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا پیچ لگائیں، پھر درج کرنے کے لیے یہاں ٹیپ کریں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nalepi obliž, nato tapni tukaj in odkljukaj."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλε το αυτοκόλλητό σου και μετά πάτα εδώ για να το σημειώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్యాచ్ అతికించండి, ఆ తర్వాత నమోదు చేయడానికి ఇక్కడ నొక్కండి."
