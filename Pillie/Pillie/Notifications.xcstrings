    "notification.refill.ring.body": {
      "comment": "Issue #233 method-aware notification",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current ring supply may be running low. Check it when convenient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scorte attuali di anelli potrebbero essere quasi terminate. Controllale quando puoi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ringvorrat könnte bald zur Neige gehen. Prüfe ihn bei Gelegenheit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton stock d'anneau est peut-être bas. Vérifie quand tu peux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suministro de anillos podría estar bajo. Revísalo cuando te convenga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu estoque de anéis pode estar acabando. Verifique quando for conveniente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ringvoorraad raakt mogelijk op. Controleer het wanneer het uitkomt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt ringförråd kan börja ta slut. Kolla det när det passar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din ringbeholdning er måske ved at være lav. Tjek den, når det passer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringbeholdningen din kan begynne å bli lav. Sjekk den når det passer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rengasvarastosi saattaa olla vähissä. Tarkista se, kun sinulle sopii."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua reserva atual de anéis pode estar a acabar. Verifica quando te der jeito."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva reserva actual d’anells pot estar a punt d’acabar-se. Revisa-la quan et vagi bé."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zapas krążków może się kończyć. Sprawdź go, gdy będzie ci wygodnie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje zásoba kroužků možná dochází. Zkontroluj ji, až se ti to bude hodit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой запас колец, возможно, заканчивается. Проверь, когда будет удобно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій запас кілець, можливо, закінчується. Перевір, коли буде зручно."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リングの残量が少なくなっているかもしれません。都合のよいときに確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링 재고가 얼마 남지 않았을 수 있어요. 편할 때 확인해 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekalan cincin kamu mungkin semakin berkurang. Semak bila senang."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerva ta de inele s-ar putea să fie pe terminate. Verifică-o când ai ocazia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja zásoba krúžkov sa možno míňa. Skontroluj ju, keď sa ti to hodí."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วงแหวนคงเหลือของคุณอาจใกล้หมด ลองเช็กดูเมื่อสะดวก"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前的阴道环库存可能快用完了。方便时检查一下。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारा रिंग स्टॉक कम हो रहा हो सकता है। सुविधा से चेक कर लो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja zaliha prstena možda je pri kraju. Provjeri je kad ti odgovara."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyűrűkészleted fogytán lehet. Nézd meg, amikor alkalmas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Halka stoğun azalıyor olabilir. Uygun bir zamanda kontrol et."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் தற்போதைய ரிங் இருப்பு குறைந்திருக்கலாம். வசதியான நேரத்தில் சரிபார்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stok cincinmu mungkin mulai menipis. Cek kalau sempat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكون مخزون الحلقات الحالي على وشك النفاد. تحققي منه عندما يناسبك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מלאי הטבעות הנוכחי שלך אולי מתחיל להיגמר. בדקי אותו כשנוח לך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vòng của bạn có thể sắp hết. Kiểm tra khi tiện."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার রিংয়ের মজুত কমে আসতে পারে। সুবিধামতো চেক করে নাও।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہارا رِنگ کا ذخیرہ کم ہو رہا ہو سکتا ہے۔ فرصت میں چیک کر لو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja zaloga obročkov bo morda kmalu pošla. Preveri jo, ko ti ustreza."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το απόθεμα δακτυλίων σου ίσως τελειώνει. Έλεγξέ το όποτε σε βολεύει."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ ప్రస్తుత రింగ్ నిల్వ తగ్గిపోతూ ఉండవచ్చు. వీలైనప్పుడు చెక్ చేసుకో."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前的陰道環庫存可能快用完了。方便時檢查一下。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તારા રિંગ સ્ટૉક કમ હો રહા હો સકતા છે। સુવિધા સે ચેક કર લો।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ ಪ್ರಸ್ತುತ ರಿಂಗ್ ನಿಲ್ವ ತಗ್ಗಿಪೋತೂ ಉಂಡವಚ್ಚು. ವೀಲೈನಪ್ಪುಡು ಚೆಕ್ ಚೇಸುಕೋ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിംഗ് സ്‌റ്റോക്ക് റിമൈൻഡർ. നോക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रिंग साठा कमी असू शकतो. सोयीनुसार तपास."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର ରିଙ୍ଗ ଷ୍ଟକ୍ କମ୍ ହେଉଥାଇପାରେ। ସୁବିଧାରେ ଯାଞ୍ଚ କର।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੇਰਾ ਰਿਂਗ ਸ੍ਟੌਕ ਕਮ ਹੋ ਰਹਾ ਹੋ ਸਕਦਾ ਹੈ। ਸੁਵਿਧਾ ਸੇ ਚੇਕ ਕਰ ਲੋ।"
          }
        }
      }
    },
