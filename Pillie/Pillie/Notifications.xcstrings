    "notification.reminder.patch.apply.body": {
      "comment": "Notification copy [notification.reminder.patch.apply.body]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply your patch, then tap here to check in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klebe dein Pflaster auf, dann tippe hier zum Abhaken."
          }
        },
        "it": {
          "stringUnit": {
