    "notification.winback.slot2.challenger.body": {
      "comment": "ENG-173 win-back push after a hard-paywall trial ends",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلك فقط في موعد تذكيرك السابق في %@. انقري لاستعادته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানেই আগে আপনার %@-এর রিমাইন্ডার আসত। ফিরিয়ে আনতে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només surt on abans hi havia el recordatori de les %@. Toca per recuperar-lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen tu dřív bývala tvoje připomínka v %@. Klepni a vrátíš ji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kommer bare der, hvor din påmindelse kl. %@ plejede at være. Tryk for at få den tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie steht nur da, wo sonst deine Erinnerung um %@ stand. Tippe, um sie zurückzuholen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απλώς στις %@ ερχόταν η υπενθύμισή σου. Πάτα για να τη φέρεις πίσω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It’s just where your %@ reminder used to be. Tap to bring it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo ocupa el lugar de tu recordatorio de las %@. Toca para recuperarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän aikaan, klo %@, tuli ennen muistutuksesi. Napauta, niin saat sen takaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tombe juste là où ton rappel de %@ arrivait avant. Touche pour le réactiver."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અહીં જ પહેલાં તમારું %@નું રિમાઇન્ડર આવતું હતું. તેને પાછું લાવવા ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פשוט כאן הייתה התזכורת שלך ב-%@. הקישי כדי להחזיר אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस यहीं पहले आपका %@ वाला रिमाइंडर आता था। उसे वापस लाने के लिए टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U %@ ti je prije stizao podsjetnik, samo to. Dodirni da ga vratiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak eddig ilyenkor, %@-kor jött az emlékeztetőd. Koppints, és kapcsold vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini cuma muncul di jam pengingatmu dulu, pukul %@. Ketuk untuk menyalakannya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriva solo dove prima c’era il tuo promemoria delle %@. Tocca per farlo tornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前%@にリマインダーが届いていた時間なので、お知らせしただけです。タップで元に戻せます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ %@ ಜ್ಞಾಪನೆ ಮೊದಲು ಇಲ್ಲೇ ಬರುತ್ತಿತ್ತು. ಅದನ್ನು ಮರಳಿ ತರಲು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
