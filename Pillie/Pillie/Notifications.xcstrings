        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் %@ நினைவூட்டல் முன்பு வந்த இடம் இதுதான். அதைத் திரும்பப் பெறத் தட்டுங்கள்."
