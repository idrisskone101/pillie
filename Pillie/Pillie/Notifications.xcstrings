    "notification.refill.body": {
      "comment": "Estimate; no pharmacy claim [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pill supply is getting low. Time to plan a refill."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pillole stanno finendo. È ora di pensare al rifornimento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Pillenvorrat wird knapp. Zeit, Nachschub zu planen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton stock de pilules baisse. Pense à en racheter bientôt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te quedan pocas píldoras. Es buen momento para reponer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu estoque de pílulas está acabando. Hora de planejar a reposição."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je pilvoorraad raakt op. Tijd om een nieuwe voorraad te regelen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt p-pillerförråd börjar ta slut. Dags att planera påfyllning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din p-pillebeholdning er ved at slippe op. Tid til at sørge for mere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillebeholdningen din begynner å bli lav. Tid for å planlegge påfyll."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillerivarastosi alkaa olla vähissä. On aika suunnitella täydennystä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua reserva de pílulas está a acabar. Está na altura de planear a reposição."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Et queden poques píndoles. És hora de pensar a reposar-ne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kończy ci się zapas tabletek. Czas pomyśleć o uzupełnieniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásoba pilulek ti dochází. Je čas naplánovat doplnění."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запас таблеток подходит к концу. Пора запланировать пополнение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запас таблеток закінчується. Час запланувати поповнення."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピルの残りが少なくなってきました。補充の準備をしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피임약이 얼마 남지 않았어요. 미리 준비해 두세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekalan pil kamu semakin berkurang. Masa untuk rancang tambah stok."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerva ta de pilule e pe terminate. E timpul să-ți plănuiești următoarea rezervă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásoba tabletiek sa ti míňa. Je čas naplánovať doplnenie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยาคุมของคุณใกล้หมดแล้ว ถึงเวลาวางแผนซื้อเพิ่ม"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的避孕药快用完了。该准备补充了。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका गोली स्टॉक कम हो रहा है। दोबारा लाने की तैयारी कर लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaliha pilula ti je pri kraju. Vrijeme je da isplaniraš nabavu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fogy a tablettakészleted. Ideje a pótlásra gondolni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hap stoğun azalıyor. Yenisini planlama zamanı."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மாத்திரை இருப்பு குறைந்து வருகிறது. மீண்டும் வாங்கத் திட்டமிடும் நேரம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stok pilmu mulai menipis. Saatnya rencanakan beli lagi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مخزون حبوبك بدأ ينفد. حان وقت التخطيط لإعادة التعبئة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מלאי הגלולות שלך מתמעט. הגיע הזמן לתכנן חידוש."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thuốc của bạn sắp hết. Đến lúc lên kế hoạch mua thêm."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পিলের মজুত কমে আসছে। নতুন করে কেনার পরিকল্পনা করার সময় হয়েছে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی گولیوں کا ذخیرہ کم ہو رہا ہے۔ دوبارہ لانے کی تیاری کر لیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloga tabletk ti pohaja. Čas je, da načrtuješ novo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το απόθεμα χαπιών σου τελειώνει. Ώρα να φροντίσεις για καινούργιο."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ మాత్రల నిల్వ తగ్గుతోంది. మళ్లీ తెచ్చుకోవడానికి ప్లాన్ చేసుకునే సమయం."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的避孕藥快用完了。該準備補充了。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો ગોળીનો સ્ટૉક ઓછો થઈ રહ્યો છે. ફરી લાવવાનું આયોજન કરવાનો સમય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮಾತ್ರೆಗಳ ಸಂಗ್ರಹ ಕಡಿಮೆಯಾಗುತ್ತಿದೆ. ಮತ್ತೆ ತರಿಸಿಕೊಳ್ಳಲು ಯೋಜಿಸುವ ಸಮಯ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഗുളിക സ്‌റ്റോക്ക് കുറഞ്ഞുവരുന്നു. വീണ്ടും വാങ്ങാൻ പ്ലാൻ ചെയ്യാനുള്ള സമയമായി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा गोळ्यांचा साठा कमी होत आहे. पुन्हा आणायची तयारी करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ପିଲ୍ ଷ୍ଟକ୍ କମ୍ ହେଉଛି। ନୂଆ କିଣିବା ପାଇଁ ଯୋଜନା କରିବାର ସମୟ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਗੋਲੀਆਂ ਦਾ ਸਟਾਕ ਘੱਟ ਹੋ ਰਿਹਾ ਹੈ। ਹੋਰ ਲਿਆਉਣ ਦੀ ਯੋਜਨਾ ਬਣਾਉਣ ਦਾ ਸਮਾਂ ਹੈ।"
          }
        }
      }
    },
