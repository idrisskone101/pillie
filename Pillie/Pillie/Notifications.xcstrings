    "notification.active_resume.body": {
      "comment": "Reminder statement [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next active-day reminder follows the time you selected."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prossimo promemoria per un giorno attivo seguirà l’orario scelto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine nächste Erinnerung für einen aktiven Tag folgt der ausgewählten Uhrzeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton prochain rappel de jour actif suit l'heure que tu as choisie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu próximo recordatorio de día activo sigue la hora que seleccionaste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu próximo lembrete de dia ativo segue o horário que você selecionou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je volgende herinnering op een actieve dag volgt het door jou gekozen tijdstip."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nästa påminnelse för en aktiv dag följer den tid du valt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din næste påmindelse på en aktiv dag følger det tidspunkt, du valgte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den neste påminnelsen på en aktiv dag følger tidspunktet du valgte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraava aktiivisen päivän muistutuksesi tulee valitsemaasi aikaan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu próximo lembrete de dia ativo segue a hora que selecionaste."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu pròxim recordatori de dia actiu segueix l’hora que has seleccionat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następne przypomnienie w dniu aktywnym przyjdzie o wybranej godzinie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Další připomínka v aktivní den přijde ve zvolený čas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующее напоминание активного дня придёт в выбранное тобой время."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наступне нагадування активного дня надійде у вибраний тобою час."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の服用日のリマインダーは、選んだ時間に届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 복용일 알림은 선택한 시간에 와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan hari aktif kamu yang seterusnya mengikut waktu yang kamu pilih."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Următorul memento pentru o zi activă urmează ora aleasă de tine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ďalšia pripomienka na aktívny deň príde vo zvolenom čase."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนวันกินยาครั้งถัดไปจะเป็นไปตามเวลาที่คุณเลือก"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你下一次服药日的提醒会按你选择的时间发送。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारा अगला सक्रिय-दिन रिमाइंडर तुम्हारे चुने समय पर आएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj sljedeći podsjetnik za aktivni dan slijedi vrijeme koje si odabrala."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő aktív napi emlékeztetőd a választott időpontot követi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki aktif gün hatırlatman seçtiğin saati takip eder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் அடுத்த செயல் நாள் நினைவூட்டல் நீ தேர்ந்தெடுத்த நேரத்தில் வரும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat hari aktif berikutnya mengikuti waktu yang kamu pilih."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع تذكير يومك النشط التالي الوقت الذي اخترتِه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תזכורת היום הפעיל הבאה שלך תגיע בשעה שבחרת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc ngày uống tiếp theo sẽ theo giờ bạn đã chọn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার পরের সক্রিয়-দিনের রিমাইন্ডার তোমার বেছে নেওয়া সময় অনুসরণ করে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہاری اگلی فعال دن کی یاد دہانی تمہارے چُنے ہوئے وقت پر آئے گی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj naslednji opomnik za aktivni dan sledi izbranemu času."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επόμενη υπενθύμιση ενεργής ημέρας ακολουθεί την ώρα που επέλεξες."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ తర్వాతి యాక్టివ్ రోజు రిమైండర్ నువ్వు ఎంచుకున్న సమయానికి వస్తుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你下一個服藥日的提醒會依你選擇的時間傳送。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તારા અગલા સક્રિય-દિન રિમાઇંડર તારા ચુને સમય પર આએગા।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ ತರ್ವಾತಿ ಯಾಕ್ಟಿವ್ ರೋಜು ಜ್ಞಾಪನೆ ನೀನು ಆರಿಸಿದ ಸಮಯಾನಿಕಿ ವಸ್ತುಂದಿ."
