    "notification.trial_ending.body": {
      "comment": "Entitlement transition [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App blocking will turn off when the trial ends. Standard reminders remain available."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco delle app si disattiverà al termine della prova. I promemoria standard resteranno disponibili."
          }
        }
      }
    },
    "notification.trial_ending.title": {
      "comment": "Trial warning [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Pillie Plus trial is ending soon"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova di Pillie Plus terminerà presto"
          }
        }
      }
