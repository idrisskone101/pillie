          "stringUnit": {
            "state": "translated",
            "value": "Só aparece onde costumava estar o teu lembrete das %@. Toca para o recuperares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "E doar locul unde era mementoul tău de la %@. Atinge ca să-l readuci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просто раньше в %@ здесь было твоё напоминание. Коснись, чтобы вернуть его."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len tu predtým bývala tvoja pripomienka o %@. Ťukni a vrátiš ju späť."
          }
        },
        "sl": {
          "stringUnit": {
