    "notification.winback.slot1.body": {
      "comment": "ENG-173 win-back push after a hard-paywall trial ends",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكيرك في %@ متوقف الآن. انقري لإعادة تشغيله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার %@-এর রিমাইন্ডার এখন বন্ধ। আবার চালু করতে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El recordatori de les %@ ara està desactivat. Toca per tornar-lo a activar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připomínka v %@ je teď vypnutá. Klepni a znovu ji zapneš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din påmindelse kl. %@ er slået fra nu. Tryk for at slå den til igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Erinnerung um %@ ist jetzt aus. Tippe, um sie wieder einzuschalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η υπενθύμισή σου στις %@ είναι πλέον ανενεργή. Πάτα για να την ενεργοποιήσεις ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ reminder is off now. Tap to turn it back on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu recordatorio de las %@ está desactivado. Toca para volver a activarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistutuksesi klo %@ on nyt pois päältä. Napauta, niin se palaa päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton rappel de %@ est désactivé. Touche pour le réactiver."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું %@નું રિમાઇન્ડર હવે બંધ છે. તેને ફરી ચાલુ કરવા ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התזכורת שלך ב-%@ כבויה עכשיו. הקישי כדי להפעיל אותה מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका %@ वाला रिमाइंडर अब बंद है। उसे फिर से चालू करने के लिए टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
