    "notification.trial_expiry.day13.body": {
      "comment": "Reverse Trial day-13 warning; app-blocking scope only [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App blocking turns off tomorrow night. Your daily reminders stay free."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco app si disattiva domani sera. I promemoria giornalieri restano gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Sperre geht morgen Abend aus. Deine täglichen Erinnerungen bleiben kostenlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le blocage d’apps se désactive demain soir. Tes rappels quotidiens restent gratuits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo de apps se desactiva mañana por la noche. Tus recordatorios diarios siguen siendo gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio de apps desliga amanhã à noite. Seus lembretes diários continuam grátis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblokkering gaat morgenavond uit. Je dagelijkse herinneringen blijven gratis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblockering stängs av i morgon kväll. Dina dagliga påminnelser är fortfarande gratis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblokering slås fra i morgen aften. Dine daglige påmindelser forbliver gratis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblokkering slås av i morgen kveld. De daglige påminnelsene dine forblir gratis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellusesto menee pois päältä huomisiltana. Päivittäiset muistutuksesi pysyvät ilmaisina."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O bloqueio de apps desliga-se amanhã à noite. Os teus lembretes diários continuam grátis."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueig d’apps es desactiva demà a la nit. Els recordatoris diaris continuen sent gratis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokowanie aplikacji wyłączy się jutro w nocy. Codzienne przypomnienia zostają za darmo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokování aplikací se vypne zítra v noci. Denní připomínky zůstávají zdarma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка приложений отключится завтра ночью. Ежедневные напоминания останутся бесплатными."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокування застосунків вимкнеться завтра вночі. Щоденні нагадування лишаться безкоштовними."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリブロックは明日の夜にオフになります。毎日のリマインダーは引き続き無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 차단이 내일 밤에 꺼져요. 매일 알림은 계속 무료예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekatan apl dimatikan esok malam. Peringatan harian kamu kekal percuma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocarea aplicațiilor se oprește mâine seară. Mementourile zilnice rămân gratuite."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokovanie aplikácií sa vypne zajtra v noci. Denné pripomienky zostávajú zdarma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบล็อกแอปจะปิดคืนพรุ่งนี้ การแจ้งเตือนประจำวันของคุณยังฟรี"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用屏蔽将在明晚关闭。你的每日提醒继续免费。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप ब्लॉकिंग कल रात बंद हो जाएगी। आपके रोज़ के रिमाइंडर मुफ़्त रहेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje aplikacija isključuje se sutra navečer. Tvoji dnevni podsjetnici ostaju besplatni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appblokkolás holnap este kikapcsol. A napi emlékeztetőid ingyenesek maradnak."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama engelleme yarın gece kapanıyor. Günlük hatırlatmaların ücretsiz kalır."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப் தடுப்பு நாளை இரவு ஆஃப் ஆகும். உங்கள் தினசரி நினைவூட்டல்கள் இலவசமாகவே இருக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokir aplikasi mati besok malam. Pengingat harianmu tetap gratis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف حظر التطبيقات ليلة الغد. تبقى تذكيراتك اليومية مجانية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חסימת האפליקציות תיכבה מחר בלילה. התזכורות היומיות שלך נשארות בחינם."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chặn ứng dụng sẽ tắt vào tối mai. Lời nhắc hàng ngày của bạn vẫn miễn phí."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগামীকাল রাতে অ্যাপ ব্লকিং বন্ধ হবে। আপনার দৈনিক রিমাইন্ডার ফ্রি-ই থাকবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ بلاکنگ کل رات بند ہو جائے گی۔ آپ کی روزانہ کی یاد دہانیاں مفت رہیں گی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje aplikacij se izklopi jutri zvečer. Tvoji dnevni opomniki ostanejo brezplačni."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αποκλεισμός εφαρμογών απενεργοποιείται αύριο το βράδυ. Οι καθημερινές υπενθυμίσεις σου μένουν δωρεάν."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్ బ్లాకింగ్ రేపు రాత్రి ఆఫ్ అవుతుంది. మీ రోజువారీ రిమైండర్లు ఉచితంగానే ఉంటాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 封鎖將在明天晚上關閉。你的每日提醒繼續免費。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપ બ્લૉકિંગ આવતીકાલે રાત્રે બંધ થશે. તમારાં રોજનાં રિમાઇન્ડર મફત જ રહેશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್ ನಿರ್ಬಂಧ ನಾಳೆ ರಾತ್ರಿ ಆಫ್ ಆಗುತ್ತದೆ. ನಿಮ್ಮ ದೈನಂದಿನ ಜ್ಞಾಪನೆಗಳು ಉಚಿತವಾಗಿಯೇ ಇರುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് ബ്ലോക്കിംഗ് നാളെ രാത്രി ഓഫാകും. നിങ്ങളുടെ ദൈനംദിന റിമൈൻഡറുകൾ സൗജന്യമായി തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ॲप ब्लॉकिंग उद्या रात्री बंद होईल. तुमचे रोजचे रिमाइंडर मोफत राहतील."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆସନ୍ତାକାଲି ରାତିରେ ଆପ୍ ବ୍ଲକିଂ ବନ୍ଦ ହେବ। ଆପଣଙ୍କ ଦୈନିକ ରିମାଇଣ୍ଡର୍ ମାଗଣା ରହିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਬਲੌਕਿੰਗ ਕੱਲ੍ਹ ਰਾਤ ਬੰਦ ਹੋ ਜਾਵੇਗੀ। ਤੁਹਾਡੇ ਰੋਜ਼ਾਨਾ ਰਿਮਾਈਂਡਰ ਮੁਫ਼ਤ ਹੀ ਰਹਿਣਗੇ।"
          }
        }
      }
    },
