    "notification.break_start.body": {
      "comment": "Pill regimen only [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pill reminders during your break days. They start again with your next pack."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun promemoria della pillola nei giorni di pausa. Ripartono con la prossima confezione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während deiner Pausentage gibt es keine Pillenerinnerungen. Mit deiner nächsten Packung kommen sie wieder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de rappel de pilule pendant tes jours d’arrêt. Ils reprennent avec ta prochaine plaquette."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin recordatorios de píldora durante tus días de descanso. Vuelven con tu próximo blíster."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem lembretes de pílula nos seus dias de intervalo. Eles voltam com a próxima cartela."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen pilherinneringen tijdens je pauzedagen. Ze beginnen weer bij je volgende strip."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga p-pillerpåminnelser under dina pausdagar. De börjar igen med din nästa karta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen p-pillepåmindelser på dine pausedage. De starter igen med din næste pakke."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen pillepåminnelser i pausedagene. De starter igjen med neste brett."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei pillerimuistutuksia taukopäivinäsi. Ne alkavat taas seuraavasta liuskasta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem lembretes da pílula durante os teus dias de intervalo. Voltam com a próxima embalagem."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha recordatoris de la píndola durant els dies de pausa. Tornen amb el pròxim envàs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W dni przerwy nie ma przypomnień o tabletce. Wrócą z następnym opakowaniem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během dnů pauzy nepřijdou připomínky na pilulku. Vrátí se s dalším balením."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время дней перерыва напоминаний о таблетке не будет. Они вернутся со следующей упаковкой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час днів перерви нагадувань про таблетку не буде. Вони повернуться з наступною упаковкою."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休薬日の間は、ピルのリマインダーはありません。次のシートから再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴약일에는 피임약 알림이 없어요. 다음 팩부터 다시 시작돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada peringatan pil semasa hari rehat kamu. Ia bermula semula dengan pek kamu yang seterusnya."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără mementouri pentru pilulă în zilele de pauză. Revin odată cu următoarea folie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas dní pauzy neprídu pripomienky na tabletku. Vrátia sa s ďalším balením."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการแจ้งเตือนกินยาในช่วงวันพักของคุณ และจะเริ่มอีกครั้งเมื่อเริ่มแผงใหม่"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停药日期间不会有服药提醒。下一板开始时会恢复。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्रेक दिनों में गोली के रिमाइंडर नहीं आएँगे। अगले पैक के साथ ये फिर शुरू होंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijekom dana pauze nema podsjetnika za pilulu. Ponovno kreću s novim pakiranjem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szünetnapokon nincs tablettaemlékeztető. A következő levéllel újra indulnak."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara günlerinde hap hatırlatması yok. Bir sonraki paketinle yeniden başlarlar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இடைவெளி நாட்களில் மாத்திரை நினைவூட்டல்கள் வராது. அடுத்த பேக்குடன் அவை மீண்டும் தொடங்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pengingat pil selama hari istirahatmu. Pengingat mulai lagi dengan strip berikutnya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تذكيرات بالحبة خلال أيام الاستراحة. تعود مع علبتك التالية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין תזכורות לגלולה בימי ההפסקה שלך. הן יחזרו עם החפיסה הבאה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có lời nhắc uống thuốc trong những ngày nghỉ của bạn. Lời nhắc sẽ bắt đầu lại khi bạn mở vỉ mới."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিরতির দিনগুলোতে পিলের রিমাইন্ডার আসবে না। পরের প্যাক থেকে আবার শুরু হবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقفے کے دنوں میں گولی کی یاد دہانیاں نہیں آئیں گی۔ اگلے پیک کے ساتھ یہ دوبارہ شروع ہوں گی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Med dnevi premora ni opomnikov za tabletko. Spet se začnejo z naslednjim zavitkom."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν υπενθυμίσεις χαπιού στις ημέρες διαλείμματος. Ξεκινούν ξανά με την επόμενη συσκευασία."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ విరామ రోజుల్లో మాత్ర రిమైండర్లు రావు. మీ తర్వాతి ప్యాక్‌తో అవి మళ్లీ మొదలవుతాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停藥日期間不會有服藥提醒。下一盒開始時會恢復。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા બ્રેકના દિવસો દરમિયાન ગોળીનાં રિમાઇન્ડર નહીં આવે. તમારા પછીના પેક સાથે તે ફરી શરૂ થશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ವಿರಾಮ ದಿನಗಳಲ್ಲಿ ಮಾತ್ರೆ ಜ್ಞಾಪನೆಗಳು ಬರುವುದಿಲ್ಲ. ನಿಮ್ಮ ಮುಂದಿನ ಪ್ಯಾಕ್‌ನೊಂದಿಗೆ ಅವು ಮತ್ತೆ ಶುರುವಾಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഇടവേള ദിനങ്ങളിൽ ഗുളിക റിമൈൻഡറുകൾ വരില്ല. അടുത്ത പാക്കിനൊപ്പം അവ വീണ്ടും തുടങ്ങും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्रेकच्या दिवसांत गोळीचे रिमाइंडर येणार नाहीत. पुढच्या पॅकसोबत ते पुन्हा सुरू होतील."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବିରତି ଦିନରେ ପିଲ୍ ରିମାଇଣ୍ଡର୍ ଆସିବ ନାହିଁ। ଆପଣଙ୍କ ପରବର୍ତ୍ତୀ ପ୍ୟାକ୍ ସହ ସେଗୁଡ଼ିକ ପୁଣି ଆରମ୍ଭ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬ੍ਰੇਕ ਦਿਨਾਂ ਦੌਰਾਨ ਗੋਲੀ ਦੇ ਰਿਮਾਈਂਡਰ ਨਹੀਂ ਆਉਣਗੇ। ਤੁਹਾਡੇ ਅਗਲੇ ਪੈਕ ਨਾਲ ਇਹ ਮੁੜ ਸ਼ੁਰੂ ਹੋਣਗੇ।"
          }
        }
      }
    },
    "notification.break_start.patch.body": {
      "comment": "Issue #233 method-aware notification",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No patch reminders during your patch-free days. They start again with your next patch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun promemoria del cerotto nei giorni senza cerotto. Ripartono con il prossimo cerotto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während deiner pflasterfreien Tage gibt es keine Pflastererinnerungen. Mit deinem nächsten Pflaster kommen sie wieder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de rappel de patch pendant tes jours sans patch. Ils reprennent avec ton prochain patch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin recordatorios de parche durante tus días sin parche. Vuelven con tu próximo parche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem lembretes de adesivo nos seus dias sem adesivo. Eles voltam com o próximo adesivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen pleisterherinneringen tijdens je pleistervrije dagen. Ze beginnen weer bij je volgende pleister."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga plåsterpåminnelser under dina plåsterfria dagar. De börjar igen med ditt nästa plåster."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen plasterpåmindelser på dine plasterfri dage. De starter igen med dit næste plaster."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen plasterpåminnelser i de plasterfrie dagene. De starter igjen med neste plaster."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei laastarimuistutuksia laastarittomina päivinäsi. Ne alkavat taas seuraavasta laastarista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem lembretes do adesivo durante os teus dias sem adesivo. Voltam com o próximo adesivo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha recordatoris del pegat durant els dies sense pegat. Tornen amb el pròxim pegat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W dni bez plastra nie ma przypomnień o plastrze. Wrócą z następnym plastrem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během dnů bez náplasti nepřijdou připomínky na náplast. Vrátí se s další náplastí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время дней без пластыря напоминаний о пластыре не будет. Они вернутся со следующим пластырем."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час днів без пластиру нагадувань про пластир не буде. Вони повернуться з наступним пластирем."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッチを貼らない日の間は、パッチのリマインダーはありません。次のパッチから再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패치 없는 날에는 패치 알림이 없어요. 다음 패치부터 다시 시작돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada peringatan tampalan semasa hari tanpa tampalan kamu. Ia bermula semula dengan tampalan kamu yang seterusnya."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără mementouri pentru plasture în zilele fără plasture. Revin odată cu următorul plasture."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas dní bez náplasti neprídu pripomienky na náplasť. Vrátia sa s ďalšou náplasťou."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการแจ้งเตือนแผ่นแปะในช่วงวันที่ไม่แปะแผ่น และจะเริ่มอีกครั้งเมื่อถึงแผ่นถัดไป"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无贴片期间不会有贴片提醒。贴下一片时会恢复。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैच-मुक्त दिनों में पैच के रिमाइंडर नहीं आएँगे। अगले पैच के साथ ये फिर शुरू होंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijekom dana bez flastera nema podsjetnika za flaster. Ponovno kreću sa sljedećim flasterom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tapaszmentes napokon nincs tapaszemlékeztető. A következő tapasszal újra indulnak."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantsız günlerinde bant hatırlatması yok. Bir sonraki bandınla yeniden başlarlar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பேட்ச் இல்லாத நாட்களில் பேட்ச் நினைவூட்டல்கள் வராது. அடுத்த பேட்ச்சுடன் அவை மீண்டும் தொடங்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pengingat koyo selama hari tanpa koyo. Pengingat mulai lagi dengan koyo berikutnya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تذكيرات باللصقة خلال أيامك بدون لصقة. تعود مع لصقتك التالية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין תזכורות למדבקה בימים בלי מדבקה. הן יחזרו עם המדבקה הבאה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có lời nhắc miếng dán trong những ngày không dán. Lời nhắc sẽ bắt đầu lại với miếng dán tiếp theo."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্যাচ-মুক্ত দিনগুলোতে প্যাচের রিমাইন্ডার আসবে না। পরের প্যাচ থেকে আবার শুরু হবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پیچ سے آزاد دنوں میں پیچ کی یاد دہانیاں نہیں آئیں گی۔ اگلے پیچ کے ساتھ یہ دوبارہ شروع ہوں گی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Med dnevi brez obliža ni opomnikov za obliž. Spet se začnejo z naslednjim obližem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν υπενθυμίσεις αυτοκόλλητου στις ημέρες χωρίς αυτοκόλλητο. Ξεκινούν ξανά με το επόμενο αυτοκόλλητο."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్యాచ్ లేని రోజుల్లో ప్యాచ్ రిమైండర్లు రావు. మీ తర్వాతి ప్యాచ్‌తో అవి మళ్లీ మొదలవుతాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無貼片期間不會有貼片提醒。貼下一片時會恢復。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પેચ વગરના દિવસોમાં પેચનાં રિમાઇન્ડર નહીં આવે. તમારા પછીના પેચ સાથે તે ફરી શરૂ થશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪ್ಯಾಚ್ ಇಲ್ಲದ ದಿನಗಳಲ್ಲಿ ಪ್ಯಾಚ್ ಜ್ಞಾಪನೆಗಳು ಬರುವುದಿಲ್ಲ. ನಿಮ್ಮ ಮುಂದಿನ ಪ್ಯಾಚ್‌ನೊಂದಿಗೆ ಅವು ಮತ್ತೆ ಶುರುವಾಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പാച്ച് ഇല്ലാത്ത നിങ്ങളുടെ ദിനങ്ങളിൽ പാച്ച് റിമൈൻഡറുകൾ വരില്ല. അടുത്ത പാച്ചിനൊപ്പം അവ വീണ്ടും തുടങ്ങും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पॅचशिवायच्या दिवसांत पॅचचे रिमाइंडर येणार नाहीत. पुढच्या पॅचसोबत ते पुन्हा सुरू होतील."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ୟାଚ୍-ମୁକ୍ତ ଦିନରେ ପ୍ୟାଚ୍ ରିମାଇଣ୍ଡର୍ ଆସିବ ନାହିଁ। ଆପଣଙ୍କ ପରବର୍ତ୍ତୀ ପ୍ୟାଚ୍ ସହ ସେଗୁଡ଼ିକ ପୁଣି ଆରମ୍ଭ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੈਚ-ਮੁਕਤ ਦਿਨਾਂ ਦੌਰਾਨ ਪੈਚ ਦੇ ਰਿਮਾਈਂਡਰ ਨਹੀਂ ਆਉਣਗੇ। ਤੁਹਾਡੇ ਅਗਲੇ ਪੈਚ ਨਾਲ ਇਹ ਮੁੜ ਸ਼ੁਰੂ ਹੋਣਗੇ।"
          }
        }
      }
    },
    "notification.break_start.ring.body": {
      "comment": "Issue #233 method-aware notification",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ring reminders during your ring-free days. They start again when it’s time to insert your ring."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun promemoria dell’anello nei giorni senza anello. Ripartono quando è il momento di inserire l’anello."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während deiner ringfreien Tage gibt es keine Ringerinnerungen. Sie kommen wieder, wenn du deinen Ring einsetzen sollst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de rappel d’anneau pendant tes jours sans anneau. Ils reprennent quand il est temps d’insérer ton anneau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin recordatorios de anillo durante tus días sin anillo. Vuelven cuando toque insertar tu anillo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem lembretes de anel nos seus dias sem anel. Eles voltam quando for hora de inserir o anel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen ringherinneringen tijdens je ringvrije dagen. Ze beginnen weer als het tijd is om je ring in te brengen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga ringpåminnelser under dina ringfria dagar. De börjar igen när det är dags att sätta in ringen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen ringpåmindelser på dine ringfri dage. De starter igen, når det er tid til at indsætte din ring."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen ringpåminnelser i de ringfrie dagene. De starter igjen når det er tid for å sette inn ringen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei rengasmuistutuksia renkaattomina päivinäsi. Ne alkavat taas, kun on aika asettaa rengas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem lembretes do anel durante os teus dias sem anel. Voltam quando for altura de inserir o anel."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha recordatoris de l’anell durant els dies sense anell. Tornen quan toqui posar-te l’anell."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W dni bez krążka nie ma przypomnień o krążku. Wrócą, gdy przyjdzie pora założyć krążek."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během dnů bez kroužku nepřijdou připomínky na kroužek. Vrátí se, až bude čas zavést kroužek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время дней без кольца напоминаний о кольце не будет. Они вернутся, когда придёт время ввести кольцо."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час днів без кільця нагадувань про кільце не буде. Вони повернуться, коли настане час ввести кільце."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リングを外している日の間は、リングのリマインダーはありません。リングを入れる日になったら再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링 없는 날에는 링 알림이 없어요. 링을 넣을 때가 되면 다시 시작돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada peringatan cincin semasa hari tanpa cincin kamu. Ia bermula semula apabila tiba masa untuk masukkan cincin."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără mementouri pentru inel în zilele fără inel. Revin când e timpul să introduci inelul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas dní bez krúžku neprídu pripomienky na krúžok. Vrátia sa, keď bude čas zaviesť krúžok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการแจ้งเตือนวงแหวนในช่วงวันที่ไม่ใส่วงแหวน และจะเริ่มอีกครั้งเมื่อถึงเวลาใส่วงแหวน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无环期间不会有阴道环提醒。到了放入阴道环的时候会恢复。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिंग-मुक्त दिनों में रिंग के रिमाइंडर नहीं आएँगे। रिंग लगाने का समय आने पर ये फिर शुरू होंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijekom dana bez prstena nema podsjetnika za prsten. Ponovno kreću kad bude vrijeme da umetneš prsten."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyűrűmentes napokon nincs gyűrűemlékeztető. Akkor indulnak újra, amikor ideje behelyezni a gyűrűt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Halkasız günlerinde halka hatırlatması yok. Halkanı yerleştirme zamanı geldiğinde yeniden başlarlar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ரிங் இல்லாத நாட்களில் ரிங் நினைவூட்டல்கள் வராது. ரிங் செருகும் நேரம் வந்ததும் அவை மீண்டும் தொடங்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pengingat cincin selama hari tanpa cincin. Pengingat mulai lagi saat waktunya memasang cincin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تذكيرات بالحلقة خلال أيامك بدون حلقة. تعود عندما يحين وقت إدخال حلقتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין תזכורות לטבעת בימים בלי טבעת. הן יחזרו כשיגיע הזמן להכניס את הטבעת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có lời nhắc vòng trong những ngày không vòng. Lời nhắc sẽ bắt đầu lại khi đến lúc đặt vòng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিং-মুক্ত দিনগুলোতে রিংয়ের রিমাইন্ডার আসবে না। রিং লাগানোর সময় হলে আবার শুরু হবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رِنگ سے آزاد دنوں میں رِنگ کی یاد دہانیاں نہیں آئیں گی۔ رِنگ لگانے کا وقت آنے پر یہ دوبارہ شروع ہوں گی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Med dnevi brez obročka ni opomnikov za obroček. Spet se začnejo, ko bo čas, da vstaviš obroček."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν υπενθυμίσεις δακτυλίου στις ημέρες χωρίς δακτύλιο. Ξεκινούν ξανά όταν έρθει η ώρα να βάλεις τον δακτύλιό σου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రింగ్ లేని రోజుల్లో రింగ్ రిమైండర్లు రావు. రింగ్ అమర్చే సమయం వచ్చినప్పుడు అవి మళ్లీ మొదలవుతాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無環期間不會有陰道環提醒。到了放入陰道環的時候會恢復。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિંગ વગરના દિવસોમાં રિંગનાં રિમાઇન્ડર નહીં આવે. રિંગ મૂકવાનો સમય થશે ત્યારે તે ફરી શરૂ થશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ರಿಂಗ್ ಇಲ್ಲದ ದಿನಗಳಲ್ಲಿ ರಿಂಗ್ ಜ್ಞಾಪನೆಗಳು ಬರುವುದಿಲ್ಲ. ರಿಂಗ್ ಅಳವಡಿಸುವ ಸಮಯ ಬಂದಾಗ ಅವು ಮತ್ತೆ ಶುರುವಾಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിംഗ് ഇല്ലാത്ത നിങ്ങളുടെ ദിനങ്ങളിൽ റിംഗ് റിമൈൻഡറുകൾ വരില്ല. റിംഗ് ഇടാനുള്ള സമയമാകുമ്പോൾ അവ വീണ്ടും തുടങ്ങും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रिंगशिवायच्या दिवसांत रिंगचे रिमाइंडर येणार नाहीत. रिंग घालायची वेळ आल्यावर ते पुन्हा सुरू होतील."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିଙ୍ଗ-ମୁକ୍ତ ଦିନରେ ରିଙ୍ଗ ରିମାଇଣ୍ଡର୍ ଆସିବ ନାହିଁ। ରିଙ୍ଗ ଭିତରେ ରଖିବା ସମୟ ହେଲେ ସେଗୁଡ଼ିକ ପୁଣି ଆରମ୍ଭ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿੰਗ-ਮੁਕਤ ਦਿਨਾਂ ਦੌਰਾਨ ਰਿੰਗ ਦੇ ਰਿਮਾਈਂਡਰ ਨਹੀਂ ਆਉਣਗੇ। ਰਿੰਗ ਪਾਉਣ ਦਾ ਸਮਾਂ ਹੋਣ ’ਤੇ ਇਹ ਮੁੜ ਸ਼ੁਰੂ ਹੋਣਗੇ।"
          }
        }
      }
    },
