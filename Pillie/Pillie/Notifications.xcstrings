    "notification.winback.slot2.blocker.body": {
      "comment": "ENG-173 win-back push after a hard-paywall trial ends",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %@ كانت ستبقى مقفلة حتى تسجّلي. انقري لإعادة تشغيل حظر التطبيقات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ থেকে টিক না দেওয়া পর্যন্ত অ্যাপগুলো পজ থাকত। অ্যাপ ব্লকিং আবার চালু করতে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A les %@ quedarien bloquejades fins que confirmis. Toca per tornar a activar el bloqueig d’apps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V %@ by zůstaly blokované, dokud neodškrtneš dnešek. Klepni a blokování znovu zapneš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kl. %@ ville de være låst, indtil du krydser af. Tryk for at slå appblokering til igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonst wären sie ab %@ gesperrt, bis du abhakst. Tippe, um die App-Sperre wieder einzuschalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στις %@ θα έμεναν αποκλεισμένες μέχρι να το σημειώσεις. Πάτα για να ενεργοποιήσεις ξανά τον αποκλεισμό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At %@ they’d stay locked until you log. Tap to turn the lock back on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A las %@ seguirían bloqueadas hasta que marques lo de hoy. Toca para reactivar el bloqueo de apps."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Klo %@ sovellukset pysyisivät estettyinä, kunnes kuittaat. Napauta, niin esto palaa päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À %@, elles resteraient verrouillées jusqu’à ce que tu valides. Touche pour réactiver le blocage d’apps."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@થી તમે નોંધ ન કરો ત્યાં સુધી તે થોભેલી રહેત. ઍપ બ્લૉકિંગ ફરી ચાલુ કરવા ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-%@ הן היו נשארות נעולות עד שתסמני. הקישי כדי להפעיל מחדש את חסימת האפליקציות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बजे से वे तब तक रुके रहते, जब तक आप दर्ज न करते। ब्लॉकिंग फिर से चालू करने के लिए टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U %@ ostale bi blokirane dok se ne javiš. Dodirni da ponovno uključiš blokiranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-kor az appjaid blokkolva maradnának, amíg ki nem pipálod. Koppints, és kapcsold vissza az appblokkolást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pukul %@ aplikasimu biasanya tetap terkunci sampai kamu check-in. Ketuk untuk menyalakan blokir aplikasi lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %@ resterebbero bloccate finché non confermi. Tocca per riattivare il blocco app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本来なら%@から、記録するまでアプリがロックされていました。タップしてアプリブロックを再びオンに。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ರಿಂದ ನೀವು ದಾಖಲಿಸುವವರೆಗೆ ಅವು ತಡೆಹಿಡಿದಿರುತ್ತಿದ್ದವು. ಆ್ಯಪ್ ನಿರ್ಬಂಧ ಮತ್ತೆ ಆನ್ ಮಾಡಲು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래라면 %@부터 체크할 때까지 앱이 잠겨 있었을 거예요. 탭해서 앱 차단을 다시 켜세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ മുതൽ നിങ്ങൾ രേഖപ്പെടുത്തുന്നതുവരെ അവ പോസ് ആകുമായിരുന്നു. ആപ്പ് ബ്ലോക്കിംഗ് വീണ്ടും ഓണാക്കാൻ ടാപ്പ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पासून तुम्ही नोंद करेपर्यंत ती थांबलेली राहिली असती. ॲप ब्लॉकिंग पुन्हा सुरू करण्यासाठी टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada pukul %@ apl kamu sepatutnya kekal dikunci sehingga kamu sahkan. Ketik untuk menghidupkan sekatan apl semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kl. %@ ville de vært låst til du krysser av. Trykk for å slå på appblokkeringen igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om %@ zouden ze vergrendeld blijven tot je afvinkt. Tik om appblokkering weer aan te zetten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ରୁ ଆପଣ ଦର୍ଜ କରିବା ପର୍ଯ୍ୟନ୍ତ ସେଗୁଡ଼ିକ ବିରାମରେ ରହିଥାନ୍ତା। ଆପ୍ ବ୍ଲକିଂ ପୁଣି ଚାଲୁ କରିବାକୁ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਤੋਂ ਦਰਜ ਕਰਨ ਤੱਕ ਇਹ ਰੁਕੀਆਂ ਰਹਿੰਦੀਆਂ। ਐਪ ਬਲੌਕਿੰਗ ਮੁੜ ਚਾਲੂ ਕਰਨ ਲਈ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ pozostałyby zablokowane, aż odhaczysz dzień. Stuknij, aby znów włączyć blokowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Às %@, eles ficariam bloqueados até você registrar. Toque para ligar o bloqueio de apps de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Às %@, ficariam bloqueadas até registares. Toca para voltares a ligar o bloqueio de apps."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La %@ ar rămâne blocate până bifezi ziua. Atinge ca să pornești din nou blocarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %@ они остались бы заблокированы, пока ты не отметишься. Коснись, чтобы снова включить блокировку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ by zostali blokované, kým neodškrtneš dnešok. Ťukni a blokovanie znova zapneš."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob %@ bi ostale blokirane, dokler ne odkljukaš. Tapni, da spet vklopiš blokiranje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kl. %@ skulle de vara låsta tills du bockar av. Tryck för att slå på appblockeringen igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ முதல் நீங்கள் பதிவு செய்யும் வரை அவை இடைநிறுத்தப்பட்டிருக்கும். ஆப் தடுப்பை மீண்டும் இயக்கத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ నుంచి మీరు నమోదు చేసే వరకు అవి పాజ్‌లో ఉండేవి. యాప్ బ్లాకింగ్ మళ్లీ ఆన్ చేయడానికి నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปกติเวลา %@ แอปจะถูกล็อกไว้จนกว่าคุณจะเช็กอิน แตะเพื่อเปิดการบล็อกแอปอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat %@ olunca, sen işaretleyene kadar engelli kalırlardı. Engellemeyi yeniden açmak için dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "О %@ вони лишалися б заблокованими, доки ти не відмітишся. Торкнись, щоб знову ввімкнути блокування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ سے یہ آپ کے درج کرنے تک رکی رہتیں۔ ایپ بلاکنگ دوبارہ آن کرنے کے لیے ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lẽ ra lúc %@, ứng dụng sẽ bị khóa đến khi bạn điểm danh. Chạm để bật lại chặn ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原本到 %@ 时，应用会一直锁住，直到你打卡。点按即可重新开启应用屏蔽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原本到 %@ 時，App 會一直鎖住，直到你打卡。點一下即可重新開啟 App 封鎖。"
          }
        }
      }
    },
