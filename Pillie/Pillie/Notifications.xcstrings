    "notification.active_resume.body": {
      "comment": "Reminder statement [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next active-day reminder follows the time you selected."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prossimo promemoria per un giorno attivo seguirà l’orario scelto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine nächste Erinnerung für einen aktiven Tag folgt der ausgewählten Uhrzeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton prochain rappel de jour actif suit l'heure que tu as choisie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu próximo recordatorio de día activo sigue la hora que seleccionaste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu próximo lembrete de dia ativo segue o horário que você selecionou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je volgende herinnering op een actieve dag volgt het door jou gekozen tijdstip."
          }
        }
      }
    },
    "notification.active_resume.title": {
      "comment": "Regimen transition [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled reminders resume today"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria programmati riprendono oggi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplante Erinnerungen beginnen heute wieder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels programmés reprennent aujourd'hui"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios programados retoman hoy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes agendados retomam hoje"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplande herinneringen hervatten vandaag"
          }
        }
      }
    },
    "notification.break_start.body": {
      "comment": "Pill regimen only [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled pill reminders pause during your break days."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria programmati per la pillola si interrompono durante i giorni di pausa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplante Pillenerinnerungen pausieren während deiner Pausentage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels de pilule programmés s'arrêtent pendant tes jours de pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios de píldora programados se pausan durante tus días de descanso."
          }
