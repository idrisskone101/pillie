    "notification.final.title": {
      "comment": "Replaces last chance [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Final scheduled reminder"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
