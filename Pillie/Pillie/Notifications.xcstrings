            "state": "translated",
            "value": "Pose ton patch, puis touche ici pour valider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca tu parche y luego toca aquí para marcarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplique seu adesivo e depois toque aqui para registrar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak je pleister en tik dan hier om af te vinken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätt på ditt plåster och tryck sedan här för att bocka av."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt dit plaster på, og tryk så her for at krydse af."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett på plasteret, og trykk her for å krysse av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinnitä laastarisi ja kuittaa napauttamalla tästä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca o adesivo e depois toca aqui para registar."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Posa’t el pegat i després toca aquí per confirmar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyklej plaster, a potem stuknij tutaj, aby odhaczyć."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nalep si náplast a pak klepnutím sem odškrtni dnešek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклей пластырь, потом коснись здесь, чтобы отметиться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклей пластир, потім торкнись тут, щоб відмітитися."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッチを貼ったら、ここをタップして記録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패치를 붙이고 여기를 탭해서 체크하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lekatkan tampalan kamu, kemudian ketik di sini untuk sahkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplică-ți plasturele, apoi atinge aici ca să bifezi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nalep si náplasť a potom ťuknutím sem odškrtni dnešok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แปะแผ่นแปะ แล้วแตะที่นี่เพื่อเช็กอิน"
