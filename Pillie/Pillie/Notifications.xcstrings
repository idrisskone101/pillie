        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kończy ci się zapas plastrów. Czas pomyśleć o uzupełnieniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásoba náplastí ti dochází. Je čas naplánovat doplnění."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запас пластырей подходит к концу. Пора запланировать пополнение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запас пластирів закінчується. Час запланувати поповнення."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッチの残りが少なくなってきました。補充の準備をしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패치가 얼마 남지 않았어요. 미리 준비해 두세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekalan tampalan kamu semakin berkurang. Masa untuk rancang tambah stok."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerva ta de plasturi e pe terminate. E timpul să-ți plănuiești următoarea rezervă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásoba náplastí sa ti míňa. Je čas naplánovať doplnenie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผ่นแปะของคุณใกล้หมดแล้ว ถึงเวลาวางแผนซื้อเพิ่ม"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的贴片快用完了。该准备补充了。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पैच स्टॉक कम हो रहा है। दोबारा लाने की तैयारी कर लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaliha flastera ti je pri kraju. Vrijeme je da isplaniraš nabavu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fogy a tapaszkészleted. Ideje a pótlásra gondolni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bant stoğun azalıyor. Yenisini planlama zamanı."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பேட்ச் இருப்பு குறைந்து வருகிறது. மீண்டும் வாங்கத் திட்டமிடும் நேரம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stok koyomu mulai menipis. Saatnya rencanakan beli lagi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مخزون لصقاتك بدأ ينفد. حان وقت التخطيط لإعادة التعبئة."
