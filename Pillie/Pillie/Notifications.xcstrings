    "notification.trial_ending.body": {
      "comment": "Entitlement transition [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App blocking will turn off when the trial ends."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco delle app si disattiverà al termine della prova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Pause wird am Ende der Testphase deaktiviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pause d'apps sera désactivée à la fin de l'essai."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo de apps se desactivará cuando termine la prueba."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueio de apps será desligado quando o teste terminar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "App-pauze wordt uitgeschakeld wanneer de proefperiode eindigt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblockering stängs av när provperioden tar slut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appblokering slås fra, når prøveperioden udløber."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "App-pause slås av når prøveperioden slutter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellustauko poistuu käytöstä, kun kokeilu päättyy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A pausa de apps desliga-se quando o período de teste terminar."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La pausa d’apps es desactivarà quan s’acabi la prova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokowanie aplikacji wyłączy się po zakończeniu okresu próbnego."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokování aplikací se po skončení zkušebního období vypne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка приложений отключится, когда закончится пробный период."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокування застосунків вимкнеться, коли завершиться пробний період."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアル終了時にアプリブロックはオフになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험이 끝나면 앱 차단이 꺼져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekatan apl akan dimatikan apabila percubaan tamat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocarea aplicațiilor se va opri când se termină perioada de probă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po skončení skúšobného obdobia sa blokovanie aplikácií vypne."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพักแอปจะปิดเมื่อช่วงทดลองใช้สิ้นสุด"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用结束后，应用屏蔽将关闭。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रायल ख़त्म होने पर ऐप ब्लॉकिंग बंद हो जाएगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje aplikacija isključit će se kad probno razdoblje završi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appblokkolás a próbaidőszak végén kikapcsol."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme bitince uygulama duraklatma kapanır."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சோதனைக் காலம் முடிந்ததும் ஆப் இடைநிறுத்தம் ஆஃப் ஆகும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeda aplikasi akan mati saat uji coba berakhir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُلغى تفعيل إيقاف التطبيقات عند انتهاء الفترة التجريبية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השהיית האפליקציות תיכבה כשתקופת הניסיון תסתיים."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chặn ứng dụng sẽ tắt khi dùng thử kết thúc."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রায়াল শেষ হলে অ্যাপ ব্লকিং বন্ধ হবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرائل ختم ہونے پر ایپ بلاکنگ بند ہو جائے گی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje aplikacij se bo ob koncu preizkusa izklopilo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η παύση εφαρμογών θα απενεργοποιηθεί όταν λήξει η δοκιμή."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రయల్ ముగిశాక యాప్ పాజ్ ఆఫ్ అవుతుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
