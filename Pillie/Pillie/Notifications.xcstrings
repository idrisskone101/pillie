    "notification.trial_expiry.day10.hard.body": {
      "comment": "Reverse Trial day-10 warning; hard-paywall terms, nothing stays free after the trial [paywall]",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي تجربتك بعد 5 أيام. بعدها تتوقف تذكيراتك اليومية حتى تختاري اشتراكًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "5 দিন পর আপনার ট্রায়াল শেষ হবে। এরপর প্ল্যান বেছে না নেওয়া পর্যন্ত আপনার দৈনিক রিমাইন্ডার বন্ধ থাকবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva prova s’acaba d’aquí a 5 dies. Després, els recordatoris diaris s’aturen fins que triïs un pla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební doba končí za 5 dní. Pak se denní připomínky zastaví, dokud si nevybereš plán."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din prøveperiode slutter om 5 dage. Derefter stopper dine daglige påmindelser, indtil du vælger et abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Testphase endet in 5 Tagen. Danach hören deine täglichen Erinnerungen auf, bis du einen Tarif wählst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δοκιμή σου τελειώνει σε 5 ημέρες. Μετά, οι καθημερινές υπενθυμίσεις σου σταματούν μέχρι να διαλέξεις πρόγραμμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trial ends in 5 days. After that, your daily reminders stop until you pick a plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba termina en 5 días. Después, tus recordatorios diarios se detienen hasta que elijas un plan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilusi päättyy 5 päivän kuluttua. Sen jälkeen päivittäiset muistutuksesi loppuvat, kunnes valitset tilauksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton essai se termine dans 5 jours. Ensuite, tes rappels quotidiens s’arrêtent jusqu’à ce que tu choisisses une formule."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો ટ્રાયલ 5 દિવસમાં પૂરો થશે. ત્યાર પછી તમે પ્લાન પસંદ ન કરો ત્યાં સુધી તમારાં રોજનાં રિમાઇન્ડર બંધ રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הניסיון שלך מסתיים בעוד 5 ימים. אחרי זה התזכורות היומיות שלך ייפסקו עד שתבחרי מסלול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका ट्रायल 5 दिन में खत्म हो जाएगा। उसके बाद, प्लान चुनने तक आपके रोज़ के रिमाइंडर बंद रहेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Probno razdoblje završava za 5 dana. Nakon toga dnevni podsjetnici prestaju dok ne odabereš plan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A próbaidőd 5 nap múlva lejár. Utána a napi emlékeztetőid leállnak, amíg nem választasz csomagot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa uji cobamu berakhir dalam 5 hari. Setelah itu, pengingat harianmu berhenti sampai kamu memilih paket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prova finisce tra 5 giorni. Poi i promemoria giornalieri si fermano finché non scegli un piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルは5日後に終わります。その後は、プランを選ぶまで毎日のリマインダーが止まります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಟ್ರಯಲ್ 5 ದಿನಗಳಲ್ಲಿ ಮುಗಿಯುತ್ತದೆ. ಅದರ ನಂತರ, ನೀವು ಯೋಜನೆಯನ್ನು ಆರಿಸುವವರೆಗೆ ನಿಮ್ಮ ದೈನಂದಿನ ಜ್ಞಾಪನೆಗಳು ನಿಲ್ಲುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험 기간이 5일 후에 끝나요. 그 후에는 이용권을 선택할 때까지 매일 알림이 멈춰요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ട്രയൽ 5 ദിവസത്തിനുള്ളിൽ അവസാനിക്കും. അതിനുശേഷം, നിങ്ങൾ ഒരു പ്ലാൻ തിരഞ്ഞെടുക്കുന്നതുവരെ നിങ്ങളുടെ ദൈനംദിന റിമൈൻഡറുകൾ നിലയ്ക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा ट्रायल 5 दिवसांत संपेल. त्यानंतर तुम्ही प्लॅन निवडेपर्यंत तुमचे रोजचे रिमाइंडर बंद राहतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percubaan anda tamat dalam 5 hari. Selepas itu, peringatan harian anda berhenti sehingga anda pilih pelan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøveperioden din slutter om 5 dager. Etter det stopper de daglige påminnelsene dine til du velger et abonnement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je proefperiode eindigt over 5 dagen. Daarna stoppen je dagelijkse herinneringen tot je een abonnement kiest."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଟ୍ରାଏଲ 5 ଦିନ ପରେ ଶେଷ ହେବ। ତାପରେ ଆପଣ ଏକ ପ୍ଲାନ ନ ବାଛିବା ପର୍ଯ୍ୟନ୍ତ ଆପଣଙ୍କ ଦୈନିକ ରିମାଇଣ୍ଡର୍ ବନ୍ଦ ରହିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਟ੍ਰਾਇਲ 5 ਦਿਨਾਂ ਵਿੱਚ ਖਤਮ ਹੋ ਜਾਵੇਗਾ। ਉਸ ਤੋਂ ਬਾਅਦ, ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਕੋਈ ਪਲਾਨ ਨਹੀਂ ਚੁਣਦੇ, ਤੁਹਾਡੇ ਰੋਜ਼ਾਨਾ ਰਿਮਾਈਂਡਰ ਬੰਦ ਰਹਿਣਗੇ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój okres próbny kończy się za 5 dni. Potem codzienne przypomnienia się zatrzymają, dopóki nie wybierzesz planu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste termina em 5 dias. Depois disso, seus lembretes diários param até você escolher um plano."
