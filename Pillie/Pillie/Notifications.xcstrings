        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੇ, ਝਟਪਟ ਚੇਕ-ਇਨ ਅਭੀ ਬਾਕ਼ੀ ਹੈ। ਜਦ ਤੈਯਾਰ ਹੋ, ਚੇਕ-ਇਨ ਕਰ"
          }
        }
      }
