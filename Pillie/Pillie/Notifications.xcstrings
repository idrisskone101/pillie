          "stringUnit": {
            "state": "translated",
            "value": "贴好贴片后，点按这里打卡。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना पैच लगाएँ, फिर दर्ज करने के लिए यहाँ टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nalijepi flaster, pa dodirni ovdje i javi se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyezd fel a tapaszt, aztán koppints ide, és pipáld ki."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandını yapıştır, sonra işaretlemek için buraya dokun."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பேட்ச்சை ஒட்டுங்கள், பிறகு பதிவு செய்ய இங்கே தட்டுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang koyomu, lalu ketuk di sini untuk check-in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضعي لصقتك، ثم انقري هنا للتسجيل."
