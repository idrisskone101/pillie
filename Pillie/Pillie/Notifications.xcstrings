    "notification.winback.slot4.new.body": {
      "comment": "ENG-173 win-back push after a hard-paywall trial ends",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا لتجربتك Pillie. هذا آخر إشعار منا. Pillie هنا متى أردتِه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ব্যবহার করে দেখার জন্য ধন্যবাদ। এটাই আমাদের শেষ নোটিফিকেশন। চাইলে Pillie এখানেই আছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gràcies per provar Pillie. Aquesta és la nostra última notificació. Pillie és aquí quan vulguis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Díky za vyzkoušení Pillie. Tohle je naše poslední oznámení. Pillie tu je, kdykoli ji budeš chtít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak, fordi du prøvede Pillie. Det her er vores sidste notifikation. Pillie er her, hvis du vil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke, dass du Pillie ausprobiert hast. Das ist unsere letzte Mitteilung. Pillie ist da, wenn du magst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστούμε που δοκίμασες το Pillie. Είναι η τελευταία μας ειδοποίηση. Το Pillie είναι εδώ όποτε θέλεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks for giving Pillie a try. This is our last notification. Pillie’s here if you want it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por probar Pillie. Esta es nuestra última notificación. Pillie sigue aquí cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiitos, että kokeilit Pillietä. Tämä on viimeinen ilmoituksemme. Pillie on täällä, jos haluat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci d’avoir essayé Pillie. C’est notre dernière notification. Pillie est là si tu en as envie."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie અજમાવવા બદલ આભાર. આ અમારું છેલ્લું નોટિફિકેશન છે. તમારે જોઈએ ત્યારે Pillie અહીં જ છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תודה שנתת ל-Pillie הזדמנות. זו ההתראה האחרונה שלנו. Pillie כאן אם תרצי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie आज़माने के लिए धन्यवाद। यह हमारा आख़िरी नोटिफ़िकेशन है। जब चाहें, Pillie यहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvala ti što si isprobala Pillie. Ovo je naša posljednja obavijest. Pillie je tu kad god ti zatreba."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Köszönjük, hogy kipróbáltad a Pillie-t. Ez az utolsó értesítésünk. A Pillie itt van, ha szeretnéd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih sudah mencoba Pillie. Ini notifikasi terakhir dari kami. Pillie ada di sini kalau kamu butuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per aver provato Pillie. Questa è la nostra ultima notifica. Pillie è qui quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieを試していただき、ありがとうございました。通知はこれで最後です。Pillieはいつでもここにあります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ಪ್ರಯತ್ನಿಸಿದ್ದಕ್ಕೆ ಧನ್ಯವಾದಗಳು. ಇದು ನಮ್ಮ ಕೊನೆಯ ಅಧಿಸೂಚನೆ. ನಿಮಗೆ ಬೇಕಾದಾಗ Pillie ಇಲ್ಲೇ ಇರುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie를 써 봐 주셔서 고마워요. 이번이 마지막 알림이에요. Pillie는 언제든 여기 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie പരീക്ഷിച്ചതിന് നന്ദി. ഇത് ഞങ്ങളുടെ അവസാന അറിയിപ്പാണ്. വേണമെങ്കിൽ Pillie ഇവിടെയുണ്ട്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie वापरून पाहिल्याबद्दल धन्यवाद. ही आमची शेवटची सूचना आहे. हवे असेल तेव्हा Pillie इथेच आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih kerana mencuba Pillie. Ini pemberitahuan terakhir kami. Pillie ada di sini jika kamu perlukan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk for at du prøvde Pillie. Dette er vårt siste varsel. Pillie er her hvis du vil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt dat je Pillie hebt geprobeerd. Dit is onze laatste melding. Pillie is er als je wilt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ବ୍ୟବହାର କରି ଦେଖିଥିବାରୁ ଧନ୍ୟବାଦ। ଏହା ଆମର ଶେଷ ନୋଟିଫିକେସନ୍। ଚାହିଁଲେ Pillie ଏଠାରେ ଅଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ਅਜ਼ਮਾਉਣ ਲਈ ਧੰਨਵਾਦ। ਇਹ ਸਾਡਾ ਆਖ਼ਰੀ ਨੋਟੀਫ਼ਿਕੇਸ਼ਨ ਹੈ। ਜਦੋਂ ਚਾਹੋ, Pillie ਇੱਥੇ ਹੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy za wypróbowanie Pillie. To nasze ostatnie powiadomienie. Pillie jest tu, jeśli zechcesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por experimentar o Pillie. Esta é nossa última notificação. O Pillie está aqui se você quiser."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por experimentares o Pillie. Esta é a nossa última notificação. O Pillie está aqui se quiseres."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulțumim că ai încercat Pillie. Asta e ultima noastră notificare. Pillie e aici dacă vrei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо, что попробовала Pillie. Это наше последнее уведомление. Pillie здесь, если понадобится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vďaka za vyskúšanie Pillie. Toto je naše posledné oznámenie. Pillie tu je, kedykoľvek ju budeš chcieť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvala za preizkus Pillie. To je naše zadnje obvestilo. Pillie ostaja tu, kadar ti bo prav."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack för att du testade Pillie. Det här är vår sista notis. Pillie finns här om du vill."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie-ஐ முயன்றதற்கு நன்றி. இது எங்கள் கடைசி அறிவிப்பு. வேண்டும்போது Pillie இங்கேயே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieని ప్రయత్నించినందుకు ధన్యవాదాలు. ఇది మా చివరి నోటిఫికేషన్. మీకు కావాలంటే Pillie ఇక్కడే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณที่ลองใช้ Pillie นี่เป็นการแจ้งเตือนครั้งสุดท้ายจากเรา Pillie อยู่ตรงนี้เสมอถ้าคุณต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie’yi denediğin için teşekkürler. Bu son bildirimimiz. İstersen Pillie burada."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дякуємо, що спробувала Pillie. Це наше останнє сповіщення. Pillie буде тут, якщо захочеш."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie آزمانے کا شکریہ۔ یہ ہمارا آخری نوٹیفکیشن ہے۔ جب چاہیں، Pillie یہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn bạn đã dùng thử Pillie. Đây là thông báo cuối cùng của chúng mình. Pillie vẫn ở đây nếu bạn cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谢谢你试用 Pillie。这是我们的最后一条通知。需要时，Pillie 一直都在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謝謝你試用 Pillie。這是我們的最後一則通知。需要時，Pillie 一直都在。"
          }
        }
      }
    },
