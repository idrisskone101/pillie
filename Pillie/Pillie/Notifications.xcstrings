{
  "sourceLanguage": "en",
  "strings": {
    "notification.action.complete": {
      "comment": "Category action; method-neutral [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark as Completed"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna come completata"
          }
        }
      }
    },
    "notification.action.snooze": {
      "comment": "Category action [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind Me Later"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricordamelo più tardi"
          }
        }
      }
    },
    "notification.active_resume.body": {
      "comment": "Reminder statement [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next active-day reminder follows the time you selected."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prossimo promemoria per un giorno attivo seguirà l’orario scelto."
          }
        }
      }
    },
    "notification.active_resume.title": {
      "comment": "Regimen transition [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled reminders resume today"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria programmati riprendono oggi"
          }
        }
      }
    },
    "notification.break_start.body": {
      "comment": "Pill regimen only [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled pill reminders pause during your break days."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria programmati per la pillola si interrompono durante i giorni di pausa."
          }
        }
      }
    },
    "notification.break_start.patch.body": {
      "comment": "Issue #233 method-aware notification",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled patch reminders pause during your patch-free days."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria programmati per il cerotto si interrompono durante i giorni senza cerotto."
          }
        }
      }
    },
    "notification.break_start.ring.body": {
      "comment": "Issue #233 method-aware notification",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled ring reminders pause during your ring-free days."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria programmati per l’anello si interrompono durante i giorni senza anello."
          }
        }
      }
    },
    "notification.break_start.title": {
      "comment": "Regimen transition [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Break days begin today"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni di pausa iniziano oggi"
          }
        }
      }
    },
    "notification.custom.direct.final": {
      "comment": "Default preset [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Final reminder: no action is logged yet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria finale: non è ancora stata registrata alcuna azione."
          }
        }
      }
    },
    "notification.custom.direct.followup": {
      "comment": "Default preset [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s action is still open."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’azione di oggi è ancora da registrare."
          }
        }
      }
    },
    "notification.custom.direct.primary": {
      "comment": "Default preset [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your scheduled action is due."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È prevista l’azione programmata."
          }
        }
      }
    },
    "notification.custom.encouraging.final": {
      "comment": "Default preset [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last scheduled check-in for today."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultima registrazione programmata per oggi."
          }
        }
      }
    },
    "notification.custom.encouraging.followup": {
      "comment": "Default preset [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can log today’s action when you’re ready."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi registrare l’azione di oggi quando vuoi."
          }
        }
      }
    },
    "notification.custom.encouraging.primary": {
      "comment": "Default preset [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick check-in for today’s routine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una breve registrazione per la routine di oggi."
          }
        }
