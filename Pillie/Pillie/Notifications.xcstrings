          "stringUnit": {
            "state": "translated",
            "value": "તૈયાર હો ત્યારે, આજે નોંધ કરવાનું યાદ રાખજો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಸಿದ್ಧರಾದಾಗ, ಇಂದು ದಾಖಲಿಸಲು ನೆನಪಿಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തയ്യാറാകുമ്പോൾ, ഇന്ന് രേഖപ്പെടുത്താൻ ഓർക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तयार असाल तेव्हा, आज नोंद करायला विसरू नका."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରସ୍ତୁତ ହେଲେ ଆଜି ଦର୍ଜ କରିବାକୁ ମନେ ରଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤਿਆਰ ਹੋਵੋ, ਅੱਜ ਦਰਜ ਕਰਨਾ ਯਾਦ ਰੱਖਣਾ।"
          }
        }
      }
    },
