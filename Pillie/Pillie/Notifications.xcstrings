        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕, 짧은 체크인이에요. 패치를 붙였으면 기록해요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei, pengesahan ringkas. Lekatkan tampalan kamu selepas selesai"
