        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej, rychlé potvrzení. Nalep si náplast a potvrď"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привет, быстрая отметка. Наклей пластырь и отметься"
