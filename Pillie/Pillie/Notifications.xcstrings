        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼好貼片後，點一下這裡打卡。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો પેચ લગાવો, પછી નોંધ કરવા અહીં ટૅપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪ್ಯಾಚ್ ಅಂಟಿಸಿ, ನಂತರ ದಾಖಲಿಸಲು ಇಲ್ಲಿ ಟ್ಯಾಪ್ ಮಾಡಿ."
