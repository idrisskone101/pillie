    "notification.reminder.patch.apply.body": {
      "comment": "Notification copy [notification.reminder.patch.apply.body]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply your patch, then tap here to check in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klebe dein Pflaster auf, dann tippe hier zum Abhaken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica il cerotto, poi tocca qui per confermare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose ton patch, puis touche ici pour valider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca tu parche y luego toca aquí para marcarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplique seu adesivo e depois toque aqui para registrar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak je pleister en tik dan hier om af te vinken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätt på ditt plåster och tryck sedan här för att bocka av."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt dit plaster på, og tryk så her for at krydse af."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett på plasteret, og trykk her for å krysse av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinnitä laastarisi ja kuittaa napauttamalla tästä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
