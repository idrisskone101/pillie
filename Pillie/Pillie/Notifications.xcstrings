        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പാച്ച് ഒട്ടിക്കൂ, എന്നിട്ട് രേഖപ്പെടുത്താൻ ഇവിടെ ടാപ്പ് ചെയ്യൂ."
