    "notification.winback.slot1.blocker.body": {
      "comment": "ENG-173 win-back push after a hard-paywall trial ends",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت فترتك التجريبية، لذا توقف تذكيرك وحظر التطبيقات. انقري لإعادة تشغيلهما."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রায়াল শেষ, তাই আপনার রিমাইন্ডার আর অ্যাপ ব্লকিং বন্ধ। দুটোই আবার চালু করতে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova s’ha acabat, i el recordatori i el bloqueig d’apps estan desactivats. Toca per tornar-los a activar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkušební období skončilo, takže připomínka i blokování aplikací jsou vypnuté. Klepni a zapneš obojí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din prøveperiode er slut, så din påmindelse og appblokering er slået fra. Tryk for at slå begge til igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Testphase ist vorbei, also sind Erinnerung und App-Sperre aus. Tippe, um beides wieder einzuschalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δοκιμή τελείωσε, οπότε η υπενθύμιση και ο αποκλεισμός εφαρμογών σταμάτησαν. Πάτα για να τα ενεργοποιήσεις ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trial ended, so your reminder and app lock are off. Tap to turn both back on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba terminó, así que tu recordatorio y el bloqueo de apps están desactivados. Toca para reactivar ambos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilusi päättyi, joten muistutus ja sovellusesto ovat pois päältä. Napauta, niin molemmat palaavat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton essai est terminé, donc ton rappel et le blocage d’apps sont désactivés. Touche pour réactiver les deux."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટ્રાયલ પૂરી થઈ, એટલે તમારું રિમાઇન્ડર અને ઍપ બ્લૉકિંગ બંધ છે. બંને ફરી ચાલુ કરવા ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקופת הניסיון הסתיימה, אז התזכורת וחסימת האפליקציות כבויות. הקישי כדי להפעיל את שתיהן מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रायल ख़त्म होने से आपका रिमाइंडर और ऐप ब्लॉकिंग बंद हैं। दोनों को फिर से चालू करने के लिए टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Probno razdoblje je završilo pa su podsjetnik i blokiranje aplikacija isključeni. Dodirni da uključiš oboje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejárt a próbaidőszakod, így az emlékeztető és az appblokkolás is kikapcsolt. Koppints, és kapcsold vissza őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Uji cobamu sudah berakhir, jadi pengingat dan blokir aplikasi mati. Ketuk untuk menyalakan keduanya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova è finita, quindi promemoria e blocco app sono disattivati. Tocca per riattivarli entrambi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルが終了したため、リマインダーとアプリブロックはオフです。タップすると両方を再びオンにできます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟ್ರಯಲ್ ಮುಗಿದಿದ್ದರಿಂದ ನಿಮ್ಮ ಜ್ಞಾಪನೆ ಮತ್ತು ಆ್ಯಪ್ ನಿರ್ಬಂಧ ಆಫ್ ಆಗಿವೆ. ಎರಡನ್ನೂ ಮತ್ತೆ ಆನ್ ಮಾಡಲು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험이 끝나서 알림과 앱 차단이 꺼졌어요. 탭해서 둘 다 다시 켜세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ട്രയൽ അവസാനിച്ചതിനാൽ നിങ്ങളുടെ റിമൈൻഡറും ആപ്പ് ബ്ലോക്കിംഗും ഓഫാണ്. രണ്ടും വീണ്ടും ഓണാക്കാൻ ടാപ്പ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रायल संपल्यामुळे तुमचा रिमाइंडर आणि ॲप ब्लॉकिंग बंद आहेत. दोन्ही पुन्हा सुरू करण्यासाठी टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percubaan kamu telah tamat, jadi peringatan dan sekatan apl dimatikan. Ketik untuk menghidupkan kedua-duanya semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøveperioden din er over, så påminnelsen og appblokkeringen er av. Trykk for å slå på begge igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je proefperiode is voorbij, dus je herinnering en appblokkering staan uit. Tik om ze weer aan te zetten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଟ୍ରାୟାଲ୍ ଶେଷ ହେବାରୁ ଆପଣଙ୍କ ରିମାଇଣ୍ଡର୍ ଓ ଆପ୍ ବ୍ଲକିଂ ବନ୍ଦ ଅଛି। ଦୁଇଟିଯାକ ପୁଣି ଚାଲୁ କରିବାକୁ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟ੍ਰਾਇਲ ਖ਼ਤਮ ਹੋਣ ਕਰਕੇ ਤੁਹਾਡਾ ਰਿਮਾਈਂਡਰ ਅਤੇ ਐਪ ਬਲੌਕਿੰਗ ਬੰਦ ਹਨ। ਦੋਵੇਂ ਮੁੜ ਚਾਲੂ ਕਰਨ ਲਈ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okres próbny się skończył, więc przypomnienie i blokowanie aplikacji są wyłączone. Stuknij, aby włączyć oba."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste terminou, então o lembrete e o bloqueio de apps estão desligados. Toque para ligar os dois de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu teste terminou, por isso o lembrete e o bloqueio de apps estão desligados. Toca para os voltares a ligar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Proba s-a încheiat, așa că mementoul și blocarea aplicațiilor sunt oprite. Atinge ca să le pornești pe amândouă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробный период закончился, поэтому напоминание и блокировка приложений выключены. Коснись, чтобы включить их снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skúšobné obdobie sa skončilo, takže pripomienka aj blokovanie aplikácií sú vypnuté. Ťukni a zapneš obe."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preizkus se je končal, zato sta opomnik in blokiranje aplikacij izklopljena. Tapni, da vklopiš oboje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din provperiod är över, så din påminnelse och appblockering är avstängda. Tryck för att slå på båda igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சோதனைக் காலம் முடிந்ததால் உங்கள் நினைவூட்டலும் ஆப் தடுப்பும் ஆஃப் ஆகியுள்ளன. இரண்டையும் மீண்டும் இயக்கத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రయల్ ముగిసినందున మీ రిమైండర్, యాప్ బ్లాకింగ్ ఆఫ్ అయ్యాయి. రెండింటినీ మళ్లీ ఆన్ చేయడానికి నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงทดลองใช้สิ้นสุดแล้ว การแจ้งเตือนและการบล็อกแอปจึงปิดอยู่ แตะเพื่อเปิดทั้งสองอย่างอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme süren bitti, bu yüzden hatırlatman ve uygulama engelleme kapalı. İkisini de yeniden açmak için dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробний період завершився, тож нагадування й блокування застосунків вимкнено. Торкнись, щоб увімкнути обидва."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرائل ختم ہونے سے آپ کی یاد دہانی اور ایپ بلاکنگ بند ہیں۔ دونوں دوبارہ آن کرنے کے لیے ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dùng thử đã kết thúc nên lời nhắc và chặn ứng dụng đều đã tắt. Chạm để bật lại cả hai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用已结束，你的提醒和应用屏蔽都已关闭。点按即可全部重新开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用已結束，你的提醒和 App 封鎖都已關閉。點一下即可全部重新開啟。"
          }
        }
      }
    },
    "notification.winback.slot2.title": {
      "comment": "ENG-173 win-back push after a hard-paywall trial ends",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة الآن %@. لا تذكير الليلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন %@। আজ রাতে কোনো রিমাইন্ডার নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Són les %@. Sense recordatori aquest vespre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je %@. Dnes večer žádná připomínka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
