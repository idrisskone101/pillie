    "notification.refill.body": {
      "comment": "Estimate; no pharmacy claim [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current supply may be running low. Check it when convenient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scorte attuali potrebbero essere quasi terminate. Controllale quando puoi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein aktueller Vorrat könnte bald zur Neige gehen. Prüfe ihn bei Gelegenheit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton stock actuel est peut-être bas. Vérifie quand tu peux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suministro actual podría estar bajo. Revísalo cuando te convenga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu estoque atual pode estar acabando. Verifique quando for conveniente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je huidige voorraad raakt mogelijk op. Controleer het wanneer het uitkomt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt förråd kan börja ta slut. Kolla det när det passar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din beholdning er måske ved at være lav. Tjek den, når det passer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholdningen din kan begynne å bli lav. Sjekk den når det passer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varastosi saattaa olla vähissä. Tarkista se, kun sinulle sopii."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua reserva atual pode estar a acabar. Verifica quando te der jeito."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva reserva actual pot estar a punt d’acabar-se. Revisa-la quan et vagi bé."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zapas może się kończyć. Sprawdź go, gdy będzie ci wygodnie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje zásoba možná dochází. Zkontroluj ji, až se ti to bude hodit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой запас, возможно, заканчивается. Проверь, когда будет удобно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій запас, можливо, закінчується. Перевір, коли буде зручно."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残量が少なくなっているかもしれません。都合のよいときに確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 재고가 얼마 남지 않았을 수 있어요. 편할 때 확인해 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekalan kamu mungkin semakin berkurang. Semak bila senang."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerva ta actuală s-ar putea să fie pe terminate. Verifică-o când ai ocazia."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja zásoba sa možno míňa. Skontroluj ju, keď sa ti to hodí."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยาคงเหลือของคุณอาจใกล้หมด ลองเช็กดูเมื่อสะดวก"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前的库存可能快用完了。方便时检查一下。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारा मौजूदा स्टॉक कम हो रहा हो सकता है। सुविधा से चेक कर लो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja trenutačna zaliha možda je pri kraju. Provjeri je kad ti odgovara."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A készleted fogytán lehet. Nézd meg, amikor alkalmas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut stoğun azalıyor olabilir. Uygun bir zamanda kontrol et."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் தற்போதைய இருப்பு குறைந்திருக்கலாம். வசதியான நேரத்தில் சரிபார்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stokmu mungkin mulai menipis. Cek kalau sempat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكون مخزونك الحالي على وشك النفاد. تحققي منه عندما يناسبك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המלאי הנוכחי שלך אולי מתחיל להיגמר. בדקי אותו כשנוח לך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số lượng hiện có của bạn có thể sắp hết. Kiểm tra khi tiện."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার বর্তমান মজুত কমে আসতে পারে। সুবিধামতো চেক করে নাও।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہارا موجودہ ذخیرہ کم ہو رہا ہو سکتا ہے۔ فرصت میں چیک کر لو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja trenutna zaloga bo morda kmalu pošla. Preveri jo, ko ti ustreza."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τρέχον απόθεμά σου ίσως τελειώνει. Έλεγξέ το όποτε σε βολεύει."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ ప్రస్తుత నిల్వ తగ్గిపోతూ ఉండవచ్చు. వీలైనప్పుడు చెక్ చేసుకో."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前的庫存可能快用完了。方便時檢查一下。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તારા મૌજૂદા સ્ટૉક કમ હો રહા હો સકતા છે। સુવિધા સે ચેક કર લો।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ ಪ್ರಸ್ತುತ ನಿಲ್ವ ತಗ್ಗಿಪೋತೂ ಉಂಡವಚ್ಚು. ವೀಲೈನಪ್ಪುಡು ಚೆಕ್ ಚೇಸುಕೋ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഗുളിക സ്‌റ്റോക്ക് ഏകദേശം നോക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सध्याचा साठा कमी असू शकतो. सोयीनुसार तपास."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର ବର୍ତ୍ତମାନର ଷ୍ଟକ୍ କମ୍ ହେଉଥାଇପାରେ। ସୁବିଧାରେ ଯାଞ୍ଚ କର।"
