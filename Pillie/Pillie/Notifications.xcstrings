    "notification.trial_expiry.day10.body": {
      "comment": "Reverse Trial day-10 warning; app-blocking scope only [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App blocking turns off in 5 days. Your daily reminders stay free."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco app si disattiva tra 5 giorni. I promemoria giornalieri restano gratis."
