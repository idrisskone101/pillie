        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ପ୍ୟାଚ୍ ଲଗାନ୍ତୁ, ତାପରେ ଦର୍ଜ କରିବାକୁ ଏଠାରେ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
