    "notification.reminder.pill.body": {
      "comment": "Reminder, not advice [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take it, then tap here to check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendila, poi tocca qui per confermare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm sie, dann tippe hier zum Abhaken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prends-la, puis touche ici pour valider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tómala y luego toca aquí para marcarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tome a pílula e depois toque aqui para registrar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem hem en tik dan hier om af te vinken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta det och tryck sedan här för att bocka av."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag den, og tryk så her for at krydse af."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta den, og trykk her for å krysse av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota se ja kuittaa napauttamalla tästä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma-a e depois toca aqui para registar."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pren-la i després toca aquí per confirmar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weź ją, a potem stuknij tutaj, aby odhaczyć."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezmi si ji a pak klepnutím sem odškrtni dnešek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прими её, потом коснись здесь, чтобы отметиться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прийми її, потім торкнись тут, щоб відмітитися."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飲んだら、ここをタップして記録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복용하고 여기를 탭해서 체크하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil pil kamu, kemudian ketik di sini untuk sahkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia-o, apoi atinge aici ca să bifezi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezmi si ju a potom ťuknutím sem odškrtni dnešok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กินยา แล้วแตะที่นี่เพื่อเช็กอิน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服药后，点按这里打卡。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गोली लें, फिर दर्ज करने के लिए यहाँ टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzmi je, pa dodirni ovdje i javi se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedd be, aztán koppints ide, és pipáld ki."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapını al, sonra işaretlemek için buraya dokun."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாத்திரையை எடுத்துக்கொள்ளுங்கள், பிறகு பதிவு செய்ய இங்கே தட்டுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minum pilmu, lalu ketuk di sini untuk check-in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خذيها، ثم انقري هنا للتسجيل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קחי אותה, ואז הקישי כאן כדי לסמן."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uống thuốc, rồi chạm vào đây để điểm danh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিলটি খান, তারপর টিক দিতে এখানে ট্যাপ করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گولی لیں، پھر درج کرنے کے لیے یہاں ٹیپ کریں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzemi jo, nato tapni tukaj in odkljukaj."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάρε το χάπι σου και μετά πάτα εδώ για να το σημειώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మాత్ర తీసుకోండి, ఆ తర్వాత నమోదు చేయడానికి ఇక్కడ నొక్కండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服藥後，點一下這裡打卡。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગોળી લો, પછી નોંધ કરવા અહીં ટૅપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾತ್ರೆ ತೆಗೆದುಕೊಳ್ಳಿ, ನಂತರ ದಾಖಲಿಸಲು ಇಲ್ಲಿ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഗുളിക കഴിക്കൂ, എന്നിട്ട് രേഖപ്പെടുത്താൻ ഇവിടെ ടാപ്പ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गोळी घ्या, मग नोंद करण्यासाठी इथे टॅप करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପିଲ୍ ଖାଆନ୍ତୁ, ତାପରେ ଦର୍ଜ କରିବାକୁ ଏଠାରେ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਗੋਲੀ ਲਓ, ਫਿਰ ਦਰਜ ਕਰਨ ਲਈ ਇੱਥੇ ਟੈਪ ਕਰੋ।"
          }
        }
      }
    },
