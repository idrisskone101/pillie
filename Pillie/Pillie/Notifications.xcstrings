    "notification.trial_expiry.day15.body": {
      "comment": "Reverse Trial expiry-day notification body; no numbers, safe at delivery [paywall]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your daily reminders stay free. Plus adds follow-up reminders and App blocking."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى تذكيراتك اليومية مجانية. يضيف Plus تذكيرات المتابعة وحظر التطبيقات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার দৈনিক রিমাইন্ডার ফ্রি-ই থাকবে। Plus-এ পাবেন ফলো-আপ রিমাইন্ডার আর অ্যাপ ব্লকিং।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els recordatoris diaris continuen sent gratis. Plus hi afegeix els recordatoris de seguiment i el bloqueig d’apps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Denní připomínky zůstávají zdarma. Plus přidává následné připomínky a blokování aplikací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine daglige påmindelser forbliver gratis. Plus giver dig også opfølgende påmindelser og appblokering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine täglichen Erinnerungen bleiben kostenlos. Mit Plus kommen Folgeerinnerungen und die App-Sperre dazu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι καθημερινές υπενθυμίσεις σου μένουν δωρεάν. Το Plus προσθέτει υπενθυμίσεις συνέχειας και αποκλεισμό εφαρμογών."
