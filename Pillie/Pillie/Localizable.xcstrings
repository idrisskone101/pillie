    "legal.disclaimer": {
      "comment": "Use in app where a disclaimer is shown [legal]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie provides reminders and tracking only. It is not medical advice and does not replace guidance from a clinician. Always follow the instructions for your birth control method."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie offre esclusivamente promemoria e monitoraggio. Non fornisce consulenza medica e non sostituisce le indicazioni di un professionista sanitario. Segui sempre le istruzioni del tuo metodo contraccettivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie bietet nur Erinnerungen und Protokollierung. Die App ist keine medizinische Beratung und ersetzt nicht die Empfehlungen medizinischer Fachpersonen. Halte dich immer an die Anleitung deiner Verhütungsmethode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie propose uniquement des rappels et un suivi. Ce n'est pas un avis médical et ça ne remplace pas les conseils d'un·e professionnel·le de santé. Suis toujours les instructions de ta méthode contraceptive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie solo ofrece recordatorios y seguimiento. No es consejo médico ni sustituye la orientación de un profesional de salud. Sigue siempre las instrucciones de tu método anticonceptivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie oferece apenas lembretes e registro. Não é aconselhamento médico e não substitui orientação de profissionais de saúde. Sempre siga as instruções do seu método contraceptivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie biedt alleen herinneringen en bijhouden. Het is geen medisch advies en vervangt geen begeleiding van een zorgverlener. Volg altijd de instructies voor je anticonceptiemethode."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie erbjuder bara påminnelser och loggning. Det är inte medicinsk rådgivning och ersätter inte vägledning från vården. Följ alltid anvisningarna för din preventivmetod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie tilbyder kun påmindelser og registrering. Det er ikke lægefaglig rådgivning og erstatter ikke vejledning fra en læge. Følg altid anvisningerne for din præventionsmetode."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie gir bare påminnelser og logging. Det er ikke medisinske råd og erstatter ikke veiledning fra helsepersonell. Følg alltid bruksanvisningen for prevensjonsmetoden din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie tarjoaa vain muistutuksia ja seurantaa. Se ei ole lääketieteellinen neuvo eikä korvaa terveydenhuollon ammattilaisen ohjeita. Noudata aina ehkäisymenetelmäsi ohjeita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie fornece apenas lembretes e registo. Não é aconselhamento médico e não substitui as orientações de um profissional de saúde. Segue sempre as instruções do teu método contracetivo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie només ofereix recordatoris i registre. No és consell mèdic i no substitueix les indicacions d’un professional sanitari. Segueix sempre les instruccions del teu mètode anticonceptiu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie służy wyłącznie do przypomnień i zapisywania. Nie jest poradą medyczną i nie zastępuje zaleceń lekarza. Zawsze stosuj się do instrukcji swojej metody antykoncepcji."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie poskytuje pouze připomínky a sledování. Nejde o lékařskou radu a nenahrazuje doporučení lékaře. Vždy se řiď pokyny ke své metodě antikoncepce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie предоставляет только напоминания и отслеживание. Это не медицинская консультация, и она не заменяет рекомендации врача. Всегда следуй инструкции к своему методу контрацепции."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie надає лише нагадування та відстеження. Це не медична консультація, і вона не замінює рекомендацій лікаря. Завжди дотримуйся інструкції до свого методу контрацепції."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieが提供するのはリマインダーと記録機能のみです。医療上の助言ではなく、医師などの専門家の指導に代わるものではありません。避妊法の説明書には必ず従ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie는 알림과 기록 기능만 제공해요. 의학적 조언이 아니며 의료 전문가의 안내를 대신하지 않아요. 사용하는 피임 방법의 안내를 항상 따르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie hanya menyediakan peringatan dan penjejakan. Ia bukan nasihat perubatan dan tidak menggantikan panduan daripada pengamal perubatan. Sentiasa ikut arahan kaedah kontraseptif kamu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie oferă doar mementouri și urmărire. Nu reprezintă sfat medical și nu înlocuiește îndrumarea unui medic. Urmează întotdeauna instrucțiunile metodei tale contraceptive."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie poskytuje len pripomienky a sledovanie. Nie je to lekárska rada a nenahrádza odporúčania lekára. Vždy sa riaď návodom k svojej antikoncepčnej metóde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ให้บริการเฉพาะการแจ้งเตือนและการติดตามเท่านั้น ไม่ใช่คำแนะนำทางการแพทย์และไม่สามารถใช้แทนคำแนะนำจากแพทย์หรือผู้เชี่ยวชาญ โปรดปฏิบัติตามคำแนะนำของวิธีคุมกำเนิดที่คุณใช้เสมอ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 只提供提醒和记录功能。它不是医疗建议，也不能替代医生的指导。请始终遵循你所用避孕方式的说明。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie सिर्फ़ रिमाइंडर और ट्रैकिंग देता है। यह चिकित्सीय सलाह नहीं है और डॉक्टर के मार्गदर्शन की जगह नहीं लेता। अपने गर्भनिरोधक तरीक़े के निर्देशों का हमेशा पालन करो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie nudi samo podsjetnike i praćenje. Nije medicinski savjet i ne zamjenjuje upute liječnika. Uvijek slijedi upute za svoju metodu kontracepcije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie csak emlékeztetőket és követést nyújt. Nem orvosi tanács, és nem helyettesíti az orvosi útmutatást. Mindig kövesd a fogamzásgátló módszered utasításait."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie yalnızca hatırlatma ve takip sağlar. Tıbbi tavsiye değildir ve bir sağlık uzmanının yönlendirmesinin yerini almaz. Doğum kontrol yönteminin talimatlarına her zaman uy."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie நினைவூட்டல்களையும் கண்காணிப்பையும் மட்டுமே வழங்குகிறது. இது மருத்துவ ஆலோசனை அல்ல, மருத்துவரின் வழிகாட்டுதலுக்கு மாற்று அல்ல. உன் கருத்தடை முறையின் வழிமுறைகளை எப்போதும் பின்பற்று."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie hanya menyediakan pengingat dan pelacakan. Ini bukan nasihat medis dan tidak menggantikan arahan dari tenaga kesehatan. Selalu ikuti petunjuk metode kontrasepsimu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقدّم Pillie التذكيرات والتتبع فقط. وهو ليس نصيحة طبية ولا يحل محل إرشادات الطبيب. اتبعي دائمًا تعليمات وسيلة منع الحمل الخاصة بك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie מספקת תזכורות ומעקב בלבד. היא אינה ייעוץ רפואי ואינה מחליפה הנחיות של גורם רפואי. תמיד פעלי לפי ההוראות של אמצעי המניעה שלך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie chỉ cung cấp lời nhắc và theo dõi. Đây không phải lời khuyên y khoa và không thay thế hướng dẫn của bác sĩ. Hãy luôn làm theo hướng dẫn của phương pháp tránh thai bạn đang dùng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie শুধু রিমাইন্ডার ও ট্র্যাকিং দেয়। এটি চিকিৎসা পরামর্শ নয় এবং চিকিৎসকের নির্দেশনার বিকল্প নয়। সবসময় তোমার জন্মনিয়ন্ত্রণ পদ্ধতির নির্দেশনা অনুসরণ করো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie صرف یاد دہانیاں اور ٹریکنگ فراہم کرتا ہے۔ یہ طبی مشورہ نہیں ہے اور کسی معالج کی رہنمائی کا متبادل نہیں۔ اپنے مانع حمل طریقے کی ہدایات پر ہمیشہ عمل کرو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ponuja samo opomnike in sledenje. Ni medicinski nasvet in ne nadomešča navodil zdravstvenega strokovnjaka. Vedno upoštevaj navodila za svojo kontracepcijsko metodo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pillie παρέχει μόνο υπενθυμίσεις και παρακολούθηση. Δεν αποτελεί ιατρική συμβουλή και δεν αντικαθιστά την καθοδήγηση από επαγγελματία υγείας. Ακολούθα πάντα τις οδηγίες της αντισυλληπτικής μεθόδου σου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie రిమైండర్లు, ట్రాకింగ్ మాత్రమే అందిస్తుంది. ఇది వైద్య సలహా కాదు, వైద్యుల మార్గదర్శకానికి ప్రత్యామ్నాయం కాదు. నీ గర్భనిరోధక పద్ధతి సూచనలను ఎప్పుడూ పాటించు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 只提供提醒和記錄功能。它不是醫療建議，也不能取代醫師的指導。請務必遵循你所用避孕方式的說明。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie સિર્ફ઼ રિમાઇંડર અને ટ્રૈકિંગ દેતા છે। આ ચિકિત્સીય સલાહ નહીં છે અને ડૉક્ટર કે માર્ગદર્શન કી જગહ નહીં લેતા। તારા ગર્ભનિરોધક તરીક઼ે કે નિર્દેશોં કા હમેશા પાલન કર।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ಜ್ಞಾಪನೆಲು, ಟ್ರಾಕಿಂಗ್ ಮಾತ್ರೆಮೇ ಅಂದಿಸ್ತುಂದಿ. ಇದಿ ವೈದ್ಯ ಸಲಹಾ ಕಾದು, ವೈದ್ಯುಲ ಮಾರ್ಗದರ್ಶಕಾನಿಕಿ ಪ್ರತ್ಯಾಮ್ನಾಯಂ ಕಾದು. ನಿನ್ನ ಗರ್ಭನಿರೋಧಕ ಪದ್ಧತಿ ಸೂಚನಲನು ಎಪ್ಪುಡೂ ಪಾಟಿಂಚು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie റിമൈൻഡറുകളും ട്രാക്കിംഗും മാത്രമേ നൽകുന്നുള്ളൂ. ഇത് വൈദ്യോപദേശമല്ല, ഒരു ഡോക്ടറുടെ മാർഗ്ഗനിർദ്ദേശത്തിന് പകരവുമല്ല. നിന്റെ ഗർഭനിരോധന രീതിയുടെ നിർദ്ദേശങ്ങൾ എപ്പോഴും പാലിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie फक्त आठवण आणि ट्रैकिंग देता आहे. हे चिकित्सीय सलाह नाही आहे आणि डॉक्टर के मार्गदर्शन की जगह नाही लेता। तुझे गर्भनिरोधक तरीक़े के निर्देशों का हमेशा पालन कर।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie କେବଳ ରିମାଇଣ୍ଡର୍ ଓ ଟ୍ରାକିଂ ପ୍ରଦାନ କରେ। ଏହା ଚିକିତ୍ସା ପରାମର୍ଶ ନୁହେଁ ଏବଂ ଡାକ୍ତରଙ୍କ ମାର୍ଗଦର୍ଶନର ବିକଳ୍ପ ନୁହେଁ। ସବୁବେଳେ ତୁମର ଗର୍ଭନିରୋଧକ ପଦ୍ଧତିର ନିର୍ଦ୍ଦେଶ ମାନ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ਸਿਰ੍ਫ਼ ਰਿਮਾਇਂਡਰ ਤੇ ਟ੍ਰੈਕਿਂਗ ਦੇਤਾ ਹੈ। ਯਹ ਚਿਕਿਤ੍ਸੀਯ ਸਲਾਹ ਨਹੀਂ ਹੈ ਤੇ ਡੌਕ੍ਟਰ ਦੇ ਮਾਰ੍ਗਦਰ੍ਸ਼ਨ ਦੀ ਜਗਹ ਨਹੀਂ ਲੇਤਾ। ਅਪਨੇ ਗਰ੍ਭਨਿਰੋਧਕ ਤਰੀਕ਼ੇ ਦੇ ਨਿਰ੍ਦੇਸ਼ੋਂ ਦਾ ਹਮੇਸ਼ਾ ਪਾਲਨ ਕਰ।"
          }
        }
      }
    },
