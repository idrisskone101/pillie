        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਨੇ ਹੁਏ ਐਪਾਂ ਤਬ ਤੱਕ ਰੁਦੇ ਰਹਤੇ ਹੈਂ ਜਦ ਤੱਕ ਤੂੰ ਕਾਮ ਲਾਗ ਨਹੀਂ ਕਰਤੇ।"
          }
