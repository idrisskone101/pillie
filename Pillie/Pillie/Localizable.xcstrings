            "state": "translated",
            "value": "Pillie te lo recuerda, tú lo marcas y tu historial se completa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie lembra, você registra e seu histórico vai se completando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie herinnert je eraan, jij vinkt af en je geschiedenis vult zich aan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie påminner dig, du bockar av, och din historik fylls på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie minder dig om det. Du krydser af, og din historik fyldes ud."
