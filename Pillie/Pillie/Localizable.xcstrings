            "state": "translated",
            "value": "Més recordatoris fins que confirmis avui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Więcej przypomnień, dopóki nie odhaczysz dzisiejszego dnia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Další připomínky, dokud neodškrtneš dnešek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
