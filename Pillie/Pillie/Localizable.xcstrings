            "value": "యాప్ బ్లాకింగ్‌కు స్క్రీన్ టైమ్ అవసరం"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 封鎖需要螢幕使用時間"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપ બ્લૉકિંગ માટે સ્ક્રીન ટાઇમ જરૂરી છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್ ನಿರ್ಬಂಧಕ್ಕೆ ಸ್ಕ್ರೀನ್ ಟೈಮ್ ಬೇಕು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് ബ്ലോക്കിംഗിന് ‘സ്ക്രീൻ സമയം’ വേണം"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ॲप ब्लॉकिंगसाठी स्क्रीन टाइम हवा"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପ୍ ବ୍ଲକିଂ ପାଇଁ ସ୍କ୍ରିନ୍ ଟାଇମ୍ ଦରକାର"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਬਲੌਕਿੰਗ ਲਈ ਸਕ੍ਰੀਨ ਟਾਈਮ ਚਾਹੀਦਾ ਹੈ"
          }
        }
      }
    },
    "error.screen_time.body": {
      "comment": "Capability statement [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Screen Time access so Pillie can pause the apps you pick."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso a Tempo di utilizzo così Pillie può mettere in pausa le app che scegli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf Bildschirmzeit, damit Pillie die Apps pausieren kann, die du auswählst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise l’accès à Temps d’écran pour que Pillie puisse mettre en pause les apps que tu choisis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a Tiempo de uso para que Pillie pueda pausar las apps que elijas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao Tempo de Uso para o Pillie poder pausar os apps que você escolher."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toegang tot Schermtijd toe zodat Pillie de apps kan pauzeren die je kiest."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt åtkomst till Skärmtid så att Pillie kan pausa apparna du väljer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad adgang til Skærmtid, så Pillie kan sætte de apps, du vælger, på pause."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tilgang til Skjermtid så Pillie kan pause appene du velger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli Ruutuajan käyttö, jotta Pillie voi laittaa valitsemasi sovellukset tauolle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite o acesso ao Tempo de ecrã para o Pillie poder pausar as apps que escolheres."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet l’accés a Temps d’ús perquè Pillie pugui posar en pausa les apps que triïs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do Czasu przed ekranem, aby Pillie mogło wstrzymywać wybrane aplikacje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povol přístup k Času u obrazovky, aby Pillie mohla pozastavit aplikace, které vybereš."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши доступ к Экранному времени, чтобы Pillie мог ставить выбранные тобой приложения на паузу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволь доступ до Екранного часу, щоб Pillie міг ставити вибрані тобою застосунки на паузу."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieが選んだアプリを一時停止できるよう、スクリーンタイムへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie가 선택한 앱을 일시 중지할 수 있도록 스크린 타임 접근을 허용해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan akses Masa Skrin supaya Pillie boleh menjeda apl yang kamu pilih."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite accesul la Timp de utilizare ca Pillie să poată pune pe pauză aplicațiile alese."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľ prístup k Času pred obrazovkou, aby Pillie mohla pozastaviť aplikácie, ktoré vyberieš."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้เข้าถึงเวลาหน้าจอเพื่อให้ Pillie หยุดแอปที่คุณเลือกชั่วคราวได้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问屏幕使用时间，Pillie 才能暂停你选择的应用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन टाइम की अनुमति दें, ताकि Pillie आपके चुने हुए ऐप्स रोक सके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopusti pristup Vremenu uporabe zaslona da Pillie može pauzirati aplikacije koje odabereš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a Képernyőidő-hozzáférést, hogy a Pillie szüneteltethesse a választott appokat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie’nin seçtiğin uygulamaları duraklatabilmesi için Ekran Süresi erişimine izin ver."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தேர்ந்தெடுக்கும் ஆப்ஸை Pillie இடைநிறுத்த, ஸ்கிரீன் டைம் அணுகலை அனுமதியுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses Durasi Layar agar Pillie bisa menjeda aplikasi yang kamu pilih."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمحي بالوصول إلى مدة استخدام الجهاز ليتمكن Pillie من إيقاف التطبيقات التي تختارينها مؤقتًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרי גישה לזמן מסך כדי ש-Pillie תוכל להשהות את האפליקציות שבחרת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập Thời gian sử dụng để Pillie có thể tạm dừng các ứng dụng bạn chọn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie যেন আপনার বেছে নেওয়া অ্যাপগুলো পজ করতে পারে, সেজন্য স্ক্রিন টাইম অ্যাক্সেস দিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین ٹائم کی اجازت دیں، تاکہ Pillie آپ کی چنی ہوئی ایپس روک سکے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoli dostop do Časa pred zaslonom, da lahko Pillie začasno zaustavi aplikacije, ki jih izbereš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε την πρόσβαση στον Χρόνο επί οθόνης για να μπορεί το Pillie να βάζει σε παύση τις εφαρμογές που διαλέγεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎంచుకునే యాప్‌లను Pillie పాజ్ చేయడానికి, స్క్రీన్ టైమ్ యాక్సెస్ అనుమతించండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許存取螢幕使用時間，Pillie 才能暫停你選的 App。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે પસંદ કરો તે ઍપ્સ Pillie થોભાવી શકે તે માટે સ્ક્રીન ટાઇમની ઍક્સેસ આપો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆರಿಸುವ ಆ್ಯಪ್‌ಗಳನ್ನು Pillie ತಡೆಹಿಡಿಯಲು, ಸ್ಕ್ರೀನ್ ಟೈಮ್ ಪ್ರವೇಶವನ್ನು ಅನುಮತಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തിരഞ്ഞെടുക്കുന്ന ആപ്പുകൾ Pillie-ക്ക് പോസ് ചെയ്യാൻ, ‘സ്ക്രീൻ സമയം’ ആക്‌സസ് അനുവദിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन टाइमला परवानगी द्या, म्हणजे तुम्ही निवडलेली ॲप्स Pillie थांबवू शकेल."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ବାଛିଥିବା ଆପ୍‌ଗୁଡ଼ିକୁ Pillie ବିରାମ କରିପାରିବା ପାଇଁ ସ୍କ୍ରିନ୍ ଟାଇମ୍ ଆକ୍ସେସ୍ ଦିଅନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕ੍ਰੀਨ ਟਾਈਮ ਦੀ ਪਹੁੰਚ ਦਿਓ ਤਾਂ ਜੋ Pillie ਤੁਹਾਡੀਆਂ ਚੁਣੀਆਂ ਐਪਾਂ ਨੂੰ ਰੋਕ ਸਕੇ।"
          }
        }
      }
    },
    "error.screen_time.conflict_body": {
      "comment": "Screen Time refused because another app on the iPhone already holds it [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app on this iPhone is using Screen Time. Turn it off in that app, then try again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra app su questo iPhone sta usando Tempo di utilizzo. Disattivalo in quell’app, poi riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere App auf diesem iPhone nutzt Bildschirmzeit. Schalte sie in dieser App aus und versuch es dann noch mal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app de cet iPhone utilise Temps d’écran. Désactive-le dans cette app, puis réessaie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app de este iPhone está usando Tiempo de uso. Desactívalo en esa app y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro app neste iPhone está usando o Tempo de Uso. Desative-o nesse app e tente de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere app op deze iPhone gebruikt Schermtijd. Zet het uit in die app en probeer het opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan app på den här iPhonen använder Skärmtid. Stäng av det i den appen och försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden app på denne iPhone bruger Skærmtid. Slå det fra i den app, og prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen app på denne iPhonen bruker Skjermtid. Slå det av i den appen, og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen tämän iPhonen sovellus käyttää Ruutuaikaa. Laita se pois päältä siinä sovelluksessa ja yritä uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra app neste iPhone está a usar o Tempo de ecrã. Desativa-o nessa app e tenta outra vez."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una altra app d’aquest iPhone fa servir Temps d’ús. Desactiva’l en aquella app i torna-ho a provar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inna aplikacja na tym iPhonie używa Czasu przed ekranem. Wyłącz go w tamtej aplikacji i spróbuj ponownie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas u obrazovky na tomto iPhonu používá jiná aplikace. Vypni ho v ní a zkus to znovu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое приложение на этом iPhone уже использует Экранное время. Отключи его в том приложении и попробуй снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший застосунок на цьому iPhone уже використовує Екранний час. Вимкни його в тому застосунку й спробуй ще раз."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneでは別のアプリがスクリーンタイムを使用しています。そのアプリでオフにしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 다른 앱이 스크린 타임을 사용하고 있어요. 그 앱에서 끈 다음 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl lain pada iPhone ini sedang menggunakan Masa Skrin. Matikannya dalam apl itu, kemudian cuba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O altă aplicație de pe acest iPhone folosește Timp de utilizare. Dezactivează-l în aplicația aceea, apoi încearcă din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas pred obrazovkou na tomto iPhone používa iná aplikácia. Vypni ho v nej a skús to znova."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีแอปอื่นบน iPhone เครื่องนี้ใช้เวลาหน้าจออยู่ ปิดในแอปนั้นก่อน แล้วลองอีกครั้ง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 上的另一个应用正在使用屏幕使用时间。请在那个应用里关闭，然后再试一次。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone पर कोई दूसरा ऐप स्क्रीन टाइम इस्तेमाल कर रहा है। उस ऐप में इसे बंद करें, फिर दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Druga aplikacija na ovom iPhoneu koristi Vrijeme uporabe zaslona. Isključi ga u toj aplikaciji pa pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy másik app ezen az iPhone-on már használja a Képernyőidőt. Kapcsold ki abban az appban, majd próbáld újra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone’daki başka bir uygulama Ekran Süresi’ni kullanıyor. O uygulamada kapat, sonra yeniden dene."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த iPhone-இல் வேறொரு ஆப் ஸ்கிரீன் டைமைப் பயன்படுத்துகிறது. அந்த ஆப்பில் அதை ஆஃப் செய்து, மீண்டும் முயலுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi lain di iPhone ini sedang memakai Durasi Layar. Matikan di aplikasi itu, lalu coba lagi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق آخر على جهاز iPhone هذا يستخدم مدة استخدام الجهاز. أوقفيه من ذلك التطبيق، ثم حاولي مرة أخرى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפליקציה אחרת באייפון הזה משתמשת בזמן מסך. כבי את זה באפליקציה ההיא ונסי שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ứng dụng khác trên iPhone này đang dùng Thời gian sử dụng. Hãy tắt trong ứng dụng đó rồi thử lại."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই iPhone-এ অন্য একটি অ্যাপ স্ক্রিন টাইম ব্যবহার করছে। সেই অ্যাপে এটি বন্ধ করে আবার চেষ্টা করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس iPhone پر کوئی اور ایپ اسکرین ٹائم استعمال کر رہی ہے۔ اس ایپ میں اسے بند کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druga aplikacija v tem iPhonu uporablja Čas pred zaslonom. Izklopi ga v tisti aplikaciji in poskusi znova."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια άλλη εφαρμογή σε αυτό το iPhone χρησιμοποιεί τον Χρόνο επί οθόνης. Απενεργοποίησέ τον σε εκείνη την εφαρμογή και δοκίμασε ξανά."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ iPhoneలో మరో యాప్ స్క్రీన్ టైమ్‌ను ఉపయోగిస్తోంది. ఆ యాప్‌లో దాన్ని ఆఫ్ చేసి, మళ్లీ ప్రయత్నించండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支 iPhone 上的另一個 App 正在使用螢幕使用時間。請在那個 App 裡關閉，然後再試一次。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ iPhone પરની બીજી ઍપ સ્ક્રીન ટાઇમનો ઉપયોગ કરી રહી છે. તે ઍપમાં તેને બંધ કરો, પછી ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ iPhone ನಲ್ಲಿ ಇನ್ನೊಂದು ಆ್ಯಪ್ ಸ್ಕ್ರೀನ್ ಟೈಮ್ ಬಳಸುತ್ತಿದೆ. ಆ ಆ್ಯಪ್‌ನಲ್ಲಿ ಅದನ್ನು ಆಫ್ ಮಾಡಿ, ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ iPhone-ലെ മറ്റൊരു ആപ്പ് ‘സ്ക്രീൻ സമയം’ ഉപയോഗിക്കുന്നുണ്ട്. ആ ആപ്പിൽ അത് ഓഫാക്കിയ ശേഷം വീണ്ടും ശ്രമിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या iPhone वरील दुसरे ॲप स्क्रीन टाइम वापरत आहे. त्या ॲपमध्ये ते बंद करा, मग पुन्हा प्रयत्न करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି iPhone ରେ ଅନ୍ୟ ଏକ ଆପ୍ ସ୍କ୍ରିନ୍ ଟାଇମ୍ ବ୍ୟବହାର କରୁଛି। ସେହି ଆପ୍‌ରେ ଏହାକୁ ବନ୍ଦ କରନ୍ତୁ, ତା’ପରେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ iPhone ’ਤੇ ਕੋਈ ਹੋਰ ਐਪ ਸਕ੍ਰੀਨ ਟਾਈਮ ਵਰਤ ਰਹੀ ਹੈ। ਉਸ ਐਪ ਵਿੱਚ ਇਸਨੂੰ ਬੰਦ ਕਰੋ, ਫਿਰ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        }
      }
    },
