    "today.intervention.alert.body": {
      "comment": "Observed app state [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You opened a paused app before checking in today."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai aperto un’app in pausa prima di confermare oggi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast eine pausierte App geöffnet, bevor du heute abgehakt hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as ouvert une app en pause avant de valider aujourd’hui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has abierto una app en pausa antes de marcar lo de hoy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você abriu um app pausado antes de registrar hoje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opende een gepauzeerde app voordat je vandaag had afgevinkt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du öppnade en pausad app innan du hade bockat av i dag."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du åbnede en app på pause, før du havde krydset af i dag."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du åpnet en pauset app før du hadde krysset av i dag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avasit tauolla olevan sovelluksen ennen kuin kuittasit tänään."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abriste uma app em pausa antes de registares hoje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has obert una app en pausa abans de confirmar avui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymana aplikacja została otwarta jeszcze przed dzisiejszym odhaczeniem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastavená aplikace se otevřela ještě před dnešním odškrtnutím."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты открыла приложение на паузе, ещё не отметившись сегодня."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти відкрила застосунок на паузі, ще не відмітившись сьогодні."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の記録の前に、一時停止中のアプリを開きました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 체크하기 전에 일시 중지된 앱을 열었어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu membuka apl yang dijeda sebelum sahkan hari ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai deschis o aplicație pusă pe pauză înainte să bifezi ziua de azi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastavená aplikácia sa otvorila ešte pred dnešným odškrtnutím."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเปิดแอปที่หยุดชั่วคราวไว้ก่อนเช็กอินวันนี้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在今天打卡前打开了一个已暂停的应用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज दर्ज करने से पहले आपने एक रुका हुआ ऐप खोला।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzirana aplikacija otvorena je prije današnjeg javljanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitottál egy szüneteltetett appot, mielőtt ma kipipáltad volna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün işaretlemeden önce duraklatılmış bir uygulamayı açtın."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்று பதிவு செய்வதற்கு முன், இடைநிறுத்தப்பட்ட ஒரு ஆப்பைத் திறந்தீர்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu membuka aplikasi yang dijeda sebelum check-in hari ini."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتحتِ تطبيقًا متوقفًا مؤقتًا قبل أن تسجّلي اليوم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחת אפליקציה מושהית לפני שסימנת היום."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã mở một ứng dụng đang tạm dừng trước khi điểm danh hôm nay."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ টিক দেওয়ার আগে আপনি একটি পজ করা অ্যাপ খুলেছিলেন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج درج کرنے سے پہلے آپ نے ایک رکی ہوئی ایپ کھولی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred današnjo kljukico je bila odprta zaustavljena aplikacija."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξες μια εφαρμογή σε παύση πριν το σημειώσεις σήμερα."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు నమోదు చేయకముందే మీరు పాజ్‌లో ఉన్న ఒక యాప్‌ను తెరిచారు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在今天打卡前打開了一個已暫停的 App。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજે નોંધ કરતાં પહેલાં તમે થોભેલી ઍપ ખોલી હતી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಂದು ದಾಖಲಿಸುವ ಮೊದಲೇ ನೀವು ತಡೆಹಿಡಿದಿದ್ದ ಒಂದು ಆ್ಯಪ್ ತೆರೆದಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്ന് രേഖപ്പെടുത്തുന്നതിന് മുമ്പ്, പോസ് ആയിരുന്ന ഒരു ആപ്പ് നിങ്ങൾ തുറന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आज नोंद करण्याआधी तुम्ही एक थांबलेले ॲप उघडले."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଜି ଦର୍ଜ କରିବା ଆଗରୁ ଆପଣ ଏକ ବିରାମରେ ଥିବା ଆପ୍ ଖୋଲିଥିଲେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੱਜ ਦਰਜ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਤੁਸੀਂ ਇੱਕ ਰੁਕੀ ਹੋਈ ਐਪ ਖੋਲ੍ਹੀ ਸੀ।"
          }
        }
      }
    },
