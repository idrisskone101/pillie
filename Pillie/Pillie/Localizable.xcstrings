          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्ज करने तक ऐप्स रुके रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije su pauzirane dok se ne javiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appok szünetelnek, amíg ki nem pipálod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar sen işaretleyene kadar duraklar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பதிவு செய்யும் வரை ஆப்ஸ் இடைநிறுத்தப்படும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi dijeda sampai kamu check-in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف التطبيقات مؤقتًا حتى تسجّلي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציות מושהות עד שתסמני."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng tạm dừng cho đến khi bạn điểm danh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টিক না দেওয়া পর্যন্ত অ্যাপ পজ থাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درج کرنے تک ایپس رکی رہتی ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije so zaustavljene, dokler ne odkljukaš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές μένουν σε παύση μέχρι να το σημειώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు నమోదు చేసే వరకు యాప్‌లు పాజ్ అవుతాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 會暫停，直到你完成打卡。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નોંધ ન કરો ત્યાં સુધી ઍપ્સ થોભેલી રહે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ದಾಖಲಿಸುವವರೆಗೆ ಆ್ಯಪ್‌ಗಳು ತಡೆಹಿಡಿಯಲ್ಪಡುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ രേഖപ്പെടുത്തുന്നതുവരെ ആപ്പുകൾ പോസ് ആയിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोंद करेपर्यंत ॲप्स थांबलेली राहतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦର୍ଜ କରିବା ପର୍ଯ୍ୟନ୍ତ ଆପ୍ ବିରାମରେ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦਰਜ ਕਰਨ ਤੱਕ ਐਪਾਂ ਰੁਕੀਆਂ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        }
      }
    },
    "onboarding.blocking_setup.subtitle": {
      "comment": "Hero subtitle explaining pause-after-reminder flow [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The apps you pick pause after a reminder. They come back when you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che scegli vanno in pausa dopo un promemoria. Tornano quando confermi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Apps, die du wählst, pausieren nach einer Erinnerung. Wenn du abhakst, sind sie wieder da."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps que tu choisis se mettent en pause après un rappel. Elles reviennent quand tu valides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que elijas se pausan tras un recordatorio. Vuelven cuando marques lo de hoy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps que você escolher ficam pausados após um lembrete. Eles voltam quando você registrar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De apps die je kiest, pauzeren na een herinnering. Ze komen terug als je afvinkt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparna du väljer pausas efter en påminnelse. De kommer tillbaka när du bockar av."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De apps, du vælger, sættes på pause efter en påmindelse. De kommer tilbage, når du krydser af."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appene du velger, pauses etter en påminnelse. De kommer tilbake når du krysser av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitsemasi sovellukset menevät tauolle muistutuksen jälkeen. Ne palaavat, kun kuittaat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As apps que escolheres ficam em pausa após um lembrete. Voltam quando registares."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps que triïs es posen en pausa després d’un recordatori. Tornen quan confirmes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane aplikacje zostają wstrzymane po przypomnieniu. Wracają, gdy odhaczysz dzień."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrané aplikace se po připomínce pozastaví. Vrátí se, až odškrtneš dnešek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные приложения встают на паузу после напоминания. Они снова открываются, когда ты отмечаешься."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрані застосунки стають на паузу після нагадування. Вони знову відкриваються, коли ти відмічаєшся."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだアプリはリマインダーの後に一時停止します。記録すると、また開けるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 앱은 알림 후에 일시 중지돼요. 체크하면 다시 열 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl yang kamu pilih dijeda selepas peringatan. Apl itu kembali apabila kamu sahkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile pe care le alegi intră în pauză după un memento. Revin după ce bifezi ziua."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrané aplikácie sa po pripomienke pozastavia. Vrátia sa, keď odškrtneš dnešok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปที่คุณเลือกจะหยุดชั่วคราวหลังการแจ้งเตือน และกลับมาเมื่อคุณเช็กอิน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选择的应用会在提醒后暂停。打卡后就能重新打开。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके चुने हुए ऐप्स रिमाइंडर के बाद रुक जाते हैं। दर्ज करने पर वे फिर से खुल जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije koje odabereš pauziraju se nakon podsjetnika. Vraćaju se kad se javiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A választott appok egy emlékeztető után szünetelnek. Amikor kipipálod, visszatérnek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğin uygulamalar bir hatırlatmadan sonra duraklar. İşaretlediğinde geri gelirler."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தேர்ந்தெடுக்கும் ஆப்ஸ் நினைவூட்டலுக்குப் பிறகு இடைநிறுத்தப்படும். நீங்கள் பதிவு செய்ததும் அவை திரும்பும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi yang kamu pilih dijeda setelah pengingat. Aplikasi kembali saat kamu check-in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف التطبيقات التي تختارينها مؤقتًا بعد التذكير. وتعود عندما تسجّلي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציות שבחרת מושהות אחרי תזכורת. הן חוזרות כשאת מסמנת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng bạn chọn sẽ tạm dừng sau lời nhắc. Chúng trở lại khi bạn điểm danh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বেছে নেওয়া অ্যাপগুলো রিমাইন্ডারের পর পজ হবে। টিক দিলে সেগুলো আবার খোলা যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی چنی ہوئی ایپس یاد دہانی کے بعد رک جاتی ہیں۔ درج کرنے پر وہ دوبارہ کھل جاتی ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije, ki jih izbereš, se po opomniku zaustavijo. Vrnejo se, ko odkljukaš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές που διαλέγεις μπαίνουν σε παύση μετά από μια υπενθύμιση. Επιστρέφουν όταν το σημειώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎంచుకున్న యాప్‌లు రిమైండర్ తర్వాత పాజ్ అవుతాయి. మీరు నమోదు చేయగానే అవి తిరిగి వస్తాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你選的 App 會在提醒後暫停。打卡後就能再次開啟。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે પસંદ કરેલી ઍપ્સ રિમાઇન્ડર પછી થોભી જાય છે. નોંધ કરતાં તે ફરી ખૂલે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆರಿಸುವ ಆ್ಯಪ್‌ಗಳು ಜ್ಞಾಪನೆಯ ನಂತರ ತಡೆಹಿಡಿಯಲ್ಪಡುತ್ತವೆ. ನೀವು ದಾಖಲಿಸಿದಾಗ ಅವು ಮರಳುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തിരഞ്ഞെടുക്കുന്ന ആപ്പുകൾ റിമൈൻഡറിന് ശേഷം പോസ് ആകും. നിങ്ങൾ രേഖപ്പെടുത്തുമ്പോൾ അവ തിരികെ വരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही निवडलेली ॲप्स रिमाइंडरनंतर थांबतात. नोंद केल्यावर ती पुन्हा उघडतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ବାଛିଥିବା ଆପ୍ ରିମାଇଣ୍ଡର୍ ପରେ ବିରାମ ହୁଏ। ଦର୍ଜ କଲେ ସେଗୁଡ଼ିକ ପୁଣି ଖୋଲେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀਆਂ ਚੁਣੀਆਂ ਐਪਾਂ ਰਿਮਾਈਂਡਰ ਤੋਂ ਬਾਅਦ ਰੁਕ ਜਾਂਦੀਆਂ ਹਨ। ਦਰਜ ਕਰਨ ’ਤੇ ਉਹ ਮੁੜ ਖੁੱਲ੍ਹ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        }
      }
    },
    "onboarding.blocking_setup.empty_detail": {
      "comment": "Footer coach line before Screen Time authorization [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, Apple asks for Screen Time so the apps can pause. Tap Continue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi Apple chiede Tempo di utilizzo così le app possono andare in pausa. Tocca Continua."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Nächstes fragt Apple nach Bildschirmzeit, damit die Apps pausieren können. Tippe auf Weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, Apple demande l’accès à Temps d’écran pour que les apps puissent se mettre en pause. Touche Continuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, Apple pide acceso a Tiempo de uso para que las apps puedan pausarse. Toca Continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em seguida, a Apple pede Tempo de Uso para que os apps possam ser pausados. Toque em Continuar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daarna vraagt Apple om Schermtijd zodat de apps kunnen pauzeren. Tik op Verder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedan ber Apple om Skärmtid så att apparna kan pausas. Tryck på Fortsätt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Derefter beder Apple om Skærmtid, så apps kan sættes på pause. Tryk på Fortsæt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Deretter ber Apple om Skjermtid slik at appene kan pauses. Trykk på Fortsett."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraavaksi Apple pyytää Ruutuaikaa, jotta sovellukset voivat mennä tauolle. Napauta Jatka."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A seguir, a Apple pede acesso ao Tempo de ecrã para as apps poderem ficar em pausa. Toca em Continuar."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Després, Apple demana Temps d’ús perquè les apps es puguin posar en pausa. Toca Continuar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potem Apple poprosi o dostęp do Czasu przed ekranem, aby Pillie mogło wstrzymywać aplikacje. Stuknij Dalej."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poté Apple požádá o Čas u obrazovky, aby se aplikace mohly pozastavit. Klepni na Pokračovat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Далее Apple запросит доступ к Экранному времени, чтобы приложения могли вставать на паузу. Нажми «Дальше»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Далі Apple попросить доступ до Екранного часу, щоб застосунки могли ставати на паузу. Торкнись «Далі»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に、アプリを一時停止できるようAppleがスクリーンタイムへのアクセスを求めます。「続ける」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음으로 앱을 일시 중지할 수 있도록 Apple이 스크린 타임 권한을 요청해요. 계속을 탭하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seterusnya, Apple meminta Masa Skrin supaya apl boleh dijeda. Ketik Teruskan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoi Apple cere Timp de utilizare ca aplicațiile să poată intra în pauză. Atinge Continuă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potom Apple požiada o Čas pred obrazovkou, aby sa aplikácie mohli pozastaviť. Ťukni na Pokračovať."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จากนั้น Apple จะขอสิทธิ์เวลาหน้าจอเพื่อให้แอปหยุดชั่วคราวได้ แตะ “ต่อไป”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来，Apple 会请求屏幕使用时间权限，这样应用才能暂停。点按“继续”。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बाद Apple स्क्रीन टाइम की अनुमति माँगेगा, ताकि ऐप्स रुक सकें। जारी रखें पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatim Apple traži pristup Vremenu uporabe zaslona kako bi se aplikacije mogle pauzirati. Dodirni Nastavi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezután az Apple Képernyőidő-hozzáférést kér, hogy az appok szünetelhessenek. Koppints a Folytatás gombra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardından Apple, uygulamaların duraklayabilmesi için Ekran Süresi izni ister. Devam’a dokun."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அடுத்து, ஆப்ஸை இடைநிறுத்த Apple ஸ்கிரீன் டைம் அனுமதியைக் கேட்கும். தொடரவும் என்பதைத் தட்டுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikutnya, Apple meminta akses Durasi Layar agar aplikasi bisa dijeda. Ketuk Lanjut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعدها تطلب Apple إذن مدة استخدام الجهاز حتى تتوقف التطبيقات مؤقتًا. اضغطي متابعة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחר כך Apple תבקש גישה לזמן מסך כדי שהאפליקציות יוכלו להיות מושהות. הקישי על המשך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp theo, Apple sẽ yêu cầu quyền Thời gian sử dụng để các ứng dụng có thể tạm dừng. Chạm vào Tiếp tục."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এরপর অ্যাপগুলো পজ করার জন্য Apple স্ক্রিন টাইমের অনুমতি চাইবে। চালিয়ে যান-এ ট্যাপ করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے بعد Apple اسکرین ٹائم کی اجازت مانگے گا، تاکہ ایپس رک سکیں۔ جاری رکھیں پر ٹیپ کریں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nato Apple zahteva dostop do Časa pred zaslonom, da se aplikacije lahko zaustavijo. Tapni Nadaljuj."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά η Apple ζητά πρόσβαση στον Χρόνο επί οθόνης για να μπορούν οι εφαρμογές να μπαίνουν σε παύση. Πάτα Συνέχεια."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తర్వాత, యాప్‌లను పాజ్ చేయడానికి Apple స్క్రీన్ టైమ్ అనుమతి అడుగుతుంది. కొనసాగించండి నొక్కండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接下來，Apple 會要求存取螢幕使用時間，才能暫停 App。點一下「繼續」。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હવે ઍપ્સ થોભાવવા માટે Apple સ્ક્રીન ટાઇમની મંજૂરી માગશે. ચાલુ રાખો પર ટૅપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂದೆ, ಆ್ಯಪ್‌ಗಳನ್ನು ತಡೆಹಿಡಿಯಲು Apple ಸ್ಕ್ರೀನ್ ಟೈಮ್ ಅನುಮತಿ ಕೇಳುತ್ತದೆ. ಮುಂದುವರಿಸಿ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്തതായി, ആപ്പുകൾ പോസ് ചെയ്യാൻ Apple ‘സ്ക്രീൻ സമയം’ അനുമതി ചോദിക്കും. തുടരൂ ടാപ്പ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यानंतर ॲप्स थांबवता यावीत म्हणून Apple स्क्रीन टाइमची परवानगी मागेल. सुरू ठेवा वर टॅप करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହାପରେ ଆପ୍ ବିରାମ କରିବା ପାଇଁ Apple ସ୍କ୍ରିନ୍ ଟାଇମ୍ ଅନୁମତି ମାଗିବ। ଜାରି ରଖନ୍ତୁ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੱਗੇ, ਐਪਾਂ ਰੋਕਣ ਲਈ Apple ਸਕ੍ਰੀਨ ਟਾਈਮ ਦੀ ਇਜਾਜ਼ਤ ਮੰਗੇਗਾ। ਜਾਰੀ ਰੱਖੋ ’ਤੇ ਟੈਪ ਕਰੋ।"
          }
        }
      }
    },
