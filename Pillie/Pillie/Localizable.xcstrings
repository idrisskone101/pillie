    "onboarding.personalise.choice.snooze": {
      "comment": "Issue #233 runtime setup option",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I swipe reminders away."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorro via i promemoria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich wische Erinnerungen weg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je balaie les rappels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quito los recordatorios deslizando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizo e dispenso os lembretes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik veeg herinneringen weg."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag sveper bort påminnelser."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg stryger påmindelser væk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg sveiper påminnelser bort."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäisen muistutukset pois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizo os lembretes para o lado."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarto els recordatoris lliscant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucam przypomnienia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připomínky zavírám."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я смахиваю напоминания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я змахую нагадування."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーを消してしまう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 밀어서 없애 버려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya leret peringatan ke tepi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dau mementourile la o parte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomienky zatváram."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันปัดการแจ้งเตือนทิ้ง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我会划掉提醒。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं रिमाइंडर स्वाइप करके हटा देती हूँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnike samo odbacim."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellegyintem az emlékeztetőket."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatmaları kaydırıp geçiyorum."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நினைவூட்டல்களை ஸ்வைப் செய்து நீக்கிவிடுகிறேன்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aku langsung menutup pengingatnya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزيل التذكيرات بالسحب."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני מחליקה תזכורות הצידה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình vuốt bỏ lời nhắc."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি রিমাইন্ডার সোয়াইপ করে সরিয়ে দিই।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں یاد دہانیاں سوائپ کر کے ہٹا دیتی ہوں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opomnike kar podrsam stran."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σβήνω τις υπενθυμίσεις με ένα σύρσιμο."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను రిమైండర్లను స్వైప్ చేసి తీసేస్తాను."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我會把提醒滑掉。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હું રિમાઇન્ડર સ્વાઇપ કરીને હટાવી દઉં છું."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾನು ಜ್ಞಾಪನೆಗಳನ್ನು ಸ್ವೈಪ್ ಮಾಡಿ ತೆಗೆದುಬಿಡುತ್ತೇನೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞാൻ റിമൈൻഡറുകൾ സ്വൈപ്പ് ചെയ്ത് മാറ്റുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मी रिमाइंडर स्वाइप करून काढून टाकते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମୁଁ ରିମାଇଣ୍ଡର୍ ସ୍ୱାଇପ୍ କରି ହଟାଇଦିଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੈਂ ਰਿਮਾਈਂਡਰ ਸਵਾਈਪ ਕਰਕੇ ਹਟਾ ਦਿੰਦੀ ਹਾਂ।"
          }
        }
      }
    },
