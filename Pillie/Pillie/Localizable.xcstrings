        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ രേഖപ്പെടുത്തുന്നതുവരെ നിങ്ങൾ തിരഞ്ഞെടുത്ത ആപ്പുകൾ പോസ് ആയിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही नोंद करेपर्यंत तुम्ही निवडलेली ॲप्स थांबलेली राहतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଦର୍ଜ ନକରିବା ପର୍ଯ୍ୟନ୍ତ ଆପଣ ବାଛିଥିବା ଆପ୍ ବିରାମରେ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਦਰਜ ਨਹੀਂ ਕਰਦੇ, ਤੁਹਾਡੀਆਂ ਚੁਣੀਆਂ ਐਪਾਂ ਰੁਕੀਆਂ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        }
      }
