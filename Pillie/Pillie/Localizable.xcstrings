            "value": "APP-PAUSE"
          }
        }
      }
    },
    "onboarding.mechanism.enforce.title": {
      "comment": "Mechanism-proof second step title [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause distracting apps"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in pausa le app che distraggono"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ablenkende Apps pausieren"
          }
        }
      }
    },
    "onboarding.mechanism.enforce.detail": {
      "comment": "Mechanism-proof second step detail [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected apps stay paused until you log the action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app selezionate restano in pausa finché non registri l’azione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Apps bleiben pausiert, bis du die Aktion protokollierst."
          }
        }
      }
    },
    "onboarding.mechanism.release.phase": {
      "comment": "Mechanism-proof third phase [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
