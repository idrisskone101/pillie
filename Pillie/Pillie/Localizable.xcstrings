    "onboarding.demo.explainer": {
      "comment": "No adherence guarantee [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie reminds you, you check in, and your history fills in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie te lo ricorda, tu confermi e la cronologia si riempie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie erinnert dich, du hakst ab, und dein Verlauf füllt sich."
          }
        },
