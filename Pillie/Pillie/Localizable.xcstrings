    "onboarding.dial.patch.title": {
      "comment": "Onboarding drag-the-dial step (patch, wearing). ENG-146 [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long has this patch been on?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منذ متى تضعين هذه اللصقة؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্যাচটি কত দিন ধরে লাগানো আছে?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quant de temps fa que portes aquest pegat?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak dlouho už máš tuhle náplast?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor længe har dette plaster siddet på?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange ist dieses Pflaster schon drauf?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο καιρό έχεις αυτό το αυτοκόλλητο;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto tiempo llevas con este parche?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauanko tämä laastari on ollut kiinni?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis combien de temps portes-tu ce patch ?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ પેચ કેટલા સમયથી લગાવેલો છે?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה זמן המדבקה הזאת עלייך?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पैच कितने समय से लगा है?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko dugo već nosiš ovaj flaster?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mióta van fent ez a tapasz?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah berapa lama koyo ini terpasang?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da quanto porti questo cerotto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパッチを貼ってどのくらいですか？"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಪ್ಯಾಚ್ ಅಂಟಿಸಿ ಎಷ್ಟು ದಿನವಾಯಿತು?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 패치를 붙인 지 얼마나 됐어요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പാച്ച് ഒട്ടിച്ചിട്ട് എത്ര ദിവസമായി?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा पॅच किती दिवसांपासून लावलेला आहे?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah berapa lama tampalan ini dipakai?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor lenge har dette plasteret sittet på?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoelang zit deze pleister er al op?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
