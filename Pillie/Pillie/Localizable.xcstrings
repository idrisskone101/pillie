    "onboarding.personalise.distraction.subtitle": {
      "comment": "Screen Time selection [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the kinds of apps, or specific ones, that usually pull you away."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli i tipi di app, o app specifiche, che di solito ti distraggono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Arten von Apps oder einzelne Apps, die dich meistens ablenken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis les types d’apps, ou des apps précises, qui te détournent souvent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige los tipos de apps, o apps concretas, que suelen distraerte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os tipos de app, ou apps específicos, que costumam te distrair."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de soorten apps, of specifieke apps, die je meestal afleiden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj de typer av appar, eller specifika appar, som brukar distrahera dig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg de typer apps, eller bestemte apps, der plejer at trække dig væk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg typene apper, eller bestemte apper, som pleier å trekke deg bort."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse sovellustyypit tai tietyt sovellukset, jotka yleensä vievät huomiosi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe os tipos de apps, ou apps específicas, que costumam distrair-te."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria els tipus d’apps, o apps concretes, que normalment et distreuen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz rodzaje aplikacji albo konkretne aplikacje, które zwykle cię rozpraszają."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber druhy aplikací nebo konkrétní aplikace, které tě obvykle rozptylují."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери типы приложений или конкретные приложения, которые обычно тебя отвлекают."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обери типи застосунків або конкретні застосунки, які зазвичай тебе відволікають."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ついつい開いてしまうアプリの種類や、特定のアプリを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 손이 가는 앱의 종류나 특정 앱을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jenis apl, atau apl tertentu, yang biasanya mengalihkan perhatian kamu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege tipurile de aplicații, sau anumite aplicații, care de obicei te distrag."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber druhy aplikácií alebo konkrétne aplikácie, ktoré ťa zvyčajne rozptyľujú."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกประเภทแอปหรือแอปที่มักดึงความสนใจของคุณไป"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择常让你分心的应用类别，或具体的应用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस तरह के ऐप्स, या ख़ास ऐप्स, चुनें जो अक्सर आपका ध्यान खींच लेते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi vrste aplikacija, ili baš određene, koje te obično odvuku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, milyen típusú appok vagy konkrétan melyek vonják el általában a figyelmedet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni genelde oyalayan uygulama türlerini ya da belirli uygulamaları seç."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கவனத்தை வழக்கமாகச் சிதறடிக்கும் ஆப் வகைகளையோ குறிப்பிட்ட ஆப்ஸையோ தேர்ந்தெடுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jenis aplikasi, atau aplikasi tertentu, yang biasanya mengalihkan perhatianmu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختاري أنواع التطبيقات، أو تطبيقات بعينها، التي تشغلك عادةً."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרי סוגי אפליקציות, או אפליקציות מסוימות, שבדרך כלל מסיחות את דעתך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn loại ứng dụng, hoặc ứng dụng cụ thể, thường khiến bạn xao nhãng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে ধরনের অ্যাপ বা নির্দিষ্ট যে অ্যাপগুলো সাধারণত আপনার মনোযোগ কেড়ে নেয়, সেগুলো বেছে নিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس طرح کی ایپس، یا خاص ایپس، چنیں جو اکثر آپ کی توجہ کھینچ لیتی ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi vrste aplikacij ali točno določene, ki te običajno zamotijo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε τα είδη εφαρμογών, ή συγκεκριμένες εφαρμογές, που συνήθως σε αποσπούν."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సాధారణంగా మీ దృష్టిని మళ్లించే యాప్ రకాలను, లేదా నిర్దిష్ట యాప్‌లను ఎంచుకోండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇常讓你分心的 App 類別，或特定的 App。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જે પ્રકારની ઍપ્સ અથવા જે ખાસ ઍપ્સ તમારું ધ્યાન ખેંચી જાય છે, તે પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಾಮಾನ್ಯವಾಗಿ ನಿಮ್ಮ ಗಮನ ಸೆಳೆಯುವ ಆ್ಯಪ್ ವರ್ಗಗಳನ್ನು, ಅಥವಾ ನಿರ್ದಿಷ್ಟ ಆ್ಯಪ್‌ಗಳನ್ನು ಆರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സാധാരണ നിങ്ങളുടെ ശ്രദ്ധ തിരിക്കുന്ന ആപ്പ് വിഭാഗങ്ങളോ പ്രത്യേക ആപ്പുകളോ തിരഞ്ഞെടുക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जी ॲप्स सहसा तुमचे लक्ष ओढून घेतात, त्या प्रकारची ॲप्स किंवा ठरावीक ॲप्स निवडा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯେଉଁ ପ୍ରକାରର ଆପ୍ କିମ୍ବା ନିର୍ଦ୍ଦିଷ୍ଟ ଆପ୍ ସାଧାରଣତଃ ଆପଣଙ୍କ ଧ୍ୟାନ ଟାଣିନିଏ, ସେଗୁଡ଼ିକୁ ବାଛନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਿਸ ਕਿਸਮ ਦੀਆਂ ਐਪਾਂ ਜਾਂ ਜਿਹੜੀਆਂ ਖ਼ਾਸ ਐਪਾਂ ਤੁਹਾਡਾ ਧਿਆਨ ਖਿੱਚ ਲੈਂਦੀਆਂ ਹਨ, ਉਹ ਚੁਣੋ।"
          }
        }
      }
    },
