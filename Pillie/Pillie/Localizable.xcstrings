    "onboarding.dial.patch.next_change_detail": {
      "comment": "Result row detail. %@ is a bare weekday name. ENG-146 [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every %@ at your reminder time"
          }
        },
        "ar": {
          "stringUnit": {
