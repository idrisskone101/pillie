    "onboarding.welcome.subtitle": {
      "comment": "Conservative rewrite; no effortless or guarantee claim [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe the reminder away and your apps stay paused until you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se scarti il promemoria, le app restano in pausa finché non confermi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wischst du die Erinnerung weg, bleiben deine Apps pausiert, bis du abhakst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie le rappel, et tes apps restent en pause jusqu’à ce que tu valides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quitas el recordatorio, tus apps siguen en pausa hasta que marques lo de hoy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você dispensar o lembrete, seus apps continuam pausados até você registrar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg je de herinnering weg, dan blijven je apps gepauzeerd tot je afvinkt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveper du bort påminnelsen förblir dina appar pausade tills du bockar av."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stryger du påmindelsen væk, forbliver dine apps på pause, indtil du krydser af."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveiper du bort påminnelsen, forblir appene dine pauset til du krysser av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos pyyhkäiset muistutuksen pois, sovelluksesi pysyvät tauolla, kunnes kuittaat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se deslizares o lembrete para o lado, as tuas apps ficam em pausa até registares."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si descartes el recordatori, les teves apps es queden en pausa fins que confirmis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsuń przypomnienie, a aplikacje zostaną wstrzymane, aż odhaczysz dzień."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavři připomínku a aplikace zůstanou pozastavené, dokud neodškrtneš dnešek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахнёшь напоминание, а приложения останутся на паузе, пока ты не отметишься."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змахнеш нагадування, а застосунки лишаться на паузі, доки ти не відмітишся."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーをスワイプで消しても、記録するまでアプリは一時停止したままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 밀어서 없애도, 체크할 때까지 앱은 일시 중지된 상태로 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret peringatan ke tepi, apl kamu kekal dijeda sehingga kamu sahkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai mementoul la o parte, iar aplicațiile rămân pe pauză până bifezi ziua."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavri pripomienku a aplikácie zostanú pozastavené, kým neodškrtneš dnešok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่อให้ปัดการแจ้งเตือนทิ้ง แอปของคุณก็ยังหยุดชั่วคราวจนกว่าคุณจะเช็กอิน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就算划掉提醒，你的应用也会一直暂停，直到你打卡。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर स्वाइप करके हटा दें, तो भी आपके ऐप्स दर्ज करने तक रुके रहते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako odbaciš podsjetnik, aplikacije ostaju pauzirane dok se ne javiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha ellegyinted az emlékeztetőt, az appjaid szünetelnek, amíg ki nem pipálod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatmayı kaydırıp geçsen de uygulamaların sen işaretleyene kadar duraklatılmış kalır."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நினைவூட்டலை ஸ்வைப் செய்து நீக்கினாலும், நீங்கள் பதிவு செய்யும் வரை உங்கள் ஆப்ஸ் இடைநிறுத்தத்தில் இருக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meski pengingatnya kamu tutup, aplikasimu tetap dijeda sampai kamu check-in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا أزحتِ التذكير، تبقى تطبيقاتك متوقفة مؤقتًا حتى تسجّلي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גם אם תחליקי את התזכורת הצידה, האפליקציות שלך יישארו מושהות עד שתסמני."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có gạt lời nhắc đi thì ứng dụng của bạn vẫn tạm dừng cho đến khi bạn điểm danh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডার সোয়াইপ করে সরালেও, টিক না দেওয়া পর্যন্ত আপনার অ্যাপগুলো পজ থাকবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی سوائپ کر کے ہٹا دیں، تب بھی آپ کی ایپس درج کرنے تک رکی رہتی ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če opomnik podrsaš stran, aplikacije ostanejo zaustavljene, dokler ne odkljukaš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν σβήσεις την υπενθύμιση, οι εφαρμογές σου μένουν σε παύση μέχρι να το σημειώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిమైండర్‌ను స్వైప్ చేసి తీసేసినా, మీరు నమోదు చేసే వరకు మీ యాప్‌లు పాజ్‌లోనే ఉంటాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "就算滑掉提醒，你的 App 也會一直暫停，直到你打卡。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇન્ડર સ્વાઇપ કરીને હટાવો તો પણ, નોંધ ન કરો ત્યાં સુધી તમારી ઍપ્સ થોભેલી રહે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜ್ಞಾಪನೆಯನ್ನು ಸ್ವೈಪ್ ಮಾಡಿ ತೆಗೆದರೂ, ನೀವು ದಾಖಲಿಸುವವರೆಗೆ ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳು ತಡೆಹಿಡಿಯಲ್ಪಟ್ಟಿರುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിമൈൻഡർ സ്വൈപ്പ് ചെയ്ത് മാറ്റിയാലും, നിങ്ങൾ രേഖപ്പെടുത്തുന്നതുവരെ നിങ്ങളുടെ ആപ്പുകൾ പോസ് ആയിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर स्वाइप करून काढला तरी, नोंद करेपर्यंत तुमची ॲप्स थांबलेली राहतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ସ୍ୱାଇପ୍ କରି ହଟାଇଲେ ବି, ଦର୍ଜ କରିବା ପର୍ଯ୍ୟନ୍ତ ଆପଣଙ୍କ ଆପ୍ ବିରାମରେ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਈਂਡਰ ਸਵਾਈਪ ਕਰਕੇ ਹਟਾ ਦਿਓ, ਫਿਰ ਵੀ ਦਰਜ ਕਰਨ ਤੱਕ ਤੁਹਾਡੀਆਂ ਐਪਾਂ ਰੁਕੀਆਂ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        }
      }
    },
