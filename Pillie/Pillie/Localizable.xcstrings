          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές που διάλεξες μένουν σε παύση μέχρι να το σημειώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు నమోదు చేసే వరకు మీరు ఎంచుకున్న యాప్‌లు పాజ్‌లోనే ఉంటాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你選的 App 會一直暫停，直到你打卡。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે નોંધ ન કરો ત્યાં સુધી પસંદ કરેલી ઍપ્સ થોભેલી રહે છે."
