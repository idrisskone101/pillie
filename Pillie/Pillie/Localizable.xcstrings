          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentéskor tapaszra váltasz, és törlődnek a tablettás előzményeid."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan akan mengganti metodemu ke koyo dan menghapus riwayat pilmu."
