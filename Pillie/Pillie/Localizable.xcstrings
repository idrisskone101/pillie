        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோராயமாகச் சொன்னால் போதும். பிறகு மாற்றலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kira-kira saja. Kamu bisa mengubahnya nanti."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدير تقريبي فقط. يمكنك تغييره لاحقًا."
