          "stringUnit": {
            "state": "translated",
            "value": "مبني على الروتين الذي اخترتِه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נבנה מהשגרה שבחרת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được tạo từ lịch bạn đã chọn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার বেছে নেওয়া রুটিন থেকে তৈরি।"
