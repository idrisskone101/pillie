    "onboarding.frequency.subtitle": {
      "comment": "Replaces protection level [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This helps Pillie decide how firm your reminders should be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così Pillie capisce quanto devono essere insistenti i promemoria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So weiß Pillie, wie bestimmt deine Erinnerungen sein sollen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça aide Pillie à savoir à quel point tes rappels doivent insister."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto ayuda a Pillie a decidir cuánto deben insistir tus recordatorios."
