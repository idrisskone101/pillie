    "settings.custom_messages.followup_subtitle": {
      "comment": "Subtitle under 'Follow-up reminder' on its edit sheet: it only fires when today's check-in is still open [standard]",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم تسجّلي بعد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যদি এখনও চেক-ইন না করে থাকেন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si encara no has fet el registre"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud ses ještě nezapsala"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du ikke har tjekket ind endnu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls du noch nicht eingecheckt hast"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν δεν έχεις κάνει ακόμα check-in"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you haven’t checked in yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aún no has hecho el registro"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos et ole vielä kirjautunut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu n’as pas encore fait ton suivi"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો તમે હજી ચેક-ઇન ન કર્યું હોય"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם עדיין לא סימנת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आपने अभी तक चेक-इन नहीं किया है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako se još nisi prijavila"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha még nem jelentkeztél be"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kamu belum check-in"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non hai ancora fatto il check-in"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだチェックインしていないとき"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಇನ್ನೂ ಚೆಕ್-ಇನ್ ಮಾಡದಿದ್ದರೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 체크인하지 않았을 때"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇതുവരെ ചെക്ക്-ഇൻ ചെയ്തിട്ടില്ലെങ്കിൽ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही अजून चेक-इन केले नसेल तर"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda belum daftar masuk"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du ikke har sjekket inn ennå"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je nog niet hebt ingecheckt"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯଦି ଆପଣ ଏପର୍ଯ୍ୟନ୍ତ ଚେକ୍-ଇନ୍ କରିନାହାନ୍ତି"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
