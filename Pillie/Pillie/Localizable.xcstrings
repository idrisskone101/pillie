    "onboarding.dial.not_yet_status": {
      "comment": "Dial status after Not yet. ENG-146 [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not checked in yet. Pillie will remind you today."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم التسجيل بعد. سيذكّركِ Pillie اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও টিক দেওয়া হয়নি। Pillie আজ আপনাকে মনে করিয়ে দেবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara sense confirmar. Pillie t’ho recordarà avui."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím neodškrtnuto. Pillie ti dnes připomene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke krydset af endnu. Pillie minder dig om det i dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht abgehakt. Pillie erinnert dich heute."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν σημειώθηκε ακόμα. Το Pillie θα σου το θυμίσει σήμερα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún sin marcar. Pillie te lo recordará hoy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä kuitattu. Pillie muistuttaa sinua tänään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore validé. Pillie te le rappellera aujourd’hui."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજુ નોંધ થઈ નથી. Pillie આજે તમને યાદ અપાવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא סומן. תקבלי תזכורת מ-Pillie היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी दर्ज नहीं हुआ। आज आपको Pillie से रिमाइंडर मिलेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nije javljeno. Pillie će te danas podsjetiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs kipipálva. A Pillie ma emlékeztet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum check-in. Pillie akan mengingatkanmu hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora confermato. Pillie te lo ricorderà oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ記録がありません。今日Pillieがお知らせします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ದಾಖಲಾಗಿಲ್ಲ. Pillie ಇಂದು ನಿಮಗೆ ನೆನಪಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 체크 안 했어요. 오늘 Pillie가 알려 드릴게요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ രേഖപ്പെടുത്തിയിട്ടില്ല. Pillie ഇന്ന് നിങ്ങളെ ഓർമ്മിപ്പിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून नोंद नाही. Pillie आज तुम्हाला आठवण करून देईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum disahkan lagi. Pillie akan ingatkan kamu hari ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke krysset av ennå. Pillie minner deg på det i dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet afgevinkt. Pillie herinnert je er vandaag aan."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏପର୍ଯ୍ୟନ୍ତ ଦର୍ଜ ହୋଇନାହିଁ। Pillie ଆଜି ଆପଣଙ୍କୁ ମନେ ପକାଇବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਾਲੇ ਦਰਜ ਨਹੀਂ ਹੋਇਆ। ਅੱਜ ਤੁਹਾਨੂੰ Pillie ਤੋਂ ਰਿਮਾਈਂਡਰ ਆਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nieodhaczone. Pillie przypomni ci dziś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem registro. O Pillie vai te lembrar hoje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem registo. O Pillie vai lembrar-te hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nebifat. Pillie îți amintește azi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока не отмечено. Pillie напомнит сегодня."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ neodškrtnuté. Pillie ti dnes pripomenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še ni odkljukano. Pillie te danes opomni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte avbockat än. Pillie påminner dig i dag."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் பதிவு செய்யப்படவில்லை. Pillie இன்று உங்களுக்கு நினைவூட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా నమోదు కాలేదు. Pillie ఈరోజు మీకు గుర్తు చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้เช็กอิน Pillie จะเตือนคุณวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz işaretlenmedi. Pillie bugün sana hatırlatacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще не відмічено. Pillie нагадає сьогодні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی درج نہیں ہوا۔ Pillie آج آپ کو یاد دلائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa điểm danh. Hôm nay Pillie sẽ nhắc bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没打卡。Pillie 今天会提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒打卡。Pillie 今天會提醒你。"
          }
        }
      }
    },
    "onboarding.dial.patch.hint": {
      "comment": "Hint line under card, patch, no question. ENG-146 [health]",
      "localizations": {
        "en": {
          "stringUnit": {
