          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি টিক আপনার স্ট্রিক আর সাইকেলের ইতিহাসে যোগ হয়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر اندراج آپ کے سلسلے اور سائیکل ہسٹری میں جڑتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka kljukica podaljša tvoj niz in dopolni zgodovino cikla."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε μέρα που το σημειώνεις μεγαλώνει το σερί σου και συμπληρώνει το ιστορικό του κύκλου σου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి నమోదు మీ స్ట్రీక్‌కు, సైకిల్ చరిత్రకు జోడించబడుతుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次打卡都會計入你的連續打卡和週期歷史。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક નોંધ તમારી સ્ટ્રીક અને સાઇકલના ઇતિહાસમાં ઉમેરાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ದಾಖಲೂ ನಿಮ್ಮ ಸರಣಿಗೆ ಮತ್ತು ಚಕ್ರದ ಇತಿಹಾಸಕ್ಕೆ ಸೇರುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ രേഖപ്പെടുത്തലും നിങ്ങളുടെ സ്ട്രീക്കിലേക്കും സൈക്കിൾ ചരിത്രത്തിലേക്കും ചേരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक नोंद तुमच्या सलग मालिकेत आणि चक्राच्या इतिहासात भर घालते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ଥର ଦର୍ଜ କରିବା ଆପଣଙ୍କ ଧାରା ଓ ଚକ୍ର ଇତିହାସରେ ଯୋଗ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਵਾਰ ਦਰਜ ਕਰਨਾ ਤੁਹਾਡੀ ਸਟ੍ਰੀਕ ਅਤੇ ਸਾਈਕਲ ਇਤਿਹਾਸ ਵਿੱਚ ਜੁੜਦਾ ਹੈ।"
          }
        }
      }
    },
