    "settings.custom_messages.tone.gentle_body": {
      "comment": "Line under the tone control when Gentle is selected [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft words that give you a little room."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمات لطيفة تمنحكِ بعض المساحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোমল কথা, আপনাকে একটু সময় দেয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Paraules suaus que et donen una mica de marge."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemná slova, která ti nechají trochu prostoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bløde ord, der giver dig lidt luft."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanfte Worte, die dir etwas Raum lassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαλά λόγια που σου αφήνουν λίγο χώρο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Palabras suaves que te dan un poco de margen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pehmeitä sanoja, jotka antavat sinulle vähän tilaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des mots doux qui te laissent un peu de marge."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નરમ શબ્દો, જે તમને થોડી મોકળાશ આપે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מילים רכות שנותנות לך קצת מרחב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नरम शब्द, जो आपको थोड़ी गुंजाइश देते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nježne riječi koje ti ostavljaju malo prostora."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lágy szavak, amelyek hagynak egy kis teret."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-kata lembut yang memberimu sedikit ruang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parole morbide che ti lasciano un po’ di spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し余裕をくれる、やさしい言葉です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮಗೆ ಸ್ವಲ್ಪ ಅವಕಾಶ ನೀಡುವ ಮೃದು ಮಾತುಗಳು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조금 여유를 주는 부드러운 말이에요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്ക് അൽപം ഇടം നൽകുന്ന മൃദുവായ വാക്കുകൾ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला थोडी मोकळीक देणारे हळुवार शब्द."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-kata lembut yang memberi kamu sedikit ruang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Myke ord som gir deg litt rom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachte woorden die je wat ruimte geven."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କୁ ଟିକେ ସୁଯୋଗ ଦେଉଥିବା କୋମଳ କଥା।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਰਮ ਸ਼ਬਦ, ਜੋ ਤੁਹਾਨੂੰ ਥੋੜ੍ਹੀ ਗੁੰਜਾਇਸ਼ ਦਿੰਦੇ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łagodne słowa, które dają ci trochę przestrzeni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavras suaves que te dão um pouco de espaço."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavras suaves que te dão algum espaço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuvinte blânde care îți lasă puțin loc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкие слова, которые дают тебе немного свободы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemné slová, ktoré ti nechajú trochu priestoru."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nežne besede, ki ti pustijo nekaj prostora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjuka ord som ger dig lite utrymme."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்குச் சற்று இடம் தரும் மென்மையான சொற்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు కొంచెం వెసులుబాటు ఇచ్చే మృదువైన మాటలు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้อยคำนุ่มนวลที่ให้คุณมีพื้นที่บ้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana biraz alan tanıyan yumuşak sözler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "М’які слова, що дають тобі трохи простору."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نرم الفاظ، جو آپ کو تھوڑی گنجائش دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhẹ nhàng, cho bạn chút thong thả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温柔的话语，给你一点余地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫柔的話語，給你一點餘地。"
          }
        }
      }
    },
    "settings.custom_messages.tone.direct_body": {
      "comment": "Line under the tone control when Direct is selected [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short and clear. Says what to do, then stops."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قصيرة وواضحة. تقول ما عليكِ فعله ثم تتوقف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছোট ও স্পষ্ট। কী করতে হবে বলে, তারপর থামে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Curt i clar. Diu què has de fer i prou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátce a jasně. Řekne, co udělat, a dost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort og klart. Siger, hvad du skal, og stopper så."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz und klar. Sagt, was zu tun ist, und fertig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύντομα και καθαρά. Λέει τι να κάνεις και σταματά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corto y claro. Dice qué hacer y ya."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyhyt ja selkeä. Kertoo mitä tehdä, ja siinä se."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Court et clair. Dit quoi faire, puis s’arrête."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટૂંકું અને સ્પષ્ટ. શું કરવું તે કહે છે, પછી અટકે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קצר וברור. אומר מה לעשות, ונגמר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटा और साफ़। क्या करना है, बताकर रुक जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kratko i jasno. Kaže što treba i stane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rövid és világos. Megmondja, mit tegyél, és kész."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Singkat dan jelas. Bilang apa yang perlu dilakukan, lalu selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Breve e chiaro. Dice cosa fare, poi basta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短くはっきり。することだけ伝えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಿಕ್ಕದು, ಸ್ಪಷ್ಟ. ಏನು ಮಾಡಬೇಕೆಂದು ಹೇಳಿ ನಿಲ್ಲುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧고 분명해요. 할 일만 말하고 끝나요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചുരുക്കവും വ്യക്തവും. ചെയ്യേണ്ടത് പറഞ്ഞ് നിർത്തും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटे आणि स्पष्ट. काय करायचे ते सांगून थांबते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringkas dan jelas. Beritahu apa perlu dibuat, kemudian berhenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort og klart. Sier hva du skal gjøre, og stopper der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort en duidelijk. Zegt wat je moet doen en stopt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଛୋଟ ଓ ସ୍ପଷ୍ଟ। କଣ କରିବେ କହି ଅଟକିଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਛੋਟਾ ਤੇ ਸਾਫ਼। ਕੀ ਕਰਨਾ ਹੈ ਦੱਸ ਕੇ ਰੁਕ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótko i jasno. Mówi, co zrobić, i tyle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Curto e claro. Diz o que fazer e para."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Curto e claro. Diz o que fazer e fica por aí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scurt și clar. Spune ce ai de făcut, apoi se oprește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коротко и ясно. Говорит, что сделать, и всё."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátko a jasne. Povie, čo urobiť, a dosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kratko in jasno. Pove, kaj narediti, in konec."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort och tydligt. Säger vad du ska göra och slutar där."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கமாக, தெளிவாக. செய்ய வேண்டியதைச் சொல்லி நிற்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చిన్నగా, స్పష్టంగా. ఏం చేయాలో చెప్పి ఆగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สั้นและชัด บอกสิ่งที่ต้องทำแล้วจบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa ve net. Ne yapacağını söyler, o kadar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коротко і ясно. Каже, що зробити, і все."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مختصر اور واضح۔ کیا کرنا ہے، بتا کر رک جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngắn gọn, rõ ràng. Nói việc cần làm rồi thôi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简短清楚。说完该做什么就停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簡短清楚。說完該做什麼就停。"
          }
        }
      }
    },
    "settings.custom_messages.tone.encouraging_body": {
      "comment": "Line under the tone control when Encouraging is selected [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheers you on as the habit takes hold."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشجّعكِ بينما تترسّخ العادة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অভ্যাস গড়ে ওঠার সময় আপনাকে উৎসাহ দেয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "T’anima mentre l’hàbit va arrelant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fandí ti, než se zvyk ujme."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hepper på dig, mens vanen sætter sig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feuert dich an, während die Gewohnheit wächst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε ενθαρρύνει όσο η συνήθεια παγιώνεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te anima mientras el hábito se asienta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kannustaa sinua, kun tapa vakiintuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "T’encourage pendant que l’habitude s’installe."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આદત પડતી જાય તેમ તમારો ઉત્સાહ વધારે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעודד אותך בזמן שההרגל נקלט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आदत बनते समय आपका हौसला बढ़ाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodri te dok navika ne zaživi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szurkol neked, amíg a szokás meggyökerezik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyemangatimu selagi kebiasaan terbentuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa il tifo per te mentre l’abitudine si consolida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣が身につくまで応援します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಭ್ಯಾಸ ರೂಢಿಯಾಗುವಾಗ ನಿಮ್ಮನ್ನು ಹುರಿದುಂಬಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관이 자리 잡을 때까지 응원해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശീലം ഉറയ്ക്കുമ്പോൾ നിങ്ങളെ പ്രോത്സാഹിപ്പിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सवय रुजत असताना तुम्हाला प्रोत्साहन देते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyokong kamu sambil tabiat itu terbentuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Heier på deg mens vanen setter seg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moedigt je aan terwijl de gewoonte wortel schiet."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅଭ୍ୟାସ ଗଢ଼ିଉଠିବା ବେଳେ ଆପଣଙ୍କୁ ଉତ୍ସାହ ଦିଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਦਤ ਪੱਕੀ ਹੋਣ ਤੱਕ ਤੁਹਾਡਾ ਹੌਸਲਾ ਵਧਾਉਂਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kibicuje ci, gdy nawyk się utrwala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Torce por você enquanto o hábito se firma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoia-te enquanto o hábito se instala."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Te încurajează cât timp obiceiul prinde rădăcini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживает тебя, пока привычка закрепляется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fandí ti, kým sa zvyk neujme."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spodbuja te, medtem ko se navada utrjuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hejar på dig medan vanan sätter sig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பழக்கம் உறுதியாகும்போது உங்களை உற்சாகப்படுத்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అలవాటు స్థిరపడేటప్పుడు మిమ్మల్ని ప్రోత్సహిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นกำลังใจให้ระหว่างที่นิสัยเริ่มติดตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışkanlık oturana kadar seni destekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримує тебе, поки звичка закріплюється."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عادت پختہ ہونے تک آپ کی حوصلہ افزائی کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cổ vũ bạn trong lúc thói quen dần hình thành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在习惯养成时为你加油。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在習慣養成時為你加油。"
          }
        }
      }
    },
    "settings.custom_messages.tone.private_body": {
      "comment": "Line under the tone control when Private is selected [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doesn’t name your birth control."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تذكر وسيلة منع الحمل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জন্মনিয়ন্ত্রণ পদ্ধতির নাম বলে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No anomena el teu anticonceptiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezmiňuje tvou antikoncepci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nævner ikke din prævention."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwähnt deine Verhütung nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν αναφέρει την αντισύλληψή σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No nombra tu anticonceptivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei mainitse ehkäisyäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne nomme pas ta contraception."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ગર્ભનિરોધક પદ્ધતિનું નામ લેતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא מזכיר את אמצעי המניעה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके गर्भनिरोधक का नाम नहीं लेता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne spominje tvoju kontracepciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem nevezi meg a fogamzásgátlódat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak menyebut alat kontrasepsimu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non nomina il tuo contraccettivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "避妊方法の名前は出しません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಗರ್ಭನಿರೋಧಕದ ಹೆಸರು ಹೇಳುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피임 방법을 언급하지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഗർഭനിരോധന മാർഗത്തിന്റെ പേര് പറയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या गर्भनिरोधकाचे नाव घेत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak menyebut kaedah perancang keluarga kamu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevner ikke prevensjonen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noemt je anticonceptie niet."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଗର୍ଭନିରୋଧକର ନାମ ନିଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਗਰਭ ਨਿਰੋਧਕ ਦਾ ਨਾਂ ਨਹੀਂ ਲੈਂਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie nazywa twojej antykoncepcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não cita seu anticoncepcional."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não refere o teu contracetivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu îți numește contraceptivul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не называет твою контрацепцию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nespomína tvoju antikoncepciu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne omenja tvoje kontracepcije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämner inte ditt preventivmedel."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கருத்தடை முறையின் பெயரைச் சொல்லாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ గర్భనిరోధక పద్ధతి పేరు చెప్పదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เอ่ยถึงวิธีคุมกำเนิดของคุณ"
          }
        },
        "tr": {
