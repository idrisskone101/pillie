          "stringUnit": {
            "state": "translated",
            "value": "Pillie provides reminders and tracking only. It is not medical advice and does not replace guidance from a clinician. Always follow the instructions for your birth control method."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie offre esclusivamente promemoria e monitoraggio. Non fornisce consulenza medica e non sostituisce le indicazioni di un professionista sanitario. Segui sempre le istruzioni del tuo metodo contraccettivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie bietet nur Erinnerungen und Protokollierung. Die App ist keine medizinische Beratung und ersetzt nicht die Empfehlungen medizinischer Fachpersonen. Halte dich immer an die Anleitung deiner Verhütungsmethode."
          }
        }
      }
    },
