        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvarjeno iz izbrane rutine."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βασισμένο στη ρουτίνα που επέλεξες."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నువ్వు ఎంచుకున్న రొటీన్ నుంచి రూపొందించబడింది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
