            "value": "Ο αποκλεισμός εφαρμογών χρειάζεται τον Χρόνο επί οθόνης"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్ బ్లాకింగ్‌కు స్క్రీన్ టైమ్ అవసరం"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 封鎖需要螢幕使用時間"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપ બ્લૉકિંગ માટે સ્ક્રીન ટાઇમ જરૂરી છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್ ನಿರ್ಬಂಧಕ್ಕೆ ಸ್ಕ್ರೀನ್ ಟೈಮ್ ಬೇಕು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് ബ്ലോക്കിംഗിന് ‘സ്ക്രീൻ സമയം’ വേണം"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ॲप ब्लॉकिंगसाठी स्क्रीन टाइम हवा"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପ୍ ବ୍ଲକିଂ ପାଇଁ ସ୍କ୍ରିନ୍ ଟାଇମ୍ ଦରକାର"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਬਲੌਕਿੰਗ ਲਈ ਸਕ੍ਰੀਨ ਟਾਈਮ ਚਾਹੀਦਾ ਹੈ"
          }
        }
      }
    },
    "error.screen_time.body": {
      "comment": "Capability statement [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Screen Time access so Pillie can pause the apps you pick."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso a Tempo di utilizzo così Pillie può mettere in pausa le app che scegli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf Bildschirmzeit, damit Pillie die Apps pausieren kann, die du auswählst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise l’accès à Temps d’écran pour que Pillie puisse mettre en pause les apps que tu choisis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a Tiempo de uso para que Pillie pueda pausar las apps que elijas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao Tempo de Uso para o Pillie poder pausar os apps que você escolher."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toegang tot Schermtijd toe zodat Pillie de apps kan pauzeren die je kiest."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt åtkomst till Skärmtid så att Pillie kan pausa apparna du väljer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad adgang til Skærmtid, så Pillie kan sætte de apps, du vælger, på pause."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tilgang til Skjermtid så Pillie kan pause appene du velger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli Ruutuajan käyttö, jotta Pillie voi laittaa valitsemasi sovellukset tauolle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite o acesso ao Tempo de ecrã para o Pillie poder pausar as apps que escolheres."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet l’accés a Temps d’ús perquè Pillie pugui posar en pausa les apps que triïs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do Czasu przed ekranem, aby Pillie mogło wstrzymywać wybrane aplikacje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povol přístup k Času u obrazovky, aby Pillie mohla pozastavit aplikace, které vybereš."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши доступ к Экранному времени, чтобы Pillie мог ставить выбранные тобой приложения на паузу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволь доступ до Екранного часу, щоб Pillie міг ставити вибрані тобою застосунки на паузу."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieが選んだアプリを一時停止できるよう、スクリーンタイムへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie가 선택한 앱을 일시 중지할 수 있도록 스크린 타임 접근을 허용해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan akses Masa Skrin supaya Pillie boleh menjeda apl yang kamu pilih."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite accesul la Timp de utilizare ca Pillie să poată pune pe pauză aplicațiile alese."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľ prístup k Času pred obrazovkou, aby Pillie mohla pozastaviť aplikácie, ktoré vyberieš."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้เข้าถึงเวลาหน้าจอเพื่อให้ Pillie หยุดแอปที่คุณเลือกชั่วคราวได้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问屏幕使用时间，Pillie 才能暂停你选择的应用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन टाइम की अनुमति दें, ताकि Pillie आपके चुने हुए ऐप्स रोक सके।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopusti pristup Vremenu uporabe zaslona da Pillie može pauzirati aplikacije koje odabereš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a Képernyőidő-hozzáférést, hogy a Pillie szüneteltethesse a választott appokat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie’nin seçtiğin uygulamaları duraklatabilmesi için Ekran Süresi erişimine izin ver."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தேர்ந்தெடுக்கும் ஆப்ஸை Pillie இடைநிறுத்த, ஸ்கிரீன் டைம் அணுகலை அனுமதியுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses Durasi Layar agar Pillie bisa menjeda aplikasi yang kamu pilih."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمحي بالوصول إلى مدة استخدام الجهاز ليتمكن Pillie من إيقاف التطبيقات التي تختارينها مؤقتًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרי גישה לזמן מסך כדי ש-Pillie תוכל להשהות את האפליקציות שבחרת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập Thời gian sử dụng để Pillie có thể tạm dừng các ứng dụng bạn chọn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie যেন আপনার বেছে নেওয়া অ্যাপগুলো পজ করতে পারে, সেজন্য স্ক্রিন টাইম অ্যাক্সেস দিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین ٹائم کی اجازت دیں، تاکہ Pillie آپ کی چنی ہوئی ایپس روک سکے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovoli dostop do Časa pred zaslonom, da lahko Pillie začasno zaustavi aplikacije, ki jih izbereš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε την πρόσβαση στον Χρόνο επί οθόνης για να μπορεί το Pillie να βάζει σε παύση τις εφαρμογές που διαλέγεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎంచుకునే యాప్‌లను Pillie పాజ్ చేయడానికి, స్క్రీన్ టైమ్ యాక్సెస్ అనుమతించండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許存取螢幕使用時間，Pillie 才能暫停你選的 App。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે પસંદ કરો તે ઍપ્સ Pillie થોભાવી શકે તે માટે સ્ક્રીન ટાઇમની ઍક્સેસ આપો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆರಿಸುವ ಆ್ಯಪ್‌ಗಳನ್ನು Pillie ತಡೆಹಿಡಿಯಲು, ಸ್ಕ್ರೀನ್ ಟೈಮ್ ಪ್ರವೇಶವನ್ನು ಅನುಮತಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തിരഞ്ഞെടുക്കുന്ന ആപ്പുകൾ Pillie-ക്ക് പോസ് ചെയ്യാൻ, ‘സ്ക്രീൻ സമയം’ ആക്‌സസ് അനുവദിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन टाइमला परवानगी द्या, म्हणजे तुम्ही निवडलेली ॲप्स Pillie थांबवू शकेल."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ବାଛିଥିବା ଆପ୍‌ଗୁଡ଼ିକୁ Pillie ବିରାମ କରିପାରିବା ପାଇଁ ସ୍କ୍ରିନ୍ ଟାଇମ୍ ଆକ୍ସେସ୍ ଦିଅନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕ੍ਰੀਨ ਟਾਈਮ ਦੀ ਪਹੁੰਚ ਦਿਓ ਤਾਂ ਜੋ Pillie ਤੁਹਾਡੀਆਂ ਚੁਣੀਆਂ ਐਪਾਂ ਨੂੰ ਰੋਕ ਸਕੇ।"
          }
        }
      }
    },
