    "onboarding.blocking_demo.body": {
      "comment": "Functionality, not medical protection [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus can pause selected apps when a reminder is due. They come back after you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus mette in pausa le app al promemoria. Tornano dopo il check-in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pausiert Apps bei einer Erinnerung. Nach dem Check-in sind sie wieder da."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus peut mettre en pause les apps sélectionnées quand un rappel est dû. Elles reviennent après ton check-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus puede pausar apps seleccionadas cuando toca un recordatorio. Vuelven después de que hagas el check-in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie Plus pode pausar apps selecionados quando um lembrete chega. Eles voltam depois do check-in."
