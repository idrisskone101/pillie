    "onboarding.plan.disclaimer": {
      "comment": "Not a medical recommendation [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reminder setup is based on your selections. You can change it later in Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa configurazione dei promemoria si basa sulle tue scelte. Puoi modificarla in seguito nelle Impostazioni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Erinnerungen basieren auf deiner Auswahl. Du kannst sie später in den Einstellungen ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette configuration de rappels repose sur tes choix. Tu pourras la modifier plus tard dans Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta configuración de recordatorios se basa en tus selecciones. Puedes cambiarla después en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta configuração de lembretes é baseada nas suas escolhas. Você pode alterar depois em Ajustes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze herinneringsinstelling is gebaseerd op je keuzes. Je kunt het later wijzigen in Instellingen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här påminnelseinställningen bygger på dina val. Du kan ändra den senare i Inställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne påmindelsesopsætning er baseret på dine valg. Du kan ændre den senere i Indstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette påminnelsesoppsettet er basert på valgene dine. Du kan endre det senere i Innstillinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä muistutusasetus perustuu valintoihisi. Voit muuttaa sitä myöhemmin Asetuksista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta configuração de lembretes baseia-se nas tuas escolhas. Podes alterá-la mais tarde nas Definições."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta configuració de recordatoris es basa en les teves eleccions. La pots canviar més tard a Configuració."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te przypomnienia bazują na twoich wyborach. Możesz je później zmienić w Ustawieniach."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto nastavení připomínek vychází z tvých voleb. Později ho můžeš změnit v Nastavení."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти напоминания основаны на твоём выборе. Изменить их можно позже в настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці нагадування ґрунтуються на твоєму виборі. Змінити їх можна пізніше в параметрах."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリマインダー設定はあなたの選択に基づいています。あとで設定から変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 알림 설정은 선택한 내용을 바탕으로 만들어졌어요. 나중에 설정에서 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapan peringatan ini berdasarkan pilihan kamu. Kamu boleh ubah kemudian dalam Tetapan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această configurare a mementourilor se bazează pe alegerile tale. O poți schimba mai târziu din Configurări."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto nastavenie pripomienok vychádza z tvojich odpovedí. Neskôr ho môžeš zmeniť v Nastaveniach."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าแจ้งเตือนนี้อิงจากสิ่งที่คุณเลือก คุณเปลี่ยนได้ทีหลังในการตั้งค่า"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这套提醒设置基于你的选择。你随时可以在“设置”中更改。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रिमाइंडर सेटअप तुम्हारे चयन पर आधारित है। तुम इसे बाद में सेटिंग्स में बदल सकते हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ove postavke podsjetnika temelje se na tvojim odabirima. Kasnije ih možeš promijeniti u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az emlékeztető-beállítás a válaszaidon alapul. Később a Beállításokban módosíthatod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hatırlatma kurulumu seçimlerine dayanıyor. Daha sonra Ayarlar'dan değiştirebilirsin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நினைவூட்டல் அமைப்பு உன் தேர்வுகளின் அடிப்படையில் உள்ளது. பிறகு அமைப்புகளில் மாற்றலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan pengingat ini berdasarkan pilihanmu. Kamu bisa mengubahnya nanti di Pengaturan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعداد التذكيرات هذا مبني على اختياراتك. يمكنك تغييره لاحقًا في الإعدادات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרת התזכורות הזו מבוססת על הבחירות שלך. אפשר לשנות אותה אחר כך בהגדרות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết lập lời nhắc này dựa trên lựa chọn của bạn. Bạn có thể đổi sau trong Cài đặt."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রিমাইন্ডার সেটআপ তোমার নির্বাচনের ওপর ভিত্তি করে। পরে সেটিংস থেকে বদলাতে পারো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ یاد دہانی سیٹ اپ تمہارے انتخاب پر مبنی ہے۔ اسے بعد میں سیٹنگز میں بدلا جا سکتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta nastavitev opomnikov temelji na tvoji izbiri. Pozneje jo lahko spremeniš v nastavitvah."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η ρύθμιση υπενθυμίσεων βασίζεται στις επιλογές σου. Μπορείς να την αλλάξεις αργότερα στις Ρυθμίσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ రిమైండర్ సెటప్ నీ ఎంపికల ఆధారంగా ఉంది. తర్వాత సెట్టింగ్‌లలో మార్చుకోవచ్చు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這套提醒設定是依你的選擇而來。你之後隨時可以在「設定」中更改。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ રિમાઇન્ડર સેટઅપ તારી પસંદ પર આધારિત છે। પછી સેટિંગ્સમાં બદલી શકે છે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಜ್ಞಾಪನೆ ಸೆಟಪ್ ನಿನ್ನ ಎಂಪಿಕಲ ಆಧಾರಂಗಾ ಉಂದಿ. ತರ್ವಾತ ಸೆಟ್ಟಿಂಗ್‌ಲಲೋ ಮಾರ್ಚುಕೋವಚ್ಚು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ റിമൈൻഡർ സജ്ജീകരണം നിന്റെ തിരഞ്ഞെടുപ്പുകളെ അടിസ്ഥാനമാക്കിയാണ്. പിന്നീട് സെറ്റിംഗ്‌സിൽ മാറ്റാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही आठवण मांडणी तुझ्या निवडीवर आहे. नंतर सेटिंग्जमध्ये बदलता येईल."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ରିମାଇଣ୍ଡର୍ ସେଟଅପ୍ ତୁମର ଚୟନ ଉପରେ ଆଧାରିତ। ତୁମେ ପରେ ସେଟିଂସ୍‌ରେ ଏହା ବଦଳାଇପାରିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਯਹ ਰਿਮਾਇਂਡਰ ਸੇਟਅਪ ਤੇਰੇ ਚਯਨ ਪਰ ਆਧਾਰਿਤ ਹੈ। ਤੂੰ ਇਸੇ ਬਾਅਦ ਵਿੱਚ ਸੇਟਿਂਗ੍ਸ ਵਿੱਚ ਬਦਲ ਸਕਦੀ ਹੈਂ।"
          }
        }
      }
    },
