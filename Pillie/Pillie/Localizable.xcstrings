    "onboarding.dial.ring.subtitle": {
      "comment": "Onboarding drag-the-dial subtitle (ring). ENG-146 [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In for 21 days, then out for 7."
          }
        },
        "ar": {
          "stringUnit": {
