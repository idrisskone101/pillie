    "today.protection.setup.title": {
      "comment": "Unconfigured blocking card title [ENG-70]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't set up app blocking yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast App-Pause noch nicht eingerichtet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora impostato il blocco app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'as pas encore configuré la pause d'apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no configuraste el bloqueo de apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não configurou o bloqueio de apps."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt app-pauze nog niet ingesteld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har inte ställt in appblockering än."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke sat appblokering op endnu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke satt opp app-pause enda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ole vielä ottanut sovellustaukoa käyttöön."
          }
        },
        "pt-PT": {
          "stringUnit": {
