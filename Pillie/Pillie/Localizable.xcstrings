    "today.protection.ended.detail": {
      "comment": "Protection-off card body [ENG-70]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Plus access ended, so your apps aren't paused. Your setup is saved. Turn Plus back on and it picks up where you left off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Plus-Zugang ist zu Ende, also sind deine Apps nicht pausiert. Dein Setup ist gespeichert. Hol Plus zurück und es geht weiter wie vorher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo accesso plus è finito, quindi le app non sono in pausa. La tua configurazione è salvata. Riattiva plus e riprende da dove eri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton accès Plus est terminé, donc tes apps ne sont pas en pause. Ta config est sauvegardée. Réactive Plus et ça reprend où tu en étais."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu acceso a Plus terminó, así que tus apps no están en pausa. Tu configuración está guardada. Reactiva Plus y retoma donde lo dejaste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu acesso ao Plus terminou, então seus apps não estão pausados. Sua configuração está salva. Reative o Plus e tudo continua de onde parou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Plus-toegang is afgelopen, dus je apps zijn niet gepauzeerd. Je instellingen zijn bewaard. Zet Plus weer aan en het gaat verder waar je was gebleven."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Plus-åtkomst har upphört, så dina appar pausas inte. Din inställning är sparad. Slå på Plus igen så fortsätter det där du slutade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Plus-adgang er udløbet, så dine apps er ikke på pause. Din opsætning er gemt. Slå Plus til igen, så fortsætter det, hvor du slap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus-tilgangen din er avsluttet, så appene dine er ikke pauset. Oppsettet ditt er lagret. Slå på Plus igjen, så fortsetter det der du slapp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus-käyttöoikeutesi päättyi, joten sovelluksesi eivät ole tauolla. Asetuksesi on tallennettu. Ota Plus taas käyttöön, niin se jatkaa siitä, mihin jäit."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu acesso ao Plus terminou, por isso as tuas apps não estão em pausa. A tua configuração está guardada. Volta a ativar o Plus e ele continua onde ficaste."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu accés al Plus s’ha acabat, així que les teves apps no estan en pausa. La teva configuració està desada. Torna a activar el Plus i continuarà on ho vas deixar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dostęp do Plus się skończył, więc aplikacje nie są wstrzymywane. Konfiguracja jest zapisana. Włącz Plus ponownie, a wszystko ruszy tam, gdzie skończyło."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj přístup k Plus skončil, takže aplikace nejsou pozastavené. Nastavení máš uložené. Zapni Plus znovu a naváže tam, kde skončilo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к Plus закончился, поэтому приложения не на паузе. Твоя настройка сохранена. Включи Plus снова — и всё продолжится с того же места."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до Plus закінчився, тому застосунки не на паузі. Твоє налаштування збережено. Увімкни Plus знову — і все продовжиться з того ж місця."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusの利用が終了したため、アプリは一時停止されていません。設定は保存されています。Plusを再開すれば、そのまま続きから使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus 이용이 끝나서 앱이 일시 중지되지 않아요. 설정은 저장돼 있어요. Plus를 다시 켜면 이어서 사용할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses Plus kamu telah tamat, jadi apl kamu tidak dijeda. Tetapan kamu disimpan. Hidupkan Plus semula dan ia sambung dari tempat kamu berhenti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul tău la Plus s-a încheiat, așa că aplicațiile tale nu sunt pe pauză. Configurarea ta e salvată. Reactivează Plus și continuă de unde ai rămas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj prístup k Plus sa skončil, takže aplikácie nie sú pozastavené. Nastavenie máš uložené. Zapni Plus znova a pokračuje sa tam, kde to skončilo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์ Plus ของคุณสิ้นสุดแล้ว แอปจึงไม่ถูกพัก การตั้งค่าของคุณยังบันทึกไว้ เปิด Plus อีกครั้งแล้วทุกอย่างจะกลับมาเหมือนเดิม"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Plus 权限已结束，所以应用不会暂停。你的设置已保存。重新开启 Plus，就能从上次的地方继续。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारी Plus पहुँच ख़त्म हो गई, इसलिए तुम्हारे ऐप्स रुके नहीं हैं। तुम्हारा सेटअप सेव है। Plus फिर चालू करो और यह वहीं से आगे बढ़ेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj pristup Plusu je završio, pa tvoje aplikacije nisu pauzirane. Tvoje postavke su spremljene. Ponovno uključi Plus i nastavlja gdje si stala."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Plus-hozzáférésed lejárt, így az appjaid nem szünetelnek. A beállításod mentve van. Kapcsold vissza a Plust, és onnan folytatja, ahol abbahagytad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus erişimin sona erdi, bu yüzden uygulamaların duraklatılmıyor. Kurulumun kayıtlı. Plus'ı yeniden aç, kaldığı yerden devam eder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் Plus அணுகல் முடிந்தது, அதனால் உன் ஆப்ஸ் இடைநிறுத்தப்படவில்லை. உன் அமைப்பு சேமிக்கப்பட்டுள்ளது. Plus-ஐ மீண்டும் ஆன் செய்தால், விட்ட இடத்திலிருந்து தொடரும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses Plus kamu sudah berakhir, jadi aplikasimu tidak dijeda. Pengaturanmu tersimpan. Nyalakan Plus lagi dan semuanya lanjut seperti sebelumnya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى وصولك إلى Plus، لذا تطبيقاتك غير متوقفة. إعدادك محفوظ. أعيدي تفعيل Plus وسيتابع من حيث توقفتِ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה שלך ל-Plus הסתיימה, אז האפליקציות שלך לא מושהות. ההגדרות שלך שמורות. הפעילי את Plus מחדש והוא ימשיך מאיפה שעצרת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập Plus của bạn đã kết thúc, nên ứng dụng không bị tạm dừng. Thiết lập của bạn vẫn được lưu. Bật lại Plus và mọi thứ tiếp tục từ chỗ bạn dừng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার Plus অ্যাক্সেস শেষ হয়েছে, তাই অ্যাপগুলো পজ নেই। তোমার সেটআপ সেভ আছে। Plus আবার চালু করলে যেখানে ছিলে সেখান থেকেই চলবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہاری Plus رسائی ختم ہو گئی، اس لیے تمہاری ایپس رکی ہوئی نہیں ہیں۔ تمہارا سیٹ اپ محفوظ ہے۔ Plus دوبارہ آن کرو اور یہ وہیں سے چل پڑے گا جہاں چھوڑا تھا۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj dostop do Plus se je končal, zato aplikacije niso na premoru. Tvoja nastavitev je shranjena. Znova vklopi Plus in vse se nadaljuje tam, kjer je ostalo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβασή σου στο Plus έληξε, οπότε οι εφαρμογές σου δεν είναι σε παύση. Η ρύθμισή σου είναι αποθηκευμένη. Ενεργοποίησε ξανά το Plus και συνεχίζει από εκεί που έμεινες."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ Plus యాక్సెస్ ముగిసింది, అందుకే నీ యాప్‌లు పాజ్‌లో లేవు. నీ సెటప్ సేవ్ అయి ఉంది. Plus మళ్లీ ఆన్ చేస్తే, ఆగిన చోటు నుంచే కొనసాగుతుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Plus 權限已結束，所以應用程式不會暫停。你的設定已儲存。重新開啟 Plus，就能從上次的地方接著繼續。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તારી Plus પહોંચ પૂરી થઈ, એતલે ઍપ્સ થોભેલા નથી। તારું સેટઅપ સાચવાયેલ છે। Plus ફરી ચાલુ કર અને એ ત્યાંથી આગળ વધશે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ Plus ಪ್ರವೇಶ ಮುಗಿದೆ, ಆದ್ದರಿಂದ ಆ್ಯಾಪ್‌ಗಳು ನಿಂತಿಲ್ಲ. ನಿನ್ನ ಸೆಟಅಪ್ ಉಳಿದೆ. Plus ಮತ್ತೆ ಆನ್ ಮಾಡಿದರೆ ಅಲ್ಲಿಂದಿಂದ ಇಂದ ಮುಂದುವರಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിന്റെ Plus ആക്‌സസ് അവസാനിച്ചു, അതിനാൽ ആപ്പുകൾ പോസ് ചെയ്‌തിട്ടില്ല. നിന്റെ സജ്ജീകരണം സേവ് ചെയ്‌തിട്ടുണ്ട്. Plus വീണ്ടും ഓണാക്കിയാൽ നിർത്തിയിടത്ത് നിന്ന് തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुझा Plus प्रवेश संपला, म्हणून अॅप्स थांबलेले नाहीत. तुझं सेट जतन आहे. Plus पुन्हा चालू कर, तेथून पुढे चालेल."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର Plus ଆକ୍ସେସ୍ ଶେଷ ହୋଇଗଲା, ତେଣୁ ତୁମର ଆପ୍ ବିରାମରେ ନାହିଁ। ତୁମର ସେଟଅପ୍ ସେଭ୍ ହୋଇଛି। Plus ପୁଣି ଚାଲୁ କର ଓ ଏହା ଯେଉଁଠି ଛାଡ଼ିଥିଲ ସେଠାରୁ ଆରମ୍ଭ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੇਰੀ Plus ਪਹੁਁਚ ਖ਼ਤ੍ਮ ਹੋ ਗਈ, ਇਸਲਿਏ ਤੇਰੇ ਐਪਾਂ ਰੁਦੇ ਨਹੀਂ ਹੈਂ। ਤੇਰਾ ਸੇਟਅਪ ਸੇਵ ਹੈ। Plus ਫਿਰ ਚਾਲੂ ਕਰ ਤੇ ਯਹ ਵਹੀਂ ਸੇ ਆਗੇ ਬਢ਼ੇਗਾ।"
          }
        }
      }
    },
