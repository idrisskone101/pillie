        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ước chừng thôi. Bạn có thể đổi sau."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মোটামুটি একটা ধারণা দিলেই হবে। পরে বদলাতে পারেন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بس ایک موٹا اندازہ۔ اسے بعد میں بدلا جا سکتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
