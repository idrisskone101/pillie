{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.mechanism.release.detail": {
      "comment": "Mechanism-proof third step detail [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your apps become available again right away."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Subito dopo, le tue app tornano disponibili."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach sind deine Apps sofort wieder verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes apps redeviennent disponibles tout de suite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus apps vuelven a estar disponibles al instante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus apps ficam disponíveis de novo na hora."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je apps zijn meteen weer beschikbaar."
          }
        }
      }
    },
