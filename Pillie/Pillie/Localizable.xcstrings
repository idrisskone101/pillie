    "today.protection.ended.detail": {
      "comment": "Protection-off card body [ENG-70]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Plus access ended, so your apps aren’t paused. Your setup is saved. Turn Plus back on and it picks up where you left off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Plus-Zugang ist abgelaufen, also sind deine Apps nicht pausiert. Deine Einrichtung ist gespeichert. Schalte Plus wieder ein, dann geht es da weiter, wo du aufgehört hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo accesso a Plus è finito, quindi le app non vanno in pausa. La configurazione è salvata. Riattiva Plus e riprendi da dove eri rimasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton accès Plus a pris fin, donc tes apps ne sont pas en pause. Tes réglages sont sauvegardés. Réactive Plus et tout reprend là où tu en étais."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu acceso a Plus ha terminado, así que tus apps no están en pausa. Tu configuración está guardada. Reactiva Plus y retoma donde lo dejaste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu acesso ao Plus terminou, então seus apps não estão pausados. Sua configuração está salva. Reative o Plus e tudo continua de onde parou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Plus-toegang is afgelopen, dus je apps zijn niet gepauzeerd. Wat je hebt ingesteld, is bewaard. Zet Plus weer aan en het gaat verder waar je was gebleven."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Plus-åtkomst har upphört, så dina appar pausas inte. Det du har ställt in är sparat. Slå på Plus igen så fortsätter det där du slutade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Plus-adgang er udløbet, så dine apps er ikke på pause. Din opsætning er gemt. Slå Plus til igen, så fortsætter det, hvor du slap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus-tilgangen din er avsluttet, så appene dine blir ikke pauset. Oppsettet ditt er lagret. Slå på Plus igjen, så fortsetter det der du slapp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus-käyttöoikeutesi päättyi, joten sovelluksesi eivät mene tauolle. Asetuksesi on tallennettu. Ota Plus taas käyttöön, niin se jatkaa siitä, mihin jäit."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu acesso ao Plus terminou, por isso as tuas apps não estão em pausa. A tua configuração está guardada. Volta a ativar o Plus e tudo continua onde ficaste."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu accés al Plus s’ha acabat, així que les teves apps no es posen en pausa. La teva configuració està desada. Torna a activar el Plus i continuarà on ho vas deixar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dostęp do Plus się skończył, więc aplikacje nie są wstrzymywane. Konfiguracja jest zapisana. Włącz Plus ponownie, a wszystko ruszy od miejsca, w którym się zatrzymało."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj přístup k Plus skončil, takže aplikace nejsou pozastavené. Nastavení máš uložené. Zapni Plus znovu a všechno naváže tam, kde to skončilo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к Plus закончился, поэтому приложения не на паузе. Твои настройки сохранены. Включи Plus снова, и всё продолжится с того же места."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до Plus закінчився, тому застосунки не на паузі. Твої налаштування збережено. Увімкни Plus знову, і все продовжиться з того ж місця."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusの利用が終了したため、アプリは一時停止されていません。設定は保存されています。Plusを再開すれば、そのまま続きから使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus 이용이 끝나서 앱이 일시 중지되지 않아요. 설정은 저장돼 있어요. Plus를 다시 켜면 이어서 사용할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses Plus kamu telah tamat, jadi apl kamu tidak dijeda. Tetapan kamu disimpan. Hidupkan Plus semula dan ia sambung dari tempat kamu berhenti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul tău la Plus s-a încheiat, așa că aplicațiile tale nu sunt pe pauză. Configurarea ta e salvată. Reactivează Plus și totul continuă de unde ai rămas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj prístup k Plus sa skončil, takže aplikácie nie sú pozastavené. Nastavenie máš uložené. Zapni Plus znova a všetko nadviaže tam, kde to skončilo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์ Plus ของคุณสิ้นสุดแล้ว แอปจึงไม่ถูกหยุดชั่วคราว การตั้งค่าของคุณยังบันทึกไว้ เปิด Plus อีกครั้งแล้วทุกอย่างจะกลับมาเหมือนเดิม"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Plus 权限已结束，所以应用不会暂停。你的设置已保存。重新开启 Plus，就能从上次的地方继续。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Plus ऐक्सेस ख़त्म हो गया है, इसलिए आपके ऐप्स रुक नहीं रहे। आपका सेटअप सेव है। Plus फिर से चालू करें, और यह वहीं से शुरू होगा जहाँ छोड़ा था।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj pristup Plusu je završio, pa tvoje aplikacije nisu pauzirane. Postavke su spremljene. Ponovno uključi Plus i sve se nastavlja gdje je stalo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Plus-hozzáférésed lejárt, így az appjaid nem szünetelnek. A beállításod mentve van. Kapcsold vissza a Plust, és onnan folytatja, ahol abbahagytad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus erişimin sona erdi, bu yüzden uygulamaların duraklatılmıyor. Kurulumun kayıtlı. Plus’ı yeniden aç, kaldığı yerden devam eder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Plus அணுகல் முடிந்ததால், உங்கள் ஆப்ஸ் இடைநிறுத்தப்படுவதில்லை. உங்கள் அமைப்பு சேமிக்கப்பட்டுள்ளது. Plus-ஐ மீண்டும் இயக்கினால், விட்ட இடத்திலிருந்து தொடரும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses Plus kamu sudah berakhir, jadi aplikasimu tidak dijeda. Pengaturanmu tersimpan. Nyalakan Plus lagi dan semuanya lanjut seperti sebelumnya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى وصولك إلى Plus، لذا لم تعد تطبيقاتك تتوقف مؤقتًا. إعدادك محفوظ. أعيدي تفعيل Plus ليكمل من حيث توقفتِ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה שלך ל-Plus הסתיימה, אז האפליקציות שלך לא מושהות. ההגדרות שלך שמורות. הפעילי את Plus מחדש והוא ימשיך מאיפה שעצרת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập Plus của bạn đã kết thúc, nên ứng dụng không bị tạm dừng. Thiết lập của bạn vẫn được lưu. Bật lại Plus và mọi thứ tiếp tục từ chỗ bạn dừng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Plus অ্যাক্সেস শেষ হয়েছে, তাই অ্যাপগুলো পজ হচ্ছে না। আপনার সেটআপ সেভ করা আছে। Plus আবার চালু করলে যেখানে ছেড়েছিলেন, সেখান থেকেই শুরু হবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی Plus رسائی ختم ہو گئی ہے، اس لیے آپ کی ایپس نہیں رک رہیں۔ آپ کا سیٹ اپ محفوظ ہے۔ Plus دوبارہ آن کریں، اور یہ وہیں سے شروع ہو گا جہاں چھوڑا تھا۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj dostop do Plus se je končal, zato aplikacije niso zaustavljene. Tvoje nastavitve so shranjene. Znova vklopi Plus in vse se nadaljuje tam, kjer je ostalo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβασή σου στο Plus έληξε, οπότε οι εφαρμογές σου δεν είναι σε παύση. Η ρύθμισή σου είναι αποθηκευμένη. Ενεργοποίησε ξανά το Plus και συνεχίζει από εκεί που έμεινες."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Plus యాక్సెస్ ముగిసింది, అందుకే మీ యాప్‌లు పాజ్ అవ్వడం లేదు. మీ సెటప్ సేవ్ అయి ఉంది. Plus మళ్లీ ఆన్ చేస్తే, మీరు ఆగిన చోటు నుంచే కొనసాగుతుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Plus 權限已結束，所以 App 不會暫停。你的設定已儲存。重新開啟 Plus，就能從上次的地方接著繼續。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી Plus ઍક્સેસ પૂરી થઈ ગઈ છે, તેથી તમારી ઍપ્સ થોભતી નથી. તમારું સેટઅપ સચવાયેલું છે. Plus ફરી ચાલુ કરો, અને તમે જ્યાંથી છોડ્યું હતું ત્યાંથી આગળ વધશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ Plus ಪ್ರವೇಶ ಮುಗಿದಿದೆ, ಆದ್ದರಿಂದ ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳನ್ನು ತಡೆಹಿಡಿಯಲಾಗುತ್ತಿಲ್ಲ. ನಿಮ್ಮ ಸೆಟಪ್ ಉಳಿಸಲಾಗಿದೆ. Plus ಅನ್ನು ಮತ್ತೆ ಆನ್ ಮಾಡಿದರೆ, ನೀವು ನಿಲ್ಲಿಸಿದಲ್ಲಿಂದಲೇ ಮುಂದುವರಿಯುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ Plus ആക്‌സസ് അവസാനിച്ചു, അതിനാൽ നിങ്ങളുടെ ആപ്പുകൾ പോസ് ചെയ്യുന്നില്ല. നിങ്ങളുടെ സജ്ജീകരണം സേവ് ചെയ്‌തിട്ടുണ്ട്. Plus വീണ്ടും ഓണാക്കിയാൽ, നിർത്തിയിടത്ത് നിന്ന് തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा Plus ॲक्सेस संपला आहे, त्यामुळे तुमची ॲप्स थांबत नाहीत. तुमचा सेटअप सेव्ह आहे. Plus पुन्हा सुरू करा, आणि जिथे सोडले होते तिथून ते पुढे चालू होईल."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ Plus ଆକ୍ସେସ୍ ଶେଷ ହୋଇଛି, ତେଣୁ ଆପଣଙ୍କ ଆପ୍ ବିରାମ ହେଉନାହିଁ। ଆପଣଙ୍କ ସେଟଅପ୍ ସେଭ୍ ଅଛି। Plus ପୁଣି ଚାଲୁ କରନ୍ତୁ, ଆଉ ଆପଣ ଯେଉଁଠି ଛାଡ଼ିଥିଲେ ସେଠାରୁ ଆରମ୍ଭ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ Plus ਪਹੁੰਚ ਖ਼ਤਮ ਹੋ ਗਈ ਹੈ, ਇਸ ਲਈ ਤੁਹਾਡੀਆਂ ਐਪਾਂ ਨਹੀਂ ਰੁਕ ਰਹੀਆਂ। ਤੁਹਾਡਾ ਸੈੱਟਅੱਪ ਸੇਵ ਹੈ। Plus ਮੁੜ ਚਾਲੂ ਕਰੋ ਅਤੇ ਇਹ ਉੱਥੋਂ ਹੀ ਅੱਗੇ ਚੱਲੇਗਾ ਜਿੱਥੇ ਤੁਸੀਂ ਛੱਡਿਆ ਸੀ।"
          }
        }
      }
    },
