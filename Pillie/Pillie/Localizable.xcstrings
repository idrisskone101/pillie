    "home.pack.subtitle.late_tomorrow": {
      "comment": "Home pack card subtitle when today's pill is late but can still be taken until the next reminder tomorrow; %@ is that clock time, e.g. \"Late · still time until 8:00 PM tomorrow\". Calm, never scolding.",
