    "settings.cycle_day.history_note": {
      "comment": "State mutation disclosure [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier days count as done. Nothing gets marked missed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni precedenti contano come fatti. Nessuno viene segnato come saltato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühere Tage gelten als erledigt. Kein Tag wird als verpasst markiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours précédents comptent comme faits. Aucun jour n’est marqué comme oublié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días anteriores cuentan como hechos. Ninguno se marca como omitido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias anteriores contam como concluídos. Nenhum dia é marcado como perdido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerdere dagen tellen als gedaan. Geen dag wordt als gemist gemarkeerd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidigare dagar räknas som klara. Inget markeras som missat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidligere dage tæller som gennemført. Intet bliver markeret som glemt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidligere dager regnes som gjort. Ingenting blir merket som glemt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiemmat päivät lasketaan tehdyiksi. Mitään ei merkitä väliin jääneeksi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias anteriores contam como feitos. Nada fica marcado como falhado."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els dies anteriors compten com a fets. Res no es marca com a omès."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wcześniejsze dni liczą się jako wykonane. Nic nie zostanie oznaczone jako pominięte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dřívější dny se počítají jako splněné. Nic se neoznačí jako vynechané."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущие дни считаются выполненными. Ничего не отмечается как пропущенное."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередні дні вважаються виконаними. Ніщо не позначається як пропущене."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以前の日は完了として扱われます。飲み忘れとしては記録されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 날들은 완료로 처리돼요. 놓친 것으로 표시되는 날은 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari-hari sebelumnya dikira selesai. Tiada yang ditanda terlepas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zilele anterioare se consideră făcute. Nimic nu se marchează ca ratat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skoršie dni sa počítajú ako hotové. Nič sa neoznačí ako vynechané."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันก่อนหน้าจะนับว่าทำแล้ว ไม่มีวันไหนถูกทำเครื่องหมายว่าพลาด"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的日子会算作已完成。不会有任何一天被标记为漏服。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले के दिन पूरे माने जाते हैं। कोई दिन छूटा हुआ नहीं माना जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raniji dani računaju se kao obavljeni. Ništa se ne označava kao propušteno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A korábbi napok elvégzettnek számítanak. Semmi nem lesz kihagyottként jelölve."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki günler yapıldı sayılır. Hiçbir gün kaçırıldı olarak işaretlenmez."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முந்தைய நாட்கள் முடிந்ததாகக் கருதப்படும். எதுவும் தவறவிட்டதாகக் குறிக்கப்படாது."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari-hari sebelumnya dihitung selesai. Tidak ada yang ditandai terlewat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب الأيام السابقة مكتملة. لن يُوضع على أي يوم علامة فائت."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ימים קודמים נחשבים כבוצעו. שום דבר לא יסומן כפוספס."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ngày trước đó được tính là xong. Không ngày nào bị đánh dấu là bỏ lỡ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগের দিনগুলো সম্পন্ন হিসেবে গণ্য হবে। কিছুই মিস হিসেবে চিহ্নিত হবে না।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے کے دن مکمل مانے جاتے ہیں۔ کوئی دن چھوٹا ہوا نہیں مانا جاتا۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejšnji dnevi se štejejo kot opravljeni. Nič ne bo označeno kot zamujeno."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προηγούμενες ημέρες μετρούν ως ολοκληρωμένες. Καμία δεν μετρά ως χαμένη."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మునుపటి రోజులు పూర్తయినట్లు లెక్కించబడతాయి. ఏదీ మిస్ అయినట్లు గుర్తించబడదు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的日子會算作已完成。不會有任何一天被標示為漏服。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પહેલાંના દિવસો પૂર્ણ ગણાશે. કંઈ ચૂકેલું ગણાશે નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಿಂದಿನ ದಿನಗಳನ್ನು ಮುಗಿದಿವೆ ಎಂದು ಎಣಿಸಲಾಗುತ್ತದೆ. ಯಾವುದನ್ನೂ ತಪ್ಪಿಹೋಗಿದೆ ಎಂದು ಗುರುತಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുൻ ദിവസങ്ങൾ കഴിഞ്ഞതായി കണക്കാക്കും. ഒന്നും വിട്ടുപോയതായി അടയാളപ്പെടുത്തില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आधीचे दिवस पूर्ण मानले जातात. कोणताही दिवस चुकलेला मानला जात नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପୂର୍ବ ଦିନଗୁଡ଼ିକ ସମ୍ପୂର୍ଣ୍ଣ ଭାବେ ଗଣା ହୁଏ। କିଛି ବି ଛାଡ଼ି ଯାଇଛି ବୋଲି ଚିହ୍ନିତ ହୁଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿਛਲੇ ਦਿਨ ਪੂਰੇ ਗਿਣੇ ਜਾਣਗੇ। ਕੁਝ ਵੀ ਖੁੰਝਿਆ ਦਰਜ ਨਹੀਂ ਹੋਵੇਗਾ।"
          }
        }
      }
    },
