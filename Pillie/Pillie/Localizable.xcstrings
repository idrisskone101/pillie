            "value": "Thêm lời nhắc cho đến khi bạn điểm danh hôm nay."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ টিক না দেওয়া পর্যন্ত আরও রিমাইন্ডার।"
          }
        },
        "ur": {
