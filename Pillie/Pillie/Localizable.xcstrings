        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare bifare se adaugă la seria ta și la istoricul ciclului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé odškrtnutie predĺži tvoju sériu a doplní históriu cyklu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกครั้งที่เช็กอินจะเพิ่มสตรีคและประวัติรอบของคุณ"
