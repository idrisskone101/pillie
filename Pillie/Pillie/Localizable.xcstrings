    "onboarding.blocking_setup.privacy": {
      "comment": "Privacy-safe explanation of the opaque Screen Time selection [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie only sees how many you picked. The apps themselves stay private on this device."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie vede solo quante ne hai scelte. Le app restano private su questo dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie sieht nur, wie viele du ausgewählt hast. Welche Apps es sind, bleibt privat auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie voit seulement combien d’apps tu as choisies. Les apps elles-mêmes restent privées sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie solo ve cuántas elegiste. Las apps en sí quedan privadas en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie só vê quantos você escolheu. Os apps em si ficam privados neste aparelho."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ziet alleen hoeveel je er hebt gekozen. Welke apps het zijn, blijft privé op dit apparaat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ser bara hur många du har valt. Själva apparna förblir privata på den här enheten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ser kun, hvor mange du har valgt. Hvilke apps det er, forbliver privat på denne enhed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ser bare hvor mange du valgte. Selve appene forblir private på denne enheten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie näkee vain, montako valitsit. Itse sovellukset pysyvät yksityisinä tällä laitteella."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie só vê quantas escolheste. As apps em si ficam privadas neste dispositivo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie només veu quantes n’has triat. Les apps es mantenen privades en aquest dispositiu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie widzi tylko, ile aplikacji wybrano. Same aplikacje pozostają prywatne na tym urządzeniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie vidí jen, kolik aplikací je vybraných. Samotné aplikace zůstávají soukromé v tomto zařízení."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie видит только, сколько приложений ты выбрала. Какие именно, знает лишь это устройство."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie бачить лише, скільки застосунків ти вибрала. Які саме, знає тільки цей пристрій."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieにわかるのは選んだ数だけです。どのアプリかは、このデバイスの中だけに保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie는 몇 개를 골랐는지만 알 수 있어요. 어떤 앱인지는 이 기기 안에서만 비공개로 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie hanya melihat bilangan yang kamu pilih. Apl itu sendiri kekal peribadi pada peranti ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie vede doar câte ai ales. Aplicațiile în sine rămân private pe acest dispozitiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie vidí len, koľko aplikácií je vybraných. Samotné aplikácie zostávajú súkromné v tomto zariadení."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie เห็นแค่จำนวนที่คุณเลือก ส่วนแอปที่เลือกจะอยู่แค่บนอุปกรณ์นี้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 只知道你选了几个。具体是哪些应用，只保留在这台设备上。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie को बस यह पता चलता है कि कितने ऐप्स चुने गए। कौन-से ऐप्स हैं, यह इसी डिवाइस पर निजी रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie vidi samo broj odabranih aplikacija. Same aplikacije ostaju privatne na ovom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie csak azt látja, hányat választottál. Hogy melyek ezek, az ezen az eszközön marad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie yalnızca kaç tane seçtiğini görür. Uygulamaların kendisi bu cihazda gizli kalır."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் எத்தனை தேர்ந்தெடுத்தீர்கள் என்பது மட்டுமே Pillie-க்குத் தெரியும். அந்த ஆப்ஸ் இந்தச் சாதனத்திலேயே தனிப்பட்டதாக இருக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie hanya melihat jumlah yang kamu pilih. Aplikasinya sendiri tetap privat di perangkat ini."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرى Pillie إلا عدد ما اخترتِه. تبقى التطبيقات نفسها خاصة على هذا الجهاز."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie רואה רק כמה בחרת. האפליקציות עצמן נשארות פרטיות במכשיר הזה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie chỉ biết bạn đã chọn bao nhiêu. Bản thân các ứng dụng vẫn được giữ riêng tư trên thiết bị này."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কয়টি বেছে নিয়েছেন, Pillie শুধু সেটুকুই দেখে। অ্যাপগুলোর তথ্য এই ডিভাইসেই গোপন থাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie کو بس یہ پتا چلتا ہے کہ کتنی ایپس چنی گئیں۔ کون سی ایپس ہیں، یہ اسی ڈیوائس پر نجی رہتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie vidi samo, koliko aplikacij je izbranih. Katere so, ostane zasebno na tej napravi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pillie βλέπει μόνο πόσες διάλεξες. Οι ίδιες οι εφαρμογές μένουν ιδιωτικές σε αυτή τη συσκευή."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎన్ని ఎంచుకున్నారో మాత్రమే Pillieకి తెలుస్తుంది. ఆ యాప్‌లు ఈ డివైస్‌లోనే ప్రైవేట్‌గా ఉంటాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 只知道你選了幾個。具體是哪些 App，只會保留在這部裝置上。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે કેટલી પસંદ કરી એટલું જ Pillie જુએ છે. ઍપ્સની વિગતો આ ઉપકરણ પર ખાનગી રહે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಎಷ್ಟು ಆರಿಸಿದ್ದೀರಿ ಎಂಬುದು ಮಾತ್ರ Pillie ಗೆ ತಿಳಿಯುತ್ತದೆ. ಆ ಆ್ಯಪ್‌ಗಳು ಈ ಸಾಧನದಲ್ಲೇ ಖಾಸಗಿಯಾಗಿರುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ എത്രയെണ്ണം തിരഞ്ഞെടുത്തു എന്ന് മാത്രമേ Pillie-ക്ക് അറിയൂ. ആ ആപ്പുകൾ ഈ ഡിവൈസിൽ തന്നെ സ്വകാര്യമായി തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही किती निवडली एवढेच Pillie ला कळते. कोणती ॲप्स, हे याच डिव्हाइसवर खाजगी राहते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ କେତୋଟି ବାଛିଛନ୍ତି, Pillie କେବଳ ସେତିକି ଦେଖେ। ଆପ୍‌ଗୁଡ଼ିକ ଏହି ଡିଭାଇସ୍‌ରେ ଗୋପନ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ਸਿਰਫ਼ ਇਹ ਦੇਖਦਾ ਹੈ ਕਿ ਤੁਸੀਂ ਕਿੰਨੀਆਂ ਚੁਣੀਆਂ। ਐਪਾਂ ਦੀ ਜਾਣਕਾਰੀ ਇਸੇ ਡਿਵਾਈਸ ’ਤੇ ਨਿੱਜੀ ਰਹਿੰਦੀ ਹੈ।"
          }
        }
      }
    },
