    "plus_setup.messages.body": {
      "comment": "Messages setup step body [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write what your reminders say. You’ll see a Lock Screen preview before you save."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتبي ما تقوله تذكيراتك. سترين معاينة على شاشة القفل قبل الحفظ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রিমাইন্ডারে কী লেখা থাকবে, লিখুন। সেভ করার আগে লক স্ক্রিনে প্রিভিউ দেখতে পাবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriu què diuen els teus recordatoris. Abans de desar, en veuràs una vista prèvia a la pantalla bloquejada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiš, co budou tvoje připomínky říkat. Před uložením uvidíš náhled na zamčené obrazovce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv, hvad dine påmindelser siger. Du ser en forhåndsvisning på låseskærmen, før du gemmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib, was deine Erinnerungen sagen. Vor dem Speichern siehst du eine Vorschau auf dem Sperrbildschirm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γράψε τι λένε οι υπενθυμίσεις σου. Πριν την αποθήκευση θα δεις προεπισκόπηση στην οθόνη κλειδώματος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe lo que dicen tus recordatorios. Antes de guardar, verás una vista previa en la pantalla bloqueada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita, mitä muistutuksesi sanovat. Näet esikatselun lukitulla näytöllä ennen tallennusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris ce que disent tes rappels. Tu verras un aperçu sur l’écran verrouillé avant d’enregistrer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારાં રિમાઇન્ડર શું કહે તે લખો. સેવ કરતાં પહેલાં તમને લૉક સ્ક્રીન પર પ્રિવ્યૂ દેખાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתבי מה התזכורות שלך אומרות. לפני השמירה תראי תצוגה מקדימה במסך הנעילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिखें कि आपके रिमाइंडर क्या कहें। सेव करने से पहले लॉक स्क्रीन पर उसका प्रीव्यू दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiši što tvoji podsjetnici kažu. Prije spremanja vidjet ćeš pretpregled na zaključanom zaslonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd meg, mit mondjanak az emlékeztetőid. Mentés előtt előnézetet látsz a zárolási képernyőn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis isi pengingatmu. Kamu akan melihat pratinjau di Layar Kunci sebelum menyimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi cosa dicono i tuoi promemoria. Prima di salvare vedrai un’anteprima sulla schermata di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーの文言を書けます。保存する前に、ロック画面でのプレビューを確認できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಜ್ಞಾಪನೆಗಳು ಏನು ಹೇಳಬೇಕೆಂದು ಬರೆಯಿರಿ. ಉಳಿಸುವ ಮೊದಲು ಲಾಕ್ ಸ್ಕ್ರೀನ್‌ನ ಮುನ್ನೋಟವನ್ನು ನೋಡುತ್ತೀರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에 표시할 문구를 써 보세요. 저장하기 전에 잠금 화면 미리보기를 볼 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ റിമൈൻഡറുകൾ എന്ത് പറയണമെന്ന് എഴുതൂ. സേവ് ചെയ്യും മുമ്പ് ലോക്ക് സ്ക്രീനിൽ ഒരു പ്രിവ്യൂ കാണാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे रिमाइंडर काय सांगतील ते लिहा. सेव्ह करण्याआधी तुम्हाला लॉक स्क्रीनवर प्रिव्ह्यू दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis apa yang peringatan kamu katakan. Kamu akan nampak pratonton pada Skrin Kunci sebelum simpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv hva påminnelsene dine sier. Du ser en forhåndsvisning på låst skjerm før du lagrer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf wat je herinneringen zeggen. Voor je opslaat, zie je een preview op je vergrendelscherm."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ରିମାଇଣ୍ଡର୍ କ’ଣ କହିବ, ଲେଖନ୍ତୁ। ସେଭ୍ କରିବା ପୂର୍ବରୁ ଆପଣ ଲକ୍ ସ୍କ୍ରିନ୍‌ରେ ଏକ ପ୍ରିଭ୍ୟୁ ଦେଖିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਿਖੋ ਕਿ ਤੁਹਾਡੇ ਰਿਮਾਈਂਡਰ ਕੀ ਕਹਿਣ। ਸੇਵ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਤੁਹਾਨੂੰ ਲੌਕ ਸਕ੍ਰੀਨ ’ਤੇ ਪ੍ਰੀਵਿਊ ਦਿਖਾਈ ਦੇਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz, co mówią twoje przypomnienia. Przed zapisaniem zobaczysz podgląd na ekranie blokady."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva o que seus lembretes dizem. Você vê uma prévia na Tela Bloqueada antes de salvar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve o que os teus lembretes dizem. Vês uma pré-visualização no ecrã bloqueado antes de guardar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrie ce spun mementourile tale. Înainte să salvezi, vezi o previzualizare pe ecranul de blocare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напиши, что будет в твоих напоминаниях. Перед сохранением увидишь предпросмотр на экране блокировки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíš, čo hovoria tvoje pripomienky. Pred uložením uvidíš ukážku na zamknutej obrazovke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiši, kaj povejo tvoji opomniki. Pred shranjevanjem vidiš predogled na zaklenjenem zaslonu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv vad dina påminnelser säger. Du ser en förhandsvisning på låsskärmen innan du sparar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நினைவூட்டல்கள் என்ன சொல்ல வேண்டும் என்று எழுதுங்கள். சேமிக்கும் முன் பூட்டுத் திரையில் முன்னோட்டத்தைப் பார்ப்பீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రిమైండర్లు ఏం చెప్పాలో రాయండి. సేవ్ చేసే ముందు లాక్ స్క్రీన్‌లో ప్రివ్యూ చూస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนข้อความการแจ้งเตือนของคุณเอง คุณจะเห็นตัวอย่างบนหน้าจอล็อกก่อนบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatmalarının ne diyeceğini yaz. Kaydetmeden önce Kilit Ekranı’nda bir önizleme görürsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напиши, що кажуть твої нагадування. Перед збереженням побачиш попередній перегляд на екрані блокування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لکھیں کہ آپ کی یاد دہانیاں کیا کہیں۔ محفوظ کرنے سے پہلے لاک اسکرین پر پیش نظارہ نظر آئے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết nội dung cho lời nhắc của bạn. Bạn sẽ thấy bản xem trước trên Màn hình khóa trước khi lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下提醒要说的话。保存前，你可以在锁定屏幕上预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫下提醒要說的話。儲存前，你可以在鎖定畫面上預覽。"
          }
        }
      }
    },
