    "onboarding.mechanism.headline": {
      "comment": "Mechanism-proof headline [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your apps open again as soon as you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue app si riaprono non appena confermi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apps sind wieder offen, sobald du abhakst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes apps redeviennent accessibles dès que tu valides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes volver a abrir tus apps en cuanto marques lo de hoy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus apps abrem de novo assim que você registrar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je apps gaan weer open zodra je afvinkt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina appar öppnas igen så fort du bockar av."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine apps åbner igen, så snart du krydser af."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appene dine åpnes igjen så snart du krysser av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksesi aukeavat taas heti, kun kuittaat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas apps voltam a abrir assim que registares."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves apps es tornen a obrir tan bon punt confirmes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje aplikacje znów się otworzą, gdy tylko odhaczysz dzień."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikace se zase otevřou, jakmile odškrtneš dnešek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения снова открываются, как только ты отмечаешься."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунки знову відкриваються, щойно ти відмічаєшся."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録すると、すぐにアプリがまた開けるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크하면 바로 앱을 다시 열 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl kamu dibuka semula sebaik sahaja kamu sahkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile tale se deschid din nou imediat ce bifezi ziua."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikácie sa znova otvoria, hneď ako odškrtneš dnešok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปของคุณจะเปิดได้อีกครั้งทันทีที่คุณเช็กอิน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一打卡，你的应用就能重新打开。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्ज करते ही आपके ऐप्स फिर से खुल जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikacije ponovno se otvaraju čim se javiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appjaid újra megnyílnak, amint kipipálod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretlediğin anda uygulamaların yeniden açılır."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பதிவு செய்த உடனே உங்கள் ஆப்ஸ் மீண்டும் திறக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasimu terbuka lagi begitu kamu check-in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح تطبيقاتك من جديد بمجرد أن تسجّلي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציות שלך נפתחות שוב ברגע שאת מסמנת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng của bạn mở lại ngay khi bạn điểm danh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টিক দিলেই আপনার অ্যাপগুলো আবার খোলা যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درج کرتے ہی آپ کی ایپس دوبارہ کھل جاتی ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikacije se spet odprejo, takoj ko odkljukaš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές σου ανοίγουν ξανά μόλις το σημειώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు నమోదు చేసిన వెంటనే మీ యాప్‌లు మళ్లీ తెరుచుకుంటాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一打卡，你的 App 就能再次開啟。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નોંધ કરતાં જ તમારી ઍપ્સ ફરી ખૂલી જાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ದಾಖಲಿಸಿದ ತಕ್ಷಣ ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳು ಮತ್ತೆ ತೆರೆಯುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ രേഖപ്പെടുത്തിയാലുടൻ നിങ്ങളുടെ ആപ്പുകൾ വീണ്ടും തുറക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोंद करताच तुमची ॲप्स पुन्हा उघडतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦର୍ଜ କରିବା ମାତ୍ରେ ଆପଣଙ୍କ ଆପ୍ ପୁଣି ଖୋଲିଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦਰਜ ਕਰਦੇ ਹੀ ਤੁਹਾਡੀਆਂ ਐਪਾਂ ਮੁੜ ਖੁੱਲ੍ਹ ਜਾਂਦੀਆਂ ਹਨ।"
