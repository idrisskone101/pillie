    "error.screen_time.body": {
      "comment": "Capability statement [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Screen Time access to select and pause apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso a Tempo di utilizzo per scegliere e mettere in pausa le app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf Bildschirmzeit, um Apps auszuwählen und zu pausieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise l'accès à Temps d'écran pour sélectionner et mettre en pause des apps."
          }
        },
        "es": {
