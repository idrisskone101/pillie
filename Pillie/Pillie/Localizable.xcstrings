    "today.intervention.alert.body": {
      "comment": "Observed app state [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A selected app was opened while today’s action was still open."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stata aperta un’app selezionata mentre l’azione di oggi era ancora da registrare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ausgewählte App wurde geöffnet, während die heutige Aktion noch offen war."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app sélectionnée a été ouverte alors que l'action du jour était encore en attente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abrió una app seleccionada mientras la acción de hoy seguía pendiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um app selecionado foi aberto enquanto a ação de hoje ainda estava aberta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een geselecteerde app werd geopend terwijl de actie van vandaag nog open stond."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En vald app öppnades medan dagens åtgärd fortfarande var öppen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En valgt app blev åbnet, mens dagens handling stadig var åben."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En valgt app ble åpnet mens dagens handling fortsatt var åpen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valittu sovellus avattiin, kun päivän toimenpide oli yhä avoinna."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma app selecionada foi aberta enquanto a ação de hoje ainda estava em aberto."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’ha obert una app seleccionada mentre l’acció d’avui encara estava pendent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarto wybraną aplikację, gdy dzisiejsza czynność wciąż czekała."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Byla otevřena vybraná aplikace, zatímco dnešní akce byla stále otevřená."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранное приложение открывали, пока сегодняшнее действие ещё не было отмечено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний застосунок відкривали, коли сьогоднішню дію ще не було відмічено."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のアクションが未完了のまま、選んだアプリが開かれました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 행동이 완료되지 않은 상태에서 선택한 앱이 열렸어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl terpilih dibuka semasa tindakan hari ini masih belum selesai."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicație selectată a fost deschisă în timp ce acțiunea de azi era încă deschisă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraná aplikácia bola otvorená, keď bola dnešná akcia ešte otvorená."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการเปิดแอปที่เลือกไว้ขณะที่กิจกรรมของวันนี้ยังค้างอยู่"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的操作还没完成时，有一个所选应用被打开了。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का काम बाक़ी रहते हुए एक चुना हुआ ऐप खोला गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrana aplikacija otvorena je dok je današnja radnja još bila otvorena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy kijelölt appot megnyitottak, amíg a mai teendő még nyitva volt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü işlem hâlâ açıkken seçili bir uygulama açıldı."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்றைய செயல் நிலுவையில் இருக்கும்போது தேர்ந்தெடுத்த ஆப் ஒன்று திறக்கப்பட்டது."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi terpilih dibuka saat tindakan hari ini masih belum selesai."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فتح تطبيق محدد بينما كان إجراء اليوم ما زال مفتوحًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפליקציה שנבחרה נפתחה בזמן שהפעולה של היום עדיין הייתה פתוחה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ứng dụng đã chọn được mở khi việc hôm nay vẫn chưa xong."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের কাজ বাকি থাকা অবস্থায় একটি বেছে নেওয়া অ্যাপ খোলা হয়েছিল।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کا کام باقی ہونے کے دوران ایک چُنی ہوئی ایپ کھولی گئی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrana aplikacija je bila odprta, ko je bilo današnje dejanje še odprto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια επιλεγμένη εφαρμογή ανοίχτηκε ενώ η σημερινή ενέργεια ήταν ακόμα ανοιχτή."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు చర్య పెండింగ్‌లో ఉన్నప్పుడు ఎంచుకున్న ఒక యాప్ తెరవబడింది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的動作還沒完成時，有一個所選的應用程式被打開了。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજનું કામ બાકી હોય ત્યારે એક પસંદ ઍપ ખુલ્યો।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈರೋಜು ಕೆಲಸ ಪೆಂಡಿಂಗ್‌ಲೋ ಉನ್ನಪ್ಪುಡು ಆರಿಸಿದ ಒಕ ಯಾಪ್ ತೆರವಬಡಿಂದಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്നത്തെ ആക്ഷൻ ബാക്കിയായിരിക്കുമ്പോൾ തിരഞ്ഞെടുത്ത ഒരു ആപ്പ് തുറന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का काम बाक़ी रहते हुए एक चुना हुआ अॅप खोला गया।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଜିର କାମ ବାକି ଥିବାବେଳେ ଏକ ବଛା ଆପ୍ ଖୋଲା ହୋଇଥିଲା।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੱਜ ਦਾ ਕਾਮ ਬਾਕ਼ੀ ਰਹਤੇ ਹੁਏ ਏਕ ਚੁਨਾ ਹੁਆ ਐਪ ਖੋਲਾ ਗਯਾ।"
          }
        }
      }
    },
