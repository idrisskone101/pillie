          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Akcia zaznamenaná. Pokračuj vo svojom dni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกกิจกรรมแล้ว ใช้ชีวิตต่อได้เลย"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已记录。继续你的一天吧。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काम लॉग हो गया। अपना दिन जारी रखो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radnja zabilježena. Nastavi sa svojim danom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Teendő rögzítve. Folytasd a napodat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem kaydedildi. Gününe devam et."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயல் பதிவானது. உன் நாளைத் தொடர்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan tercatat. Lanjutkan harimu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل الإجراء. تابعي يومك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה נרשמה. המשיכי ביום שלך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ghi lại. Tiếp tục ngày của bạn nhé."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাজ লগ হয়েছে। তোমার দিন চালিয়ে যাও।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کام لاگ ہو گیا۔ اپنا دن جاری رکھو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejanje zabeleženo. Nadaljuj s svojim dnem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ενέργεια καταγράφηκε. Συνέχισε τη μέρα σου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చర్య నమోదైంది. నీ రోజును కొనసాగించు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動作已記錄。繼續你的一天吧。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કામ લૉગ હો ગયા। તારો દિન જારી રખો।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೆಲಸ ನಮೋದೈಂದಿ. ನಿನ್ನ ರೋಜುನು ಮುಂದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആക്ഷൻ രേഖപ്പെടുത്തി. നിന്റെ ദിവസം തുടരൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कृती नोंदली. तुझा दिवस सुरू ठेव."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କାମ ଲଗ୍ ହେଲା। ତୁମର ଦିନ ଚାଲୁ ରଖ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਾਮ ਲਾਗ ਹੋ ਗਯਾ। ਅਪਨਾ ਦਿਨ ਜਾਰੀ ਰੱਖ।"
          }
        }
      }
    },
    "onboarding.blocking_demo.body": {
      "comment": "Functionality, not medical protection [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus can pause selected apps when a reminder is due. They come back after you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus mette in pausa le app al promemoria. Tornano dopo il check-in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pausiert Apps bei einer Erinnerung. Nach dem Check-in sind sie wieder da."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus peut mettre en pause les apps sélectionnées quand un rappel est dû. Elles reviennent après ton check-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus puede pausar apps seleccionadas cuando toca un recordatorio. Vuelven después de que hagas el check-in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie Plus pode pausar apps selecionados quando um lembrete chega. Eles voltam depois do check-in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus kan geselecteerde apps pauzeren wanneer een herinnering klaarstaat. Ze komen terug na je check-in."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus kan pausa valda appar när en påminnelse är aktuell. De kommer tillbaka när du har checkat in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus kan sætte valgte apps på pause, når en påmindelse er aktuel. De kommer tilbage, når du har tjekket ind."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus kan pause valgte apper når en påminnelse forfaller. De kommer tilbake etter at du har sjekket inn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus voi laittaa valitut sovellukset tauolle, kun muistutus on ajankohtainen. Ne palaavat, kun olet kuitannut."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie Plus pode pausar as apps selecionadas quando um lembrete chega. Voltam depois de registares."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus pot pausar les apps seleccionades quan arriba un recordatori. Tornen quan registres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus może wstrzymać wybrane aplikacje, gdy nadejdzie przypomnienie. Wracają po potwierdzeniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus umí pozastavit vybrané aplikace, když přijde připomínka. Po potvrzení se vrátí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus может ставить выбранные приложения на паузу, когда приходит напоминание. После отметки они снова доступны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus може ставити вибрані застосунки на паузу, коли надходить нагадування. Після відмітки вони знову доступні."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plusは、リマインダーの時間になると選んだアプリを一時停止できます。チェックインすると元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus는 알림 시간이 되면 선택한 앱을 일시 중지할 수 있어요. 체크인하면 다시 돌아와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus boleh menjeda apl terpilih apabila peringatan tiba. Apl itu kembali selepas kamu sahkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus poate pune pe pauză aplicațiile selectate când e timpul pentru un memento. Revin după ce confirmi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus vie pozastaviť vybrané aplikácie, keď príde čas pripomienky. Po potvrdení sú zase späť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus สามารถพักแอปที่เลือกเมื่อถึงเวลาแจ้งเตือน แอปจะกลับมาหลังคุณเช็กอิน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus 可以在提醒到点时暂停所选应用。完成打卡后它们就会恢复。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर आने पर Pillie Plus चुने हुए ऐप्स रोक सकता है। चेक-इन के बाद वे वापस आ जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus može pauzirati odabrane aplikacije kad stigne podsjetnik. Vraćaju se nakon što potvrdiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie Plus szüneteltetni tudja a kijelölt appokat, amikor esedékes egy emlékeztető. A bejelölés után visszatérnek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus, hatırlatma zamanı geldiğinde seçili uygulamaları duraklatabilir. Kaydını yaptıktan sonra geri gelirler."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நினைவூட்டல் நேரம் வந்ததும் Pillie Plus தேர்ந்தெடுத்த ஆப்ஸை இடைநிறுத்தும். செக்-இன் செய்தபின் அவை திரும்பும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus bisa menjeda aplikasi terpilih saat pengingat tiba. Aplikasi kembali setelah kamu check-in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ Pillie Plus إيقاف التطبيقات المحددة مؤقتًا عند حلول موعد التذكير. وتعود بعد التسجيل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus יכולה להשהות אפליקציות נבחרות כשמגיע זמן התזכורת. הן חוזרות אחרי הדיווח."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus có thể tạm dừng các ứng dụng đã chọn khi đến giờ nhắc. Chúng sẽ trở lại sau khi bạn điểm danh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডারের সময় হলে Pillie Plus বেছে নেওয়া অ্যাপগুলো পজ করতে পারে। চেক-ইন করলে সেগুলো ফিরে আসে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی کا وقت آنے پر Pillie Plus چُنی ہوئی ایپس روک سکتا ہے۔ چیک اِن کے بعد وہ واپس آ جاتی ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus lahko ob opomniku začasno ustavi izbrane aplikacije. Po potrditvi so spet na voljo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pillie Plus μπορεί να βάλει σε παύση επιλεγμένες εφαρμογές όταν έρθει η ώρα της υπενθύμισης. Επανέρχονται μόλις επιβεβαιώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిమైండర్ సమయం రాగానే Pillie Plus ఎంచుకున్న యాప్‌లను పాజ్ చేయగలదు. నువ్వు చెక్-ఇన్ చేశాక అవి తిరిగి వస్తాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus 可以在提醒到的時候暫停所選的應用程式。完成打卡後它們就會恢復。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇંડર આને પર Pillie Plus ચુને હુએ ઍપ્સ રોક સકતા છે। ચેક-ઇન કે પછી વે વાપસ આ જાતે છે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜ್ಞಾಪನೆ ಸಮಯಂ ರಾಗಾನೇ Pillie Plus ಆರಿಸಿದ ಆ್ಯಾಪ್ನು ಪಾಜ್ ಚೇಯಗಲದು. ನೀನು ಚೆಕ್-ಇನ್ ಚೇಶಾಕ ಅವಿ ತಿರಿಗಿ ಸಿಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിമൈൻഡർ വരുമ്പോൾ Pillie Plus തിരഞ്ഞെടുത്ത ആപ്പുകൾ പോസ് ചെയ്യും. ചെക്ക്-ഇൻ കഴിഞ്ഞാൽ അവ തിരികെ വരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आठवण आली की Pillie Plus निवडलेले अॅप्स थांबवू शकतो. नोंदीनंतर ते परत येतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ସମୟ ହେଲେ Pillie Plus ବଛା ଆପ୍ ବିରାମ କରିପାରେ। ଚେକ୍-ଇନ୍ ପରେ ସେଗୁଡ଼ିକ ଫେରିଆସେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਇਂਡਰ ਆਨੇ ਪਰ Pillie Plus ਚੁਨੇ ਹੁਏ ਐਪਾਂ ਰੋਕ ਸਕਦਾ ਹੈ। ਚੇਕ-ਇਨ ਦੇ ਬਾਅਦ ਵੇ ਵਾਪਸ ਆ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        }
      }
    },
    "onboarding.blocking_demo.shake_body": {
      "comment": "Instruction [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shake your phone now, or tap this card in Simulator."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scuoti ora il telefono oppure tocca questa scheda nel simulatore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schüttle jetzt dein iPhone oder tippe im Simulator auf diese Karte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Secoue ton iPhone maintenant, ou tape sur cette carte dans le simulateur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agita tu teléfono ahora, o toca esta tarjeta en el Simulador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance o iPhone agora ou toque neste card no Simulador."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schud nu je telefoon, of tik op deze kaart in Simulator."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaka telefonen nu, eller tryck på det här kortet i simulatorn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryst din telefon nu, eller tryk på dette kort i simulatoren."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rist telefonen nå, eller trykk på dette kortet i Simulator."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravista puhelinta nyt tai napauta tätä korttia Simulatorissa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abana o telemóvel agora ou toca neste cartão no Simulador."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sacseja el mòbil ara o toca aquesta targeta al Simulador."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrząśnij teraz telefonem albo stuknij tę kartę w Symulatorze."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď zatřes telefonem, nebo v Simulátoru klepni na tuto kartu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встряхни телефон сейчас или коснись этой карточки в Симуляторе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Струсни телефон зараз або торкнись цієї картки в Симуляторі."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今スマートフォンをシェイクするか、シミュレータではこのカードをタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 휴대폰을 흔들거나, 시뮬레이터에서는 이 카드를 탭하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Goncang telefon kamu sekarang, atau ketik kad ini dalam Simulator."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scutură-ți telefonul acum sau atinge acest card în Simulator."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz zatras telefónom alebo v Simulátore ťukni na túto kartu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขย่าโทรศัพท์ตอนนี้ หรือแตะการ์ดนี้ในเครื่องจำลอง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在摇一摇手机，或在模拟器中点按此卡片。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी अपना फ़ोन हिलाओ, या Simulator में इस कार्ड पर टैप करो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protresi telefon sada ili dodirni ovu karticu u Simulatoru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rázd meg most a telefonodat, vagy koppints erre a kártyára a Szimulátorban."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi telefonunu salla ya da Simülatör'de bu karta dokun."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது உன் போனை குலுக்கு, அல்லது Simulator-இல் இந்த கார்டைத் தட்டு."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Goyangkan ponselmu sekarang, atau ketuk kartu ini di Simulator."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هزّي هاتفك الآن، أو انقري على هذه البطاقة في المحاكي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נערי את הטלפון עכשיו, או הקישי על הכרטיס הזה בסימולטור."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lắc điện thoại ngay bây giờ, hoặc chạm vào thẻ này trong Simulator."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন ফোনটি ঝাঁকাও, অথবা Simulator-এ এই কার্ডে ট্যাপ করো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی اپنا فون ہلاؤ، یا Simulator میں اس کارڈ پر ٹیپ کرو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdaj stresi telefon ali v simulatorju tapni to kartico."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κούνησε το τηλέφωνό σου τώρα ή πάτα αυτή την κάρτα στον Simulator."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇప్పుడు నీ ఫోన్ ఊపు, లేదా Simulator‌లో ఈ కార్డ్‌ను నొక్కు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在搖一搖手機，或在模擬器中點一下這張卡片。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હમણાં તારો ફ઼ોન હિલાઓ, યા Simulator મેં ઇસ કાર્ડ પર ટૈપ કર।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈಗ ನಿನ್ನ ಫೋನ್ ಊಪು, ಲೇದಾ Simulator‌ಲೋ ಈ ಕಾರ್ಡ್‌ನು ನೊಕ್ಕು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ ഫോൺ കുലുക്കൂ, അല്ലെങ്കിൽ സിമുലേറ്ററിൽ ഈ കാർഡിൽ ടാപ്പ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आता फोन हलव, किंवा सिम्युलेटरमध्ये ही कार्ड टॅप कर."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏବେ ତୁମର ଫୋନ୍ ହଲାଅ, ବା Simulator ରେ ଏହି କାର୍ଡ ଟିପ୍ କର।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਭੀ ਅਪਨਾ ਫ਼ੋਨ ਹਿਲਾ, ਯਾ Simulator ਵਿੱਚ ਇਸ ਕਾਰ੍ਡ ਪਰ ਟੈਪ ਕਰ।"
          }
        }
      }
    },
