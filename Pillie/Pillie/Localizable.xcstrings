          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ സമയത്ത് ഞാൻ തിരക്കിലായിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तेव्हा मला वेळ नसतो."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସେତେବେଳେ ମୁଁ ବ୍ୟସ୍ତ ଥାଏ।"
