    "onboarding.personalise.distraction.subtitle": {
      "comment": "Screen Time selection [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose categories or specific apps for your draft blocklist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli categorie o app specifiche per la bozza dell’elenco da bloccare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Kategorien oder bestimmte Apps für deine vorläufige Sperrliste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis des catégories ou des apps pour ta liste de blocage provisoire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige categorías o apps específicas para tu lista de bloqueo provisional."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha categorias ou apps específicos para sua lista de bloqueio provisória."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies categorieën of specifieke apps voor je concept-blokkeerlijst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj kategorier eller specifika appar till din preliminära blockeringslista."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg kategorier eller bestemte apps til din foreløbige blokeringsliste."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg kategorier eller bestemte apper til den foreløpige blokkeringslisten din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse luokat tai tietyt sovellukset alustavaan estolistaasi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe categorias ou apps específicas para a tua lista provisória de pausa."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria categories o apps concretes per a la teva llista provisional de pausa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kategorie lub konkretne aplikacje do wstępnej listy blokowania."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber kategorie nebo konkrétní aplikace pro předběžný seznam blokování."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери категории или конкретные приложения для черновика списка блокировки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери категорії або конкретні застосунки для чернетки списку блокування."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックリストの下書きに入れるカテゴリや特定のアプリを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 차단 목록에 넣을 카테고리나 특정 앱을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kategori atau apl tertentu untuk draf senarai sekatan kamu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege categorii sau aplicații anume pentru lista ta provizorie de blocare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber kategórie alebo konkrétne aplikácie do predbežného zoznamu na blokovanie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกหมวดหมู่หรือแอปที่ต้องการสำหรับรายการพักแอปฉบับร่าง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你的初始屏蔽列表选择类别或具体应用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी ड्राफ़्ट ब्लॉकलिस्ट के लिए श्रेणियाँ या ख़ास ऐप्स चुनो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi kategorije ili određene aplikacije za svoj privremeni popis blokiranja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz kategóriákat vagy konkrét appokat az előzetes blokkolási listádhoz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taslak engel listen için kategoriler veya belirli uygulamalar seç."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் வரைவு தடுப்புப் பட்டியலுக்கு வகைகள் அல்லது குறிப்பிட்ட ஆப்ஸைத் தேர்ந்தெடு."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kategori atau aplikasi tertentu untuk draf daftar jedamu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختاري فئات أو تطبيقات معينة لقائمة الحظر الأولية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרי קטגוריות או אפליקציות מסוימות לרשימת החסימה הראשונית שלך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn danh mục hoặc ứng dụng cụ thể cho danh sách chặn nháp của bạn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার খসড়া ব্লকলিস্টের জন্য ক্যাটাগরি বা নির্দিষ্ট অ্যাপ বেছে নাও।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی ابتدائی بلاک لسٹ کے لیے زمرے یا مخصوص ایپس چُنو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi kategorije ali določene aplikacije za osnutek svojega seznama za blokiranje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε κατηγορίες ή συγκεκριμένες εφαρμογές για την πρόχειρη λίστα παύσης σου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ డ్రాఫ్ట్ బ్లాక్ జాబితాకు వర్గాలు లేదా నిర్దిష్ట యాప్‌లను ఎంచుకో."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為你的初步封鎖清單選擇類別或特定的應用程式。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તારી ડ્રાફ઼્ટ બ્લૉકલિસ્ટ માટે શ્રેણિયાઁ યા ખ઼ાસ ઍપ્સ ચુનો।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ ಡ್ರಾಫ್ಟ್ ಬ್ಲಾಕ್ ಜಾಬಿತಾಕು ವರ್ಗಾಲು ಲೇದಾ ನಿರ್ದಿಷ್ಟ ಆ್ಯಾಪ್ನು ಎಂಚುಕೋ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിന്റെ താൽക്കാലിക ബ്ലോക്ക് ലിസ്‌റ്റിനായി വിഭാഗങ്ങളോ പ്രത്യേക ആപ്പുകളോ തിരഞ്ഞെടുക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी ड्राफ़्ट ब्लॉकलिस्ट के साठी श्रेणियाँ किंवा ख़ास अॅप्स निवड।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର ଖସଡ଼ା ବ୍ଲକ୍‌ଲିଷ୍ଟ ପାଇଁ ବର୍ଗ ବା ନିର୍ଦ୍ଦିଷ୍ଟ ଆପ୍ ବାଛ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਪਨੀ ਡ੍ਰਾਫ਼੍ਟ ਬ੍ਲਾਕਲਿਸ੍ਟ ਲਈ ਸ਼੍ਰੇਣਿਯਾਁ ਯਾ ਖ਼ਾਸ ਐਪਾਂ ਚੁਣ।"
          }
        }
      }
    },
