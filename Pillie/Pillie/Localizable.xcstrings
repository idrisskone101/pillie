          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowy cykl zacznie się dziś. Dotychczasowa historia zostaje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes začne nový cyklus. Stará historie zůstane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня начнётся новый цикл. Прежняя история сохранится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні почнеться новий цикл. Попередня історія збережеться."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日から新しい周期を始めます。これまでの履歴は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘부터 새 주기가 시작돼요. 이전 기록은 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memulakan kitaran baharu hari ini. Sejarah lama kamu kekal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asta începe azi un ciclu nou. Istoricul tău vechi rămâne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes sa začne nový cyklus. Tvoja doterajšia história zostáva."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะเริ่มรอบใหม่ตั้งแต่วันนี้ ประวัติเดิมของคุณยังอยู่"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从今天开始新的周期。旧的历史记录会保留。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आज नया साइकल शुरू होता है। आपका पुराना इतिहास बना रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovim danas počinje novi ciklus. Tvoja stara povijest ostaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel ma új ciklus kezdődik. A korábbi előzményeid megmaradnak."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bugün yeni bir döngü başlatır. Eski geçmişin kalır."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இன்று ஒரு புதிய சுழற்சியைத் தொடங்கும். உங்கள் பழைய வரலாறு அப்படியே இருக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memulai siklus baru hari ini. Riwayat lamamu tetap tersimpan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ هذا دورة جديدة اليوم. يبقى سجلّك السابق."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה מתחיל מחזור חדש היום. ההיסטוריה הקודמת שלך נשמרת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này bắt đầu chu kỳ mới từ hôm nay. Lịch sử cũ của bạn vẫn còn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে আজ থেকে নতুন সাইকেল শুরু হবে। আপনার পুরোনো ইতিহাস থেকে যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے آج نیا سائیکل شروع ہوتا ہے۔ آپ کی پرانی ہسٹری برقرار رہتی ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem danes začneš nov cikel. Tvoja prejšnja zgodovina ostane."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινά νέος κύκλος σήμερα. Το παλιό ιστορικό σου παραμένει."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ఈరోజు కొత్త సైకిల్ మొదలుపెడుతుంది. మీ పాత చరిత్ర అలాగే ఉంటుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從今天開始新的週期。舊的歷史紀錄會保留。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આનાથી આજે નવી સાઇકલ શરૂ થશે. તમારો જૂનો ઇતિહાસ રહેશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಇಂದು ಹೊಸ ಚಕ್ರವನ್ನು ಪ್ರಾರಂಭಿಸುತ್ತದೆ. ನಿಮ್ಮ ಹಳೆಯ ಇತಿಹಾಸ ಹಾಗೆಯೇ ಇರುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് ഇന്ന് ഒരു പുതിയ സൈക്കിൾ തുടങ്ങും. നിങ്ങളുടെ പഴയ ചരിത്രം അതേപടി തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यामुळे आज नवीन चक्र सुरू होते. तुमचा जुना इतिहास राहतो."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା ଆଜି ଏକ ନୂଆ ଚକ୍ର ଆରମ୍ଭ କରେ। ଆପଣଙ୍କ ପୁରୁଣା ଇତିହାସ ରହିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਨਾਲ ਅੱਜ ਤੋਂ ਨਵਾਂ ਸਾਈਕਲ ਸ਼ੁਰੂ ਹੋਵੇਗਾ। ਤੁਹਾਡਾ ਪੁਰਾਣਾ ਇਤਿਹਾਸ ਰਹੇਗਾ।"
          }
        }
      }
    },
