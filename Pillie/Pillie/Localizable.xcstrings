          }
        }
      }
    },
    "onboarding.blocking_demo.apps_blocked_body": {
      "comment": "Avoid named third-party examples [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They stay paused until you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano in pausa finché non confermi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie bleiben pausiert, bis du abhakst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles restent en pause jusqu’à ce que tu valides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguen en pausa hasta que marques lo de hoy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles ficam pausados até você registrar."
