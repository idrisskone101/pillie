    "accessibility.drag_help": {
      "comment": "Issue #233 runtime setup option",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag right along the path to pause your apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina verso destra lungo il percorso per mettere in pausa le app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe entlang des Pfads nach rechts, um deine Apps zu pausieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse vers la droite le long du chemin pour mettre tes apps en pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra a la derecha por el camino para pausar tus apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para a direita ao longo do caminho para pausar seus apps."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep naar rechts langs het pad om je apps te pauzeren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra åt höger längs banan för att pausa dina appar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk mod højre langs banen for at sætte dine apps på pause."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra mot høyre langs banen for å pause appene dine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä oikealle polkua pitkin laittaaksesi sovelluksesi tauolle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta para a direita ao longo do trajeto para pausar as tuas apps."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrossega cap a la dreta seguint el camí per pausar les teves apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij w prawo wzdłuż ścieżki, aby wstrzymać aplikacje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tažením doprava po dráze pozastavíš své aplikace."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведи вправо по дорожке, чтобы поставить приложения на паузу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведи вправо вздовж доріжки, щоб поставити застосунки на паузу."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスに沿って右にドラッグして、アプリを一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로를 따라 오른쪽으로 드래그해서 앱을 일시 중지하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret ke kanan sepanjang laluan untuk menjeda apl kamu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage spre dreapta de-a lungul traseului ca să pui aplicațiile pe pauză."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahni doprava po dráhe a pozastav svoje aplikácie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากไปทางขวาตามเส้นทางเพื่อพักแอปของคุณ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿路径向右拖动即可暂停你的应用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने ऐप्स रोकने के लिए रास्ते पर दाईं ओर खींचो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci udesno duž putanje da pauziraš svoje aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd jobbra a sáv mentén, hogy szüneteltesd az appjaidat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalarını duraklatmak için yol boyunca sağa sürükle."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் ஆப்ஸை இடைநிறுத்த, பாதையில் வலப்பக்கம் இழு."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret ke kanan mengikuti jalur untuk menjeda aplikasimu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحبي يمينًا على طول المسار لإيقاف تطبيقاتك مؤقتًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גררי ימינה לאורך המסלול כדי להשהות את האפליקציות שלך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo sang phải theo đường dẫn để tạm dừng ứng dụng của bạn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপগুলো পজ করতে পথ ধরে ডানে টানো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی ایپس روکنے کے لیے راستے پر دائیں طرف گھسیٹو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povleci desno po poti, da ustaviš svoje aplikacije."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρε δεξιά κατά μήκος της διαδρομής για να βάλεις σε παύση τις εφαρμογές σου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ యాప్‌లను పాజ్ చేయడానికి మార్గం వెంట కుడివైపు లాగు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿著路徑向右拖曳，即可暫停你的應用程式。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપ્સ થોભાવવા રસ્તે જમણે ખેંચ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ ಆ್ಯಾಪ್ನು ಪಾಜ್ ಚೇಯಡಾನಿಕಿ ಮಾರ್ಗಂ ವೆಂಟ ಕುಡಿವೈಪು ಲಾಗು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിന്റെ ആപ്പുകൾ പോസ് ചെയ്യാൻ പാതയിലൂടെ വലത്തോട്ട് വലിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अॅप्स थांबवण्यासाठी वाटेवर उजवीकडे ओढ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର ଆପ୍ ବିରାମ କରିବାକୁ ପଥ ଧରି ଡାହାଣକୁ ଟାଣ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਪਨੇ ਐਪਾਂ ਰੋਕਨੇ ਲਈ ਰਾਸ੍ਤੇ ਪਰ ਦਾਈਂ ਓਰ ਖੀਂਚੋ।"
          }
        }
      }
    },
