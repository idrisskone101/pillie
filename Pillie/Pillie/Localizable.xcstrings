        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੇਵ ਕਰਨ ਨਾਲ ਤੁਹਾਡਾ ਇਤਿਹਾਸ ਮਿਟ ਜਾਵੇਗਾ ਅਤੇ ਗੋਲੀ %lld ਤੋਂ ਦੁਬਾਰਾ ਸ਼ੁਰੂਆਤ ਹੋਵੇਗੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisanie usunie historię i zaczniesz od nowa od tabletki %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar apaga seu histórico e recomeça na pílula %lld."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar apaga o teu histórico e recomeça na pílula %lld."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvarea îți șterge istoricul și reîncepi de la pilula %lld."
