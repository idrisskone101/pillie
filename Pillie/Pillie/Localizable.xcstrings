        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje pakiranje, baš kao u ruci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A leveled, pont úgy, ahogy a kezedben tartod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemasanmu, persis seperti di tanganmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua confezione, proprio come la vedi in mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手に持ったときと同じ見え方のシートです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪ್ಯಾಕ್, ಕೈಯಲ್ಲಿ ಕಾಣುವಂತೆಯೇ."
