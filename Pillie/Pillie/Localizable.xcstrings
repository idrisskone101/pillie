    "settings.break_notice.body": {
      "comment": "Pill regimen feature [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder when your break week starts, so you know why reminders pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria quando inizia la settimana di pausa, così sai perché i promemoria si fermano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung, wenn deine Pausenwoche beginnt, damit du weißt, warum die Erinnerungen pausieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel au début de ta semaine d’arrêt, pour que tu saches pourquoi tu ne reçois plus de rappels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio cuando empieza tu semana de descanso, para que sepas por qué no recibes recordatorios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete no início da sua semana de intervalo, para você saber por que os lembretes param."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een herinnering als je stopweek begint, zodat je weet waarom herinneringen pauzeren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En påminnelse när din pausvecka börjar, så att du vet varför påminnelserna pausar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En påmindelse, når din pauseuge starter, så du ved, hvorfor påmindelserne holder pause."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En påminnelse når pauseuken starter, så du vet hvorfor påminnelsene tar pause."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistutus, kun taukoviikkosi alkaa, jotta tiedät, miksi muistutukset ovat tauolla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete no início da tua semana de intervalo, para saberes porque é que os lembretes param."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatori quan comença la setmana de pausa, perquè sàpigues per què s’aturen els recordatoris."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienie, gdy zaczyna się tydzień przerwy, żeby było jasne, czemu przypomnienia milkną."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připomínka na začátku týdne pauzy, ať víš, proč připomínky utichnou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание в начале недели перерыва, чтобы ты знала, почему напоминания на паузе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування на початку тижня перерви, щоб ти знала, чому нагадування на паузі."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーが止まる理由がわかるよう、休薬週の始まりにお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴약 주가 시작될 때 알려 드려서, 알림이 왜 멈추는지 알 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan apabila minggu rehat kamu bermula, supaya kamu tahu kenapa peringatan berhenti seketika."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un memento când începe săptămâna de pauză, ca să știi de ce fac pauză mementourile."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomienka na začiatku týždňa pauzy, nech vieš, prečo pripomienky stíchnu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนเมื่อสัปดาห์พักของคุณเริ่มต้น เพื่อให้คุณรู้ว่าทำไมการแจ้งเตือนถึงหยุดไป"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停药周开始时提醒你，让你知道提醒为什么暂停。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्रेक हफ़्ता शुरू होने पर एक रिमाइंडर, ताकि आपको पता रहे कि रिमाइंडर क्यों रुके हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnik kad počne tvoj tjedan pauze, da znaš zašto podsjetnici privremeno stanu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Emlékeztető a szünethét elején, hogy tudd, miért szünetelnek az emlékeztetők."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara haftan başladığında bir hatırlatma, böylece hatırlatmaların neden durduğunu bilirsin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இடைவெளி வாரம் தொடங்கும்போது ஒரு நினைவூட்டல். நினைவூட்டல்கள் ஏன் நிற்கின்றன என்பது உங்களுக்குத் தெரியும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat saat minggu istirahatmu dimulai, supaya kamu tahu kenapa pengingat berhenti sementara."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكير عند بداية أسبوع الاستراحة، لتعرفي لماذا تتوقف التذكيرات مؤقتًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תזכורת כששבוע ההפסקה שלך מתחיל, כדי שתדעי למה התזכורות מושהות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lời nhắc khi tuần nghỉ của bạn bắt đầu, để bạn biết vì sao lời nhắc tạm dừng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিরতির সপ্তাহ শুরু হলে একটি রিমাইন্ডার, যাতে বুঝতে পারেন কেন রিমাইন্ডার থেমে আছে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقفے کا ہفتہ شروع ہونے پر ایک یاد دہانی، تاکہ آپ کو پتا رہے کہ یاد دہانیاں کیوں رکی ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opomnik ob začetku tedna premora, da veš, zakaj se opomniki začasno ustavijo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια υπενθύμιση όταν αρχίζει η εβδομάδα διαλείμματος, για να ξέρεις γιατί σταματούν προσωρινά οι υπενθυμίσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ విరామ వారం మొదలైనప్పుడు ఒక రిమైండర్, రిమైండర్లు ఎందుకు ఆగాయో మీకు తెలియడానికి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停藥週開始時提醒你，讓你知道提醒為什麼暫停。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું બ્રેક અઠવાડિયું શરૂ થાય ત્યારે એક રિમાઇન્ડર, જેથી તમને ખબર પડે કે રિમાઇન્ડર કેમ થોભ્યાં છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ವಿರಾಮ ವಾರ ಶುರುವಾದಾಗ ಒಂದು ಜ್ಞಾಪನೆ, ಜ್ಞಾಪನೆಗಳು ಏಕೆ ನಿಂತಿವೆ ಎಂದು ನಿಮಗೆ ತಿಳಿಯಲು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഇടവേള ആഴ്ച തുടങ്ങുമ്പോൾ ഒരു റിമൈൻഡർ, റിമൈൻഡറുകൾ എന്തുകൊണ്ട് നിൽക്കുന്നു എന്ന് നിങ്ങൾ അറിയാൻ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्रेकचा आठवडा सुरू झाल्यावर एक रिमाइंडर, म्हणजे रिमाइंडर का थांबले ते तुम्हाला कळेल."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ବିରତି ସପ୍ତାହ ଆରମ୍ଭ ହେଲେ ଏକ ରିମାଇଣ୍ଡର୍, ଯାହାଦ୍ୱାରା ଆପଣ ଜାଣିବେ ରିମାଇଣ୍ଡର୍ କାହିଁକି ବିରାମରେ ଅଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਬ੍ਰੇਕ ਹਫ਼ਤਾ ਸ਼ੁਰੂ ਹੋਣ ’ਤੇ ਇੱਕ ਰਿਮਾਈਂਡਰ, ਤਾਂ ਜੋ ਤੁਹਾਨੂੰ ਪਤਾ ਹੋਵੇ ਕਿ ਰਿਮਾਈਂਡਰ ਕਿਉਂ ਰੁਕੇ ਹਨ।"
          }
        }
      }
    },
