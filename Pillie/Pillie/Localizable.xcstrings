    "onboarding.blocking_demo.apps_blocked": {
      "comment": "State heading [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected apps pause"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app selezionate vengono messe in pausa"
          }
        }
      }
    },
    "onboarding.blocking_demo.apps_blocked_body": {
      "comment": "Avoid named third-party examples [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected apps wait until you confirm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app selezionate restano in pausa fino alla conferma."
          }
        }
      }
    },
    "onboarding.blocking_demo.apps_unlock": {
      "comment": "State heading [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps are available again"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app sono di nuovo disponibili"
          }
        }
      }
    },
    "onboarding.blocking_demo.apps_unlock_body": {
      "comment": "Method-neutral [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action logged. Continue with your day."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azione registrata. Continua la tua giornata."
          }
        }
      }
    },
    "onboarding.blocking_demo.body": {
      "comment": "Functionality, not medical protection [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus can pause selected apps when a reminder is due, then make them available after you log the action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus può mettere in pausa le app selezionate quando arriva il promemoria e renderle di nuovo disponibili dopo la registrazione."
          }
        }
      }
    },
    "onboarding.blocking_demo.shake_body": {
      "comment": "Instruction [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shake your phone now, or tap this card in Simulator."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muovi ora il telefono oppure tocca questa scheda nel simulatore."
          }
        }
      }
    },
    "onboarding.blocking_demo.shake_progress": {
      "comment": "Both placeholders are integers [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of %lld shakes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld movimenti su %lld"
          }
        }
      }
    },
    "onboarding.blocking_demo.shake_title": {
      "comment": "Feature name [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Shake to Confirm"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova Muovi per confermare"
          }
