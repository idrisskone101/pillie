    "history.dayCorrection.accessibilityHint": {
      "comment": "VoiceOver hint on a tappable past day in History [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double tap to update this day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double tape pour mettre à jour ce jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para actualizar este día."
          }
        },
        "pt-BR": {
          "stringUnit": {
