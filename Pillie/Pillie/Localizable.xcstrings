        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீ செயலைப் பதிவு செய்யும் வரை தேர்ந்தெடுத்த ஆப்ஸ் இடைநிறுத்தத்தில் இருக்கும்."
