          "stringUnit": {
            "state": "translated",
            "value": "Dette hjelper Pillie å avgjøre hvor iherdige påminnelsene dine bør være."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näin Pillie osaa päättää, kuinka tiukkoja muistutustesi pitäisi olla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto ajuda o Pillie a decidir quão firmes devem ser os teus lembretes."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això ajuda Pillie a decidir com de ferms han de ser els teus recordatoris."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki temu Pillie wie, jak stanowcze mają być twoje przypomnienia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie tak pozná, jak důrazné mají tvoje připomínky být."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так Pillie поймёт, насколько настойчиво тебе напоминать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так Pillie зрозуміє, наскільки наполегливо тобі нагадувати."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieがリマインダーの強さを決める参考にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie가 알림을 얼마나 적극적으로 보낼지 정하는 데 도움이 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini membantu Pillie menentukan sekuat mana peringatan kamu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Așa Pillie știe cât de insistente să fie mementourile tale."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie tak zistí, aké dôrazné majú byť tvoje pripomienky."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วยให้ Pillie รู้ว่าควรแจ้งเตือนคุณหนักแน่นแค่ไหน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这能帮 Pillie 决定提醒的力度。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे Pillie तय करता है कि आपके रिमाइंडर कितने सख़्त हों।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tako Pillie zna koliko uporni trebaju biti tvoji podsjetnici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Így a Pillie tudja, milyen határozottak legyenek az emlékeztetőid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, Pillie’nin hatırlatmalarının ne kadar ısrarcı olacağına karar vermesine yardımcı olur."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நினைவூட்டல்கள் எவ்வளவு உறுதியாக இருக்க வேண்டும் என்று Pillie முடிவு செய்ய இது உதவும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini membantu Pillie menentukan seberapa tegas pengingatmu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يساعد هذا Pillie على تحديد مدى الحزم المناسب لتذكيراتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כך Pillie תדע כמה להתעקש בתזכורות שלך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này giúp Pillie quyết định lời nhắc của bạn nên kiên quyết đến mức nào."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে Pillie বুঝতে পারে আপনার রিমাইন্ডার কতটা জোরালো হওয়া উচিত।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے Pillie طے کرتا ہے کہ آپ کی یاد دہانیاں کتنی سخت ہوں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tako Pillie ve, kako odločni naj bodo tvoji opomniki."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έτσι το Pillie ξέρει πόσο επίμονες να είναι οι υπενθυμίσεις σου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రిమైండర్లు ఎంత గట్టిగా ఉండాలో Pillie నిర్ణయించడానికి ఇది సహాయపడుతుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這能幫 Pillie 決定提醒的力道。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આનાથી Pillie નક્કી કરી શકે છે કે તમારાં રિમાઇન્ડર કેટલાં મક્કમ હોવાં જોઈએ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಜ್ಞಾಪನೆಗಳು ಎಷ್ಟು ದೃಢವಾಗಿರಬೇಕು ಎಂದು Pillie ನಿರ್ಧರಿಸಲು ಇದು ಸಹಾಯ ಮಾಡುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ റിമൈൻഡറുകൾ എത്ര ദൃഢമായിരിക്കണം എന്ന് തീരുമാനിക്കാൻ ഇത് Pillie-യെ സഹായിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यावरून Pillie ठरवते की तुमचे रिमाइंडर किती ठाम असावेत."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହାଦ୍ୱାରା Pillie ସ୍ଥିର କରେ ଆପଣଙ୍କ ରିମାଇଣ୍ଡର୍ କେତେ ଦୃଢ଼ ହେବା ଉଚିତ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਨਾਲ Pillie ਤੈਅ ਕਰਦਾ ਹੈ ਕਿ ਤੁਹਾਡੇ ਰਿਮਾਈਂਡਰ ਕਿੰਨੇ ਪੱਕੇ ਹੋਣ।"
          }
        }
      }
    },
