{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.mechanism.release.detail": {
      "comment": "Mechanism-proof third step detail [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your apps become available again right away."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Subito dopo, le tue app tornano disponibili."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach sind deine Apps sofort wieder verfügbar."
          }
        }
      }
    },
    "onboarding.mechanism.locked": {
      "comment": "Mechanism-proof locked badge [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PAUSED"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "IN PAUSA"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PAUSIERT"
          }
        }
      }
    },
    "onboarding.mechanism.mark.pill": {
      "comment": "Mechanism-proof pill completion button [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I took my pill"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho preso la pillola"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe meine Pille genommen"
          }
        }
      }
    },
    "onboarding.mechanism.mark.patch": {
      "comment": "Mechanism-proof patch completion button [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I changed my patch"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho cambiato il cerotto"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe mein Pflaster gewechselt"
          }
        }
      }
    },
    "onboarding.mechanism.mark.ring": {
      "comment": "Mechanism-proof ring completion button [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I checked my ring"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho controllato l’anello"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe meinen Ring geprüft"
          }
        }
      }
    },
    "onboarding.mechanism.replay": {
      "comment": "Mechanism-proof replay button [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replay"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripeti"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch einmal"
          }
        }
      }
    },
    "onboarding.mechanism.continue": {
      "comment": "Mechanism-proof continue button [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter"
          }
        }
      }
    },
    "onboarding.mechanism.footer": {
      "comment": "Mechanism-proof footer [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of your Pillie reminder plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa parte del tuo piano di promemoria Pillie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teil deines Pillie-Erinnerungsplans."
          }
        }
      }
    },
    "onboarding.mechanism.unlocked": {
      "comment": "Mechanism-proof unlocked confirmation [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. Your apps are available again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatto. Le tue app sono di nuovo disponibili."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledigt. Deine Apps sind wieder da."
          }
        }
      }
    },
    "onboarding.mechanism.replay_hint": {
      "comment": "VoiceOver hint for the mechanism replay button [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays the app-pause demonstration again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce di nuovo la dimostrazione della pausa delle app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt die Demonstration der App-Pause erneut ab."
          }
        }
      }
    },
    "onboarding.mechanism.accessibility_summary": {
      "comment": "VoiceOver summary of the mechanism proof [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At your chosen time, Pillie sends a reminder and pauses distracting apps. Log today’s action to make them available again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All’orario scelto, Pillie invia un promemoria e mette in pausa le app che distraggono. Registra l’azione di oggi per renderle di nuovo disponibili."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur gewählten Zeit sendet Pillie eine Erinnerung und pausiert ablenkende Apps. Protokolliere die heutige Aktion, um sie wieder freizugeben."
          }
        }
      }
    },
    "onboarding.mechanism.eyebrow": {
      "comment": "Mechanism-proof section label [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HOW IT WORKS"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "COME FUNZIONA"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SO FUNKTIONIERT’S"
          }
        }
      }
    },
    "onboarding.mechanism.headline": {
      "comment": "Mechanism-proof headline [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your apps become available again as soon as you log today’s action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue app tornano disponibili non appena registri l’azione di oggi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apps werden wieder verfügbar, sobald du die heutige Aktion protokollierst."
          }
        }
      }
    },
    "onboarding.mechanism.trigger.phase": {
      "comment": "Mechanism-proof first phase [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "REMINDER"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "PROMEMORIA"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ERINNERUNG"
          }
        }
      }
    },
    "onboarding.mechanism.trigger.title": {
      "comment": "Mechanism-proof first step title [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder rings"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il promemoria suona"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung klingelt"
          }
        }
      }
    },
    "onboarding.mechanism.trigger.detail": {
      "comment": "Mechanism-proof first step detail [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle reminder at your chosen time."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria discreto all’orario scelto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine sanfte Erinnerung zur gewählten Zeit."
          }
        }
      }
    },
    "onboarding.mechanism.enforce.phase": {
      "comment": "Mechanism-proof second phase [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
