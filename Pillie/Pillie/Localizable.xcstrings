            "state": "translated",
            "value": "Rist telefonen nå, eller trykk på dette kortet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ravista puhelinta nyt tai napauta tätä korttia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abana o telemóvel agora ou toca neste cartão."
          }
        },
        "ca": {
