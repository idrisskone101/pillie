    "onboarding.mechanism.release.detail": {
      "comment": "Mechanism-proof third step detail [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your apps open again right away."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue app si riaprono subito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apps sind sofort wieder offen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes apps redeviennent accessibles tout de suite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes volver a abrir tus apps al instante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus apps abrem de novo na hora."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je apps gaan meteen weer open."
          }
