    "onboarding.blocking_setup.privacy": {
      "comment": "Privacy-safe explanation of the opaque Screen Time selection [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie only receives the number of items selected. Your selection stays on this device."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie riceve solo il numero di elementi selezionati. La selezione resta su questo dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie erhält nur die Anzahl der ausgewählten Elemente. Deine Auswahl bleibt auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie reçoit seulement le nombre d'éléments sélectionnés. Ta sélection reste sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie solo recibe la cantidad de elementos seleccionados. Tu selección se queda en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie recebe apenas a quantidade de itens selecionados. Sua seleção fica neste dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ontvangt alleen het aantal geselecteerde items. Je selectie blijft op dit apparaat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie får bara veta hur många objekt som valts. Ditt urval stannar på den här enheten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie modtager kun antallet af valgte elementer. Dit valg bliver på denne enhed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie får bare vite antallet valgte elementer. Utvalget ditt blir på denne enheten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie saa tietää vain valittujen kohteiden määrän. Valintasi pysyy tällä laitteella."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie só recebe o número de itens selecionados. A tua seleção fica neste dispositivo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie només rep el nombre d’elements seleccionats. La teva selecció es queda en aquest dispositiu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie otrzymuje tylko liczbę wybranych elementów. Twój wybór zostaje na tym urządzeniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie dostane jen počet vybraných položek. Tvůj výběr zůstává v tomto zařízení."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie получает только количество выбранных элементов. Твой выбор остаётся на этом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie отримує лише кількість вибраних елементів. Твій вибір лишається на цьому пристрої."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieが受け取るのは選択した項目の数だけです。選択内容はこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie는 선택한 항목의 개수만 받아요. 선택 내용은 이 기기에만 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie hanya menerima bilangan item yang dipilih. Pilihan kamu kekal pada peranti ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie primește doar numărul de elemente selectate. Selecția ta rămâne pe acest dispozitiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie dostane len počet vybraných položiek. Tvoj výber zostáva v tomto zariadení."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ได้รับเพียงจำนวนรายการที่เลือก สิ่งที่คุณเลือกจะอยู่บนอุปกรณ์นี้เท่านั้น"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 只会收到所选项目的数量。你的选择只保存在这台设备上。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie को सिर्फ़ चुने गए आइटम की संख्या मिलती है। तुम्हारा चयन इसी डिवाइस पर रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie prima samo broj odabranih stavki. Tvoj odabir ostaje na ovom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie csak a kijelölt elemek számát kapja meg. A kijelölésed ezen az eszközön marad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie yalnızca seçilen öğe sayısını alır. Seçimin bu cihazda kalır."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie-க்கு தேர்ந்தெடுத்தவற்றின் எண்ணிக்கை மட்டுமே கிடைக்கும். உன் தேர்வு இந்த சாதனத்திலேயே இருக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie hanya menerima jumlah item yang dipilih. Pilihanmu tetap tersimpan di perangkat ini."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتلقى Pillie سوى عدد العناصر المحددة. يبقى اختيارك على هذا الجهاز."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie מקבלת רק את מספר הפריטים שנבחרו. הבחירה שלך נשארת במכשיר הזה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie chỉ nhận được số mục đã chọn. Lựa chọn của bạn ở lại trên thiết bị này."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie শুধু নির্বাচিত আইটেমের সংখ্যা পায়। তোমার নির্বাচন এই ডিভাইসেই থাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie کو صرف منتخب آئٹمز کی تعداد ملتی ہے۔ تمہارا انتخاب اسی ڈیوائس پر رہتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie prejme samo število izbranih elementov. Tvoja izbira ostane na tej napravi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pillie λαμβάνει μόνο τον αριθμό των επιλεγμένων στοιχείων. Η επιλογή σου μένει σε αυτή τη συσκευή."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieకి ఎంచుకున్న అంశాల సంఖ్య మాత్రమే అందుతుంది. నీ ఎంపిక ఈ డివైస్‌లోనే ఉంటుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 只會收到所選項目的數量。你的選擇只會保留在這部裝置上。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie કો સિર્ફ઼ ચુને ગએ આઇટમ કી સંખ્યા મિલતી છે। તારા ચયન ઇસી ડિવાઇસ પર રહતા છે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieಕಿ ಆರಿಸಿದ ಅಂಶಾಲ ಸಂಖ್ಯ ಮಾತ್ರೆಮೇ ಅಂದುತುಂದಿ. ನಿನ್ನ ಎಂಪಿಕ ಈ ಡಿವೈಸ್‌ಲೋನೇ ಉಂಟುಂದಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത ഇനങ്ങളുടെ എണ്ണം മാത്രമേ Pillie-ക്ക് ലഭിക്കൂ. നിന്റെ തിരഞ്ഞെടുപ്പ് ഈ ഡിവൈസിൽ തന്നെ തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ला फक्त निवडलेल्या गोष्टींची संख्या मिळते. तुझी निवड याच उपकरणावर राहते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie କେବଳ ବଛା ଆଇଟମ୍‌ର ସଂଖ୍ୟା ପାଏ। ତୁମର ଚୟନ ଏହି ଡିଭାଇସ୍‌ରେ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ਕੋ ਸਿਰ੍ਫ਼ ਚੁਨੇ ਗਏ ਆਇਟਮ ਦੀ ਸਂਖ੍ਯਾ ਮਿਲਤੀ ਹੈ। ਤੇਰਾ ਚਯਨ ਇਸੀ ਡਿਵਾਇਸ ਪਰ ਰਹਤਾ ਹੈ।"
          }
        }
      }
    },
