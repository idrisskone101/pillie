    "onboarding.ready.subtitle": {
      "comment": "No guarantee [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie will follow the schedule you picked. You can change it anytime."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie seguirà il programma selezionato. Puoi modificarlo in qualsiasi momento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie folgt deinem ausgewählten Zeitplan. Du kannst ihn jederzeit ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie suivra le planning que tu as choisi. Tu peux le modifier à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie seguirá el horario que elegiste. Puedes cambiarlo cuando quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie seguirá o cronograma que você escolheu. Você pode alterar a qualquer momento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie volgt het schema dat je koos. Je kunt het altijd wijzigen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie följer det schema du valde. Du kan ändra det när du vill."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie følger den tidsplan, du valgte. Du kan ændre den når som helst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie følger tidsplanen du valgte. Du kan endre den når som helst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie noudattaa valitsemaasi aikataulua. Voit muuttaa sitä milloin tahansa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie vai seguir o horário que escolheste. Podes alterá-lo a qualquer momento."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie seguirà l’horari que has triat. El pots canviar quan vulguis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie będzie trzymać się wybranego harmonogramu. Możesz go zmienić w każdej chwili."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie se bude držet zvoleného rozvrhu. Kdykoliv ho můžeš změnit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie будет следовать выбранному графику. Изменить его можно в любой момент."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie дотримуватиметься вибраного графіка. Змінити його можна будь-коли."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieは選んだスケジュールに従います。いつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie가 선택한 일정을 따라가요. 언제든 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie akan ikut jadual yang kamu pilih. Kamu boleh ubah bila-bila masa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie va urma programul pe care l-ai ales. Îl poți schimba oricând."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie sa bude držať zvoleného rozvrhu. Kedykoľvek ho môžeš zmeniť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie จะทำตามตารางที่คุณเลือก คุณเปลี่ยนได้ทุกเมื่อ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 会按照你选择的时间表运行。你随时可以更改。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie तुम्हारे चुने शेड्यूल पर चलेगा। तुम इसे कभी भी बदल सकते हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie će pratiti raspored koji si odabrala. Možeš ga promijeniti kad god želiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie a kiválasztott beosztást követi. Bármikor módosíthatod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie seçtiğin programı takip eder. İstediğin zaman değiştirebilirsin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீ தேர்ந்தெடுத்த அட்டவணையை Pillie பின்பற்றும். எப்போது வேண்டுமானாலும் மாற்றலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie akan mengikuti jadwal yang kamu pilih. Kamu bisa mengubahnya kapan saja."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتبع Pillie الجدول الذي اخترتِه. يمكنك تغييره في أي وقت."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie תעקוב אחרי לוח הזמנים שבחרת. אפשר לשנות אותו בכל עת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie sẽ theo lịch bạn đã chọn. Bạn có thể đổi bất cứ lúc nào."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie তোমার বেছে নেওয়া সময়সূচি অনুসরণ করবে। যখন খুশি বদলাতে পারো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie تمہارے چُنے ہوئے شیڈول پر چلے گا۔ اسے کبھی بھی بدلا جا سکتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie bo sledil izbranemu urniku. Kadar koli ga lahko spremeniš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pillie θα ακολουθεί το πρόγραμμα που επέλεξες. Μπορείς να το αλλάξεις όποτε θέλεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నువ్వు ఎంచుకున్న షెడ్యూల్‌ను Pillie అనుసరిస్తుంది. ఎప్పుడైనా మార్చుకోవచ్చు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 會依照你選擇的時程運作。你隨時可以更改。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie તારા પસંદ શેડ્યૂલ પર ચાલશે। તું એ ક્યારેય બદલી શકે છે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀನು ಆರಿಸಿದ ಷೆಡ್ಯೂಲ್‌ನು Pillie ಅನುಸರಿಸ್ತುಂದಿ. ಎಪ್ಪುಡೈನಾ ಮಾರ್ಚುಕೋವಚ್ಚು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നീ തിരഞ്ഞെടുത്ത ഷെഡ്യൂൾ Pillie പിന്തുടരും. എപ്പോൾ വേണമെങ്കിലും മാറ്റാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie तुझ्या चुने शेड्यूल पर चलेगा। तू हे कभी भी बदल शकतोस।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ତୁମେ ବାଛିଥିବା ସୂଚୀ ଅନୁସରଣ କରିବ। ତୁମେ ଯେକୌଣସି ସମୟରେ ଏହା ବଦଳାଇପାରିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ਤੇਰੇ ਚੁਨੇ ਸ਼ੇਡ੍ਯੂਲ ਪਰ ਚਲੇਗਾ। ਤੂੰ ਇਸੇ ਕਭੀ ਭੀ ਬਦਲ ਸਕਦੀ ਹੈਂ।"
          }
        }
      }
    },
