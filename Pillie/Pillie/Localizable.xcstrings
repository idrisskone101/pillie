        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હવે તમારો ફોન હલાવો, અથવા આ કાર્ડ પર ટૅપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈಗ ನಿಮ್ಮ ಫೋನ್ ಅಲುಗಾಡಿಸಿ, ಅಥವಾ ಈ ಕಾರ್ಡ್ ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ നിങ്ങളുടെ ഫോൺ കുലുക്കൂ, അല്ലെങ്കിൽ ഈ കാർഡിൽ ടാപ്പ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आता तुमचा फोन हलवा, किंवा या कार्डवर टॅप करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏବେ ଆପଣଙ୍କ ଫୋନ୍ ହଲାନ୍ତୁ, କିମ୍ବା ଏହି କାର୍ଡରେ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੁਣ ਆਪਣਾ ਫ਼ੋਨ ਹਿਲਾਓ, ਜਾਂ ਇਸ ਕਾਰਡ ’ਤੇ ਟੈਪ ਕਰੋ।"
          }
        }
      }
