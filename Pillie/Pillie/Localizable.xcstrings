    "onboarding.acquisition.subtitle": {
      "comment": "Avoid need/protection wording [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answer helps more people find the app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua risposta aiuta più persone a trovare l'app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Antwort hilft mehr Leuten, die App zu finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta réponse aide d'autres personnes à trouver l'app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu respuesta ayuda a que más personas encuentren la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua resposta ajuda mais pessoas a encontrar o app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je antwoord helpt meer mensen de app te vinden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt svar hjälper fler att hitta appen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit svar hjælper flere med at finde appen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret ditt hjelper flere med å finne appen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastauksesi auttaa useampia löytämään sovelluksen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua resposta ajuda mais pessoas a encontrar a app."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva resposta ajuda més gent a trobar l’app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja odpowiedź pomaga innym znaleźć aplikację."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje odpověď pomůže dalším lidem aplikaci najít."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой ответ помогает другим найти приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоя відповідь допомагає іншим знайти застосунок."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの回答が、より多くの人にアプリを届ける助けになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변해 주시면 더 많은 사람이 앱을 찾는 데 도움이 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawapan kamu membantu lebih ramai orang menemui apl ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsul tău ajută mai mulți oameni să găsească aplicația."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja odpoveď pomôže ďalším ľuďom nájsť túto apku."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบของคุณช่วยให้คนอื่นค้นพบแอปนี้ได้มากขึ้น"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的回答能帮助更多人找到这款应用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारा जवाब और लोगों को यह ऐप ढूँढने में मदद करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj odgovor pomaže da više ljudi pronađe aplikaciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszod segít, hogy többen találjanak rá az appra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cevabın daha fazla kişinin uygulamayı bulmasına yardımcı olur."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் பதில் மேலும் பலர் இந்த ஆப்பைக் கண்டறிய உதவும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawabanmu membantu lebih banyak orang menemukan aplikasi ini."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجابتك تساعد مزيدًا من الأشخاص على العثور على التطبيق."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התשובה שלך עוזרת לעוד אנשים למצוא את האפליקציה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời của bạn giúp nhiều người tìm thấy ứng dụng hơn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার উত্তর আরও মানুষকে অ্যাপটি খুঁজে পেতে সাহায্য করে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہارا جواب زیادہ لوگوں کو ایپ ڈھونڈنے میں مدد دیتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj odgovor pomaga, da aplikacijo najde več ljudi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απάντησή σου βοηθά περισσότερους να βρουν την εφαρμογή."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ జవాబు ఈ యాప్‌ను మరింత మంది కనుగొనడానికి సహాయపడుతుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的回答能幫助更多人找到這個應用程式。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તારા જવાબ અને લોગોં કો આ ઍપ ઢૂઁઢને મેં મદદ કરતા છે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ ಜವಾಬು ಈ ಯಾಪ್‌ನು ಮರಿಂತ ಮಂದಿ ಕನುಗೊನಡಾನಿಕಿ ಸಹಾಯಪಡುತುಂದಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിന്റെ ഉത്തരം കൂടുതൽ ആളുകൾക്ക് ആപ്പ് കണ്ടെത്താൻ സഹായിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुझं उत्तर आणखी लोकांना अॅप सापडायला मदत करते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର ଉତ୍ତର ଅଧିକ ଲୋକଙ୍କୁ ଆପ୍ ଖୋଜିବାରେ ସାହାଯ୍ୟ କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੇਰਾ ਜਵਾਬ ਤੇ ਲੋਗੋਂ ਕੋ ਯਹ ਐਪ ਢੂਁਢਨੇ ਵਿੱਚ ਮਦਦ ਕਰਦਾ ਹੈ।"
          }
        }
      }
    },
