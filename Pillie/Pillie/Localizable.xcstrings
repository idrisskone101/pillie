    "legal.disclaimer": {
      "comment": "Use in app where a disclaimer is shown [legal]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie provides reminders and tracking only. It is not medical advice and does not replace guidance from a clinician. Always follow the instructions for your birth control method."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie offre esclusivamente promemoria e monitoraggio. Non fornisce consulenza medica e non sostituisce le indicazioni di un professionista sanitario. Segui sempre le istruzioni del tuo metodo contraccettivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie bietet nur Erinnerungen und Protokollierung. Die App ist keine medizinische Beratung und ersetzt nicht die Empfehlungen medizinischer Fachpersonen. Halte dich immer an die Anleitung deiner Verhütungsmethode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie propose uniquement des rappels et un suivi. Ce n'est pas un avis médical et ça ne remplace pas les conseils d'un·e professionnel·le de santé. Suis toujours les instructions de ta méthode contraceptive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie solo ofrece recordatorios y seguimiento. No es consejo médico ni sustituye la orientación de un profesional de salud. Sigue siempre las instrucciones de tu método anticonceptivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie oferece apenas lembretes e registro. Não é aconselhamento médico e não substitui orientação de profissionais de saúde. Sempre siga as instruções do seu método contraceptivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie biedt alleen herinneringen en bijhouden. Het is geen medisch advies en vervangt geen begeleiding van een zorgverlener. Volg altijd de instructies voor je anticonceptiemethode."
          }
        }
      }
    },
