    "settings.custom_messages.preview_caption": {
      "comment": "Caption under the Lock Screen preview in Reminder messages [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live preview. Tap the pencil to write your own."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاينة مباشرة. انقري على القلم لتكتبي رسالتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ প্রিভিউ। নিজে লিখতে পেনসিলে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualització en directe. Toca el llapis per escriure el teu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živý náhled. Klepnutím na tužku napíšeš vlastní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-forhåndsvisning. Tryk på blyanten for at skrive din egen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Vorschau. Tippe auf den Stift für eigene Texte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζωντανή προεπισκόπηση. Πάτησε το μολύβι για να γράψεις το δικό σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa en vivo. Toca el lápiz para escribir el tuyo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-esikatselu. Kirjoita oma napauttamalla kynää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu en direct. Touche le crayon pour écrire le tien."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાઇવ પ્રિવ્યૂ. જાતે લખવા માટે પેન્સિલ પર ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תצוגה חיה. הקישי על העיפרון כדי לכתוב בעצמך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव प्रीव्यू। ख़ुद लिखने के लिए पेंसिल पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretpregled uživo. Dodirni olovku i napiši svoj tekst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Élő előnézet. Koppints a ceruzára, és írd meg a sajátodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau langsung. Ketuk pensil untuk menulis sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima dal vivo. Tocca la matita per scrivere il tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブプレビュー。鉛筆をタップして自分で書けます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲೈವ್ ಮುನ್ನೋಟ. ನೀವೇ ಬರೆಯಲು ಪೆನ್ಸಿಲ್ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 미리보기예요. 연필을 탭해 직접 써 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൈവ് പ്രിവ്യൂ. സ്വന്തമായി എഴുതാൻ പെൻസിലിൽ ടാപ്പ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव्ह प्रिव्ह्यू. स्वतः लिहिण्यासाठी पेन्सिलवर टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratonton langsung. Ketik pensel untuk menulis sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkte forhåndsvisning. Trykk på blyanten for å skrive din egen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live preview. Tik op het potlood om je eigen tekst te schrijven."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲାଇଭ୍ ପ୍ରିଭ୍ୟୁ। ନିଜେ ଲେଖିବାକୁ ପେନସିଲ୍‌ରେ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਾਈਵ ਪ੍ਰੀਵਿਊ। ਆਪ ਲਿਖਣ ਲਈ ਪੈਨਸਿਲ ’ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podgląd na żywo. Stuknij ołówek, aby napisać własny tekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévia ao vivo. Toque no lápis para escrever o seu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualização em direto. Toca no lápis para escreveres o teu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Previzualizare live. Atinge creionul ca să scrii textul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живой предпросмотр. Нажми на карандаш, чтобы написать свой текст."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Živý náhľad. Ťuknutím na ceruzku napíšeš vlastný."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predogled v živo. Tapni svinčnik in napiši svoje besedilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liveförhandsvisning. Tryck på pennan för att skriva din egen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரடி முன்னோட்டம். நீங்களே எழுத பென்சிலைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లైవ్ ప్రివ్యూ. మీరే రాయడానికి పెన్సిల్‌ను నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวอย่างแบบสด แตะดินสอเพื่อเขียนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı önizleme. Kendin yazmak için kaleme dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Живий перегляд. Торкнися олівця, щоб написати свій текст."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لائیو پیش منظر۔ خود لکھنے کے لیے پنسل پر ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem trước trực tiếp. Chạm vào bút chì để tự viết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时预览。点按铅笔即可自己编写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時預覽。點一下鉛筆即可自己撰寫。"
          }
        }
      }
    },
