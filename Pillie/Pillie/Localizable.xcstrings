    "settings.followup.body": {
      "comment": "Description of recurring follow-up reminders [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional reminders while today’s action is still open."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria aggiuntivi finché l’azione di oggi resta da registrare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weitere Erinnerungen, solange die heutige Aktion noch offen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des rappels supplémentaires tant que l'action du jour est encore en attente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios adicionales mientras la acción de hoy siga pendiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes adicionais enquanto a ação de hoje ainda estiver aberta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra herinneringen zolang de actie van vandaag nog open staat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fler påminnelser medan dagens åtgärd fortfarande är öppen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstra påmindelser, mens dagens handling stadig er åben."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere påminnelser så lenge dagens handling fortsatt er åpen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisämuistutuksia, kun päivän toimenpide on yhä avoinna."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes adicionais enquanto a ação de hoje ainda estiver em aberto."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatoris addicionals mentre l’acció d’avui encara estigui pendent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatkowe przypomnienia, gdy dzisiejsza czynność wciąż czeka."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Další připomínky, dokud je dnešní akce otevřená."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительные напоминания, пока сегодняшнее действие не отмечено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додаткові нагадування, доки сьогоднішню дію не відмічено."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のアクションが未完了の間に送る追加のリマインダーです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 행동이 완료되지 않은 동안 보내는 추가 알림이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan tambahan selagi tindakan hari ini masih belum selesai."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mementouri suplimentare cât timp acțiunea de azi e încă deschisă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ďalšie pripomienky, kým je dnešná akcia ešte otvorená."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนเพิ่มเติมขณะที่กิจกรรมของวันนี้ยังค้างอยู่"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的操作还没完成时，会继续发送额外提醒。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का काम बाक़ी रहने तक अतिरिक्त रिमाइंडर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatni podsjetnici dok je današnja radnja još otvorena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "További emlékeztetők, amíg a mai teendő még nyitva van."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü işlem hâlâ açıkken ek hatırlatmalar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்றைய செயல் நிலுவையில் இருக்கும்போது கூடுதல் நினைவூட்டல்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat tambahan selama tindakan hari ini masih belum selesai."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكيرات إضافية ما دام إجراء اليوم مفتوحًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תזכורות נוספות כל עוד הפעולה של היום עדיין פתוחה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lời nhắc thêm khi việc hôm nay vẫn chưa xong."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের কাজ বাকি থাকলে অতিরিক্ত রিমাইন্ডার।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کا کام باقی رہنے تک اضافی یاد دہانیاں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatni opomniki, dokler je današnje dejanje še odprto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιπλέον υπενθυμίσεις όσο η σημερινή ενέργεια είναι ακόμα ανοιχτή."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు చర్య పెండింగ్‌లో ఉన్నప్పుడు అదనపు రిమైండర్లు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的動作還沒完成時，會持續傳送額外提醒。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજ કા કામ બાક઼ી રહને સુધી અતિરિક્ત રિમાઇંડર।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈರೋಜು ಕೆಲಸ ಪೆಂಡಿಂಗ್‌ಲೋ ಉನ್ನಪ್ಪುಡು ಅದನಪು ಜ್ಞಾಪನೆಲು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്നത്തെ ആക്ഷൻ ബാക്കിയായിരിക്കുമ്പോൾ അധിക റിമൈൻഡറുകൾ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का काम बाक़ी रहने पर्यंत अतिरिक्त आठवण।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଜିର କାମ ବାକି ଥିବା ପର୍ୟ୍ୟନ୍ତ ଅତିରିକ୍ତ ରିମାଇଣ୍ଡର୍।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੱਜ ਦਾ ਕਾਮ ਬਾਕ਼ੀ ਰਹਨੇ ਤੱਕ ਅਤਿਰਿਕ੍ਤ ਰਿਮਾਇਂਡਰ।"
          }
        }
      }
    },
