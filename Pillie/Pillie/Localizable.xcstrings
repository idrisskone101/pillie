            "value": "Ta plaquette, telle que tu la vois dans ta main."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું પેક, હાથમાં જેવું દેખાય છે એવું જ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החפיסה שלך, בדיוק כמו שהיא נראית ביד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पैक, ठीक वैसा ही जैसा हाथ में दिखता है।"
