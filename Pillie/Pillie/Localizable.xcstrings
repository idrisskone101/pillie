    "onboarding.welcome.subtitle": {
      "comment": "Conservative rewrite; no effortless or guarantee claim [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't swipe this reminder away. It stays until you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi scartarlo. Resta fino al check-in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst sie nicht wegwischen. Sie bleibt bis zum Check-in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne peux pas balayer ce rappel. Il reste jusqu'au check-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes descartar este recordatorio. Se queda hasta que hagas el check-in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode descartar este lembrete. Ele fica até o check-in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt deze herinnering niet wegswipen. Die blijft tot je incheckt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan inte svepa bort den här påminnelsen. Den stannar tills du checkar in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke stryge denne påmindelse væk. Den bliver, indtil du tjekker ind."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne påminnelsen kan du ikke sveipe bort. Den blir til du sjekker inn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä muistutusta et voi pyyhkäistä pois. Se pysyy, kunnes kuittaat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consegues deslizar este lembrete para o lado. Fica até registares."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No el pots descartar lliscant. S'hi queda fins que registres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego przypomnienia nie da się odrzucić. Zostaje, aż potwierdzisz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuhle připomínku neodsuneš. Zůstane, dokud nepotvrdíš."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это напоминание не смахнуть. Оно остаётся, пока ты не отметишься."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це нагадування не змахнути. Воно лишається, доки ти не відмітишся."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリマインダーはスワイプで消せません。チェックインするまで残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 알림은 밀어서 없앨 수 없어요. 체크인할 때까지 남아 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan ini tak boleh dileret pergi. Ia kekal sehingga kamu sahkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu poți da acest memento la o parte. Rămâne până confirmi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Túto pripomienku neodsunieš. Zostane, kým to nepotvrdíš."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณปัดการแจ้งเตือนนี้ทิ้งไม่ได้ มันจะอยู่จนกว่าคุณจะเช็กอิน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条提醒划不掉。它会一直留着，直到你完成打卡。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिमाइंडर को तुम स्वाइप करके हटा नहीं सकते। यह चेक-इन तक रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj podsjetnik ne možeš odbaciti. Ostaje dok ne potvrdiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt az emlékeztetőt nem tudod elhúzni. Marad, amíg be nem jelölöd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hatırlatmayı kaydırıp atamazsın. Kaydını yapana kadar kalır."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நினைவூட்டலை ஸ்வைப் செய்து நீக்க முடியாது. நீ செக்-இன் செய்யும் வரை அது இருக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat ini tidak bisa kamu geser. Tetap ada sampai kamu check-in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك تمرير هذا التذكير بعيدًا. يبقى حتى تسجّلي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר להעביר את התזכורת הזו הצידה. היא נשארת עד שתדווחי."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn không thể gạt lời nhắc này đi. Nó sẽ ở lại đến khi bạn điểm danh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রিমাইন্ডার সোয়াইপ করে সরানো যায় না। চেক-ইন না করা পর্যন্ত এটা থাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ یاد دہانی سوائپ کر کے نہیں ہٹ سکتی۔ یہ چیک اِن تک رہتی ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tega opomnika ne moreš odriniti. Ostane, dokler ne potrdiš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν την ξεφορτώνεσαι. Μένει μέχρι να επιβεβαιώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ రిమైండర్‌ను స్వైప్ చేసి తీసేయలేవు. నువ్వు చెక్-ఇన్ చేసేదాకా అది ఉంటుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這則提醒滑不掉。它會一直留著，直到你完成打卡。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ રિમાઇન્ડર તું સ્વાઇપ કરી હટાવી શકે નહીં। એ ચેક-ઇન સુધી રહે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಜ್ಞಾಪನೆಯನ್ನು ನೀನು ಸ್ವೈಪ್ ಮಾಡಿ ತೆಗೆಯಲಾಗದು. ಚೆಕ್-ಇನ್ ತನಕ ಇರುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ റിമൈൻഡർ സ്വൈപ്പ് ചെയ്ത് മാറ്റാൻ കഴിയില്ല. ചെക്ക്-ഇൻ വരെ അത് നിലനിൽക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इस आठवण ला तू स्वाइप करके हटा नाही सकते। हे नोंद पर्यंत रहता आहे."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମେ ଏହି ରିମାଇଣ୍ଡର୍ ସ୍ୱାଇପ୍ କରି ହଟାଇପାରିବ ନାହିଁ। ତୁମେ ଚେକ୍-ଇନ୍ କରିବା ପର୍ୟ୍ୟନ୍ତ ଏହା ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਰਿਮਾਇਂਡਰ ਕੋ ਤੂੰ ਸ੍ਵਾਇਪ ਕਰਦੇ ਹਟਾ ਨਹੀਂ ਸਕਤੇ। ਯਹ ਚੇਕ-ਇਨ ਤੱਕ ਰਹਤਾ ਹੈ।"
          }
        }
      }
    },
