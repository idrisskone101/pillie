        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నమోదు అయింది. రద్దు చేయడానికి నొక్కండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已打卡。點一下可復原。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નોંધ થઈ ગઈ. પાછું લેવા ટૅપ કરો."
