        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci le distrazioni finché non registri l’azione."
          }
        }
      }
    },
    "onboarding.blocking_setup.subtitle": {
      "comment": "Method-neutral [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected apps pause after a Pillie reminder and become available after you log the action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app selezionate vengono messe in pausa dopo un promemoria di Pillie e tornano disponibili dopo la registrazione."
          }
        }
      }
    },
    "onboarding.blocking_setup.title": {
