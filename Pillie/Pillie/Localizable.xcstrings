        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಆ್ಯಪ್‌ಗಳು ತಕ್ಷಣ ಮತ್ತೆ ತೆರೆಯುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ആപ്പുകൾ ഉടൻ വീണ്ടും തുറക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची ॲप्स लगेच पुन्हा उघडतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଆପ୍ ସଙ୍ଗେ ସଙ୍ଗେ ପୁଣି ଖୋଲିଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀਆਂ ਐਪਾਂ ਤੁਰੰਤ ਮੁੜ ਖੁੱਲ੍ਹ ਜਾਂਦੀਆਂ ਹਨ।"
          }
