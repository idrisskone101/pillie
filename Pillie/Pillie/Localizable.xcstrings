        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে আজ থেকে নতুন সাইকেল শুরু হবে। তোমার পুরোনো ইতিহাস থাকবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے آج نیا سائیکل شروع ہو گا۔ تمہاری پرانی ہسٹری رہے گی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem danes začneš nov cikel. Tvoja prejšnja zgodovina ostane."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινά νέος κύκλος σήμερα. Το παλιό ιστορικό σου παραμένει."
