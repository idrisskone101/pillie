            "value": "Ponovno prikazuje demonstraciju pauziranja aplikacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra lejátssza az appszünet bemutatóját."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama duraklatma gösterimini yeniden oynatır."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப் இடைநிறுத்த விளக்கத்தை மீண்டும் காட்டுகிறது."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memutar ulang demonstrasi jeda aplikasi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد عرض شرح إيقاف التطبيقات مؤقتًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג שוב את ההדגמה של השהיית האפליקציות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát lại phần minh họa tạm dừng ứng dụng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ-পজের ডেমো আবার দেখায়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ روکنے کا ڈیمو دوبارہ چلاتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova predvaja prikaz premora aplikacij."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παίζει ξανά την επίδειξη της παύσης εφαρμογών."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్ పాజ్ డెమోను మళ్లీ ప్లే చేస్తుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次播放應用程式暫停的示範。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપ-થોભાવ ડેમો ફરી ચલાવે છે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಾಪ್-ವಿರಾಮ ಡೆಮೋವನ್ನು ಮತ್ತೆ ಚಲಾಯಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് പോസ് ഡെമോ വീണ്ടും പ്ലേ ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अॅप थांबव डेमो पुन्हा दाखवतो."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପ୍ ବିରାମର ପ୍ରଦର୍ଶନ ପୁଣି ଚଲାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ-ਪੌਜ਼ ਦਾ ਡੇਮੋ ਫਿਰ ਚਲਾਤਾ ਹੈ।"
          }
        }
      }
    },
    "onboarding.mechanism.accessibility_summary": {
      "comment": "VoiceOver summary of the mechanism proof [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At your chosen time, Pillie sends a reminder and pauses distracting apps. Log today’s action to make them available again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All’orario scelto, Pillie invia un promemoria e mette in pausa le app che distraggono. Registra l’azione di oggi per renderle di nuovo disponibili."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur gewählten Zeit sendet Pillie eine Erinnerung und pausiert ablenkende Apps. Protokolliere die heutige Aktion, um sie wieder freizugeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l'heure choisie, Pillie envoie un rappel et met en pause les apps qui te distraient. Inscris l'action du jour pour les débloquer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la hora que elijas, Pillie envía un recordatorio y pausa apps que distraen. Registra la acción de hoy para volver a usarlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No horário que você escolher, o Pillie envia um lembrete e pausa apps que distraem. Registre a ação de hoje para liberá-los de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op het door jou gekozen tijdstip stuurt Pillie een herinnering en pauzeert afleidende apps. Houd de actie van vandaag bij om ze weer vrij te geven."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid den tid du valt skickar Pillie en påminnelse och pausar distraherande appar. Logga dagens åtgärd för att göra dem tillgängliga igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På det tidspunkt, du har valgt, sender Pillie en påmindelse og sætter distraherende apps på pause. Log dagens handling for at gøre dem tilgængelige igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På valgt tidspunkt sender Pillie en påminnelse og pauser distraherende apper. Logg dagens handling for å gjøre dem tilgjengelige igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitsemaasi aikaan Pillie lähettää muistutuksen ja laittaa häiritsevät sovellukset tauolle. Kirjaa päivän toimenpide, niin ne ovat taas käytettävissä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "À hora que escolheste, o Pillie envia um lembrete e pausa as apps que te distraem. Regista a ação de hoje para as voltar a libertar."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A l’hora que has triat, Pillie envia un recordatori i pausa les apps que et distreuen. Registra l’acció d’avui per tornar-les a alliberar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O wybranej godzinie Pillie wysyła przypomnienie i wstrzymuje rozpraszające aplikacje. Zapisz dzisiejszą czynność, aby znów były dostępne."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve zvolený čas Pillie pošle připomínku a pozastaví rozptylující aplikace. Zaznamenej dnešní akci a budou zase dostupné."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В выбранное время Pillie отправляет напоминание и ставит отвлекающие приложения на паузу. Отметь сегодняшнее действие, чтобы снова открыть их."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вибраний час Pillie надсилає нагадування й ставить відволікаючі застосунки на паузу. Відміть сьогоднішню дію, щоб знову їх відкрити."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した時間になると、Pillieがリマインダーを送り、気を散らすアプリを一時停止します。今日のアクションを記録すると、また使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 시간이 되면 Pillie가 알림을 보내고 방해되는 앱을 일시 중지해요. 오늘의 행동을 기록하면 다시 사용할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada waktu pilihan kamu, Pillie menghantar peringatan dan menjeda apl yang mengganggu. Rekodkan tindakan hari ini untuk membolehkannya digunakan semula."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La ora aleasă, Pillie îți trimite un memento și pune pe pauză aplicațiile care te distrag. Înregistrează acțiunea de azi ca să le faci din nou disponibile."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vo zvolenom čase ti Pillie pošle pripomienku a pozastaví rušivé aplikácie. Zaznamenaj dnešnú akciu, aby boli zase dostupné."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อถึงเวลาที่คุณเลือก Pillie จะส่งการแจ้งเตือนและพักแอปที่รบกวนสมาธิ บันทึกกิจกรรมของวันนี้เพื่อให้แอปกลับมาใช้ได้อีกครั้ง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到了你设定的时间，Pillie 会发送提醒并暂停会让你分心的应用。记录今天的操作后，它们就会恢复可用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारे चुने समय पर Pillie एक रिमाइंडर भेजता है और ध्यान भटकाने वाले ऐप्स रोक देता है। उन्हें फिर से उपलब्ध करने के लिए आज का काम लॉग करो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U odabrano vrijeme Pillie šalje podsjetnik i pauzira aplikacije koje te ometaju. Zabilježi današnju radnju da ponovno budu dostupne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A választott időpontban a Pillie emlékeztetőt küld, és szünetelteti a figyelemelterelő appokat. Rögzítsd a mai teendőt, hogy újra elérhetők legyenek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğin saatte Pillie bir hatırlatma gönderir ve dikkat dağıtan uygulamaları duraklatır. Uygulamaların yeniden açılması için bugünkü işlemi kaydet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீ தேர்ந்தெடுத்த நேரத்தில் Pillie ஒரு நினைவூட்டலை அனுப்பி, கவனத்தை சிதறடிக்கும் ஆப்ஸை இடைநிறுத்துகிறது. இன்றைய செயலைப் பதிவு செய்தால் அவை மீண்டும் கிடைக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada waktu yang kamu pilih, Pillie mengirim pengingat dan menjeda aplikasi yang mengganggu. Catat tindakan hari ini agar aplikasi bisa dipakai lagi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الوقت الذي اخترتِه، يرسل Pillie تذكيرًا ويوقف التطبيقات المشتّتة مؤقتًا. سجّلي إجراء اليوم لتعود متاحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בזמן שבחרת, Pillie שולחת תזכורת ומשהה אפליקציות מסיחות. רשמי את הפעולה של היום כדי שהן יהיו זמינות שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vào giờ bạn chọn, Pillie gửi lời nhắc và tạm dừng các ứng dụng gây xao nhãng. Ghi lại việc hôm nay để dùng lại chúng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার বেছে নেওয়া সময়ে Pillie একটি রিমাইন্ডার পাঠায় এবং মনোযোগ নষ্ট করা অ্যাপগুলো পজ করে। আজকের কাজটি লগ করলে সেগুলো আবার ব্যবহার করা যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہارے چُنے ہوئے وقت پر Pillie ایک یاد دہانی بھیجتا ہے اور توجہ بھٹکانے والی ایپس روک دیتا ہے۔ آج کا کام لاگ کرو تو وہ دوبارہ کھل جاتی ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob izbranem času Pillie pošlje opomnik in začasno ustavi moteče aplikacije. Zabeleži današnje dejanje, da bodo spet na voljo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Την ώρα που επέλεξες, το Pillie στέλνει υπενθύμιση και βάζει σε παύση τις εφαρμογές που σε αποσπούν. Καταγράψε τη σημερινή ενέργεια για να γίνουν ξανά διαθέσιμες."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నువ్వు ఎంచుకున్న సమయానికి Pillie రిమైండర్ పంపి, దృష్టి మళ్లించే యాప్‌లను పాజ్ చేస్తుంది. ఈరోజు చర్యను నమోదు చేస్తే అవి మళ్లీ అందుబాటులోకి వస్తాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到了你設定的時間，Pillie 會傳送提醒並暫停會讓你分心的應用程式。記錄今天的動作後，它們就會恢復可用。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તારા પસંદના સમયે Pillie રિમાઇન્ડર મોકલે છે અને ધ્યાન ખેંચતા ઍપ્સ થોભાવે છે। તેમને ફરી મેળવવા આજનું કામ નોંધ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀನು ಆರಿಸಿದ ಸಮಯಕ್ಕೆ Pillie ಜ್ಞಾಪನೆ ಕಳುಹಿಸಿ ಗಮನ ಕದಿಯುವ ಆ್ಯಾಪ್‌ಗಳನ್ನು ನಿಲ್ಲಿಸುತ್ತದೆ. ಅವು ಮತ್ತೆ ಸಿಗಲು ಇಂದಿನ ಕೆಲಸ ನೋಂದಿಸು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നീ തിരഞ്ഞെടുത്ത സമയത്ത് Pillie ഒരു റിമൈൻഡർ അയയ്ക്കുകയും ശ്രദ്ധ തിരിക്കുന്ന ആപ്പുകൾ പോസ് ചെയ്യുകയും ചെയ്യുന്നു. അവ വീണ്ടും ലഭ്യമാക്കാൻ ഇന്നത്തെ ആക്ഷൻ രേഖപ്പെടുത്തൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तू निवडलेल्या वेळी Pillie आठवण पाठवतो आणि लक्ष विचलित करणारे अॅप्स थांबवतो. ते परत मिळवण्यासाठी आजची कृती नोंद."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମେ ବାଛିଥିବା ସମୟରେ Pillie ଏକ ରିମାଇଣ୍ଡର୍ ପଠାଏ ଏବଂ ଧ୍ୟାନ ଭାଙ୍ଗୁଥିବା ଆପ୍‌ଗୁଡ଼ିକୁ ବିରାମ କରେ। ସେଗୁଡ଼ିକୁ ପୁଣି ଉପଲବ୍ଧ କରିବାକୁ ଆଜିର କାମ ଲଗ୍ କର।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੇਰੇ ਚੁਨੇ ਸਮਯ ਪਰ Pillie ਏਕ ਰਿਮਾਇਂਡਰ ਭੇਜਤਾ ਹੈ ਤੇ ਧ੍ਯਾਨ ਭਟਕਾਨੇ ਵਾਲੇ ਐਪਾਂ ਰੋਕ ਦੇਤਾ ਹੈ। ਉਨ੍ਹੇਂ ਫਿਰ ਉਪਲਬਧ ਕਰਨੇ ਲਈ ਅੱਜ ਦਾ ਕਾਮ ਲਾਗ ਕਰ।"
          }
        }
      }
    },
    "onboarding.mechanism.eyebrow": {
