        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বেছে নেওয়া রুটিনের ভিত্তিতে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے چنے ہوئے روٹین کی بنیاد پر۔"
