    "onboarding.demo.history_body": {
      "comment": "Tracking statement only [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every check-in adds to your streak and your cycle history."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni conferma si aggiunge alla tua serie e alla cronologia del ciclo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Häkchen zählt für deine Serie und deinen Zyklusverlauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque validation compte pour ta série et ton historique de cycle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día que marcas suma a tu racha y a tu historial del ciclo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada registro soma na sua sequência e no histórico do ciclo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk vinkje telt mee voor je reeks en je cyclusgeschiedenis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje bock räknas in i din svit och din cykelhistorik."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert kryds tæller med i din stime og din cyklushistorik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver avkrysning legges til i rekken og syklushistorikken din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kuittaus kasvattaa putkeasi ja kiertohistoriaasi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada registo conta para a tua sequência e para o histórico do ciclo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada confirmació s’afegeix a la teva ratxa i a l’historial del cicle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde odhaczenie wydłuża twoją serię i uzupełnia historię cyklu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé odškrtnutí prodlouží tvoji sérii a doplní historii cyklu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая отметка пополняет твою серию и историю цикла."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна відмітка поповнює твою серію та історію циклу."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録するたびに、連続記録と周期の履歴が増えていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크할 때마다 연속 기록과 주기 기록이 늘어나요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kali kamu sahkan, rentetan dan sejarah kitaran kamu bertambah."
