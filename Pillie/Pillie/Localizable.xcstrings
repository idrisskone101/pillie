    "settings.followup.body": {
      "comment": "Description of recurring follow-up reminders [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More reminders until you check in today."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altri promemoria finché non confermi oggi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weitere Erinnerungen, bis du heute abhakst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’autres rappels jusqu’à ce que tu valides aujourd’hui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más recordatorios hasta que marques lo de hoy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais lembretes até você registrar hoje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meer herinneringen tot je vandaag afvinkt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fler påminnelser tills du bockar av i dag."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere påmindelser, indtil du krydser af i dag."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere påminnelser til du krysser av i dag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää muistutuksia, kunnes kuittaat tänään."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais lembretes até registares hoje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Més recordatoris fins que confirmis avui."
          }
        },
        "pl": {
