    "settings.schedule_reset.body": {
      "comment": "Integer placeholder [destructive]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing your schedule clears all your history and starts you on day %lld. You can’t undo this."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cambi il programma, cancelli tutta la cronologia e riparti dal giorno %lld. Non puoi annullare questa operazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du deinen Zeitplan änderst, wird dein ganzer Verlauf gelöscht und du startest bei Tag %lld. Das lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer ton planning efface tout ton historique et te fait repartir au jour %lld. Tu ne pourras pas revenir en arrière."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar tu horario borra todo tu historial y empiezas en el día %lld. No se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudar o cronograma apaga todo o seu histórico e recomeça no dia %lld. Não dá para desfazer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je je schema wijzigt, wordt je hele geschiedenis gewist en begin je op dag %lld. Dit kun je niet ongedaan maken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du ändrar ditt schema raderas all din historik och du börjar på dag %lld. Det går inte att ångra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du ændrer din tidsplan, slettes al din historik, og du starter på dag %lld. Det kan ikke fortrydes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du endrer tidsplanen, slettes hele historikken din, og du starter på dag %lld. Dette kan ikke angres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aikataulun muuttaminen poistaa koko historiasi, ja aloitat päivästä %lld. Tätä ei voi kumota."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudar o horário apaga todo o teu histórico e recomeça no dia %lld. Não é possível anular."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si canvies l’horari, s’esborra tot el teu historial i comences al dia %lld. No es pot desfer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana harmonogramu usunie całą historię, a ty zaczniesz od dnia %lld. Nie da się tego cofnąć."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna rozvrhu vymaže celou historii a začneš dnem %lld. Nejde to vrátit zpět."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение графика удалит всю историю, и ты начнёшь с дня %lld. Это нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна графіка видалить усю історію, і ти почнеш із дня %lld. Цю дію не можна скасувати."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールを変更すると、履歴がすべて消去され、%lld日目から始まります。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정을 바꾸면 모든 기록이 삭제되고 %lld일째부터 시작돼요. 되돌릴 수 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukar jadual akan memadam semua sejarah kamu dan bermula pada hari %lld. Ini tidak boleh dibuat asal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă schimbi programul, tot istoricul se șterge și începi de la ziua %lld. Nu poți anula asta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmena rozvrhu vymaže celú históriu a začneš dňom %lld. Nedá sa to vrátiť späť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนตารางจะล้างประวัติทั้งหมดของคุณและเริ่มที่วันที่ %lld ย้อนกลับไม่ได้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改时间表会清除你的所有历史记录，并从第 %lld 天开始。这一步无法撤销。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेड्यूल बदलने से आपका पूरा इतिहास मिट जाता है और शुरुआत दिन %lld से होती है। इसे वापस नहीं किया जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjena rasporeda briše cijelu tvoju povijest i počinješ od dana %lld. To se ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beosztás módosítása törli az összes előzményedet, és a %lld. napon kezdesz. Ezt nem tudod visszavonni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programını değiştirmek tüm geçmişini siler ve seni %lld. günden başlatır. Bu geri alınamaz."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அட்டவணையை மாற்றினால் உங்கள் முழு வரலாறும் அழிக்கப்பட்டு, நீங்கள் நாள் %lld-இல் தொடங்குவீர்கள். இதைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah jadwal akan menghapus semua riwayatmu dan memulai dari hari %lld. Ini tidak bisa dibatalkan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي تغيير جدولك إلى مسح سجلّك بالكامل والبدء من اليوم %lld. لا يمكنك التراجع عن ذلك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי לוח הזמנים ימחק את כל ההיסטוריה שלך, ותתחילי מיום %lld. אי אפשר לבטל את זה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi lịch sẽ xóa toàn bộ lịch sử của bạn và bắt đầu từ ngày %lld. Không thể hoàn tác."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়সূচি বদলালে আপনার সব ইতিহাস মুছে যাবে এবং দিন %lld থেকে শুরু হবে। এটি আর ফেরানো যাবে না।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شیڈول بدلنے سے آپ کی پوری ہسٹری مٹ جاتی ہے اور شروعات دن %lld سے ہوتی ہے۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprememba urnika izbriše vso tvojo zgodovino in začneš na dnevu %lld. Tega ne moreš razveljaviti."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν αλλάξεις το πρόγραμμα, διαγράφεται όλο το ιστορικό σου και ξεκινάς από την ημέρα %lld. Δεν μπορείς να το αναιρέσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షెడ్యూల్ మార్చితే మీ చరిత్ర అంతా తొలగిపోతుంది, మీరు రోజు %lld నుంచి మొదలుపెడతారు. దీన్ని రద్దు చేయలేరు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改時程會清除你的所有歷史紀錄，並從第 %lld 天開始。這一步無法復原。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શેડ્યૂલ બદલવાથી તમારો બધો ઇતિહાસ ભૂંસાઈ જશે અને તમે દિવસ %lld થી શરૂ કરશો. આ પાછું ફેરવી શકાશે નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವೇಳಾಪಟ್ಟಿ ಬದಲಿಸಿದರೆ ನಿಮ್ಮ ಇಡೀ ಇತಿಹಾಸ ಅಳಿಸಿಹೋಗುತ್ತದೆ ಮತ್ತು ನೀವು ದಿನ %lld ರಿಂದ ಪ್ರಾರಂಭಿಸುತ್ತೀರಿ. ಇದನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഷെഡ്യൂൾ മാറ്റിയാൽ നിങ്ങളുടെ ചരിത്രം മുഴുവൻ മായ്ക്കപ്പെടും, നിങ്ങൾ ദിവസം %lld-ൽ തുടങ്ങും. ഇത് പഴയപടിയാക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वेळापत्रक बदलल्याने तुमचा सगळा इतिहास पुसला जातो आणि सुरुवात दिवस %lld पासून होते. हे पूर्ववत करता येत नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସୂଚୀ ବଦଳାଇଲେ ଆପଣଙ୍କ ସମସ୍ତ ଇତିହାସ ଲିଭିଯିବ ଏବଂ ଦିନ %lld ରୁ ଆରମ୍ଭ ହେବ। ଏହାକୁ ଆଉ ଫେରାଇ ହେବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸ਼ਡਿਊਲ ਬਦਲਣ ਨਾਲ ਤੁਹਾਡਾ ਸਾਰਾ ਇਤਿਹਾਸ ਮਿਟ ਜਾਵੇਗਾ ਅਤੇ ਤੁਸੀਂ ਦਿਨ %lld ਤੋਂ ਸ਼ੁਰੂ ਕਰੋਗੇ। ਇਹ ਵਾਪਸ ਨਹੀਂ ਹੋ ਸਕਦਾ।"
          }
        }
      }
    },
