{
  "sourceLanguage": "en",
  "strings": {
    "onboarding.mechanism.release.detail": {
      "comment": "Mechanism-proof third step detail [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your apps become available again right away."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Subito dopo, le tue app tornano disponibili."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach sind deine Apps sofort wieder verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes apps redeviennent disponibles tout de suite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus apps vuelven a estar disponibles al instante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus apps ficam disponíveis de novo na hora."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je apps zijn meteen weer beschikbaar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina appar blir tillgängliga igen direkt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine apps bliver tilgængelige igen med det samme."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appene dine blir tilgjengelige igjen med en gang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksesi ovat heti taas käytettävissä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas apps voltam a ficar disponíveis de imediato."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves apps tornen a estar disponibles de seguida."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje aplikacje od razu znów są dostępne."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikace jsou hned zase dostupné."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои приложения сразу становятся доступны снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твої застосунки одразу знову стають доступними."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはすぐにまた使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 바로 다시 사용할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl kamu boleh digunakan semula serta-merta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile tale devin disponibile din nou imediat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikácie sú hneď zase dostupné."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปของคุณกลับมาใช้ได้ทันที"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后你的应用会立刻恢复可用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारे ऐप्स तुरंत फिर से उपलब्ध हो जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikacije odmah su ponovno dostupne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appjaid rögtön újra elérhetők."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaların hemen yeniden kullanılabilir olur."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் ஆப்ஸ் உடனே மீண்டும் கிடைக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasimu langsung bisa dipakai lagi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعود تطبيقاتك متاحة فورًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציות שלך זמינות שוב מיד."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng của bạn sẽ dùng lại được ngay."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার অ্যাপগুলো সঙ্গে সঙ্গে আবার ব্যবহার করা যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہاری ایپس فوراً دوبارہ کھل جاتی ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikacije so takoj spet na voljo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές σου γίνονται αμέσως ξανά διαθέσιμες."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ యాప్‌లు వెంటనే మళ్లీ అందుబాటులోకి వస్తాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後你的應用程式會立刻恢復可用。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તારા ઍપ્સ તરત જ ફરી મળે છે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ ಆ್ಯಾಪ್‌ಗಳು ತಕ್ಷಣ ಮತ್ತೆ ಸಿಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിന്റെ ആപ്പുകൾ ഉടൻ തന്നെ വീണ്ടും ലഭ്യമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुझे अॅप्स लगेच परत मिळतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର ଆପ୍‌ଗୁଡ଼ିକ ସଙ୍ଗେ ସଙ୍ଗେ ପୁଣି ଉପଲବ୍ଧ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੇਰੇ ਐਪਾਂ ਤੁਰੰਤ ਫਿਰ ਉਪਲਬਧ ਹੋ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        }
      }
    },
