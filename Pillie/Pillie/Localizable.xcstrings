          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё напоминания, пока ты не отметишься сегодня."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще нагадування, доки ти не відмітишся сьогодні."
          }
        },
