        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐにアプリがまた開けるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 앱을 다시 열 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl kamu dibuka semula serta-merta."
