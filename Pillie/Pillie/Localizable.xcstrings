          "stringUnit": {
            "state": "translated",
            "value": "Avbockat. Tryck för att ångra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Krydset af. Tryk for at fortryde."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krysset av. Trykk for å angre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuitattu. Kumoa napauttamalla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registado. Toca para anular."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmat. Toca per desfer-ho."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhaczone. Stuknij, aby cofnąć."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odškrtnuto. Klepnutím vrátíš zpět."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечено. Коснись, чтобы отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відмічено. Торкнись, щоб скасувати."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録しました。タップで取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크했어요. 탭하면 취소돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah disahkan. Ketik untuk buat asal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bifat. Atinge ca să anulezi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odškrtnuté. Ťuknutím vrátiš späť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช็กอินแล้ว แตะเพื่อเลิกทำ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已打卡。点按可撤销。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्ज हो गया। वापस लेने के लिए टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Javljeno. Dodirni za poništavanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kipipálva. Koppints a visszavonáshoz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretlendi. Geri almak için dokun."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு செய்யப்பட்டது. செயல்தவிர்க்கத் தட்டவும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah check-in. Ketuk untuk mengurungkan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التسجيل. انقري للتراجع."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סומן. הקישי לביטול."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã điểm danh. Chạm để hoàn tác."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টিক দেওয়া হয়েছে। ফেরাতে ট্যাপ করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درج ہو گیا۔ واپس لینے کے لیے ٹیپ کریں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkljukano. Tapni za razveljavitev."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημειώθηκε. Πάτα για αναίρεση."
