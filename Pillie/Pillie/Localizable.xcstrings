        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще нагадування, доки ти не відмітишся сьогодні."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日記録するまで、リマインダーをくり返し送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 체크할 때까지 알림을 더 보내요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
