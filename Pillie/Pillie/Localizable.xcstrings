        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksesi aukeavat taas heti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas apps voltam a abrir de imediato."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves apps es tornen a obrir de seguida."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje aplikacje od razu znów się otwierają."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikace se hned zase otevřou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения сразу снова открываются."
