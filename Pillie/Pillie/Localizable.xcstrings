          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव करने से आपका तरीका पैच हो जाएगा और आपका गोली का इतिहास मिट जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
