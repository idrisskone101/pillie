    "settings.schedule_reset.body": {
      "comment": "Integer placeholder [destructive]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the schedule resets all tracking history and starts at day %lld. This cannot be undone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica del programma reimposta tutta la cronologia e riparte dal giorno %lld. L’operazione non può essere annullata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du den Zeitplan änderst, wird der gesamte Protokollverlauf zurückgesetzt und bei Tag %lld neu begonnen. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer le planning réinitialise tout l'historique de suivi et repart au jour %lld. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el horario restablece todo el historial de seguimiento y empieza en el día %lld. Esto no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar o cronograma redefine todo o histórico de registro e recomeça no dia %lld. Isso não pode ser desfeito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je het schema wijzigt, wordt alle bijhoudgeschiedenis gereset en start opnieuw op dag %lld. Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
