    "plus_setup.done.body_partial": {
      "comment": "Done step body when the user skipped a Plus setup step; %@ is the next reminder time [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next reminder is at %@. You can set up the rest in Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكيرك التالي في %@. يمكنكِ ضبط الباقي في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরের রিমাইন্ডার %@-এ। বাকিটা সেটিংস থেকে সেট আপ করতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu proper recordatori és a les %@. La resta la pots configurar a Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Další připomínka přijde v %@. Zbytek si můžeš nastavit v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din næste påmindelse er kl. %@. Resten kan du sætte op i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine nächste Erinnerung kommt um %@. Den Rest kannst du in den Einstellungen einrichten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επόμενη υπενθύμισή σου είναι στις %@. Μπορείς να ορίσεις τα υπόλοιπα στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu próximo recordatorio es a las %@. El resto puedes configurarlo en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraava muistutuksesi on klo %@. Loput voit ottaa käyttöön kohdassa Asetukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton prochain rappel est à %@. Tu peux configurer le reste dans Réglages."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું આગલું રિમાઇન્ડર %@ વાગ્યે છે. બાકીનું તમે સેટિંગ્સમાં સેટ કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התזכורת הבאה שלך ב-%@. את השאר אפשר להגדיר בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका अगला रिमाइंडर %@ पर है। बाक़ी आप सेटिंग्ज़ में सेट कर सकती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sljedeći podsjetnik stiže u %@. Ostalo možeš postaviti u odjeljku Postavke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő emlékeztetőd ekkor jön: %@. A többit a Beállítások között állíthatod be."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat berikutnya pukul %@. Sisanya bisa kamu atur di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo prossimo promemoria è alle %@. Il resto puoi configurarlo in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のリマインダーは%@です。残りは設定からセットアップできます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮುಂದಿನ ಜ್ಞಾಪನೆ %@ ಗಂಟೆಗೆ. ಉಳಿದದ್ದನ್ನು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಹೊಂದಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 알림은 %@에 와요. 나머지는 설정에서 할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അടുത്ത റിമൈൻഡർ %@-ന് ആണ്. ബാക്കിയുള്ളവ ക്രമീകരണങ്ങളിൽ സെറ്റ് ചെയ്യാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा पुढचा रिमाइंडर %@ ला आहे. बाकीचे तुम्ही सेटिंग्जमध्ये सेट करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan seterusnya pada %@. Selebihnya boleh kamu sediakan dalam Tetapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste påminnelse kommer kl. %@. Resten kan du sette opp i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je volgende herinnering is om %@. De rest kun je regelen in Instellingen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ପରବର୍ତ୍ତୀ ରିମାଇଣ୍ଡର୍ %@ ରେ। ବାକି ସବୁ ସେଟିଂସ୍‌ରେ ସେଟ୍ କରିପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਅਗਲਾ ਰਿਮਾਈਂਡਰ %@ ’ਤੇ ਹੈ। ਬਾਕੀ ਤੁਸੀਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਸੈੱਟ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następne przypomnienie o %@. Resztę ustawisz w sekcji Ustawienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu próximo lembrete é às %@. Você pode configurar o resto em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu próximo lembrete é às %@. Podes configurar o resto em Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Următorul memento e la %@. Restul îl poți configura din Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующее напоминание в %@. Остальное можно настроить в разделе «Настройки»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ďalšia pripomienka príde o %@. Zvyšok si môžeš nastaviť v časti Nastavenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslednji opomnik je ob %@. Ostalo lahko nastaviš v razdelku Nastavitve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nästa påminnelse kommer kl. %@. Resten kan du ställa in i Inställningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அடுத்த நினைவூட்டல் %@ மணிக்கு. மீதியை அமைப்புகளில் அமைக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ తర్వాతి రిమైండర్ %@ కి. మిగతావి సెట్టింగ్‌లలో సెట్ చేసుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนครั้งถัดไปคือ %@ คุณตั้งค่าส่วนที่เหลือได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki hatırlatman saat %@. Gerisini Ayarlar’dan kurabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наступне нагадування о %@. Решту можна налаштувати в розділі «Параметри»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی اگلی یاد دہانی %@ پر ہے۔ باقی آپ سیٹنگز میں سیٹ کر سکتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc tiếp theo lúc %@. Bạn có thể thiết lập phần còn lại trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一条提醒在 %@。其余的可以在设置中完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一則提醒在 %@。其餘的可以在設定中完成。"
          }
        }
      }
