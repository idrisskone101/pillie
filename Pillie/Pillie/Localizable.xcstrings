    "settings.break_notice.body": {
      "comment": "Pill regimen feature [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ping when reminders pause for your break week."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ping quando i promemoria si fermano nella settimana di pausa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ping, wenn Erinnerungen in der Pause aussetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ping quand les rappels s'arrêtent pendant ta semaine de pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso cuando los recordatorios se pausan en tu semana de descanso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ping quando os lembretes pausam na sua semana de pausa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ping wanneer herinneringen pauzeren tijdens je stopweek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En puff när påminnelserna pausar under din pausvecka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et prik, når påmindelserne holder pause i din pauseuge."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En pling når påminnelsene pauser i pauseuken din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pingaus, kun muistutukset menevät tauolle taukoviikollasi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um aviso quando os lembretes param na tua semana de pausa."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avís quan els recordatoris s’aturen per la teva setmana de pausa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sygnał, gdy przypomnienia pauzują na tydzień przerwy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění, když se připomínky na týden pauzy zastaví."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигнал, когда напоминания приостанавливаются на неделю перерыва."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигнал, коли нагадування призупиняються на тиждень перерви."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休薬週でリマインダーが止まるときにお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴약 주에 알림이 멈출 때 한 번 알려 드려요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Makluman apabila peringatan berhenti untuk minggu rehat kamu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un semnal când mementourile se opresc pentru săptămâna ta de pauză."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornenie, keď sa pripomienky počas týždňa pauzy zastavia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งให้รู้เมื่อการแจ้งเตือนหยุดพักในสัปดาห์พักของคุณ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停药周提醒暂停时，会发一条提示。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब ब्रेक हफ़्ते में रिमाइंडर रुकते हैं, तब एक पिंग।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ping kad se podsjetnici pauziraju za tvoj tjedan pauze."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelzés, amikor az emlékeztetők a szünethéten leállnak."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara haftanda hatırlatmalar duraklayınca bir uyarı."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் இடைவெளி வாரத்தில் நினைவூட்டல்கள் நிறுத்தப்படும்போது ஒரு பிங்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan saat pengingat berhenti selama minggu jedamu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنبيه عند توقف التذكيرات في أسبوع الاستراحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התראה כשהתזכורות מושהות לשבוע ההפסקה שלך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thông báo khi lời nhắc tạm dừng trong tuần nghỉ của bạn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিরতির সপ্তাহে রিমাইন্ডার থামলে একটি পিং।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک پنگ جب تمہارے وقفے کے ہفتے میں یاد دہانیاں رکتی ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvestilo, ko se opomniki med tednom premora ustavijo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ειδοποίηση όταν οι υπενθυμίσεις σταματούν για την εβδομάδα διαλείμματος."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ విరామ వారంలో రిమైండర్లు ఆగినప్పుడు ఒక పింగ్."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停藥週提醒暫停時，會傳送一則提示。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે બ્રેક હફ઼્તે મેં રિમાઇંડર રુકતે છે, તબ એક પિંગ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿನ್ನ ವಿರಾಮ ವಾರಂಲೋ ಜ್ಞಾಪನೆಲು ಆಗಿನಪ್ಪುಡು ಒಕ ಪಿಂಗ್."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇടവേള ആഴ്ചയിൽ റിമൈൻഡറുകൾ നിർത്തുമ്പോൾ ഒരു പിംഗ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जेव्हा ब्रेक आठवडे मध्ये आठवण रुकते हैं, तब एक पिंग।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର ବିରତି ସପ୍ତାହ ପାଇଁ ରିମାଇଣ୍ଡର୍ ବନ୍ଦ ହେଲେ ଏକ ପିଙ୍ଗ୍।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦ ਬ੍ਰੇਕ ਹਫ਼੍ਤੇ ਵਿੱਚ ਰਿਮਾਇਂਡਰ ਰੁਕਤੇ ਹੈਂ, ਤਬ ਏਕ ਪਿਂਗ।"
          }
        }
      }
    },
