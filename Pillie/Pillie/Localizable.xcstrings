          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಮುಂದುವರಿದಂತೆ ನಿಮ್ಮ ಇತಿಹಾಸ ಬೆಳೆಯುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തുടരുന്നതിനനുസരിച്ച് നിങ്ങളുടെ ചരിത്രം വളരും"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा इतिहास हळूहळू तयार होतो"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଯେତେ ଆଗକୁ ବଢ଼ିବେ, ଆପଣଙ୍କ ଇତିହାସ ସେତେ ଗଢ଼ି ଉଠିବ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਿਵੇਂ-ਜਿਵੇਂ ਤੁਸੀਂ ਅੱਗੇ ਵਧਦੇ ਹੋ, ਤੁਹਾਡਾ ਇਤਿਹਾਸ ਬਣਦਾ ਜਾਂਦਾ ਹੈ"
          }
        }
      }
    },
