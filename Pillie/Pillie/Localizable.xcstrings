            "state": "translated",
            "value": "I promemoria restano. Plus può pausare le app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels restent actifs. Plus peut mettre les apps en pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios siguen activos. Plus puede pausar apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes continuam ativos. O Plus pode pausar apps."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen blijven aan. Plus kan apps pauzeren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelserna är kvar. Plus kan pausa appar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Påmindelserne fortsætter. Plus kan sætte apps på pause."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelsene er fortsatt på. Plus kan pause apper."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistutukset pysyvät päällä. Plus voi laittaa sovellukset tauolle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes continuam ativos. O Plus pode pausar apps."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els recordatoris continuen actius. El Plus pot pausar apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia działają dalej. Plus może wstrzymywać aplikacje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připomínky zůstávají zapnuté. Plus umí pozastavit aplikace."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания работают. Plus может ставить приложения на паузу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування працюють. Plus може ставити застосунки на паузу."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーはそのまま。Plusならアプリを一時停止できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 계속 켜져 있어요. Plus는 앱을 일시 중지할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan kekal hidup. Plus boleh menjeda apl."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mementourile rămân pornite. Plus poate pune aplicațiile pe pauză."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomienky zostávajú zapnuté. Plus vie pozastaviť aplikácie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนยังเปิดอยู่ Plus พักแอปได้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒保持开启。Plus 可以暂停应用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर चालू रहते हैं। Plus ऐप्स रोक सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnici ostaju uključeni. Plus može pauzirati aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emlékeztetők maradnak. A Plus szüneteltetni tudja az appokat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatmalar açık kalır. Plus uygulamaları duraklatabilir."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நினைவூட்டல்கள் ஆன். Plus ஆப்ஸை இடைநிறுத்தலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat tetap aktif. Plus bisa menjeda aplikasi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التذكيرات تبقى مفعّلة. يمكن لـ Plus إيقاف التطبيقات مؤقتًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התזכורות נשארות פועלות. Plus יכול להשהות אפליקציות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc vẫn bật. Plus có thể tạm dừng ứng dụng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডার চালু থাকে। Plus অ্যাপ পজ করতে পারে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانیاں آن رہتی ہیں۔ Plus ایپس روک سکتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opomniki ostanejo vklopljeni. Plus lahko ustavi aplikacije."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι υπενθυμίσεις μένουν ενεργές. Το Plus μπορεί να βάλει εφαρμογές σε παύση."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిమైండర్లు ఆన్‌లో ఉంటాయి. Plus యాప్‌లను పాజ్ చేయగలదు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒維持開啟。Plus 可以暫停應用程式。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇંડર ચાલૂ રહતે છે। Plus ઍપ્સ રોક સકતા છે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜ್ಞಾಪನೆಲು ಆನ್‌ಲೋ ಉಂಟಾಯಿ. Plus ಆ್ಯಾಪ್ನು ಪಾಜ್ ಚೇಯಗಲದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിമൈൻഡറുകൾ ഓണായി തുടരും. Plus ആപ്പുകൾ പോസ് ചെയ്യാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आठवण चालू रहते आहेत. Plus अॅप्स थांबव सकता आहे."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ଚାଲୁ ରହେ। Plus ଆପ୍ ବିରାମ କରିପାରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਇਂਡਰ ਚਾਲੂ ਰਹਤੇ ਹੈਂ। Plus ਐਪਾਂ ਰੋਕ ਸਕਦਾ ਹੈ।"
          }
        }
      }
    },
