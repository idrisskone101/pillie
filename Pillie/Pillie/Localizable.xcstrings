        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ପ୍ୟାକ୍‌ର ପିଲ୍ ଧାଡ଼ି ସହ ମିଳାଇ ଦେଖନ୍ତୁ।"
          }
