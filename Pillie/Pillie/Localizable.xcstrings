    "onboarding.demo.explainer": {
      "comment": "No adherence guarantee [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie reminds you, you check in, and your history fills in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie te lo ricorda, tu confermi e la cronologia si riempie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie erinnert dich, du hakst ab, und dein Verlauf füllt sich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie te rappelle, tu valides, et ton historique se remplit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie te lo recuerda, tú lo marcas y tu historial se completa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie lembra, você registra e seu histórico vai se completando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie herinnert je eraan, jij vinkt af en je geschiedenis vult zich aan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie påminner dig, du bockar av, och din historik fylls på."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie minder dig om det. Du krydser af, og din historik fyldes ud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie minner deg på det, du krysser av, og historikken din fylles ut."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie muistuttaa, sinä kuittaat, ja historiasi täyttyy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie lembra-te, tu registas e o teu histórico vai-se preenchendo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie t’ho recorda, tu confirmes i el teu historial es va omplint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie przypomina, ty odhaczasz dzień, a historia sama się uzupełnia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ti připomene, ty odškrtneš dnešek a historie se sama doplní."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie напоминает, ты отмечаешься, а история заполняется сама."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie нагадує, ти відмічаєшся, а історія заповнюється сама."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieがリマインドして、あなたが記録すると、履歴が埋まっていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie가 알려 주고, 체크하면 기록이 채워져요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ingatkan kamu, kamu sahkan, dan sejarah kamu terisi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie îți amintește, tu bifezi ziua, iar istoricul se completează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ti pripomenie, ty odškrtneš dnešok a história sa sama doplní."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie เตือนคุณ คุณเช็กอิน แล้วประวัติก็บันทึกไว้ให้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 提醒你，你来打卡，历史记录就会慢慢填满。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie याद दिलाता है, आप दर्ज करती हैं, और इतिहास भरता जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie te podsjeti, ti se javiš, a povijest se sama popunjava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie emlékeztet, te kipipálod, az előzményeid pedig maguktól telnek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie hatırlatır, sen işaretlersin, geçmişin de dolar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie நினைவூட்டும், நீங்கள் பதிவு செய்வீர்கள், உங்கள் வரலாறு நிரம்பும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie mengingatkanmu, kamu check-in, dan riwayatmu terisi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يذكّرك Pillie، فتسجّلين، ويمتلئ سجلّك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie מזכירה, את מסמנת, וההיסטוריה שלך מתמלאת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie nhắc bạn, bạn điểm danh, và lịch sử tự được ghi lại."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie মনে করিয়ে দেয়, আপনি টিক দেন, আর আপনার ইতিহাস তৈরি হতে থাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie یاد دلاتا ہے، آپ درج کرتی ہیں، اور ہسٹری بھرتی جاتی ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie te opomni, ti odkljukaš, zgodovina pa se sproti polni."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pillie σού θυμίζει, εσύ το σημειώνεις και το ιστορικό σου γεμίζει."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie గుర్తు చేస్తుంది, మీరు నమోదు చేస్తారు, మీ చరిత్ర నిండుతుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 提醒你，你來打卡，歷史紀錄就會慢慢填滿。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie યાદ અપાવે છે, તમે નોંધ કરો છો, અને તમારો ઇતિહાસ ભરાતો જાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ನೆನಪಿಸುತ್ತದೆ, ನೀವು ದಾಖಲಿಸುತ್ತೀರಿ, ನಿಮ್ಮ ಇತಿಹಾಸ ತುಂಬುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ഓർമ്മിപ്പിക്കും, നിങ്ങൾ രേഖപ്പെടുത്തും, നിങ്ങളുടെ ചരിത്രം നിറയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie आठवण करून देते, तुम्ही नोंद करता, आणि इतिहास भरत जातो."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ମନେ ପକାଏ, ଆପଣ ଦର୍ଜ କରନ୍ତି, ଆଉ ଆପଣଙ୍କ ଇତିହାସ ଭରିଚାଲେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ਯਾਦ ਕਰਾਉਂਦਾ ਹੈ, ਤੁਸੀਂ ਦਰਜ ਕਰਦੇ ਹੋ, ਅਤੇ ਤੁਹਾਡਾ ਇਤਿਹਾਸ ਭਰਦਾ ਜਾਂਦਾ ਹੈ।"
          }
        }
      }
    },
    "onboarding.demo.history_body": {
      "comment": "Tracking statement only [health]",
      "localizations": {
