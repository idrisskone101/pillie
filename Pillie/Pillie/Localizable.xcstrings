    "settings.cycle_day.history_note": {
      "comment": "State mutation disclosure [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier days count as done. Nothing gets marked missed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni precedenti contano come fatti. Nessuno viene segnato come saltato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühere Tage gelten als erledigt. Kein Tag wird als verpasst markiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours précédents comptent comme faits. Aucun jour n'est marqué comme oublié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días anteriores cuentan como hechos. Ninguno se marca como omitido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias anteriores contam como concluídos. Nenhum dia é marcado como perdido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerdere dagen tellen als gedaan. Geen dag wordt als gemist gemarkeerd."
          }
        }
      }
    },
