    "today.action.undo_complete": {
      "comment": "Undo label [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked in. Tap to undo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confermato. Tocca per annullare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
