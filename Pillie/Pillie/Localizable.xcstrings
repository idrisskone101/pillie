          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalment, quant tard la prens després del recordatori?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak szybko po przypomnieniu zwykle ją bierzesz?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak brzy po připomínce si ji obvykle vezmeš?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как быстро ты обычно принимаешь её после напоминания?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як швидко ти зазвичай приймаєш її після нагадування?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーの後、普段どのくらいで飲みますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 후 보통 얼마 만에 복용하나요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa cepat kamu biasanya ambil selepas peringatan?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de repede o iei de obicei după memento?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako skoro po pripomienke ju zvyčajne užiješ?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปกติคุณกินยาเร็วแค่ไหนหลังได้รับการแจ้งเตือน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到提醒后，你通常多久会服用？"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर के बाद तुम आम तौर पर कितनी जल्दी लेती हो?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko brzo je obično uzmeš nakon podsjetnika?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Általában mennyi idővel az emlékeztető után veszed be?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatmadan sonra genelde ne kadar sürede alıyorsun?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நினைவூட்டலுக்குப் பிறகு பொதுவாக எவ்வளவு விரைவில் எடுக்கிறாய்?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biasanya seberapa cepat kamu meminumnya setelah pengingat?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد كم من الوقت تأخذينها عادةً بعد التذكير؟"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה זמן אחרי התזכורת את בדרך כלל לוקחת אותה?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau lời nhắc, bạn thường uống sau bao lâu?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডারের পরে সাধারণত কত তাড়াতাড়ি নাও?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی کے بعد عموماً کتنی جلدی لی جاتی ہے؟"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako hitro po opomniku jo običajno vzameš?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο γρήγορα το παίρνεις συνήθως μετά την υπενθύμιση;"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిమైండర్ తర్వాత సాధారణంగా ఎంత త్వరగా తీసుకుంటావు?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收到提醒後，你通常多久會服用？"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇંડર કે પછી તું સામાન્ય રીતે કિતની જલ્દી લેતી હો?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜ್ಞಾಪನೆಯ ನಂತರ ನೀನು ಸಾಮಾನ್ಯವಾಗಿ ಎಷ್ಟು ಬೇಗ ತೆಗೆದುಕೊಳ್ಳುತ್ತೀಯ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിമൈൻഡറിന് ശേഷം സാധാരണയായി എത്ര വേഗം കഴിക്കും?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आठवण के नंतर तू आम तौर पर कितनी जल्दी लेती हो?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ପରେ ତୁମେ ସାଧାରଣତଃ କେତେ ଶୀଘ୍ର ନିଅ?"
