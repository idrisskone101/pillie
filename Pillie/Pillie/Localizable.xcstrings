        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse luokat tai sovellukset Applen Käyttöajalla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o Tempo de Ecrã da Apple para escolher categorias ou apps."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir el Temps d’ús d’Apple per triar categories o apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kategorie lub aplikacje w Czasie przed ekranem Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie nebo aplikace vyber přes Čas u obrazovky od Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери категории или приложения через Экранное время Apple."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери категорії або застосунки через Екранний час Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleのスクリーンタイムでカテゴリやアプリを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 스크린 타임으로 카테고리나 앱을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Masa Skrin Apple untuk memilih kategori atau apl."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește Timp de utilizare de la Apple pentru a alege categorii sau aplicații."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategórie alebo aplikácie vyber cez Čas pred obrazovkou od Apple."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เวลาหน้าจอของ Apple เพื่อเลือกหมวดหมู่หรือแอป"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 屏幕使用时间来选择类别或应用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "श्रेणियाँ या ऐप्स चुनने के लिए Apple स्क्रीन टाइम का इस्तेमाल करो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomoću Appleova Vremena uporabe odaberi kategorije ili aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Képernyőidővel válassz kategóriákat vagy appokat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategori veya uygulama seçmek için Apple Ekran Süresi'ni kullan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ஸ்கிரீன் டைம் மூலம் வகைகள் அல்லது ஆப்ஸைத் தேர்ந்தெடு."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Durasi Layar Apple untuk memilih kategori atau aplikasi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدمي مدة استخدام الجهاز من Apple لاختيار الفئات أو التطبيقات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרי קטגוריות או אפליקציות דרך זמן מסך של Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng Thời gian sử dụng của Apple để chọn danh mục hoặc ứng dụng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাটাগরি বা অ্যাপ বেছে নিতে Apple স্ক্রিন টাইম ব্যবহার করো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زمرے یا ایپس چُننے کے لیے Apple اسکرین ٹائم استعمال کرو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z Applovim Časom uporabe izberi kategorije ali aplikacije."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε τον Χρόνο Χρήσης της Apple για να διαλέξεις κατηγορίες ή εφαρμογές."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple స్క్రీన్ టైమ్ ద్వారా వర్గాలు లేదా యాప్‌లను ఎంచుకో."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 螢幕使用時間來選擇類別或應用程式。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શ્રેણિયાઁ યા ઍપ્સ પસંદ કરવા માટે Apple સ્ક્રીન ટાઇમ કા ઇસ્તેમાલ કર।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ಸ್ಕ್ರೀನ್ ಟೈಮ್ ದ್ವಾರಾ ವರ್ಗಾಲು ಲೇದಾ ಆ್ಯಾಪ್ನು ಎಂಚುಕೋ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിഭാഗങ്ങളോ ആപ്പുകളോ തിരഞ്ഞെടുക്കാൻ Apple സ്ക്രീൻ ടൈം ഉപയോഗിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्ग किंवा अॅप्स निवडायला Apple Screen Time वापर."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବର୍ଗ ବା ଆପ୍ ବାଛିବାକୁ Apple Screen Time ବ୍ୟବହାର କର।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸ਼੍ਰੇਣਿਯਾਁ ਯਾ ਐਪਾਂ ਚੁਨਨੇ ਲਈ Apple ਸ੍ਕ੍ਰੀਨ ਟਾਇਮ ਦਾ ਵਰਤੋਂ ਕਰ।"
          }
        }
      }
    },
