        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken karta liknar din?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த பேக் உங்களுடையதைப் போல் இருக்கிறது?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ ప్యాక్ మీ ప్యాక్‌లా ఉంది?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผงยาแบบไหนเหมือนของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi paket seninkine benziyor?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яка упаковка схожа на твою?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کون سا پیک آپ کے پیک جیسا ہے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vỉ nào giống vỉ của bạn?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪种药板和你的一样？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪種藥盒和你的一樣？"
          }
        }
      }
    },
    "onboarding.pack_sheet.subtitle": {
      "comment": "Onboarding pack type sheet subtitle [standard]",
      "localizations": {
