    "onboarding.dial.patch.subtitle": {
      "comment": "Onboarding drag-the-dial subtitle (patch). ENG-146 [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the patch, then drag to today."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختاري اللصقة، ثم اسحبي حتى اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্যাচ বেছে নিন, তারপর টেনে আজকের দিনে আনুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria el pegat i arrossega fins avui."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber náplast a pak přetáhni na dnešek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg plasteret, og træk så til i dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl das Pflaster und zieh dann bis heute."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε αυτοκόλλητο και σύρε μέχρι σήμερα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el parche y desliza hasta hoy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse laastari ja vedä sitten tähän päivään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis le patch, puis fais glisser jusqu’à aujourd’hui."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પેચ પસંદ કરો, પછી આજ સુધી ખેંચો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרי מדבקה, ואז גררי עד היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैच चुनें, फिर आज तक खींचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi flaster, pa povuci do danas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki a tapaszt, majd húzd a mai napig."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih koyonya, lalu geser ke hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il cerotto, poi trascina fino a oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッチを選んで、今日の位置までドラッグしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ಯಾಚ್ ಆರಿಸಿ, ನಂತರ ಇಂದಿನವರೆಗೆ ಎಳೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패치를 고른 다음 오늘까지 드래그하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പാച്ച് തിരഞ്ഞെടുക്കൂ, എന്നിട്ട് ഇന്നുവരെ വലിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पॅच निवडा, मग आजपर्यंत ओढा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tampalan, kemudian seret ke hari ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg plasteret, og dra så til i dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de pleister en sleep dan naar vandaag."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ୟାଚ୍ ବାଛନ୍ତୁ, ତାପରେ ଆଜି ପର୍ଯ୍ୟନ୍ତ ଟାଣନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੈਚ ਚੁਣੋ, ਫਿਰ ਅੱਜ ਤੱਕ ਖਿੱਚੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz plaster, a potem przeciągnij do dziś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o adesivo e arraste até hoje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe o adesivo e arrasta até hoje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege plasturele, apoi trage până azi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери пластырь и перетащи точку на сегодня."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber náplasť a potom potiahni na dnešok."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi obliž, nato povleci do danes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj plåstret och dra sedan till i dag."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பேட்சைத் தேர்ந்தெடுத்து, இன்று வரை இழுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్యాచ్‌ను ఎంచుకోండి, తర్వాత ఈరోజు వరకు లాగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแผ่นแปะ แล้วลากไปที่วันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandı seç, sonra bugüne sürükle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обери пластир і перетягни точку на сьогодні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پیچ چنیں، پھر آج تک کھینچیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn miếng dán, rồi kéo đến hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择贴片，然后拖到今天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇貼片，然後拖到今天。"
          }
        }
      }
