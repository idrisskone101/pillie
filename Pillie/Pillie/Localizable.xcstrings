            "state": "translated",
            "value": "Sacseja el mòbil ara o toca aquesta targeta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrząśnij teraz telefonem albo stuknij tę kartę."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď zatřes telefonem, nebo klepni na tuto kartu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встряхни телефон сейчас или коснись этой карточки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Струсни телефон зараз або торкнись цієї картки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐスマートフォンを振るか、このカードをタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 휴대폰을 흔들거나 이 카드를 탭하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Goncang telefon kamu sekarang, atau ketik kad ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scutură-ți telefonul acum sau atinge acest card."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz zatras telefónom alebo ťukni na túto kartu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขย่าโทรศัพท์ตอนนี้ หรือแตะการ์ดนี้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在摇一摇手机，或点按这张卡片。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी अपना फ़ोन हिलाएँ, या इस कार्ड पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protresi telefon sada ili dodirni ovu karticu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rázd meg most a telefont, vagy koppints erre a kártyára."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi telefonunu salla ya da bu karta dokun."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது உங்கள் போனைக் குலுக்குங்கள், அல்லது இந்த கார்டைத் தட்டுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Goyangkan ponselmu sekarang, atau ketuk kartu ini."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هزّي هاتفك الآن، أو انقري على هذه البطاقة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נערי את הטלפון עכשיו, או הקישי על הכרטיס הזה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lắc điện thoại ngay bây giờ, hoặc chạm vào thẻ này."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন ফোনটি ঝাঁকান, অথবা এই কার্ডে ট্যাপ করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی اپنا فون ہلائیں، یا اس کارڈ پر ٹیپ کریں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdaj stresi telefon ali tapni to kartico."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κούνησε τώρα το τηλέφωνό σου ή πάτα αυτή την κάρτα."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇప్పుడు మీ ఫోన్‌ను ఊపండి, లేదా ఈ కార్డ్‌ను నొక్కండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在搖一搖手機，或點一下這張卡片。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હવે તમારો ફોન હલાવો, અથવા આ કાર્ડ પર ટૅપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈಗ ನಿಮ್ಮ ಫೋನ್ ಅಲುಗಾಡಿಸಿ, ಅಥವಾ ಈ ಕಾರ್ಡ್ ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ നിങ്ങളുടെ ഫോൺ കുലുക്കൂ, അല്ലെങ്കിൽ ഈ കാർഡിൽ ടാപ്പ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आता तुमचा फोन हलवा, किंवा या कार्डवर टॅप करा."
          }
        },
        "or": {
