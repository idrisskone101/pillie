    "support.open_line.issue_invitation": {
      "comment": "Issue-report email body invitation [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us what went wrong. The more detail, the better. Type above this line."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccontaci cosa non ha funzionato. Più dettagli, meglio è. Scrivi sopra questa riga."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe, was nicht funktioniert hat. Je mehr Details, desto besser. Schreibe über dieser Zeile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-nous ce qui n’a pas marché. Plus tu donnes de détails, mieux c’est. Écris au-dessus de cette ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos qué salió mal. Cuantos más detalles, mejor. Escribe encima de esta línea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte o que deu errado. Quanto mais detalhes, melhor. Escreva acima desta linha."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertel wat er misging. Hoe meer details, hoe beter. Typ boven deze regel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berätta vad som gick fel. Ju fler detaljer, desto bättre. Skriv ovanför den här raden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortæl os, hvad der gik galt. Jo flere detaljer, jo bedre. Skriv over denne linje."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortell oss hva som gikk galt. Jo flere detaljer, jo bedre. Skriv over denne linjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro, mikä meni pieleen. Mitä tarkemmin, sen parempi. Kirjoita tämän rivin yläpuolelle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz-nos o que correu mal. Quanto mais detalhes, melhor. Escreve acima desta linha."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica’ns què ha fallat. Com més detalls, millor. Escriu a sobre d’aquesta línia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz, co poszło nie tak. Im więcej szczegółów, tym lepiej. Pisz nad tą linią."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Popiš, co se pokazilo. Čím víc detailů, tím lépe. Piš nad tuto čáru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажи, что пошло не так. Чем подробнее, тем лучше. Пиши над этой строкой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розкажи, що пішло не так. Чим детальніше, тим краще. Пиши над цим рядком."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何がうまくいかなかったか教えてください。詳しいほど助かります。この線の上に入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이 잘못됐는지 알려 주세요. 자세할수록 좋아요. 이 줄 위에 입력하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceritakan apa yang tak kena. Lebih terperinci, lebih baik. Taip di atas garisan ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune-ne ce nu a mers. Cu cât mai multe detalii, cu atât mai bine. Scrie deasupra acestei linii."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíš nám, čo sa pokazilo. Čím viac detailov, tým lepšie. Píš nad túto čiaru."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่าให้เราฟังว่าเกิดอะไรผิดพลาด ยิ่งละเอียดยิ่งดี พิมพ์เหนือบรรทัดนี้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉我们出了什么问题，越详细越好。请在此行上方输入。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बताएँ कि क्या गड़बड़ हुई। जितना ज़्यादा ब्योरा, उतना अच्छा। इस लाइन के ऊपर लिखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reci nam što nije radilo. Što više detalja, to bolje. Piši iznad ove linije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd le, mi ment rosszul. Minél részletesebben, annál jobb. Ez fölé a vonal fölé írj."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyin yanlış gittiğini anlat. Ne kadar ayrıntı, o kadar iyi. Bu satırın üstüne yaz."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என்ன தவறு நடந்தது என்று சொல்லுங்கள். எவ்வளவு விவரம் தருகிறீர்களோ அவ்வளவு நல்லது. இந்த வரிக்கு மேலே எழுதுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceritakan apa yang salah. Semakin detail, semakin baik. Ketik di atas garis ini."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبرينا بما حدث. كلما زادت التفاصيل كان أفضل. اكتبي فوق هذا السطر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספרי לנו מה השתבש. כמה שיותר פרטים, יותר טוב. כתבי מעל השורה הזו."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kể cho chúng mình biết có gì không ổn. Càng chi tiết càng tốt. Viết phía trên dòng này."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী সমস্যা হয়েছে, আমাদের জানান। যত বিস্তারিত, তত ভালো। এই লাইনের ওপরে লিখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بتائیں کہ کیا گڑبڑ ہوئی۔ جتنی زیادہ تفصیل، اتنا اچھا۔ اس لائن کے اوپر لکھیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povej nam, kaj je šlo narobe. Več podrobnosti, tem bolje. Piši nad to črto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πες μας τι πήγε στραβά. Όσο πιο αναλυτικά, τόσο καλύτερα. Γράψε πάνω από αυτή τη γραμμή."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏం తప్పు జరిగిందో మాకు చెప్పండి. ఎంత వివరంగా చెబితే అంత మంచిది. ఈ లైన్ పైన రాయండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴我們發生了什麼問題，越詳細越好。請在這一行上方輸入。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું ખોટું થયું તે અમને જણાવો. જેટલી વધુ વિગત, એટલું સારું. આ લાઇનની ઉપર લખો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನು ತಪ್ಪಾಯಿತು ಎಂದು ನಮಗೆ ತಿಳಿಸಿ. ಹೆಚ್ಚು ವಿವರ ಕೊಟ್ಟಷ್ಟೂ ಒಳ್ಳೆಯದು. ಈ ಸಾಲಿನ ಮೇಲೆ ಬರೆಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്താണ് തെറ്റിയതെന്ന് ഞങ്ങളോട് പറയൂ. കൂടുതൽ വിശദമായാൽ അത്രയും നല്ലത്. ഈ വരിക്ക് മുകളിൽ എഴുതൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काय बिघडले ते सांगा. जितका जास्त तपशील, तितके चांगले. या ओळीच्या वर लिहा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କ’ଣ ଭୁଲ ହେଲା ଆମକୁ କୁହନ୍ତୁ। ଯେତେ ଅଧିକ ବିବରଣୀ, ସେତେ ଭଲ। ଏହି ରେଖା ଉପରେ ଲେଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਨੂੰ ਦੱਸੋ ਕਿ ਕੀ ਗੜਬੜ ਹੋਈ। ਜਿੰਨਾ ਵੱਧ ਵੇਰਵਾ, ਓਨਾ ਚੰਗਾ। ਇਸ ਲਾਈਨ ਤੋਂ ਉੱਪਰ ਲਿਖੋ।"
          }
        }
      }
    },
