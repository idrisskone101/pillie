    "settings.schedule.save_note.pill_to_patch": {
      "comment": "Schedule sheet line above Save when the method changes [destructive]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving switches you to Patch and clears your pill history."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي الحفظ إلى التبديل إلى اللصقة ومسح سجلّ الحبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেভ করলে আপনার পদ্ধতি প্যাচ হয়ে যাবে এবং আপনার পিলের ইতিহাস মুছে যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si deses, passes al pegat i s’esborra el teu historial de la píndola."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložením přejdeš na náplast a vymažeš historii pilulky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du gemmer, skifter du til plaster, og din pillehistorik slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Speichern wechselst du zum Pflaster und dein Pillen-Verlauf wird gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με την αποθήκευση περνάς στο αυτοκόλλητο και διαγράφεται το ιστορικό του χαπιού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar, cambias al parche y se borra tu historial de la píldora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentaminen vaihtaa sinut laastariin ja poistaa pillerihistoriasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer te fait passer au patch et efface ton historique de pilule."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાચવવાથી તમારી પદ્ધતિ પેચ થઈ જશે અને તમારો ગોળીનો ઇતિહાસ ભૂંસાઈ જશે."
          }
        },
        "he": {
          "stringUnit": {
