          "stringUnit": {
            "state": "translated",
            "value": "ਹੋ ਗਿਆ। ਤੁਹਾਡੀਆਂ ਐਪਾਂ ਮੁੜ ਖੁੱਲ੍ਹ ਗਈਆਂ ਹਨ।"
          }
        }
      }
    },
