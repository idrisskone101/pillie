        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso ajuda o Pillie a decidir o quão firmes seus lembretes devem ser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo weet Pillie hoe stevig je herinneringen moeten zijn."
          }
        },
        "sv": {
