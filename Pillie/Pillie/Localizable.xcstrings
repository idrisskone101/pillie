        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоя упаковка, такая же, как у тебя в руке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje balenie, presne ako ho vidíš v ruke."
