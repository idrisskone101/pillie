    "onboarding.blocking_demo.title": {
      "comment": "Replaces protection claim [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps pause until you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app restano in pausa finché non confermi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apps pausieren, bis du abhakst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps se mettent en pause jusqu’à ce que tu valides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps se pausan hasta que marques lo de hoy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps ficam pausados até você registrar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je apps pauzeren tot je afvinkt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appar pausas tills du bockar av."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps er på pause, indtil du krydser af."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appene er pauset til du krysser av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellukset ovat tauolla, kunnes kuittaat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As apps ficam em pausa até registares."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps es queden en pausa fins que confirmis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje są wstrzymane, aż odhaczysz dzień."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace jsou pozastavené, dokud neodškrtneš dnešek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения на паузе, пока ты не отметишься."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунки на паузі, доки ти не відмітишся."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録するまで、アプリは一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크할 때까지 앱이 일시 중지돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl dijeda sehingga kamu sahkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile stau pe pauză până bifezi ziua."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácie sú pozastavené, kým neodškrtneš dnešok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปจะหยุดชั่วคราวจนกว่าคุณจะเช็กอิน"
