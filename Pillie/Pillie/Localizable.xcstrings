    "onboarding.frequency.subtitle": {
      "comment": "Replaces protection level [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So we know how firm the reminders should be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così sappiamo quanto devono essere insistenti i promemoria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So wissen wir, wie fest die Erinnerungen sein sollen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme ça on sait à quel point les rappels doivent être insistant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así sabemos qué tan firmes deben ser los recordatorios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim sabemos o quão firmes os lembretes devem ser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo weten we hoe stevig de herinneringen moeten zijn."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så vi vet hur bestämda påminnelserna ska vara."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Så vi ved, hvor bestemte påmindelserne skal være."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Så vi vet hvor bestemte påminnelsene bør være."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näin tiedämme, kuinka tiukkoja muistutusten pitäisi olla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sabermos quão firmes os lembretes devem ser."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Així sabem com de ferms han de ser els recordatoris."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki temu wiemy, jak stanowcze mają być przypomnienia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Abychom věděli, jak důrazné mají připomínky být."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так мы поймём, насколько настойчивыми должны быть напоминания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Так ми зрозуміємо, наскільки наполегливими мають бути нагадування."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーの強さを決めるためにお聞きします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 얼마나 확실하게 보낼지 정하기 위해서예요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Supaya kami tahu sekuat mana peringatan itu perlu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca să știm cât de insistente să fie mementourile."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby sme vedeli, aké dôrazné majú pripomienky byť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้เรารู้ว่าควรแจ้งเตือนหนักแน่นแค่ไหน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样我们才知道提醒该有多坚决。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताकि हमें पता चले कि रिमाइंडर कितने सख़्त होने चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Da znamo koliko uporni podsjetnici trebaju biti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Így tudjuk, milyen határozottak legyenek az emlékeztetők."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatmaların ne kadar ısrarcı olacağını bilelim."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நினைவூட்டல்கள் எவ்வளவு உறுதியாக இருக்க வேண்டும் என்று தெரிந்துகொள்ள."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Supaya kami tahu seberapa tegas pengingatnya perlu dibuat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لنعرف كم يجب أن تكون التذكيرات حازمة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי שנדע כמה נחושות התזכורות צריכות להיות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để chúng mình biết lời nhắc nên kiên quyết đến mức nào."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাতে আমরা জানি রিমাইন্ডার কতটা জোরালো হওয়া উচিত।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاکہ ہمیں پتا ہو یاد دہانیاں کتنی سخت ہونی چاہییں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Da vemo, kako odločni naj bodo opomniki."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να ξέρουμε πόσο επίμονες πρέπει να είναι οι υπενθυμίσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిమైండర్లు ఎంత గట్టిగా ఉండాలో మాకు తెలియడానికి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這樣我們才知道提醒該有多堅定。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તાકિ હમેં પતા ચલે કિ રિમાઇંડર કિતને સખ઼્ત હોને ચાહિએ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜ್ಞಾಪನೆಲು ಎಂತ ಗಟ್ಟಿಗಾ ಉಂಡಾಲೋ ಮಾಕು ತೆಲಿಯಡಾನಿಕಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിമൈൻഡറുകൾ എത്ര ദൃഢമായിരിക്കണം എന്ന് ഞങ്ങൾക്ക് അറിയാൻ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आठवणी किती घट्ट हव्या ते कळावं म्हणून."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯାହା ଦ୍ୱାରା ଆମେ ଜାଣିପାରିବୁ ରିମାଇଣ୍ଡର୍ କେତେ ଦୃଢ଼ ହେବା ଉଚିତ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤਾਕਿ ਹਵਿੱਚ ਪਤਾ ਚਲੇ ਕਿ ਰਿਮਾਇਂਡਰ ਕਿਤਨੇ ਸਖ਼੍ਤ ਹੋਨੇ ਚਾਹੀਦਾ ਹੈ।"
          }
        }
      }
    },
