    "settings.schedule.method_picker.footer": {
      "comment": "Schedule sheet method picker copy [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changes until you tap Save."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتغير شيء حتى تضغطي على حفظ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“সেভ করুন” ট্যাপ না করা পর্যন্ত কিছুই বদলাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No canvia res fins que toquis Desar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se nezmění, dokud neklepneš na Uložit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet ændres, før du trykker på Gem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst wenn du auf Speichern tippst, ändert sich etwas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα δεν αλλάζει μέχρι να πατήσεις Αποθήκευση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada hasta que toques Guardar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään ei muutu, ennen kuin napautat Tallenna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne change tant que tu n’as pas touché Enregistrer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“સાચવો” પર ટૅપ નહીં કરો ત્યાં સુધી કંઈ બદલાશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא משתנה עד שתקישי על שמירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“सेव करें” पर टैप करने तक कुछ नहीं बदलेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa se ne mijenja dok ne dodirneš Spremi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi sem változik, amíg nem koppintasz a Mentés gombra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang berubah sampai kamu ketuk Simpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non cambia nulla finché non tocchi Salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「保存」をタップするまで何も変わりません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“ಉಳಿಸಿ” ಟ್ಯಾಪ್ ಮಾಡುವವರೆಗೆ ಏನೂ ಬದಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장을 탭하기 전까지는 아무것도 바뀌지 않아요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“സേവ് ചെയ്യൂ” ടാപ്പ് ചെയ്യുന്നതുവരെ ഒന്നും മാറില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“सेव्ह करा” वर टॅप करेपर्यंत काहीही बदलणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa yang berubah sehingga kamu ketik Simpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting endres før du trykker på Lagre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er verandert niets tot je op Opslaan tikt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "“ସେଭ୍ କରନ୍ତୁ” ଟାପ୍ ନକରିବା ପର୍ଯ୍ୟନ୍ତ କିଛି ବଦଳିବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“ਸੇਵ ਕਰੋ” ’ਤੇ ਟੈਪ ਕਰਨ ਤੱਕ ਕੁਝ ਨਹੀਂ ਬਦਲੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic się nie zmieni, dopóki nie stukniesz Zapisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada muda até você tocar em Salvar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada muda até tocares em Guardar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nu se schimbă până nu atingi Salvează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не изменится, пока не нажмёшь «Сохранить»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič sa nezmení, kým neťukneš na Uložiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič se ne spremeni, dokler ne tapneš Shrani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget ändras förrän du trycker på Spara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“சேமிக்கவும்” தட்டும் வரை எதுவும் மாறாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“సేవ్ చేయండి” నొక్కే వరకు ఏదీ మారదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะยังไม่มีอะไรเปลี่ยนจนกว่าคุณจะแตะ บันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydet’e dokunana kadar hiçbir şey değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не зміниться, доки не натиснеш «Зберегти»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“محفوظ کریں” پر ٹیپ کرنے تک کچھ نہیں بدلے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẽ không có gì thay đổi cho đến khi bạn chạm Lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“保存”之前，什么都不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「儲存」之前，什麼都不會改變。"
          }
        }
      }
    },
