    "settings.final_reminder.body": {
      "comment": "No medical urgency [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A final reminder if today’s action is still open."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ultimo promemoria se l’azione di oggi è ancora da registrare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine letzte Erinnerung, falls die heutige Aktion noch offen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dernier rappel si l'action du jour est encore en attente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio final si la acción de hoy sigue pendiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete final se a ação de hoje ainda estiver aberta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een laatste herinnering als de actie van vandaag nog open staat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En sista påminnelse om dagens åtgärd fortfarande är öppen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En sidste påmindelse, hvis dagens handling stadig er åben."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En siste påminnelse hvis dagens handling fortsatt er åpen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeinen muistutus, jos päivän toimenpide on yhä avoinna."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um último lembrete se a ação de hoje ainda estiver em aberto."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un últim recordatori si l’acció d’avui encara està pendent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie przypomnienie, jeśli dzisiejsza czynność wciąż czeka."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslední připomínka, pokud je dnešní akce stále otevřená."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Финальное напоминание, если сегодняшнее действие ещё не отмечено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фінальне нагадування, якщо сьогоднішню дію ще не відмічено."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のアクションが未完了のときの最後のリマインダーです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 행동이 아직 완료되지 않았을 때 보내는 마지막 알림이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan akhir jika tindakan hari ini masih belum selesai."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ultim memento dacă acțiunea de azi e încă deschisă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posledná pripomienka, ak je dnešná akcia ešte otvorená."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนครั้งสุดท้ายหากกิจกรรมของวันนี้ยังค้างอยู่"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果今天的操作还没完成，会发送最后一条提醒。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आज का काम बाक़ी है तो एक आख़िरी रिमाइंडर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadnji podsjetnik ako je današnja radnja još otvorena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy utolsó emlékeztető, ha a mai teendő még nyitva van."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü işlem hâlâ açıksa son bir hatırlatma."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்றைய செயல் இன்னும் நிலுவையில் இருந்தால் ஒரு கடைசி நினைவூட்டல்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat terakhir jika tindakan hari ini masih belum selesai."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكير أخير إذا كان إجراء اليوم ما زال مفتوحًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תזכורת אחרונה אם הפעולה של היום עדיין פתוחה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lời nhắc cuối nếu việc hôm nay vẫn chưa xong."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের কাজ এখনো বাকি থাকলে একটি শেষ রিমাইন্ডার।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آج کا کام ابھی باقی ہو تو ایک آخری یاد دہانی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadnji opomnik, če je današnje dejanje še odprto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια τελευταία υπενθύμιση αν η σημερινή ενέργεια είναι ακόμα ανοιχτή."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు చర్య ఇంకా పెండింగ్‌లో ఉంటే ఒక చివరి రిమైండర్."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果今天的動作還沒完成，會傳送最後一則提醒。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અગર આજ કા કામ બાક઼ી છે તો એક આખ઼િરી રિમાઇંડર।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈರೋಜು ಕೆಲಸ ಇಂಕಾ ಪೆಂಡಿಂಗ್‌ಲೋ ಉಂಟೇ ಒಕ ಚಿವರಿ ಜ್ಞಾಪನೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്നത്തെ ആക്ഷൻ ഇപ്പോഴും ബാക്കിയാണെങ്കിൽ ഒരു അവസാന റിമൈൻഡർ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जर आज का काम बाक़ी आहे तर एक आख़िरी आठवण।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଜିର କାମ ବାକି ଥିଲେ ଏକ ଶେଷ ରିମାଇଣ୍ଡର୍।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਗਰ ਅੱਜ ਦਾ ਕਾਮ ਬਾਕ਼ੀ ਹੈ ਤੋ ਏਕ ਆਖ਼ਿਰੀ ਰਿਮਾਇਂਡਰ।"
          }
        }
      }
