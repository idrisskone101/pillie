    "settings.custom_messages.body": {
      "comment": "User-authored text is never translated [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write what each reminder says. The preview shows how it will appear on your Lock Screen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi il testo di ogni promemoria. L’anteprima mostra come apparirà sulla schermata di blocco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege den Text jeder Erinnerung fest. Die Vorschau zeigt, wie sie auf deinem Sperrbildschirm erscheint."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris ce que dit chaque rappel. L’aperçu montre comment il apparaîtra sur ton écran verrouillé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe lo que dice cada recordatorio. La vista previa muestra cómo aparecerá en tu pantalla bloqueada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva o que cada lembrete diz. A prévia mostra como aparecerá na Tela Bloqueada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf wat elke herinnering zegt. De preview laat zien hoe het op je vergrendelscherm verschijnt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv vad varje påminnelse ska säga. Förhandsvisningen visar hur den ser ut på din låsskärm."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv, hvad hver påmindelse skal sige. Forhåndsvisningen viser, hvordan den ser ud på din låseskærm."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv hva hver påminnelse skal si. Forhåndsvisningen viser hvordan den ser ut på låst skjerm."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita, mitä kukin muistutus sanoo. Esikatselu näyttää, miltä se näyttää lukitulla näytöllä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve o que cada lembrete diz. A pré-visualização mostra como vai aparecer no teu ecrã bloqueado."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriu què diu cada recordatori. La previsualització mostra com apareixerà a la pantalla bloquejada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz, co ma mówić każde przypomnienie. Podgląd pokazuje, jak pojawi się na ekranie blokady."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiš, co má každá připomínka říkat. Náhled ukazuje, jak se zobrazí na zamčené obrazovce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напиши, что будет в каждом напоминании. Предпросмотр показывает, как оно выглядит на экране блокировки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напиши, що буде в кожному нагадуванні. Попередній перегляд показує, як воно виглядатиме на екрані блокування."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各リマインダーの文言を書けます。プレビューでロック画面での表示を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 알림에 표시할 문구를 직접 써 보세요. 미리보기로 잠금 화면에 어떻게 보일지 확인할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis apa yang setiap peringatan katakan. Pratonton menunjukkan bagaimana ia dipaparkan pada Skrin Kunci kamu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrie ce spune fiecare memento. Previzualizarea arată cum va apărea pe ecranul de blocare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíš, čo má každá pripomienka hovoriť. Náhľad ukazuje, ako sa zobrazí na zamknutej obrazovke."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนข้อความของแต่ละการแจ้งเตือนเอง ตัวอย่างจะแสดงว่ามันจะปรากฏบนหน้าจอล็อกอย่างไร"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编写每条提醒的内容。预览会显示它在锁定屏幕上的样子。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिखें कि हर रिमाइंडर में क्या लिखा हो। प्रीव्यू दिखाता है कि यह आपकी लॉक स्क्रीन पर कैसा दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiši što svaki podsjetnik kaže. Pretpregled pokazuje kako će izgledati na zaključanom zaslonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd meg, mit mondjon minden emlékeztető. Az előnézet mutatja, hogyan jelenik meg a zárolási képernyőn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her hatırlatmanın ne diyeceğini yaz. Önizleme, Kilit Ekranı’nda nasıl görüneceğini gösterir."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு நினைவூட்டலும் என்ன சொல்ல வேண்டும் என்று எழுதுங்கள். அது உங்கள் பூட்டுத் திரையில் எப்படித் தோன்றும் என்று முன்னோட்டத்தில் பார்க்கலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis isi setiap pengingat. Pratinjau menunjukkan tampilannya di Layar Kunci."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتبي ما يقوله كل تذكير. تعرض المعاينة كيف سيظهر على شاشة القفل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתבי מה כל תזכורת אומרת. התצוגה המקדימה מראה איך היא תופיע במסך הנעילה שלך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết nội dung cho từng lời nhắc. Bản xem trước cho thấy nó sẽ hiện thế nào trên Màn hình khóa."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি রিমাইন্ডারে কী লেখা থাকবে, লিখুন। লক স্ক্রিনে এটি কেমন দেখাবে, প্রিভিউতে তা দেখা যায়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لکھیں کہ ہر یاد دہانی میں کیا لکھا ہو۔ پیش نظارہ دکھاتا ہے کہ یہ آپ کی لاک اسکرین پر کیسی دکھے گی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiši, kaj naj pove vsak opomnik. Predogled pokaže, kako bo videti na zaklenjenem zaslonu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γράψε τι λέει κάθε υπενθύμιση. Η προεπισκόπηση δείχνει πώς θα φαίνεται στην κλειδωμένη οθόνη σου."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి రిమైండర్ ఏం చెప్పాలో రాయండి. మీ లాక్ స్క్రీన్‌పై అది ఎలా కనిపిస్తుందో ప్రివ్యూ చూపిస్తుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撰寫每則提醒的內容。預覽會顯示它在鎖定畫面上的樣子。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક રિમાઇન્ડરમાં શું લખાય તે લખો. પ્રિવ્યૂ બતાવે છે કે તે તમારી લૉક સ્ક્રીન પર કેવું દેખાશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಜ್ಞಾಪನೆ ಏನು ಹೇಳಬೇಕು ಎಂದು ಬರೆಯಿರಿ. ನಿಮ್ಮ ಲಾಕ್ ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ ಅದು ಹೇಗೆ ಕಾಣುತ್ತದೆ ಎಂದು ಮುನ್ನೋಟ ತೋರಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ റിമൈൻഡറും എന്ത് പറയണമെന്ന് എഴുതൂ. നിങ്ങളുടെ ലോക്ക് സ്ക്രീനിൽ അത് എങ്ങനെ കാണുമെന്ന് പ്രിവ്യൂ കാണിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक रिमाइंडरमध्ये काय लिहायचे ते लिहा. ते तुमच्या लॉक स्क्रीनवर कसे दिसेल ते प्रिव्ह्यूमध्ये दिसते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ରିମାଇଣ୍ଡର୍ କ’ଣ କହିବ, ଲେଖନ୍ତୁ। ଆପଣଙ୍କ ଲକ୍ ସ୍କ୍ରିନ୍‌ରେ ଏହା କେମିତି ଦେଖାଯିବ, ପ୍ରିଭ୍ୟୁ ତାହା ଦେଖାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਿਖੋ ਕਿ ਹਰ ਰਿਮਾਈਂਡਰ ਕੀ ਕਹੇ। ਪ੍ਰੀਵਿਊ ਦਿਖਾਉਂਦਾ ਹੈ ਕਿ ਇਹ ਤੁਹਾਡੀ ਲੌਕ ਸਕ੍ਰੀਨ ’ਤੇ ਕਿਵੇਂ ਦਿਖਾਈ ਦੇਵੇਗਾ।"
          }
        }
      }
    },
