        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğin rutine göre oluşturuldu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீ தேர்ந்தெடுத்த வழக்கத்திலிருந்து உருவாக்கப்பட்டது."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
