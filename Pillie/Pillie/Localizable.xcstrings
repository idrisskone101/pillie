          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes začne nová rutina. Dosavadní historie zůstane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня начнётся новая рутина. Прежняя история сохранится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні почнеться нова рутина. Попередня історія збережеться."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日から新しいルーティンを始めます。これまでの履歴は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘부터 새 루틴이 시작돼요. 이전 기록은 유지돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memulakan rutin baharu hari ini. Sejarah sebelumnya disimpan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asta începe azi o rutină nouă. Istoricul anterior se păstrează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes sa začne nová rutina. Doterajšia história zostáva."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะเริ่มรูทีนใหม่ตั้งแต่วันนี้ ประวัติก่อนหน้ายังเก็บไว้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从今天开始新的日常安排。之前的历史记录会保留。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आज नई रूटीन शुरू होती है। पिछला इतिहास बना रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovim danas počinje nova rutina. Prethodna povijest se čuva."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel ma új rutin kezdődik. A korábbi előzmények megmaradnak."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bugün yeni bir rutin başlatır. Önceki geçmiş korunur."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இன்று ஒரு புதிய வழக்கத்தைத் தொடங்கும். முந்தைய வரலாறு அப்படியே இருக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memulai rutinitas baru hari ini. Riwayat sebelumnya tetap tersimpan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ هذا روتينًا جديدًا اليوم. يُحتفظ بالسجل السابق."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה מתחיל שגרה חדשה היום. ההיסטוריה הקודמת נשמרת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này bắt đầu lịch mới từ hôm nay. Lịch sử trước đó được giữ lại."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে আজ থেকে নতুন রুটিন শুরু হবে। আগের ইতিহাস থাকবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے آج نیا روٹین شروع ہوتا ہے۔ پچھلی ہسٹری برقرار رہتی ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem danes začneš novo rutino. Prejšnja zgodovina se ohrani."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινά νέα ρουτίνα σήμερα. Το προηγούμενο ιστορικό διατηρείται."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ఈరోజు కొత్త రొటీన్ మొదలుపెడుతుంది. మునుపటి చరిత్ర అలాగే ఉంటుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從今天開始新的日常安排。之前的歷史紀錄會保留。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આનાથી આજે નવી રૂટિન શરૂ થશે. અગાઉનો ઇતિહાસ સચવાયેલો રહેશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಇಂದು ಹೊಸ ದಿನಚರಿಯನ್ನು ಪ್ರಾರಂಭಿಸುತ್ತದೆ. ಹಿಂದಿನ ಇತಿಹಾಸ ಹಾಗೆಯೇ ಇರುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് ഇന്ന് ഒരു പുതിയ റുട്ടീൻ തുടങ്ങും. മുൻ ചരിത്രം അതേപടി തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यामुळे आज नवीन दिनक्रम सुरू होतो. आधीचा इतिहास राहतो."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା ଆଜି ଏକ ନୂଆ ରୁଟିନ୍ ଆରମ୍ଭ କରେ। ପୂର୍ବ ଇତିହାସ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਨਾਲ ਅੱਜ ਤੋਂ ਨਵੀਂ ਰੁਟੀਨ ਸ਼ੁਰੂ ਹੋਵੇਗੀ। ਪਿਛਲਾ ਇਤਿਹਾਸ ਰਹੇਗਾ।"
          }
        }
      }
    },
