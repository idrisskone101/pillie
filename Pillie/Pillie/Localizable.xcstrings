    "onboarding.permission.body": {
      "comment": "Capability statement [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie needs notification permission to send the reminders you set."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie necessita dell’autorizzazione alle notifiche per inviare i promemoria impostati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie benötigt die Mitteilungsberechtigung, um deine festgelegten Erinnerungen zu senden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie a besoin de l'autorisation de notifications pour envoyer les rappels que tu configures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie necesita permiso de notificaciones para enviar los recordatorios que configures."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie precisa de permissão de notificações para enviar os lembretes que você definir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie heeft meldingsrechten nodig om de herinneringen te sturen die je instelt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie behöver tillåtelse för notiser för att kunna skicka de påminnelser du ställer in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie skal have tilladelse til notifikationer for at sende de påmindelser, du indstiller."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie trenger tillatelse til varslinger for å sende påminnelsene du har satt opp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie tarvitsee ilmoitusluvan lähettääkseen asettamasi muistutukset."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie precisa de permissão para notificações para enviar os lembretes que defines."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie necessita permís de notificacions per enviar-te els recordatoris que defineixis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie potrzebuje zgody na powiadomienia, aby wysyłać ustawione przez ciebie przypomnienia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie potřebuje povolení k oznámením, aby mohla posílat připomínky, které si nastavíš."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie нужно разрешение на уведомления, чтобы отправлять заданные тобой напоминания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie потрібен дозвіл на сповіщення, щоб надсилати задані тобою нагадування."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定したリマインダーを送るために、Pillieには通知の許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 알림을 보내려면 Pillie에 알림 권한이 필요해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie memerlukan kebenaran pemberitahuan untuk menghantar peringatan yang kamu tetapkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie are nevoie de permisiunea pentru notificări ca să-ți trimită mementourile pe care le setezi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie potrebuje povolenie na upozornenia, aby ti mohla posielať pripomienky, ktoré si nastavíš."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ต้องได้รับอนุญาตให้ส่งการแจ้งเตือน เพื่อส่งการเตือนที่คุณตั้งไว้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 需要通知权限，才能发送你设定的提醒。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारे सेट किए रिमाइंडर भेजने के लिए Pillie को नोटिफ़िकेशन की अनुमति चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie treba dopuštenje za obavijesti da bi slao podsjetnike koje postaviš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie-nek értesítési engedély kell, hogy elküldhesse a beállított emlékeztetőidet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie, ayarladığın hatırlatmaları gönderebilmek için bildirim iznine ihtiyaç duyar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீ அமைத்த நினைவூட்டல்களை அனுப்ப Pillie-க்கு அறிவிப்பு அனுமதி தேவை."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie perlu izin notifikasi untuk mengirim pengingat yang kamu atur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Pillie إلى إذن الإشعارات لإرسال التذكيرات التي حددتِها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie צריכה הרשאת התראות כדי לשלוח את התזכורות שהגדרת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie cần quyền thông báo để gửi các lời nhắc bạn đã đặt."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার সেট করা রিমাইন্ডার পাঠাতে Pillie-এর নোটিফিকেশনের অনুমতি লাগবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمہاری سیٹ کی ہوئی یاد دہانیاں بھیجنے کے لیے Pillie کو نوٹیفکیشن کی اجازت چاہیے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie potrebuje dovoljenje za obvestila, da lahko pošilja opomnike, ki jih nastaviš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pillie χρειάζεται άδεια για ειδοποιήσεις, ώστε να στέλνει τις υπενθυμίσεις που ορίζεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నువ్వు సెట్ చేసిన రిమైండర్లు పంపడానికి Pillieకి నోటిఫికేషన్ అనుమతి కావాలి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 需要通知權限，才能傳送你設定的提醒。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તારા સેટ કિએ રિમાઇંડર ભેજને માટે Pillie કો નોટિફ઼િકેશન કી અનુમતિ ચાહિએ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀನು ಸೆಟ್ ಚೇಸಿನ ಜ್ಞಾಪನೆಲು ಪಂಪಡಾನಿಕಿ Pillieಕಿ ನೋಟಿಫಿಕೇಷನ್ ಅನುಮತಿ ಕಾವಾಲಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നീ സജ്ജമാക്കിയ റിമൈൻഡറുകൾ അയയ്ക്കാൻ Pillie-ക്ക് നോട്ടിഫിക്കേഷൻ അനുമതി ആവശ്യമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तू सेट केलेल्या आठवणी पाठवण्यासाठी Pillie ला सूचना परवानगी हवी."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମେ ସେଟ୍ କରିଥିବା ରିମାଇଣ୍ଡର୍ ପଠାଇବାକୁ Pillie କୁ ନୋଟିଫିକେସନ୍ ଅନୁମତି ଦରକାର।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੇਰੇ ਸੇਟ ਕਿਏ ਰਿਮਾਇਂਡਰ ਭੇਜਨੇ ਲਈ Pillie ਕੋ ਨੋਟਿਫ਼ਿਕੇਸ਼ਨ ਦੀ ਅਨੁਮਤਿ ਚਾਹੀਦਾ ਹੈ।"
          }
        }
      }
    },
