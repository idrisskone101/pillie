    "support.open_line.issue_invitation": {
      "comment": "Issue-report email body invitation [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us what went wrong — the more detail, the better. Type above this line."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccontaci che cosa non ha funzionato: più dettagli inserisci, meglio è. Scrivi sopra questa riga."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe, was nicht funktioniert hat — je mehr Details, desto besser. Schreibe über dieser Zeile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-nous ce qui n'a pas marché — plus tu détailles, mieux c'est. Écris au-dessus de cette ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos qué salió mal — cuantos más detalles, mejor. Escribe arriba de esta línea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte o que deu errado — quanto mais detalhes, melhor. Escreva acima desta linha."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertel wat er misging — hoe meer detail, hoe beter. Typ boven deze regel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berätta vad som gick fel — ju fler detaljer, desto bättre. Skriv ovanför den här raden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortæl os, hvad der gik galt — jo flere detaljer, jo bedre. Skriv over denne linje."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortell oss hva som gikk galt — jo flere detaljer, jo bedre. Skriv over denne linjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro, mikä meni pieleen — mitä tarkemmin, sen parempi. Kirjoita tämän rivin yläpuolelle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz-nos o que correu mal — quanto mais detalhes, melhor. Escreve acima desta linha."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica’ns què ha fallat — com més detalls, millor. Escriu a sobre d’aquesta línia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz, co poszło nie tak — im więcej szczegółów, tym lepiej. Pisz nad tą linią."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Popiš, co se pokazilo — čím víc detailů, tím lépe. Piš nad tuto čáru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажи, что пошло не так — чем подробнее, тем лучше. Пиши над этой строкой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розкажи, що пішло не так — чим детальніше, тим краще. Пиши над цим рядком."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何がうまくいかなかったか教えてください。詳しいほど助かります。この線の上に入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이 잘못됐는지 알려 주세요. 자세할수록 좋아요. 이 줄 위에 입력하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceritakan apa yang tak kena — lebih terperinci, lebih baik. Taip di atas garisan ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune-ne ce nu a mers — cu cât mai multe detalii, cu atât mai bine. Scrie deasupra acestei linii."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíš nám, čo sa pokazilo — čím viac detailov, tým lepšie. Píš nad túto čiaru."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่าให้เราฟังว่าเกิดอะไรขึ้น — ยิ่งละเอียดยิ่งดี พิมพ์เหนือบรรทัดนี้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉我们出了什么问题——越详细越好。请在此行上方输入。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बताओ क्या गड़बड़ हुई — जितना ज़्यादा ब्योरा, उतना अच्छा। इस लाइन के ऊपर लिखो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reci nam što nije radilo — što više detalja, to bolje. Piši iznad ove linije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd le, mi ment rosszul — minél részletesebben, annál jobb. Írj e vonal fölé."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyin yanlış gittiğini anlat — ne kadar ayrıntı, o kadar iyi. Bu satırın üstüne yaz."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என்ன தவறு நடந்தது என்று சொல் — எவ்வளவு விவரம், அவ்வளவு நல்லது. இந்த வரிக்கு மேலே எழுது."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceritakan apa yang salah — semakin detail, semakin baik. Ketik di atas garis ini."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبرينا بما حدث — كلما زادت التفاصيل كان أفضل. اكتبي فوق هذا السطر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספרי לנו מה השתבש — כמה שיותר פרטים, יותר טוב. כתבי מעל השורה הזו."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho chúng mình biết điều gì đã xảy ra — càng chi tiết càng tốt. Viết phía trên dòng này."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী ভুল হয়েছে বলো — যত বিস্তারিত, তত ভালো। এই লাইনের ওপরে লিখো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بتاؤ کیا غلط ہوا — جتنی زیادہ تفصیل، اتنا بہتر۔ اس لکیر کے اوپر لکھو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povej nam, kaj je šlo narobe — več podrobnosti, tem bolje. Piši nad to črto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πες μας τι πήγε στραβά — όσο πιο αναλυτικά, τόσο καλύτερα. Γράψε πάνω από αυτή τη γραμμή."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏం తప్పు జరిగిందో చెప్పు — ఎంత వివరంగా ఉంటే అంత మంచిది. ఈ లైన్ పైన రాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴我們發生了什麼問題——越詳細越好。請在這一行上方輸入。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બતાઓ ક્યા ગડ઼બડ઼ હુઈ — જિતના જ઼્યાદા બ્યોરા, ઉતના અચ્છા। ઇસ લાઇન કે ઊપર લિખો।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏಂ ತಪ್ಪು ಜರಿಗಿಂದೋ ಚೆಪ್ಪು — ಎಂತ ವಿವರಂಗಾ ಉಂಟೇ ಅಂತ ಮಂಚಿದಿ. ಈ ಲೈನ್ ಪೈನ ರಾಯಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്താണ് തെറ്റിയതെന്ന് പറയൂ — കൂടുതൽ വിശദാംശങ്ങൾ, കൂടുതൽ നല്ലത്. ഈ വരിക്ക് മുകളിൽ എഴുതൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बताओ क्या गड़बड़ हुई — जितना जास्त ब्योरा, उतना अच्छा। इस लाइन के ऊपर लिखो।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କ'ଣ ଭୁଲ ହେଲା ଆମକୁ କୁହ — ଯେତେ ଅଧିକ ବିବରଣୀ, ସେତେ ଭଲ। ଏହି ରେଖା ଉପରେ ଲେଖ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਤਾਓ ਕ੍ਯਾ ਗਡ਼ਬਡ਼ ਹੁਈ — ਜਿਤਨਾ ਜ਼੍ਯਾਦਾ ਬ੍ਯੋਰਾ, ਉਤਨਾ ਅਚ੍ਛਾ। ਇਸ ਲਾਇਨ ਦੇ ਊਪਰ ਲਿਖੋ।"
          }
        }
      }
    },
