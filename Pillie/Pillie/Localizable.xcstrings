        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你选择的日常生成。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारी चुनी रूटीन से बनाया गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sastavljeno prema rutini koju si odabrala."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiválasztott rutinod alapján készült."
