            "state": "translated",
            "value": "תזכורת עדינה בזמן שבחרת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lời nhắc nhẹ nhàng vào giờ bạn chọn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার বেছে নেওয়া সময়ে একটি মৃদু রিমাইন্ডার।"
