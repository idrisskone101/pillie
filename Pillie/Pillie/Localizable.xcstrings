        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு பதிவும் உங்கள் தொடர்ச்சியிலும் சுழற்சி வரலாற்றிலும் சேரும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap check-in menambah rentetan dan riwayat siklusmu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل تسجيل يضيف إلى سلسلتك وسجل دورتك."
