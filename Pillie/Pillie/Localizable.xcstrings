    "onboarding.today_pill.subtitle": {
      "comment": "Onboarding step 7 subtitle under the pack drawing [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pack, just as it looks in your hand."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شريطك، تمامًا كما يبدو في يدك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্যাক, হাতে ঠিক যেমন দেখায় তেমনই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu envàs, tal com el veus a la mà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje balení, přesně jak ho vidíš v ruce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din pakke, lige som den ser ud i hånden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Packung, genau so, wie sie in deiner Hand aussieht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συσκευασία σου, ακριβώς όπως τη βλέπεις στο χέρι σου."
