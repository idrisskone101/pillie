    "today.protection.setup.detail.pill": {
      "comment": "Unconfigured blocking detail, pill [ENG-70]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily reminders are already on. Finish setup if you want apps to pause until you check in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tägliche Erinnerungen laufen schon. Richte es zu Ende ein, wenn Apps bis zum Check-in pausieren sollen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria giornalieri funzionano già. Finisci il setup se vuoi che le app vadano in pausa fino al check-in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels quotidiens sont déjà actifs. Termine la config si tu veux que les apps soient en pause jusqu'au check-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios diarios ya están activos. Termina la configuración si quieres que las apps se pausen hasta el check-in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes diários já estão ativos. Conclua a configuração se quiser que os apps pausem até o check-in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagelijkse herinneringen staan al aan. Rond de instelling af als je wilt dat apps pauzeren tot je incheckt."
          }
        }
      }
    },
