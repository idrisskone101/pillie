    "onboarding.demo.history_body": {
      "comment": "Tracking statement only [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every check-in updates your streak and cycle timeline so you can review it later."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni registrazione aggiorna la serie e la sequenza del ciclo, così puoi consultarle in seguito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Check-in aktualisiert deine Serie und deinen Zyklusverlauf, damit du später alles nachsehen kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque check-in met à jour ta série et ta frise de cycle pour que tu puisses tout revoir plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada check-in actualiza tu racha y la línea de tiempo del ciclo para que puedas revisarla después."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada check-in atualiza sua sequência e a linha do tempo do ciclo para você revisar depois."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke check-in werkt je reeks en cyclus-tijdlijn bij, zodat je het later kunt nakijken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje incheckning uppdaterar din svit och cykeltidslinje så att du kan se tillbaka senare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver indtjekning opdaterer din stime og cyklustidslinje, så du kan se det senere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver innsjekk oppdaterer rekken og syklustidslinjen din, så du kan se over det senere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kuittaus päivittää putkesi ja kiertosi aikajanan, jotta voit tarkastella niitä myöhemmin."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada registo atualiza a tua sequência e a linha do tempo do ciclo, para poderes rever tudo mais tarde."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada registre actualitza la teva ratxa i la línia de temps del cicle perquè ho puguis repassar més tard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde potwierdzenie aktualizuje twoją serię i oś cyklu, aby dało się do nich później wrócić."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé potvrzení aktualizuje tvoji sérii a časovou osu cyklu, takže se k nim dá později vrátit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая отметка обновляет твою серию и таймлайн цикла, чтобы потом всё можно было посмотреть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна відмітка оновлює твою серію та хронологію циклу, щоб потім усе можна було переглянути."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックインするごとに連続記録と周期のタイムラインが更新され、あとから振り返れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크인할 때마다 연속 기록과 주기 타임라인이 업데이트되어 나중에 다시 볼 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pengesahan mengemas kini rentetan dan garis masa kitaran kamu supaya boleh disemak kemudian."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare confirmare îți actualizează seria și cronologia ciclului, ca să le poți revedea mai târziu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé potvrdenie aktualizuje tvoju sériu a časovú os cyklu, aby si sa k nim mohla neskôr vrátiť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกครั้งที่เช็กอิน สตรีคและไทม์ไลน์รอบของคุณจะอัปเดต เพื่อให้ย้อนดูได้ภายหลัง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次打卡都会更新你的连续记录和周期时间线，方便以后回顾。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर चेक-इन तुम्हारी स्ट्रीक और साइकल टाइमलाइन अपडेट करता है, ताकि तुम बाद में देख सको।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka potvrda ažurira tvoj niz i vremensku crtu ciklusa, pa ih kasnije možeš pregledati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden bejelölés frissíti a sorozatodat és a ciklus időrendjét, hogy később visszanézhesd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kayıt serini ve döngü zaman çizelgeni günceller, böylece sonra gözden geçirebilirsin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு செக்-இன்னும் உன் தொடர்ச்சியையும் சுழற்சி காலவரிசையையும் புதுப்பிக்கும், பிறகு நீ பார்த்துக்கொள்ளலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap check-in memperbarui rentetan dan linimasa siklusmu supaya bisa kamu tinjau nanti."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل تسجيل يحدّث سلسلتك والجدول الزمني لدورتك لتراجعيه لاحقًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל דיווח מעדכן את הרצף ואת ציר המחזור שלך, כדי שתוכלי לעיין בהם אחר כך."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần điểm danh sẽ cập nhật chuỗi ngày và dòng thời gian chu kỳ để bạn xem lại sau."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি চেক-ইন তোমার স্ট্রিক ও সাইকেল টাইমলাইন আপডেট করে, যাতে পরে দেখে নিতে পারো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر چیک اِن تمہارا سلسلہ اور سائیکل ٹائم لائن اپ ڈیٹ کرتا ہے تاکہ تم بعد میں دیکھ سکو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka potrditev posodobi tvoj niz in časovnico cikla, da si ju lahko pozneje ogledaš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε επιβεβαίωση ενημερώνει το σερί και το χρονολόγιο του κύκλου σου, για να τα δεις αργότερα."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి చెక్-ఇన్ నీ స్ట్రీక్‌నూ, సైకిల్ టైమ్‌లైన్‌నూ అప్‌డేట్ చేస్తుంది, తర్వాత నువ్వు చూసుకోవచ్చు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次打卡都會更新你的連續紀錄和週期時間軸，方便之後回顧。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હર ચેક-ઇન તારી સ્ટ્રીક અને સાઇકલ ટાઇમલાઇન અપડેટ કરતા છે, તાકિ તું પછી દેખ સકો।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಚೆಕ್-ಇನ್ ನಿನ್ನ ಸ್ಟ್ರೀಕ್‌ನೂ, ಸೈಕಿಲ್ ಟೈಮ್‌ಲೈನ್‌ನೂ ಅಪ್‌ಡೇಟ್ ಚೇಸ್ತುಂದಿ, ತರ್ವಾತ ನೀನು ಚೂಸುಕೋವಚ್ಚು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ചെക്ക്-ഇനും നിന്റെ സ്ട്രീക്കും സൈക്കിൾ ടൈംലൈനും അപ്‌ഡേറ്റ് ചെയ്യുന്നു, പിന്നീട് അവലോകനം ചെയ്യാൻ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक नोंद तुझी सलग मालिका आणि चक्र अद्ययावत करते, नंतर बघता येईल."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ଚେକ୍-ଇନ୍ ତୁମର ଧାରା ଓ ଚକ୍ର ସମୟରେଖା ଅପଡେଟ୍ କରେ, ଯାହା ତୁମେ ପରେ ଦେଖିପାରିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਚੇਕ-ਇਨ ਤੇਰੀ ਸ੍ਟ੍ਰੀਕ ਤੇ ਸਾਇਕਲ ਟਾਇਮਲਾਇਨ ਅਪਡੇਟ ਕਰਦਾ ਹੈ, ਤਾਕਿ ਤੂੰ ਬਾਅਦ ਵਿੱਚ ਦੇਖ ਸਕੋ।"
          }
        }
      }
    },
