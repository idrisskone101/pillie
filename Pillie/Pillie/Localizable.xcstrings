    "today.pack.start_new.pill.body": {
      "comment": "Method-specific confirmation body [destructive]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This starts a new pack today. Your old history stays."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo inizia oggi una nuova confezione. La cronologia vecchia resta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das startet heute eine neue Packung. Deine alte Historie bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça démarre une nouvelle plaquette aujourd'hui. Ton ancien historique reste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto empieza un blíster nuevo hoy. Tu historial anterior se conserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso inicia uma cartela nova hoje. Seu histórico anterior permanece."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit start vandaag een nieuwe strip. Je oude geschiedenis blijft bewaard."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här startar en ny karta idag. Din gamla historik finns kvar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette starter en ny pakke i dag. Din gamle historik bliver bevaret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette starter et nytt brett i dag. Den gamle historikken din beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä aloittaa uuden liuskan tänään. Vanha historiasi säilyy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto começa hoje uma embalagem nova. O teu histórico anterior mantém-se."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això comença un envàs nou avui. El teu historial anterior es conserva."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe opakowanie zacznie się dziś. Dotychczasowa historia zostaje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes začne nové balení. Stará historie zůstane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня начнётся новая упаковка. Прежняя история сохранится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні почнеться нова упаковка. Попередня історія збережеться."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日から新しいシートを始めます。これまでの履歴は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘부터 새 팩이 시작돼요. 이전 기록은 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memulakan pek baharu hari ini. Sejarah lama kamu kekal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asta începe azi o folie nouă. Istoricul tău vechi rămâne."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes sa začne nové balenie. Tvoja doterajšia história zostáva."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะเริ่มแผงใหม่ตั้งแต่วันนี้ ประวัติเดิมของคุณยังอยู่"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从今天开始新的一板。旧的历史记录会保留。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आज नया पैक शुरू होता है। तुम्हारा पुराना इतिहास बना रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovim danas počinje novo pakiranje. Tvoja stara povijest ostaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel ma új doboz kezdődik. A korábbi előzményeid megmaradnak."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bugün yeni bir paket başlatır. Eski geçmişin kalır."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இன்று ஒரு புதிய பேக்கைத் தொடங்கும். உன் பழைய வரலாறு இருக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memulai strip baru hari ini. Riwayat lamamu tetap tersimpan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ هذا علبة جديدة اليوم. يبقى سجلّك السابق."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה מתחיל חפיסה חדשה היום. ההיסטוריה הקודמת שלך נשמרת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này bắt đầu vỉ mới từ hôm nay. Lịch sử cũ của bạn vẫn còn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে আজ থেকে নতুন প্যাক শুরু হবে। তোমার পুরোনো ইতিহাস থাকবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے آج نیا پیک شروع ہو گا۔ تمہاری پرانی ہسٹری رہے گی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem danes začneš nov zavitek. Tvoja prejšnja zgodovina ostane."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινά νέα συσκευασία σήμερα. Το παλιό ιστορικό σου παραμένει."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ఈరోజు కొత్త ప్యాక్ మొదలుపెడుతుంది. నీ పాత చరిత్ర ఉంటుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從今天開始新的一盒。舊的歷史紀錄會保留。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઇસસે આજ નયા પૈક શુરૂ હોતા છે। તારા પુરાના ઇતિહાસ બના રહતા છે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದಿ ಈರೋಜು ಕೊತ್ತ ಪ್ಯಾಕ್ ಮೊದಲುಪೆಡುತುಂದಿ. ನಿನ್ನ ಪಾತ ಚರಿತ್ರ ಉಂಟುಂದಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്ന് ഒരു പുതിയ പാക്ക് തുടങ്ങും. പഴയ ചരിത്രം അതേപടി തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आज नया पैक शुरू होता आहे. तुझा पुराना इतिहास बना रहता आहे."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା ଆଜି ଏକ ନୂଆ ପ୍ୟାକ୍ ଆରମ୍ଭ କରେ। ତୁମର ପୁରୁଣା ଇତିହାସ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸਸੇ ਅੱਜ ਨਯਾ ਪੈਕ ਸ਼ੁਰੂ ਹੁਂਦਾ ਹੈ। ਤੇਰਾ ਪੁਰਾਨਾ ਇਤਿਹਾਸ ਬਨਾ ਰਹਤਾ ਹੈ।"
          }
        }
      }
    },
    "today.pack.start_new.cycle.body": {
      "comment": "Method-specific confirmation body [destructive]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This starts a new cycle today. Your old history stays."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo inizia oggi un nuovo ciclo. La cronologia vecchia resta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das startet heute einen neuen Zyklus. Deine alte Historie bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça démarre un nouveau cycle aujourd'hui. Ton ancien historique reste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto empieza un ciclo nuevo hoy. Tu historial anterior se conserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso inicia um ciclo novo hoje. Seu histórico anterior permanece."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit start vandaag een nieuwe cyclus. Je oude geschiedenis blijft bewaard."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här startar en ny cykel idag. Din gamla historik finns kvar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette starter en ny cyklus i dag. Din gamle historik bliver bevaret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette starter en ny syklus i dag. Den gamle historikken din beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä aloittaa uuden kierron tänään. Vanha historiasi säilyy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto começa hoje um ciclo novo. O teu histórico anterior mantém-se."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això comença un cicle nou avui. El teu historial anterior es conserva."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowy cykl zacznie się dziś. Dotychczasowa historia zostaje."
