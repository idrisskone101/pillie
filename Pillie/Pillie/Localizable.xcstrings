    "onboarding.blocking_setup.subtitle": {
      "comment": "Method-neutral [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected apps pause after a Pillie reminder. They come back after you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app scelte vanno in pausa al promemoria. Tornano dopo il check-in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Apps pausieren nach einer Erinnerung. Nach dem Check-in sind sie wieder da."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps sélectionnées sont mises en pause après un rappel Pillie. Elles reviennent après ton check-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps seleccionadas se pausan tras un recordatorio de Pillie. Vuelven después del check-in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps selecionados pausam após um lembrete do Pillie. Eles voltam depois do check-in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geselecteerde apps pauzeren na een Pillie-herinnering. Ze komen terug na je check-in."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valda appar pausas efter en påminnelse från Pillie. De kommer tillbaka när du har checkat in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgte apps sættes på pause efter en påmindelse fra Pillie. De kommer tilbage, når du har tjekket ind."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgte apper pauses etter en Pillie-påminnelse. De kommer tilbake etter at du har sjekket inn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitut sovellukset menevät tauolle Pillie-muistutuksen jälkeen. Ne palaavat, kun olet kuitannut."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As apps selecionadas ficam em pausa depois de um lembrete Pillie. Voltam depois de registares."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps seleccionades es pausen després d’un recordatori de Pillie. Tornen quan registres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane aplikacje wstrzymują się po przypomnieniu Pillie. Wracają po potwierdzeniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrané aplikace se po připomínce Pillie pozastaví. Po potvrzení se vrátí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные приложения ставятся на паузу после напоминания Pillie. После отметки они снова доступны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрані застосунки стають на паузу після нагадування Pillie. Після відмітки вони знову доступні."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieのリマインダーの後、選んだアプリが一時停止します。チェックインすると元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 알림이 온 뒤 선택한 앱이 일시 중지돼요. 체크인하면 다시 돌아와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl terpilih dijeda selepas peringatan Pillie. Apl itu kembali selepas kamu sahkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile selectate intră în pauză după un memento Pillie. Revin după ce confirmi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrané aplikácie sa po pripomienke Pillie pozastavia. Po potvrdení sú zase späť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปที่เลือกจะพักหลังการแจ้งเตือนจาก Pillie และกลับมาหลังคุณเช็กอิน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 提醒后，所选应用会暂停。完成打卡后它们就会恢复。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie रिमाइंडर के बाद चुने हुए ऐप्स रुक जाते हैं। चेक-इन के बाद वे वापस आ जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrane aplikacije se pauziraju nakon Pillie podsjetnika. Vraćaju se nakon što potvrdiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kijelölt appok egy Pillie-emlékeztető után szünetelnek. A bejelölés után visszatérnek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili uygulamalar bir Pillie hatırlatmasından sonra duraklar. Kaydını yaptıktan sonra geri gelirler."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie நினைவூட்டலுக்குப் பிறகு தேர்ந்தெடுத்த ஆப்ஸ் இடைநிறுத்தப்படும். செக்-இன் செய்தபின் அவை திரும்பும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi terpilih dijeda setelah pengingat Pillie. Aplikasi kembali setelah kamu check-in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف التطبيقات المحددة مؤقتًا بعد تذكير Pillie. وتعود بعد التسجيل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציות שנבחרו מושהות אחרי תזכורת של Pillie. הן חוזרות אחרי הדיווח."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng đã chọn sẽ tạm dừng sau lời nhắc của Pillie. Chúng sẽ trở lại sau khi bạn điểm danh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie রিমাইন্ডারের পরে বেছে নেওয়া অ্যাপগুলো পজ হয়। চেক-ইন করলে সেগুলো ফিরে আসে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie کی یاد دہانی کے بعد چُنی ہوئی ایپس رک جاتی ہیں۔ چیک اِن کے بعد وہ واپس آ جاتی ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrane aplikacije se po opomniku Pillie ustavijo. Po potrditvi so spet na voljo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επιλεγμένες εφαρμογές μπαίνουν σε παύση μετά από μια υπενθύμιση Pillie. Επανέρχονται μόλις επιβεβαιώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie రిమైండర్ తర్వాత ఎంచుకున్న యాప్‌లు పాజ్ అవుతాయి. నువ్వు చెక్-ఇన్ చేశాక అవి తిరిగి వస్తాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 提醒後，所選的應用程式會暫停。完成打卡後它們就會恢復。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie રિમાઇંડર કે પછી ચુને હુએ ઍપ્સ રુક જાતે છે। ચેક-ઇન કે પછી વે વાપસ આ જાતે છે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ಜ್ಞಾಪನೆ ತರ್ವಾತ ಆರಿಸಿದ ಆ್ಯಾಪ್‌ಗಳು ಪಾಜ್ ಅವುತಾಯಿ. ನೀನು ಚೆಕ್-ಇನ್ ಚೇಶಾಕ ಅವಿ ತಿರಿಗಿ ಸಿಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie റിമൈൻഡറിന് ശേഷം തിരഞ്ഞെടുത്ത ആപ്പുകൾ പോസ് ആകും. ചെക്ക്-ഇൻ കഴിഞ്ഞാൽ അവ തിരികെ വരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie आठवणीनंतर निवडलेले अॅप्स थांबतात. नोंदीनंतर परत येतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ରିମାଇଣ୍ଡର୍ ପରେ ବଛା ଆପ୍ ବିରାମ ହୁଏ। ଚେକ୍-ଇନ୍ ପରେ ସେଗୁଡ଼ିକ ଫେରିଆସେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ਰਿਮਾਇਂਡਰ ਦੇ ਬਾਅਦ ਚੁਨੇ ਹੁਏ ਐਪਾਂ ਰੁਕ ਜਾਂਦੀਆਂ ਹਨ। ਚੇਕ-ਇਨ ਦੇ ਬਾਅਦ ਵੇ ਵਾਪਸ ਆ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        }
      }
    },
