    "settings.schedule.method_picker.subtitle": {
      "comment": "Schedule sheet method picker copy [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one, then tell Pillie where you are in it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختاري وسيلة، ثم أخبري Pillie أين وصلتِ فيها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি বেছে নিন, তারপর Pillie-কে জানান আপনি এর কোন পর্যায়ে আছেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria’n un i després digues a Pillie en quin punt ets."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber jednu a pak řekni Pillie, kde v ní jsi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg én, og fortæl så Pillie, hvor du er i den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine aus und sag Pillie, wo du gerade stehst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε μία και πες στο Pillie σε ποιο σημείο βρίσκεσαι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige uno y dile a Pillie en qué punto estás."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse yksi ja kerro sitten Pillielle, missä kohtaa olet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis-en une, puis dis à Pillie où tu en es."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક પસંદ કરો, પછી Pillieને જણાવો કે તમે એમાં ક્યાં છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרי אחת וספרי ל-Pillie איפה את נמצאת בה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक चुनें, फिर Pillie को बताएं कि आप उसमें कहां हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi jednu, pa javi Pillie gdje si u njoj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz egyet, aztán mondd el a Pillie-nek, hol tartasz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih satu, lalu beri tahu Pillie kamu sedang di tahap mana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegline uno, poi di’ a Pillie a che punto sei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つ選んで、今どの段階かをPillieに教えてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದನ್ನು ಆರಿಸಿ, ನಂತರ ನೀವು ಅದರಲ್ಲಿ ಎಲ್ಲಿದ್ದೀರಿ ಎಂದು Pillie ಗೆ ತಿಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나를 고른 뒤, 지금 어디쯤인지 Pillie에 알려 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്ന് തിരഞ്ഞെടുക്കൂ, എന്നിട്ട് അതിൽ നിങ്ങൾ എവിടെയാണെന്ന് Pillie-യോട് പറയൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक निवडा, मग तुम्ही त्यात कुठे आहात ते Pillie ला सांगा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih satu, kemudian beritahu Pillie di peringkat mana kamu sekarang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg én, og fortell Pillie hvor du er i den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies er een en vertel Pillie waar je nu zit."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗୋଟିଏ ବାଛନ୍ତୁ, ତା’ପରେ ଆପଣ ସେଥିରେ କେଉଁଠି ଅଛନ୍ତି ବୋଲି Pillieକୁ ଜଣାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਚੁਣੋ, ਫਿਰ Pillie ਨੂੰ ਦੱਸੋ ਕਿ ਤੁਸੀਂ ਇਸ ਵਿੱਚ ਕਿੱਥੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz jedną i powiedz Pillie, na jakim jesteś etapie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um e diga ao Pillie em que ponto você está."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um e diz ao Pillie em que ponto estás."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege una, apoi spune-i lui Pillie unde ai ajuns."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери один и расскажи Pillie, на каком ты этапе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber jednu a potom povedz Pillie, kde v nej si."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi eno in povej Pillie, kje si."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en och berätta för Pillie var du är i den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒன்றைத் தேர்ந்தெடுங்கள், பிறகு அதில் நீங்கள் எங்கே இருக்கிறீர்கள் என்று Pillie-க்குச் சொல்லுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకటి ఎంచుకోండి, తర్వాత అందులో మీరు ఎక్కడ ఉన్నారో Pillieకి చెప్పండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกหนึ่งอย่าง แล้วบอก Pillie ว่าคุณอยู่ช่วงไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birini seç, sonra Pillie’ye nerede olduğunu söyle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обери один і скажи Pillie, на якому ти етапі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک چنیں، پھر Pillie کو بتائیں کہ آپ اس میں کہاں ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một, rồi cho Pillie biết bạn đang ở giai đoạn nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一种，再告诉 Pillie 你进行到哪一步了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選一種，再告訴 Pillie 你進行到哪一步了。"
          }
        }
      }
    },
