        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ఈరోజు కొత్త సైకిల్ మొదలుపెడుతుంది. నీ పాత చరిత్ర ఉంటుంది."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從今天開始新的週期。舊的歷史紀錄會保留。"
