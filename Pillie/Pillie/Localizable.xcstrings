    "onboarding.plan.disclaimer": {
      "comment": "Not a medical recommendation [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plan comes from your answers. You can change it anytime in Settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo piano nasce dalle tue risposte. Puoi cambiarlo quando vuoi nelle Impostazioni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Plan beruht auf deinen Antworten. Du kannst ihn jederzeit in den Einstellungen ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce plan vient de tes réponses. Tu peux le modifier à tout moment dans Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plan sale de tus respuestas. Puedes cambiarlo cuando quieras en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plano vem das suas respostas. Você pode mudar quando quiser em Ajustes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit plan is gebaseerd op je antwoorden. Je kunt het altijd wijzigen in Instellingen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planen bygger på dina svar. Du kan ändra den när du vill i Inställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne plan bygger på dine svar. Du kan altid ændre den i Indstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne planen er laget ut fra svarene dine. Du kan endre den når som helst i Innstillinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä suunnitelma perustuu vastauksiisi. Voit muuttaa sitä milloin tahansa Asetuksista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plano vem das tuas respostas. Podes alterá-lo quando quiseres nas Definições."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest pla surt de les teves respostes. El pots canviar quan vulguis a Configuració."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plan powstał z twoich odpowiedzi. Możesz go zmienić w każdej chwili w Ustawieniach."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento plán vychází z tvých odpovědí. Kdykoliv ho můžeš změnit v Nastavení."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот план составлен по твоим ответам. Изменить его можно в любой момент в настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей план складено за твоїми відповідями. Змінити його можна будь-коли в параметрах."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプランはあなたの回答から作られています。設定からいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 플랜은 답변을 바탕으로 만들어졌어요. 설정에서 언제든 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelan ini datang daripada jawapan kamu. Kamu boleh ubah bila-bila masa dalam Seting."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planul acesta vine din răspunsurile tale. Îl poți schimba oricând din Configurări."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento plán vychádza z tvojich odpovedí. Kedykoľvek ho môžeš zmeniť v Nastaveniach."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผนนี้มาจากคำตอบของคุณ เปลี่ยนได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个计划根据你的回答生成。你随时可以在“设置”中更改。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह प्लान आपके जवाबों से बना है। इसे कभी भी सेटिंग्ज़ में बदला जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj plan nastao je iz tvojih odgovora. Možeš ga promijeniti bilo kad u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a terv a válaszaidból készült. Bármikor módosíthatod a Beállításokban."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu plan cevaplarına göre hazırlandı. İstediğin zaman Ayarlar’dan değiştirebilirsin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தத் திட்டம் உங்கள் பதில்களிலிருந்து உருவானது. அமைப்புகளில் எப்போது வேண்டுமானாலும் இதை மாற்றலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rencana ini berasal dari jawabanmu. Kamu bisa mengubahnya kapan saja di Pengaturan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الخطة مبنية على إجاباتك. يمكنك تغييرها في أي وقت من الإعدادات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוכנית הזו מבוססת על התשובות שלך. אפשר לשנות אותה בכל עת בהגדרות."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kế hoạch này dựa trên câu trả lời của bạn. Bạn có thể đổi bất cứ lúc nào trong Cài đặt."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্ল্যানটি আপনার উত্তর থেকে তৈরি। সেটিংসে গিয়ে যেকোনো সময় বদলাতে পারেন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ پلان آپ کے جوابات سے بنا ہے۔ اسے کبھی بھی سیٹنگز میں بدلا جا سکتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta načrt temelji na tvojih odgovorih. Kadar koli ga lahko spremeniš v Nastavitvah."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το πλάνο προκύπτει από τις απαντήσεις σου. Μπορείς να το αλλάξεις όποτε θέλεις στις Ρυθμίσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ప్లాన్ మీ సమాధానాల నుంచి వచ్చింది. సెట్టింగ్‌లలో ఎప్పుడైనా మార్చవచ్చు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個計畫依你的回答產生。你隨時可以在「設定」中更改。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ પ્લાન તમારા જવાબોના આધારે બન્યો છે. તમે તેને સેટિંગ્સમાં ગમે ત્યારે બદલી શકો છો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಯೋಜನೆ ನಿಮ್ಮ ಉತ್ತರಗಳಿಂದ ಬಂದಿದೆ. ಸೆಟ್ಟಿಂಗ್ಸ್‌ನಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ ಇದನ್ನು ಬದಲಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പ്ലാൻ നിങ്ങളുടെ ഉത്തരങ്ങളിൽ നിന്നാണ്. ക്രമീകരണങ്ങളിൽ എപ്പോൾ വേണമെങ്കിലും ഇത് മാറ്റാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा प्लॅन तुमच्या उत्तरांवरून बनला आहे. तो कधीही सेटिंग्जमध्ये बदलता येतो."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ପ୍ଲାନ୍ ଆପଣଙ୍କ ଉତ୍ତରରୁ ତିଆରି। ଆପଣ ସେଟିଂସ୍‌ରେ ଯେକୌଣସି ସମୟରେ ଏହା ବଦଳାଇପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਪਲਾਨ ਤੁਹਾਡੇ ਜਵਾਬਾਂ ਤੋਂ ਬਣਿਆ ਹੈ। ਤੁਸੀਂ ਇਸਨੂੰ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਕਦੇ ਵੀ ਬਦਲ ਸਕਦੇ ਹੋ।"
          }
        }
      }
    },
