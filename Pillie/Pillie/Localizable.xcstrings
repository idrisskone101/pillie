          "stringUnit": {
            "state": "translated",
            "value": "Kapj emlékeztetőt. Rögzítsd a teendőt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatma al. İşlemini kaydet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நினைவூட்டலைப் பெறு. உன் செயலைப் பதிவு செய்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan pengingat. Catat tindakanmu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقّي تذكيرًا. سجّلي إجراءك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבלי תזכורת. רשמי את הפעולה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận lời nhắc. Ghi lại việc của bạn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডার পাও। কাজটি লগ করো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی پاؤ۔ اپنا کام لاگ کرو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prejmi opomnik. Zabeleži dejanje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάρε υπενθύμιση. Κατάγραψέ το."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిమైండర్ అందుకో. నీ చర్యను నమోదు చేయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收到提醒。記錄動作。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇંડર પાઓ। તારો કામ લૉગ કર।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜ್ಞಾಪನೆ ಅಂದುಕೋ. ನಿನ್ನ ಕೆಲಸನು ನೋಂದಣಿ ಚೇಯಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിമൈൻഡർ നേടൂ. ആക്ഷൻ രേഖപ്പെടുത്തൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आठवण येईल. कृती नोंद."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ପାଅ। ତୁମର କାମ ଲଗ୍ କର।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਇਂਡਰ ਪਾਓ। ਅਪਨਾ ਕਾਮ ਲਾਗ ਕਰ।"
          }
        }
      }
    },
