          "stringUnit": {
            "state": "translated",
            "value": "Dagen zijn nu tikbaar. Tik op een dag om die bij te werken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tage sind jetzt tippbar. Tippe einen Tag an, um ihn zu aktualisieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni sono toccabili. Tocca un giorno per aggiornarlo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu kan du trycka på dagar. Tryck på en dag för att uppdatera den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan nu trykke på dage. Tryk på en dag for at opdatere den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nå kan du trykke på dagene. Trykk på en dag for å oppdatere den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päiviä voi nyt napauttaa. Napauta päivää päivittääksesi sen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora podes tocar nos dias. Toca num dia para o atualizar."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara pots tocar els dies. Toca un dia per actualitzar-lo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dni można już stukać. Stuknij dzień, aby go zaktualizować."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dny už jde klepat. Klepnutím na den ho upravíš."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь дни можно нажимать. Коснись дня, чтобы изменить его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер дні можна натискати. Торкнись дня, щоб змінити його."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付をタップできるようになりました。タップして更新できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 날짜를 탭할 수 있어요. 날짜를 탭해서 업데이트하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari kini boleh diketik. Ketik hari untuk mengemas kininya."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum poți atinge zilele. Atinge o zi pentru a o actualiza."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dni sa už dá ťuknuť. Ťukni na deň a uprav ho."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้แตะที่วันได้แล้ว แตะวันเพื่ออัปเดต"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在可以点按日期了。点按某一天即可更新。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब दिनों पर टैप कर सकते हो। अपडेट करने के लिए किसी दिन पर टैप करो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane sada možeš dodirnuti. Dodirni dan da ga ažuriraš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A napokra már koppinthatsz. Koppints egy napra a módosításhoz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlere artık dokunabilirsin. Güncellemek için bir güne dokun."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது நாட்களைத் தட்டலாம். ஒரு நாளைப் புதுப்பிக்க அதைத் தட்டு."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang hari bisa diketuk. Ketuk hari untuk memperbaruinya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن النقر على الأيام الآن. انقري على يوم لتحديثه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עכשיו אפשר להקיש על ימים. הקישי על יום כדי לעדכן אותו."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ có thể chạm vào các ngày. Chạm vào một ngày để cập nhật."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন দিনগুলোতে ট্যাপ করা যায়। আপডেট করতে একটি দিনে ট্যাপ করো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اب دنوں پر ٹیپ ہو سکتا ہے۔ اپ ڈیٹ کرنے کے لیے کسی دن پر ٹیپ کرو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dneve lahko zdaj tapneš. Tapni dan, da ga posodobiš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ημέρες είναι πλέον πατήσιμες. Πάτα μια ημέρα για να την ενημερώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇప్పుడు రోజులను నొక్కవచ్చు. అప్‌డేట్ చేయడానికి ఒక రోజును నొక్కు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在可以點選日期了。點一下某一天即可更新。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અબ દિનોં પર ટૈપ કર શકો છો। અપડેટ કરને માટે કિસી દિન પર ટૈપ કર।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈಗ ರೋಜುಲನು ನೊಕ್ಕವಚ್ಚು. ಅಪ್‌ಡೇಟ್ ಚೇಯಡಾನಿಕಿ ಒಕ ರೋಜುನು ನೊಕ್ಕು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ ദിവസങ്ങളിൽ ടാപ്പ് ചെയ്യാം. അപ്‌ഡേറ്റ് ചെയ്യാൻ ഒരു ദിവസത്തിൽ ടാപ്പ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अब दिनों पर टैप कर शकतोस। अपडेट करने के साठी किसी दिन पर टैप कर।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦିନଗୁଡ଼ିକ ଏବେ ଟିପ୍ କରିହେବ। ଅପଡେଟ୍ କରିବାକୁ ଏକ ଦିନ ଟିପ୍ କର।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੁਣ ਦਿਨੋਂ ਪਰ ਟੈਪ ਕਰ ਸਕਦੀ ਹੈਂ। ਅਪਡੇਟ ਕਰਨੇ ਲਈ ਕਿਸੇ ਦਿਨ ਪਰ ਟੈਪ ਕਰ।"
          }
        }
      }
    },
