        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাপগুলো সঙ্গে সঙ্গে আবার খোলা যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ایپس فوراً دوبارہ کھل جاتی ہیں۔"
