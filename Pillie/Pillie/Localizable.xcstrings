          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelttrykk for å oppdatere denne dagen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksoisnapauta päivittääksesi tämän päivän."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca duas vezes para atualizar este dia."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes doble toc per actualitzar aquest dia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dwukrotnie, aby zaktualizować ten dzień."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poklepáním upravíš tento den."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды коснись, чтобы изменить этот день."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двічі торкнись, щоб змінити цей день."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップでこの日を更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 탭해서 이 날을 업데이트하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik dua kali untuk mengemas kini hari ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge de două ori pentru a actualiza această zi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvakrát ťukni na úpravu tohto dňa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะสองครั้งเพื่ออัปเดตวันนี้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按两次以更新这一天。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दिन को अपडेट करने के लिए दो बार टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvaput dodirni za ažuriranje ovog dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints duplán a nap módosításához."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu günü güncellemek için iki kez dokun."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நாளைப் புதுப்பிக்க இருமுறை தட்டுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dua kali untuk memperbarui hari ini."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقري مرتين لتحديث هذا اليوم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישי פעמיים לעדכון היום הזה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm hai lần để cập nhật ngày này."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই দিনটি আপডেট করতে দুবার ট্যাপ করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس دن کو اپ ڈیٹ کرنے کے لیے دو بار ٹیپ کریں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvakrat tapni za posodobitev tega dneva."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτα δύο φορές για να ενημερώσεις αυτή την ημέρα."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ రోజును అప్‌డేట్ చేయడానికి రెండుసార్లు నొక్కండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點兩下即可更新這一天。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ દિવસ અપડેટ કરવા બે વાર ટૅપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ದಿನವನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಡಬಲ್ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ദിവസം അപ്‌ഡേറ്റ് ചെയ്യാൻ ഇരട്ട ടാപ്പ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा दिवस अपडेट करण्यासाठी दोनदा टॅप करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଦିନଟି ଅପଡେଟ୍ କରିବାକୁ ଦୁଇଥର ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਦਿਨ ਨੂੰ ਅੱਪਡੇਟ ਕਰਨ ਲਈ ਦੋ ਵਾਰ ਟੈਪ ਕਰੋ।"
          }
        }
      }
    },
