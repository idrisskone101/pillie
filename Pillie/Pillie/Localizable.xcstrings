            "value": "Dette starter en ny syklus i dag. Den gamle historikken din beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä aloittaa uuden kierron tänään. Vanha historiasi säilyy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto começa hoje um ciclo novo. O teu histórico anterior mantém-se."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això comença un cicle nou avui. El teu historial anterior es conserva."
          }
        },
        "pl": {
