    "onboarding.mechanism.headline": {
      "comment": "Mechanism-proof headline [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your apps become available again as soon as you log today’s action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue app tornano disponibili non appena registri l’azione di oggi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apps werden wieder verfügbar, sobald du die heutige Aktion protokollierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes apps redeviennent disponibles dès que tu inscris l'action du jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus apps vuelven a estar disponibles en cuanto registres la acción de hoy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus apps ficam disponíveis de novo assim que você registra a ação de hoje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je apps zijn weer beschikbaar zodra je de actie van vandaag bijhoudt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina appar blir tillgängliga igen så snart du loggar dagens åtgärd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine apps bliver tilgængelige igen, så snart du logger dagens handling."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appene dine blir tilgjengelige igjen så snart du logger dagens handling."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksesi ovat taas käytettävissä heti, kun kirjaat päivän toimenpiteen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas apps voltam a ficar disponíveis assim que registas a ação de hoje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves apps tornen a estar disponibles tan bon punt registres l’acció d’avui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje aplikacje znów będą dostępne, gdy tylko zapiszesz dzisiejszą czynność."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikace budou zase dostupné, jakmile zaznamenáš dnešní akci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения снова становятся доступны, как только ты отметишь сегодняшнее действие."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунки знову стають доступними, щойно ти відмітиш сьогоднішню дію."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のアクションを記録すると、すぐにアプリがまた使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 행동을 기록하는 순간 앱을 다시 사용할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl kamu boleh digunakan semula sebaik sahaja kamu merekod tindakan hari ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile tale devin din nou disponibile imediat ce înregistrezi acțiunea de azi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikácie budú zase dostupné, hneď ako zaznamenáš dnešnú akciu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปของคุณจะกลับมาใช้ได้ทันทีที่คุณบันทึกกิจกรรมของวันนี้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要记录今天的操作，你的应用就会立刻恢复可用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे ही तुम आज का काम लॉग करते हो, तुम्हारे ऐप्स फिर से उपलब्ध हो जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikacije ponovno su dostupne čim zabilježiš današnju radnju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appjaid újra elérhetők lesznek, amint rögzíted a mai teendőt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü işlemi kaydettiğin anda uygulamaların yeniden kullanılabilir olur."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்றைய செயலைப் பதிவு செய்த உடனே உன் ஆப்ஸ் மீண்டும் கிடைக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasimu bisa dipakai lagi begitu kamu mencatat tindakan hari ini."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعود تطبيقاتك متاحة بمجرد تسجيل إجراء اليوم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציות שלך יהיו זמינות שוב ברגע שתרשמי את הפעולה של היום."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng của bạn sẽ dùng lại được ngay khi bạn ghi lại việc hôm nay."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের কাজটি লগ করলেই তোমার অ্যাপগুলো আবার ব্যবহার করা যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جیسے ہی تم آج کا کام لاگ کرو، تمہاری ایپس دوبارہ کھل جاتی ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje aplikacije so spet na voljo, takoj ko zabeležiš današnje dejanje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές σου γίνονται ξανά διαθέσιμες μόλις καταγράψεις τη σημερινή ενέργεια."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు చర్యను నమోదు చేసిన వెంటనే నీ యాప్‌లు మళ్లీ అందుబాటులోకి వస్తాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要記錄今天的動作，你的應用程式就會立刻恢復可用。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આજનું કામ નોંધતાં જ તારા ઍપ્સ ફરી મળે છે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಂದಿನ ಕೆಲಸ ನೋಂದಿಸಿದ ಕೂಡಲೇ ನಿನ್ನ ಆ್ಯಾಪ್‌ಗಳು ಮತ್ತೆ ಸಿಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്നത്തെ ആക്ഷൻ രേഖപ്പെടുത്തിയാലുടൻ നിന്റെ ആപ്പുകൾ വീണ്ടും ലഭ്യമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आजची कृती नोंदली की तुझे अॅप्स परत मिळतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମେ ଆଜିର କାମ ଲଗ୍ କଲା ମାତ୍ରେ ତୁମର ଆପ୍‌ଗୁଡ଼ିକ ପୁଣି ଉପଲବ୍ଧ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੈਸੇ ਹੀ ਤੂੰ ਅੱਜ ਦਾ ਕਾਮ ਲਾਗ ਕਰਦੀ ਹੈਂ, ਤੇਰੇ ਐਪਾਂ ਫਿਰ ਉਪਲਬਧ ਹੋ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        }
      }
    },
