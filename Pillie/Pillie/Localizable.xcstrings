        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪ್ಯಾಕ್‌ನಲ್ಲಿರುವ ಮಾತ್ರೆಗಳ ಸಾಲುಗಳೊಂದಿಗೆ ಹೋಲಿಸಿ ನೋಡಿ."
