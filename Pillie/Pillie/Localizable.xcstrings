            "value": "SO FUNKTIONIERT’S"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "COMMENT ÇA MARCHE"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CÓMO FUNCIONA"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "COMO FUNCIONA"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HOE HET WERKT"
          }
        }
      }
    },
    "onboarding.mechanism.headline": {
      "comment": "Mechanism-proof headline [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your apps become available again as soon as you log today’s action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue app tornano disponibili non appena registri l’azione di oggi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apps werden wieder verfügbar, sobald du die heutige Aktion protokollierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes apps redeviennent disponibles dès que tu inscris l'action du jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus apps vuelven a estar disponibles en cuanto registres la acción de hoy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus apps ficam disponíveis de novo assim que você registra a ação de hoje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je apps zijn weer beschikbaar zodra je de actie van vandaag bijhoudt."
          }
        }
      }
    },
