    "today.protection.active": {
      "comment": "Functionality only [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected apps are paused until you log today’s action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app selezionate sono in pausa finché non registri l’azione di oggi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Apps bleiben pausiert, bis du die heutige Aktion protokollierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps sélectionnées restent en pause jusqu'à ce que tu inscrives l'action du jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps seleccionadas están en pausa hasta que registres la acción de hoy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps selecionados ficam pausados até você registrar a ação de hoje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geselecteerde apps blijven gepauzeerd tot je de actie van vandaag bijhoudt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valda appar är pausade tills du loggar dagens åtgärd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgte apps er på pause, indtil du logger dagens handling."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgte apper er pauset til du logger dagens handling."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitut sovellukset ovat tauolla, kunnes kirjaat päivän toimenpiteen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As apps selecionadas ficam em pausa até registares a ação de hoje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps seleccionades es queden en pausa fins que registres l’acció d’avui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane aplikacje są wstrzymane, aż zapiszesz dzisiejszą czynność."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrané aplikace jsou pozastavené, dokud nezaznamenáš dnešní akci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные приложения на паузе, пока ты не отметишь сегодняшнее действие."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрані застосунки на паузі, доки ти не відмітиш сьогоднішню дію."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のアクションを記録するまで、選んだアプリは一時停止中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 행동을 기록할 때까지 선택한 앱이 일시 중지돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl terpilih dijeda sehingga kamu merekod tindakan hari ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile selectate stau pe pauză până înregistrezi acțiunea de azi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrané aplikácie sú pozastavené, kým nezaznamenáš dnešnú akciu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปที่เลือกจะพักไว้จนกว่าคุณจะบันทึกกิจกรรมของวันนี้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选应用会一直暂停，直到你记录今天的操作。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने हुए ऐप्स तब तक रुके रहते हैं जब तक तुम आज का काम लॉग नहीं करते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrane aplikacije pauzirane su dok ne zabilježiš današnju radnju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kijelölt appok szünetelnek, amíg nem rögzíted a mai teendőt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili uygulamalar bugünkü işlemi kaydedene kadar duraklatıldı."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்றைய செயலைப் பதிவு செய்யும் வரை தேர்ந்தெடுத்த ஆப்ஸ் இடைநிறுத்தத்தில் இருக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi terpilih dijeda sampai kamu mencatat tindakan hari ini."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيقات المحددة متوقفة مؤقتًا حتى تسجّلي إجراء اليوم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציות שנבחרו מושהות עד שתרשמי את הפעולה של היום."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng đã chọn sẽ tạm dừng cho đến khi bạn ghi lại việc hôm nay."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের কাজ লগ না করা পর্যন্ত বেছে নেওয়া অ্যাপগুলো পজ থাকবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چُنی ہوئی ایپس اس وقت تک رکی رہتی ہیں جب تک تم آج کا کام لاگ نہ کرو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrane aplikacije so na premoru, dokler ne zabeležiš današnjega dejanja."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι επιλεγμένες εφαρμογές είναι σε παύση μέχρι να καταγράψεις τη σημερινή ενέργεια."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు చర్యను నమోదు చేసేదాకా ఎంచుకున్న యాప్‌లు పాజ్‌లో ఉంటాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選的應用程式會一直暫停，直到你記錄今天的動作。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પસંદ ઍપ્સ તું આજનું કામ નોંધે ત્યાં સુધી થોભેલા રહે છે।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈರೋಜು ಕೆಲಸನು ನೋಂದಣಿ ಚೇಸೇದಾಕಾ ಆರಿಸಿದ ಆ್ಯಾಪ್‌ಗಳು ಪಾಜ್‌ಲೋ ಉಂಟಾಯಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്നത്തെ ആക്ഷൻ രേഖപ്പെടുത്തുന്നതുവരെ തിരഞ്ഞെടുത്ത ആപ്പുകൾ പോസ് ചെയ്‌തിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने हुए अॅप्स तब पर्यंत थांबले रहते आहेत जेव्हा पर्यंत तू आज का काम नोंद नाही करते।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମେ ଆଜିର କାମ ଲଗ୍ କରିବା ପର୍ୟ୍ୟନ୍ତ ବଛା ଆପ୍ ବିରାମରେ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਨੇ ਹੁਏ ਐਪਾਂ ਤਬ ਤੱਕ ਰੁਦੇ ਰਹਤੇ ਹੈਂ ਜਦ ਤੱਕ ਤੂੰ ਅੱਜ ਦਾ ਕਾਮ ਲਾਗ ਨਹੀਂ ਕਰਤੇ।"
          }
        }
      }
    },
