            "state": "translated",
            "value": "Permita acesso ao Tempo de Uso para selecionar e pausar apps."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta Schermtijd-toegang toe om apps te selecteren en te pauzeren."
