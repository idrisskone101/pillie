    "custom_pack.preview.grid_weeks": {
      "comment": "Custom pack preview caption; arg 1 total days, arg 2 weeks (always 2 or more) [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld-day pack · starts again every %2$lld weeks"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيام العلبة: %1$lld · تبدأ من جديد كل %2$lld أسابيع"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld দিনের প্যাক · প্রতি %2$lld সপ্তাহে আবার শুরু হয়"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envàs de %1$lld dies · torna a començar cada %2$lld setmanes"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld-denní balení · začíná znovu každý %2$lld. týden"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakke med %1$lld dage · starter forfra hver %2$lld. uge"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld-Tage-Packung · beginnt alle %2$lld Wochen neu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συσκευασία %1$lld ημερών · ξεκινά ξανά κάθε %2$lld εβδομάδες"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blíster de %1$lld días · empieza de nuevo cada %2$lld semanas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld päivän liuska · alkaa alusta %2$lld viikon välein"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaquette de %1$lld jours · recommence toutes les %2$lld semaines"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld દિવસનું પેક · દર %2$lld અઠવાડિયે ફરી શરૂ થાય છે"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חפיסה של %1$lld ימים · מתחילה מחדש כל %2$lld שבועות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld दिन का पैक · हर %2$lld हफ़्ते में फिर शुरू होता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld-dnevno pakiranje · počinje ispočetka svaki %2$lld. tjedan"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld napos levél · %2$lld hetente újraindul"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemasan %1$lld hari · mulai lagi setiap %2$lld minggu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confezione da %1$lld giorni · ricomincia ogni %2$lld settimane"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld日シート · %2$lld週ごとに最初から"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ದಿನಗಳ ಪ್ಯಾಕ್ · ಪ್ರತಿ %2$lld ವಾರಗಳಿಗೊಮ್ಮೆ ಮತ್ತೆ ಶುರುವಾಗುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld일 팩 · %2$lld주마다 다시 시작"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ദിവസത്തെ പാക്ക് · ഓരോ %2$lld ആഴ്ച കൂടുമ്പോഴും വീണ്ടും തുടങ്ങും"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld दिवसांचे पॅक · दर %2$lld आठवड्यांनी पुन्हा सुरू होते"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek %1$lld hari · bermula semula setiap %2$lld minggu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brett med %1$lld dager · starter på nytt hver %2$lld. uke"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strip van %1$lld dagen · begint elke %2$lld weken opnieuw"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ଦିନର ପ୍ୟାକ୍ · ପ୍ରତି %2$lld ସପ୍ତାହରେ ପୁଣି ଆରମ୍ଭ ହୁଏ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ਦਿਨਾਂ ਦਾ ਪੈਕ · ਹਰ %2$lld ਹਫ਼ਤਿਆਂ ਬਾਅਦ ਫਿਰ ਸ਼ੁਰੂ ਹੁੰਦਾ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld-dniowe opakowanie · zaczyna się od nowa co %2$lld tyg."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartela de %1$lld dias · recomeça a cada %2$lld semanas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Embalagem de %1$lld dias · recomeça a cada %2$lld semanas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zile în folie: %1$lld · reîncepe o dată la %2$lld săpt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упаковка на %1$lld дн. · начинается заново каждые %2$lld нед."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld-dňové balenie · začína znova každý %2$lld. týždeň"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld-dnevni zavitek · začne znova vsak %2$lld. teden"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta på %1$lld dagar · börjar om efter %2$lld veckor"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld நாள் பேக் · %2$lld வாரங்களுக்கு ஒருமுறை மீண்டும் தொடங்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld రోజుల ప్యాక్ · ప్రతి %2$lld వారాలకు మళ్లీ మొదలవుతుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผง %1$lld วัน · เริ่มใหม่ทุก %2$lld สัปดาห์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld günlük paket · her %2$lld haftada bir yeniden başlar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Упаковка на %1$lld дн. · починається знову кожні %2$lld тиж."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld دن کا پیک · ہر %2$lld ہفتے بعد دوبارہ شروع ہوتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vỉ %1$lld ngày · bắt đầu lại sau mỗi %2$lld tuần"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 天药板 · 每 %2$lld 周重新开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 天藥盒 · 每 %2$lld 週重新開始"
          }
        }
      }
    },
