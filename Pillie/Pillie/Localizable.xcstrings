    "onboarding.mechanism.enforce.detail": {
      "comment": "Mechanism-proof second step detail [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The apps you chose stay paused until you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che hai scelto restano in pausa finché non confermi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Apps, die du gewählt hast, bleiben pausiert, bis du abhakst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps que tu as choisies restent en pause jusqu’à ce que tu valides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que elegiste siguen en pausa hasta que marques lo de hoy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps que você escolheu ficam pausados até você registrar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De apps die je koos, blijven gepauzeerd tot je afvinkt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparna du valde förblir pausade tills du bockar av."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De apps, du valgte, forbliver på pause, indtil du krydser af."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appene du valgte, forblir pauset til du krysser av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitsemasi sovellukset pysyvät tauolla, kunnes kuittaat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As apps que escolheste ficam em pausa até registares."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps que has triat es queden en pausa fins que confirmis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane aplikacje pozostają wstrzymane, aż odhaczysz dzień."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrané aplikace zůstanou pozastavené, dokud neodškrtneš dnešek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные тобой приложения остаются на паузе, пока ты не отметишься."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрані тобою застосунки лишаються на паузі, доки ти не відмітишся."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだアプリは、記録するまで一時停止したままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 앱은 체크할 때까지 일시 중지된 상태로 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl pilihan kamu kekal dijeda sehingga kamu sahkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile alese rămân pe pauză până bifezi ziua."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrané aplikácie zostanú pozastavené, kým neodškrtneš dnešok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปที่คุณเลือกจะหยุดชั่วคราวจนกว่าคุณจะเช็กอิน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选择的应用会一直暂停，直到你打卡。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके चुने हुए ऐप्स तब तक रुके रहते हैं, जब तक आप दर्ज न कर लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrane aplikacije ostaju pauzirane dok se ne javiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A választott appok szünetelnek, amíg ki nem pipálod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğin uygulamalar sen işaretleyene kadar duraklatılmış kalır."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பதிவு செய்யும் வரை நீங்கள் தேர்ந்தெடுத்த ஆப்ஸ் இடைநிறுத்தத்தில் இருக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi pilihanmu tetap dijeda sampai kamu check-in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى التطبيقات التي اخترتِها متوقفة مؤقتًا حتى تسجّلي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציות שבחרת נשארות מושהות עד שתסמני."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng bạn chọn vẫn tạm dừng cho đến khi bạn điểm danh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টিক না দেওয়া পর্যন্ত আপনার বেছে নেওয়া অ্যাপগুলো পজ থাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی چنی ہوئی ایپس تب تک رکی رہتی ہیں، جب تک آپ درج نہ کر لیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrane aplikacije ostanejo zaustavljene, dokler ne odkljukaš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές που διάλεξες μένουν σε παύση μέχρι να το σημειώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు నమోదు చేసే వరకు మీరు ఎంచుకున్న యాప్‌లు పాజ్‌లోనే ఉంటాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你選的 App 會一直暫停，直到你打卡。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે નોંધ ન કરો ત્યાં સુધી પસંદ કરેલી ઍપ્સ થોભેલી રહે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ದಾಖಲಿಸುವವರೆಗೆ ನೀವು ಆರಿಸಿದ ಆ್ಯಪ್‌ಗಳು ತಡೆಹಿಡಿಯಲ್ಪಟ್ಟಿರುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ രേഖപ്പെടുത്തുന്നതുവരെ നിങ്ങൾ തിരഞ്ഞെടുത്ത ആപ്പുകൾ പോസ് ആയിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही नोंद करेपर्यंत तुम्ही निवडलेली ॲप्स थांबलेली राहतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଦର୍ଜ ନକରିବା ପର୍ଯ୍ୟନ୍ତ ଆପଣ ବାଛିଥିବା ଆପ୍ ବିରାମରେ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਦਰਜ ਨਹੀਂ ਕਰਦੇ, ਤੁਹਾਡੀਆਂ ਚੁਣੀਆਂ ਐਪਾਂ ਰੁਕੀਆਂ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        }
      }
    },
