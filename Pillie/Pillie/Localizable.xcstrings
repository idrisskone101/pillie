            "value": "設定した時間にやさしくお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 시간에 부드러운 알림이 와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
