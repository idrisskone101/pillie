    "today.protection.ended.detail": {
      "comment": "Protection-off card body [ENG-70]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Plus access ended, so your apps aren't paused. Your setup is saved. Turn Plus back on and it picks up where you left off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Plus-Zugang ist zu Ende, also sind deine Apps nicht pausiert. Dein Setup ist gespeichert. Hol Plus zurück und es geht weiter wie vorher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo accesso plus è finito, quindi le app non sono in pausa. La tua configurazione è salvata. Riattiva plus e riprende da dove eri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton accès Plus est terminé, donc tes apps ne sont pas en pause. Ta config est sauvegardée. Réactive Plus et ça reprend où tu en étais."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu acceso a Plus terminó, así que tus apps no están en pausa. Tu configuración está guardada. Reactiva Plus y retoma donde lo dejaste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu acesso ao Plus terminou, então seus apps não estão pausados. Sua configuração está salva. Reative o Plus e tudo continua de onde parou."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Plus-toegang is afgelopen, dus je apps zijn niet gepauzeerd. Je instellingen zijn bewaard. Zet Plus weer aan en het gaat verder waar je was gebleven."
          }
        }
      }
    },
