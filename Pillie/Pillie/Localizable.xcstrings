    "onboarding.mechanism.trigger.detail": {
      "comment": "Mechanism-proof first step detail [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle reminder at your chosen time."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria discreto all’orario scelto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine sanfte Erinnerung zur gewählten Zeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel tout en douceur à l’heure choisie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio suave a la hora que elijas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete suave no horário que você escolheu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zachte herinnering op het door jou gekozen tijdstip."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En mjuk påminnelse vid den tid du valt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En blid påmindelse på det tidspunkt, du har valgt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En vennlig påminnelse på valgt tidspunkt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lempeä muistutus valitsemaasi aikaan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete suave à hora que escolheste."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatori suau a l’hora que has triat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatne przypomnienie o wybranej godzinie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemná připomínka ve zvolený čas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкое напоминание в выбранное время."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "М’яке нагадування у вибраний час."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した時間にやさしくお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 시간에 부드러운 알림이 와요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan lembut pada waktu pilihan kamu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un memento blând la ora aleasă de tine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemná pripomienka vo zvolenom čase."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนเบา ๆ ตามเวลาที่คุณเลือก"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你设定的时间，收到一条温和的提醒。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके चुने हुए समय पर एक हल्का-सा रिमाइंडर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nježan podsjetnik u vrijeme koje odabereš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy finom emlékeztető a választott időpontban."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğin saatte nazik bir hatırlatma."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தேர்ந்தெடுத்த நேரத்தில் ஒரு மென்மையான நினைவூட்டல்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat lembut pada waktu yang kamu pilih."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكير لطيف في الوقت الذي اخترتِه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תזכורת עדינה בזמן שבחרת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lời nhắc nhẹ nhàng vào giờ bạn chọn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বেছে নেওয়া সময়ে একটি মৃদু রিমাইন্ডার।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے چنے ہوئے وقت پر ایک ہلکی سی یاد دہانی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nežen opomnik ob izbranem času."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια διακριτική υπενθύμιση την ώρα που επέλεξες."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎంచుకున్న సమయంలో ఒక సున్నితమైన రిమైండర్."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你設定的時間，收到一則溫和的提醒。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે પસંદ કરેલા સમયે એક હળવું રિમાઇન્ડર."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆರಿಸಿದ ಸಮಯದಲ್ಲಿ ಒಂದು ಮೃದುವಾದ ಜ್ಞಾಪನೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തിരഞ്ഞെടുത്ത സമയത്ത് ഒരു സൗമ്യമായ റിമൈൻഡർ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही निवडलेल्या वेळी एक हलकासा रिमाइंडर."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ବାଛିଥିବା ସମୟରେ ଏକ ନରମ ରିମାଇଣ୍ଡର୍।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਚੁਣੇ ਸਮੇਂ ’ਤੇ ਇੱਕ ਨਰਮ ਰਿਮਾਈਂਡਰ।"
          }
        }
      }
    },
