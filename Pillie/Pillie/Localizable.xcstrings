    "history.discovery.banner": {
      "comment": "History day correction discovery banner [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now tap a day to update it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux maintenant toucher un jour pour le modifier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes tocar un día para actualizarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora você pode tocar em um dia para atualizá-lo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt nu op een dag tikken om die bij te werken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jetzt auf einen Tag tippen, um ihn zu aktualisieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora puoi toccare un giorno per aggiornarlo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu kan du trycka på en dag för att uppdatera den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu kan du trykke på en dag for at opdatere den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nå kan du trykke på en dag for å oppdatere den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit nyt päivittää päivän napauttamalla sitä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora podes tocar num dia para o atualizar."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara pots tocar un dia per actualitzar-lo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz możesz stuknąć dzień, aby go zaktualizować."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď můžeš klepnout na den a upravit ho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь можно коснуться дня, чтобы изменить его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер можна торкнутися дня, щоб змінити його."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付をタップして更新できるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 날짜를 탭해서 업데이트할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kini kamu boleh ketik hari untuk mengemas kininya."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum poți atinge o zi ca s-o actualizezi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz môžeš ťuknúť na deň a upraviť ho."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้คุณแตะที่วันเพื่ออัปเดตได้แล้ว"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在可以点按某一天进行更新。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब किसी दिन पर टैप करके उसे अपडेट किया जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sada možeš dodirnuti dan i ažurirati ga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most már egy napra koppintva módosíthatod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık bir güne dokunup güncelleyebilirsin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது ஒரு நாளைத் தட்டி அதைப் புதுப்பிக்கலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang kamu bisa mengetuk hari untuk memperbaruinya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الآن النقر على يوم لتحديثه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עכשיו אפשר להקיש על יום כדי לעדכן אותו."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ bạn có thể chạm vào một ngày để cập nhật."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন কোনো দিনে ট্যাপ করে সেটি আপডেট করতে পারেন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اب کسی دن پر ٹیپ کر کے اسے اپ ڈیٹ کیا جا سکتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdaj lahko tapneš dan in ga posodobiš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τώρα μπορείς να πατήσεις μια ημέρα για να την ενημερώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇప్పుడు ఒక రోజును నొక్కి దాన్ని అప్‌డేట్ చేయవచ్చు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在可以點一下某一天來更新。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હવે તમે કોઈ દિવસ પર ટૅપ કરીને તેને અપડેટ કરી શકો છો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈಗ ನೀವು ಒಂದು ದಿನವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ ಅದನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ ഒരു ദിവസത്തിൽ ടാപ്പ് ചെയ്ത് അത് അപ്‌ഡേറ്റ് ചെയ്യാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आता एखाद्या दिवसावर टॅप करून तो अपडेट करता येतो."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏବେ ଆପଣ ଯେକୌଣସି ଦିନରେ ଟ୍ୟାପ୍ କରି ତାହା ଅପଡେଟ୍ କରିପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੁਣ ਤੁਸੀਂ ਕਿਸੇ ਦਿਨ ’ਤੇ ਟੈਪ ਕਰਕੇ ਉਸਨੂੰ ਅੱਪਡੇਟ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        }
      }
    },
