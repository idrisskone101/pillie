    "onboarding.risk_window.subtitle": {
      "comment": "Question subtitle [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just a rough sense. You can change this later."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A occhio. Puoi cambiarlo dopo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur grob. Du kannst das später ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Juste une idée approximative. Tu pourras changer ça plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una idea general. Puedes cambiarlo después."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só uma ideia geral. Você pode mudar depois."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grove inschatting. Je kunt dit later wijzigen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara ungefär. Du kan ändra det senare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare cirka. Du kan ændre det senere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare omtrent. Du kan endre dette senere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain suurin piirtein. Voit muuttaa tätä myöhemmin."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só uma ideia aproximada. Podes alterar isto mais tarde."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només una idea aproximada. Ho pots canviar més tard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystarczy z grubsza. Możesz to później zmienić."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stačí přibližně. Později to můžeš změnit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерно. Изменить можно позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приблизно. Змінити можна пізніше."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大まかでOKです。あとで変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대략이면 충분해요. 나중에 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekadar anggaran. Kamu boleh ubah kemudian."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar o idee aproximativă. Poți schimba asta mai târziu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stačí približne. Neskôr to môžeš zmeniť."
