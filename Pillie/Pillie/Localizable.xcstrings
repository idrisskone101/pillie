    "onboarding.mechanism.footer": {
      "comment": "Mechanism-proof footer [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of your Pillie reminder plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa parte del tuo piano di promemoria Pillie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teil deines Pillie-Erinnerungsplans."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait partie de ton plan de rappels Pillie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de tu plan de recordatorios de Pillie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte do seu plano de lembretes do Pillie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderdeel van je Pillie-herinneringsplan."
          }
        }
      }
    },
    "onboarding.mechanism.unlocked": {
      "comment": "Mechanism-proof unlocked confirmation [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. Your apps are available again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatto. Le tue app sono di nuovo disponibili."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledigt. Deine Apps sind wieder da."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est fait. Tes apps sont de retour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo. Tus apps vuelven a estar disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto. Seus apps estão disponíveis de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar. Je apps zijn weer beschikbaar."
          }
        }
      }
    },
    "onboarding.mechanism.replay_hint": {
      "comment": "VoiceOver hint for the mechanism replay button [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays the app-pause demonstration again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce di nuovo la dimostrazione della pausa delle app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt die Demonstration der App-Pause erneut ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relance la démo de la pause d'apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce otra vez la demostración de apps en pausa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz a demonstração de apps pausados de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelt de app-pauze-demo opnieuw af."
          }
        }
      }
    },
    "onboarding.mechanism.accessibility_summary": {
      "comment": "VoiceOver summary of the mechanism proof [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At your chosen time, Pillie sends a reminder and pauses distracting apps. Log today’s action to make them available again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All’orario scelto, Pillie invia un promemoria e mette in pausa le app che distraggono. Registra l’azione di oggi per renderle di nuovo disponibili."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur gewählten Zeit sendet Pillie eine Erinnerung und pausiert ablenkende Apps. Protokolliere die heutige Aktion, um sie wieder freizugeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l'heure choisie, Pillie envoie un rappel et met en pause les apps qui te distraient. Inscris l'action du jour pour les débloquer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la hora que elijas, Pillie envía un recordatorio y pausa apps que distraen. Registra la acción de hoy para volver a usarlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No horário que você escolher, o Pillie envia um lembrete e pausa apps que distraem. Registre a ação de hoje para liberá-los de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op het door jou gekozen tijdstip stuurt Pillie een herinnering en pauzeert afleidende apps. Houd de actie van vandaag bij om ze weer vrij te geven."
          }
        }
      }
    },
    "onboarding.mechanism.eyebrow": {
      "comment": "Mechanism-proof section label [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HOW IT WORKS"
