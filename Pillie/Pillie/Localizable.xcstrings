    "onboarding.blocking_demo.body": {
      "comment": "Functionality, not medical protection [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus can pause the apps you choose when a reminder goes off. They open again once you check in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Pillie Plus le app che scegli vanno in pausa quando arriva il promemoria. Si riaprono appena confermi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus kann die Apps pausieren, die du auswählst, sobald eine Erinnerung kommt. Wenn du abhakst, sind sie wieder offen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus peut mettre en pause les apps que tu choisis quand un rappel sonne. Elles redeviennent accessibles dès que tu valides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus puede pausar las apps que elijas cuando suena un recordatorio. Puedes volver a abrirlas en cuanto marques lo de hoy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie Plus pode pausar os apps que você escolher quando um lembrete toca. Eles abrem de novo assim que você registrar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus kan de apps die je kiest pauzeren wanneer een herinnering afgaat. Ze gaan weer open zodra je afvinkt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus kan pausa apparna du väljer när en påminnelse kommer. De öppnas igen så fort du bockar av."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus kan sætte de apps, du vælger, på pause, når en påmindelse kommer. De åbner igen, så snart du krydser af."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Pillie Plus kan appene du velger, pauses når en påminnelse går av. De åpnes igjen når du krysser av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus voi laittaa valitsemasi sovellukset tauolle, kun muistutus tulee. Ne aukeavat taas, kun kuittaat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie Plus pode pausar as apps que escolheres quando um lembrete toca. Voltam a abrir assim que registares."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus pot posar en pausa les apps que triïs quan sona un recordatori. Es tornen a obrir quan confirmes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus może wstrzymać wybrane aplikacje, gdy przyjdzie przypomnienie. Znów się otworzą, gdy odhaczysz dzień."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus umí pozastavit vybrané aplikace, když přijde připomínka. Zase se otevřou, jakmile odškrtneš dnešek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus может ставить выбранные тобой приложения на паузу, когда приходит напоминание. Они снова открываются, как только ты отметишься."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus може ставити вибрані тобою застосунки на паузу, коли надходить нагадування. Вони знову відкриваються, щойно ти відмітишся."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plusなら、リマインダーが鳴ったときに選んだアプリを一時停止できます。記録すると、また開けるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus는 알림이 울릴 때 선택한 앱을 일시 중지할 수 있어요. 체크하면 다시 열 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus boleh menjeda apl pilihan kamu apabila peringatan berbunyi. Apl dibuka semula sebaik kamu sahkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus poate pune pe pauză aplicațiile alese când sună un memento. Se deschid din nou după ce bifezi ziua."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus vie pozastaviť vybrané aplikácie, keď príde pripomienka. Znova sa otvoria, keď odškrtneš dnešok."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus หยุดแอปที่คุณเลือกชั่วคราวได้เมื่อถึงเวลาแจ้งเตือน แอปจะเปิดได้อีกครั้งเมื่อคุณเช็กอิน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒响起时，Pillie Plus 可以暂停你选择的应用。打卡后就能重新打开。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर आने पर Pillie Plus आपके चुने हुए ऐप्स रोक सकता है। दर्ज करते ही वे फिर से खुल जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus može pauzirati aplikacije koje odabereš kad stigne podsjetnik. Ponovno se otvaraju čim se javiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie Plus szüneteltetni tudja a választott appokat, amikor megszólal egy emlékeztető. Újra megnyílnak, amint kipipálod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus, bir hatırlatma geldiğinde seçtiğin uygulamaları duraklatabilir. İşaretlediğinde yeniden açılırlar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நினைவூட்டல் வரும்போது நீங்கள் தேர்ந்தெடுக்கும் ஆப்ஸை Pillie Plus இடைநிறுத்தலாம். நீங்கள் பதிவு செய்ததும் அவை மீண்டும் திறக்கும்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus bisa menjeda aplikasi pilihanmu saat pengingat berbunyi. Aplikasi terbuka lagi setelah kamu check-in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ Pillie Plus إيقاف التطبيقات التي تختارينها مؤقتًا عندما يحين التذكير. وتُفتح من جديد بعد أن تسجّلي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus יכול להשהות את האפליקציות שבחרת כשמגיעה תזכורת. הן נפתחות שוב ברגע שתסמני."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus có thể tạm dừng các ứng dụng bạn chọn khi lời nhắc đến. Chúng mở lại khi bạn điểm danh."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডার এলে Pillie Plus আপনার বেছে নেওয়া অ্যাপগুলো পজ করতে পারে। টিক দিলেই সেগুলো আবার খোলা যায়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی آنے پر Pillie Plus آپ کی چنی ہوئی ایپس روک سکتا ہے۔ درج کرتے ہی وہ دوبارہ کھل جاتی ہیں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie Plus lahko ob opomniku začasno zaustavi aplikacije, ki jih izbereš. Spet se odprejo, ko odkljukaš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pillie Plus μπορεί να βάζει σε παύση τις εφαρμογές που διαλέγεις όταν έρχεται μια υπενθύμιση. Ανοίγουν ξανά μόλις το σημειώσεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిమైండర్ వచ్చినప్పుడు మీరు ఎంచుకున్న యాప్‌లను Pillie Plus పాజ్ చేయగలదు. మీరు నమోదు చేయగానే అవి మళ్లీ తెరుచుకుంటాయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒響起時，Pillie Plus 可以暫停你選的 App。打卡後就能再次開啟。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇન્ડર વાગે ત્યારે Pillie Plus તમે પસંદ કરેલી ઍપ્સ થોભાવી શકે છે. નોંધ કરતાં જ તે ફરી ખૂલે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜ್ಞಾಪನೆ ಬಂದಾಗ ನೀವು ಆರಿಸುವ ಆ್ಯಪ್‌ಗಳನ್ನು Pillie Plus ತಡೆಹಿಡಿಯಬಹುದು. ನೀವು ದಾಖಲಿಸಿದ ತಕ್ಷಣ ಅವು ಮತ್ತೆ ತೆರೆಯುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിമൈൻഡർ വരുമ്പോൾ നിങ്ങൾ തിരഞ്ഞെടുക്കുന്ന ആപ്പുകൾ Pillie Plus-ന് പോസ് ചെയ്യാനാകും. നിങ്ങൾ രേഖപ്പെടുത്തുമ്പോൾ അവ വീണ്ടും തുറക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर आल्यावर Pillie Plus तुम्ही निवडलेली ॲप्स थांबवू शकते. नोंद करताच ती पुन्हा उघडतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ଆସିଲେ Pillie Plus ଆପଣ ବାଛିଥିବା ଆପ୍ ବିରାମ କରିପାରେ। ଦର୍ଜ କଲେ ସେଗୁଡ଼ିକ ପୁଣି ଖୋଲେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਈਂਡਰ ਆਉਣ ’ਤੇ Pillie Plus ਤੁਹਾਡੀਆਂ ਚੁਣੀਆਂ ਐਪਾਂ ਰੋਕ ਸਕਦਾ ਹੈ। ਦਰਜ ਕਰਦੇ ਹੀ ਉਹ ਮੁੜ ਖੁੱਲ੍ਹ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        }
      }
    },
    "onboarding.blocking_demo.shake_body": {
      "comment": "Instruction [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shake your phone now, or tap this card."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scuoti ora il telefono oppure tocca questa scheda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schüttle jetzt dein Handy oder tippe auf diese Karte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Secoue ton iPhone maintenant, ou touche cette carte."
          }
        },
