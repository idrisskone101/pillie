    "plus_setup.blocking.body": {
      "comment": "Blocking setup step body [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the apps you reach for first. They pause at reminder time and open again once you’ve checked in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختاري التطبيقات التي تفتحينها أولًا. تتوقف مؤقتًا في وقت التذكير، وتُفتح من جديد بعد أن تسجّلي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে অ্যাপগুলো সবার আগে খোলেন, সেগুলো বেছে নিন। রিমাইন্ডারের সময় সেগুলো পজ হবে, আর টিক দেওয়ার পর আবার খোলা যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria les apps que obres primer. Es posen en pausa a l’hora del recordatori i es tornen a obrir quan hagis confirmat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber aplikace, po kterých saháš nejdřív. V čase připomínky se pozastaví a znovu se otevřou, jakmile odškrtneš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg de apps, du griber efter først. De sættes på pause, når påmindelsen kommer, og åbner igen, når du har krydset af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Apps, nach denen du zuerst greifst. Sie pausieren zur Erinnerungszeit und öffnen sich wieder, sobald du abgehakt hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε τις εφαρμογές που ανοίγεις πρώτες. Μπαίνουν σε παύση την ώρα της υπενθύμισης και ανοίγουν ξανά μόλις το σημειώσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las apps que abres primero. Se pausan a la hora del recordatorio y se vuelven a abrir cuando lo hayas marcado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse sovellukset, joihin tartut ensimmäisenä. Ne menevät tauolle muistutusaikaan ja aukeavat taas, kun olet kuitannut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis les apps que tu ouvres en premier. Elles se mettent en pause à l’heure du rappel et se rouvrent dès que tu as validé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જે ઍપ્સ તમે સૌથી પહેલાં ખોલો છો તે પસંદ કરો. રિમાઇન્ડરના સમયે તે થોભી જશે અને તમે નોંધ કરી લો પછી ફરી ખૂલશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרי את האפליקציות שאת פותחת ראשונות. הן מושהות בזמן התזכורת ונפתחות שוב אחרי שתסמני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे ऐप्स चुनें जिन्हें आप सबसे पहले खोलती हैं। रिमाइंडर के समय वे रुक जाते हैं और दर्ज करने के बाद फिर से खुल जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi aplikacije koje prve otvaraš. U vrijeme podsjetnika se pauziraju i ponovno se otvaraju čim se javiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki az appokat, amelyekért először nyúlsz. Az emlékeztető idején szünetelnek, és újra megnyílnak, amint kipipáltad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih aplikasi yang paling dulu kamu buka. Aplikasinya dijeda saat waktu pengingat dan terbuka lagi setelah kamu check-in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le app che apri per prime. Vanno in pausa all’orario del promemoria e si riaprono appena hai confermato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初に手が伸びるアプリを選んでください。リマインダーの時刻に一時停止し、記録するとまた開けるようになります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಮೊದಲು ತೆರೆಯುವ ಆ್ಯಪ್‌ಗಳನ್ನು ಆರಿಸಿ. ಜ್ಞಾಪನೆಯ ಸಮಯದಲ್ಲಿ ಅವು ತಡೆಹಿಡಿಯಲ್ಪಡುತ್ತವೆ, ನೀವು ದಾಖಲಿಸಿದ ನಂತರ ಮತ್ತೆ ತೆರೆಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 먼저 손이 가는 앱을 골라 보세요. 알림 시간에 일시 중지되고, 체크하면 다시 열려요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ആദ്യം തുറക്കുന്ന ആപ്പുകൾ തിരഞ്ഞെടുക്കൂ. റിമൈൻഡർ സമയത്ത് അവ പോസ് ആകും, നിങ്ങൾ രേഖപ്പെടുത്തിക്കഴിഞ്ഞാൽ വീണ്ടും തുറക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही सर्वात आधी उघडता ती ॲप्स निवडा. रिमाइंडरच्या वेळी ती थांबतात आणि नोंद केल्यानंतर पुन्हा उघडता येतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apl yang paling awal kamu buka. Apl itu dijeda pada waktu peringatan dan dibuka semula selepas kamu sahkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg appene du griper etter først. De settes på pause når påminnelsen kommer, og åpnes igjen når du har krysset av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de apps die je als eerste opent. Ze pauzeren op je herinneringstijd en gaan weer open zodra je hebt afgevinkt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ସବୁଠୁ ପ୍ରଥମେ ଖୋଲୁଥିବା ଆପ୍ ବାଛନ୍ତୁ। ରିମାଇଣ୍ଡର୍ ସମୟରେ ସେଗୁଡ଼ିକ ବିରାମରେ ରହିବ, ଏବଂ ଦର୍ଜ କରିସାରିବା ପରେ ପୁଣି ଖୋଲିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹ ਐਪਾਂ ਚੁਣੋ ਜੋ ਤੁਸੀਂ ਸਭ ਤੋਂ ਪਹਿਲਾਂ ਖੋਲ੍ਹਦੇ ਹੋ। ਰਿਮਾਈਂਡਰ ਦੇ ਸਮੇਂ ਉਹ ਰੁਕ ਜਾਂਦੀਆਂ ਹਨ ਅਤੇ ਦਰਜ ਕਰਨ ਤੋਂ ਬਾਅਦ ਮੁੜ ਖੁੱਲ੍ਹ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz aplikacje, po które sięgasz najpierw. O godzinie przypomnienia zostaną wstrzymane i otworzą się znowu, gdy odhaczysz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os apps que você abre primeiro. Eles pausam no horário do lembrete e abrem de novo assim que você registrar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe as apps que abres primeiro. Ficam em pausa à hora do lembrete e voltam a abrir assim que registares."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege aplicațiile pe care le deschizi primele. Se pun pe pauză la ora mementoului și se redeschid după ce bifezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери приложения, которые открываешь первыми. Во время напоминания они встают на паузу и снова открываются, как только ты отметишься."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber aplikácie, po ktorých siahaš najskôr. V čase pripomienky sa pozastavia a znova sa otvoria, keď odškrtneš."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi aplikacije, po katerih sežeš najprej. Ob času opomnika se zaustavijo in se znova odprejo, ko odkljukaš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj apparna du sträcker dig efter först. De pausas vid påminnelsetiden och öppnas igen när du har bockat av."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் முதலில் திறக்கும் ஆப்ஸைத் தேர்ந்தெடுங்கள். நினைவூட்டல் நேரத்தில் அவை இடைநிறுத்தப்படும், நீங்கள் பதிவு செய்த பிறகு மீண்டும் திறக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ముందుగా తెరిచే యాప్‌లను ఎంచుకోండి. రిమైండర్ సమయంలో అవి పాజ్ అవుతాయి, మీరు నమోదు చేశాక మళ్లీ తెరుచుకుంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแอปที่คุณมักเปิดเป็นอย่างแรก แอปจะหยุดชั่วคราวเมื่อถึงเวลาแจ้งเตือน และเปิดได้อีกครั้งเมื่อคุณเช็กอินแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk elini uzattığın uygulamaları seç. Hatırlatma saatinde duraklar, işaretledikten sonra yeniden açılırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери застосунки, які відкриваєш першими. Під час нагадування вони стають на паузу й знову відкриваються, щойно ти відмітишся."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ ایپس چنیں جو آپ سب سے پہلے کھولتی ہیں۔ یاد دہانی کے وقت یہ رک جاتی ہیں اور درج کرنے کے بعد پھر سے کھل جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn những ứng dụng bạn hay mở đầu tiên. Chúng tạm dừng vào giờ nhắc và mở lại khi bạn đã điểm danh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选出你最先会打开的应用。到了提醒时间，它们会暂停，打卡后就能再次打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選出你最先會開啟的 App。到了提醒時間，它們會暫停，打卡後就能再次開啟。"
          }
        }
      }
    },
