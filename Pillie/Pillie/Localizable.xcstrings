            "value": "保存するとパッチに切り替わり、ピルの履歴が消去されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಳಿಸಿದರೆ ನಿಮ್ಮ ವಿಧಾನ ಪ್ಯಾಚ್‌ಗೆ ಬದಲಾಗುತ್ತದೆ ಮತ್ತು ನಿಮ್ಮ ಮಾತ್ರೆಯ ಇತಿಹಾಸ ಅಳಿಸಿಹೋಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하면 패치로 바뀌고 피임약 기록이 삭제돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സേവ് ചെയ്താൽ നിങ്ങളുടെ രീതി പാച്ച് ആയി മാറും, ഗുളികയുടെ ചരിത്രം മായ്ക്കപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव्ह केल्याने तुमची पद्धत पॅच होईल आणि तुमचा गोळीचा इतिहास पुसला जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan akan menukar kamu kepada tampalan dan memadam sejarah pil kamu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du lagrer, bytter du til plaster, og pillehistorikken din slettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslaan zet je over op de pleister en wist je pilgeschiedenis."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସେଭ୍ କଲେ ଆପଣଙ୍କ ପଦ୍ଧତି ପ୍ୟାଚ୍‌କୁ ବଦଳିଯିବ ଏବଂ ଆପଣଙ୍କ ପିଲ୍‌ର ଇତିହାସ ଲିଭିଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੇਵ ਕਰਨ ਨਾਲ ਤੁਹਾਡਾ ਤਰੀਕਾ ਪੈਚ ਹੋ ਜਾਵੇਗਾ ਅਤੇ ਤੁਹਾਡਾ ਗੋਲੀ ਦਾ ਇਤਿਹਾਸ ਮਿਟ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisanie zmieni metodę na plaster i usunie historię tabletki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar troca você para o adesivo e apaga seu histórico da pílula."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar muda-te para o adesivo e apaga o teu histórico da pílula."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvarea te trece la plasture și îți șterge istoricul pilulei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При сохранении ты перейдёшь на пластырь, а история таблетки удалится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložením prejdeš na náplasť a vymažeš históriu tabletky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S shranjevanjem preideš na obliž in izbrišeš zgodovino tabletke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du sparar byter du till plåster och din pillerhistorik raderas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமித்தால் உங்கள் முறை பேட்ச்சுக்கு மாறும், உங்கள் மாத்திரை வரலாறு அழிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సేవ్ చేస్తే మీ పద్ధతి ప్యాచ్‌కు మారుతుంది, మీ మాత్ర చరిత్ర తొలగిపోతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกจะเปลี่ยนคุณไปใช้แผ่นแปะและล้างประวัติยาคุมของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmek seni banda geçirir ve hap geçmişini siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після збереження ти перейдеш на пластир, а історія таблетки видалиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ کرنے سے آپ کا طریقہ پیچ ہو جائے گا اور آپ کی گولی کی ہسٹری مٹ جائے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi lưu, bạn sẽ chuyển sang miếng dán và lịch sử thuốc sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
