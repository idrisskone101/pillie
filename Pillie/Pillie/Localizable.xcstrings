          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai multe mementouri până bifezi ziua de azi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ďalšie pripomienky, kým neodškrtneš dnešok."
