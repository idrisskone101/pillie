            "value": "आप अपने चक्र में कहाँ हैं?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdje si u ciklusu?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol tartasz a ciklusodban?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sedang di mana dalam siklusmu?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A che punto sei del ciclo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今、周期のどのあたりですか？"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಚಕ್ರದಲ್ಲಿ ಈಗ ನೀವು ಎಲ್ಲಿದ್ದೀರಿ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 주기의 어디쯤이에요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സൈക്കിളിൽ ഇപ്പോൾ നിങ്ങൾ എവിടെയാണ്?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही तुमच्या चक्रात कुठे आहात?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Di mana kamu dalam kitaran?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor er du i syklusen din?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar ben je in je cyclus?"
