    "settings.schedule_reset.body": {
      "comment": "Integer placeholder [destructive]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the schedule resets all tracking history and starts at day %lld. This cannot be undone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica del programma reimposta tutta la cronologia e riparte dal giorno %lld. L’operazione non può essere annullata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du den Zeitplan änderst, wird der gesamte Protokollverlauf zurückgesetzt und bei Tag %lld neu begonnen. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer le planning réinitialise tout l'historique de suivi et repart au jour %lld. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el horario restablece todo el historial de seguimiento y empieza en el día %lld. Esto no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar o cronograma redefine todo o histórico de registro e recomeça no dia %lld. Isso não pode ser desfeito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je het schema wijzigt, wordt alle bijhoudgeschiedenis gereset en start opnieuw op dag %lld. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du ändrar schemat återställs all historik och du börjar om på dag %lld. Det går inte att ångra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du ændrer tidsplanen, nulstilles al historik, og du starter på dag %lld. Det kan ikke fortrydes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du endrer tidsplanen, nullstilles all logghistorikk og starter på dag %lld. Dette kan ikke angres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aikataulun muuttaminen nollaa koko seurantahistorian ja aloittaa päivästä %lld. Tätä ei voi kumota."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar o horário repõe todo o histórico de registos e recomeça no dia %lld. Isto não pode ser anulado."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canviar l’horari restableix tot l’historial de registres i comença al dia %lld. Això no es pot desfer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana harmonogramu wyzeruje całą historię i zacznie od dnia %lld. Nie da się tego cofnąć."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna rozvrhu vymaže celou historii sledování a začne dnem %lld. Tuto akci nelze vrátit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение графика сбросит всю историю и начнёт отсчёт с дня %lld. Это нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна графіка скине всю історію та почне відлік із дня %lld. Це не можна скасувати."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールを変更すると、すべての記録履歴がリセットされ、%lld日目から始まります。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정을 변경하면 모든 기록이 초기화되고 %lld일째부터 다시 시작돼요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukar jadual akan set semula semua sejarah penjejakan dan bermula pada hari %lld. Ini tidak boleh dibuat asal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbarea programului resetează tot istoricul de urmărire și începe de la ziua %lld. Acțiunea nu poate fi anulată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmena rozvrhu vynuluje celú históriu sledovania a začne od dňa %lld. Toto sa nedá vrátiť späť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนตารางจะรีเซ็ตประวัติการติดตามทั้งหมดและเริ่มที่วันที่ %lld การทำเช่นนี้ย้อนกลับไม่ได้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改时间表会重置所有跟踪历史，并从第 %lld 天重新开始。此操作无法撤销。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेड्यूल बदलने से पूरा ट्रैकिंग इतिहास रीसेट हो जाता है और दिन %lld से शुरू होता है। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjena rasporeda poništava cijelu povijest praćenja i počinje od dana %lld. Ovo se ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beosztás módosítása törli az összes követési előzményt, és a %lld. naptól indul újra. Ez nem vonható vissza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programı değiştirmek tüm takip geçmişini sıfırlar ve %lld. günden başlar. Bu geri alınamaz."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அட்டவணையை மாற்றினால் எல்லா கண்காணிப்பு வரலாறும் மீட்டமைக்கப்பட்டு நாள் %lld-இல் தொடங்கும். இதைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah jadwal akan mereset semua riwayat pelacakan dan memulai dari hari %lld. Ini tidak bisa dibatalkan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي تغيير الجدول إلى إعادة تعيين سجل التتبع بالكامل والبدء من اليوم %lld. لا يمكن التراجع عن ذلك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי לוח הזמנים מאפס את כל היסטוריית המעקב ומתחיל מיום %lld. אי אפשר לבטל את הפעולה הזו."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi lịch sẽ đặt lại toàn bộ lịch sử theo dõi và bắt đầu từ ngày %lld. Không thể hoàn tác."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়সূচি বদলালে সব ট্র্যাকিং ইতিহাস রিসেট হয়ে দিন %lld থেকে শুরু হবে। এটা ফিরিয়ে নেওয়া যাবে না।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شیڈول بدلنے سے ساری ٹریکنگ ہسٹری ری سیٹ ہو کر دن %lld سے شروع ہو گی۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprememba urnika ponastavi vso zgodovino sledenja in začne pri dnevu %lld. Tega ni mogoče razveljaviti."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή του προγράμματος επαναφέρει όλο το ιστορικό παρακολούθησης και ξεκινά από την ημέρα %lld. Δεν μπορεί να αναιρεθεί."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షెడ్యూల్ మార్చితే ట్రాకింగ్ చరిత్ర అంతా రీసెట్ అయి రోజు %lld నుంచి మొదలవుతుంది. దీన్ని రద్దు చేయలేం."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改時程會重設所有追蹤紀錄，並從第 %lld 天重新開始。此操作無法復原。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શેડ્યૂલ બદલને સે પૂરા ટ્રૈકિંગ ઇતિહાસ રીસેટ હો જાતા છે અને દિન %lld સે શુરૂ હોતા છે। આને પૂર્વવત નહીં કિયા જા સકતા।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಷೆಡ್ಯೂಲ್ ಮಾರ್ಚಿತೇ ಟ್ರಾಕಿಂಗ್ ಚರಿತ್ರ ಅಂತಾ ರೀಸೆಟ್ ಅಯಿ ರೋಜು %lld ನುಂಚಿ ಮೊದಲವುತುಂದಿ. ದೀನ್ನಿ ರದ್ದು ಚೇಯಲೇಂ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഷെഡ്യൂൾ മാറ്റുന്നത് എല്ലാ ട്രാക്കിംഗ് ചരിത്രവും റീസെറ്റ് ചെയ്‌ത് ദിവസം %lld-ൽ തുടങ്ങും. ഇത് പഴയപടിയാക്കാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शेड्यूल बदलने पासून पूरा ट्रैकिंग इतिहास रीसेट हो जाता आहे आणि दिन %lld पासून शुरू होता आहे. हे पूर्ववत नाही केलं जा सकता।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସୂଚୀ ବଦଳାଇଲେ ସମସ୍ତ ଟ୍ରାକିଂ ଇତିହାସ ରିସେଟ୍ ହୁଏ ଏବଂ ଦିନ %lld ରୁ ଆରମ୍ଭ ହୁଏ। ଏହା ପୂର୍ବବତ୍ କରିହେବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸ਼ੇਡ੍ਯੂਲ ਬਦਲਨੇ ਸੇ ਪੂਰਾ ਟ੍ਰੈਕਿਂਗ ਇਤਿਹਾਸ ਰੀਸੇਟ ਹੋ ਜਾਂਦਾ ਹੈ ਤੇ ਦਿਨ %lld ਸੇ ਸ਼ੁਰੂ ਹੁਂਦਾ ਹੈ। ਇਸੇ ਪੂਰ੍ਵਵਤ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਤਾ।"
          }
        }
      }
    },
