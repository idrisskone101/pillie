            "value": "저장하면 피임약으로 바뀌고 패치 기록이 삭제돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സേവ് ചെയ്താൽ നിങ്ങളുടെ രീതി ഗുളിക ആയി മാറും, പാച്ചിന്റെ ചരിത്രം മായ്ക്കപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव्ह केल्याने तुमची पद्धत गोळी होईल आणि तुमचा पॅचचा इतिहास पुसला जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan akan menukar kamu kepada pil dan memadam sejarah tampalan kamu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du lagrer, bytter du til p-pille, og plasterhistorikken din slettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslaan zet je over op de pil en wist je pleistergeschiedenis."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସେଭ୍ କଲେ ଆପଣଙ୍କ ପଦ୍ଧତି ପିଲ୍‌କୁ ବଦଳିଯିବ ଏବଂ ଆପଣଙ୍କ ପ୍ୟାଚ୍‌ର ଇତିହାସ ଲିଭିଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੇਵ ਕਰਨ ਨਾਲ ਤੁਹਾਡਾ ਤਰੀਕਾ ਗੋਲੀ ਹੋ ਜਾਵੇਗਾ ਅਤੇ ਤੁਹਾਡਾ ਪੈਚ ਦਾ ਇਤਿਹਾਸ ਮਿਟ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisanie zmieni metodę na tabletkę i usunie historię plastra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar troca você para a pílula e apaga seu histórico do adesivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar muda-te para a pílula e apaga o teu histórico do adesivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvarea te trece la pilulă și îți șterge istoricul plasturelui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При сохранении ты перейдёшь на таблетку, а история пластыря удалится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložením prejdeš na tabletku a vymažeš históriu náplasti."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S shranjevanjem preideš na tabletko in izbrišeš zgodovino obliža."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du sparar byter du till p-piller och din plåsterhistorik raderas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமித்தால் உங்கள் முறை மாத்திரைக்கு மாறும், உங்கள் பேட்ச் வரலாறு அழிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సేవ్ చేస్తే మీ పద్ధతి మాత్రకు మారుతుంది, మీ ప్యాచ్ చరిత్ర తొలగిపోతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกจะเปลี่ยนคุณไปใช้ยาคุมและล้างประวัติแผ่นแปะของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmek seni hapa geçirir ve bant geçmişini siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після збереження ти перейдеш на таблетку, а історія пластиря видалиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ کرنے سے آپ کا طریقہ گولی ہو جائے گا اور آپ کی پیچ کی ہسٹری مٹ جائے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi lưu, bạn sẽ chuyển sang thuốc và lịch sử miếng dán sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后会切换到避孕药，并清除你的贴片历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存後會切換為避孕藥，並清除你的貼片歷史紀錄。"
          }
        }
      }
    },
