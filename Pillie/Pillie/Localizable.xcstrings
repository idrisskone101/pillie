    "onboarding.blocking_setup.privacy": {
      "comment": "Privacy-safe explanation of the opaque Screen Time selection [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie only receives the number of items selected. Your selection stays on this device."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie riceve solo il numero di elementi selezionati. La selezione resta su questo dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie erhält nur die Anzahl der ausgewählten Elemente. Deine Auswahl bleibt auf diesem Gerät."
          }
        },
        "fr": {
