            "value": "তখন আমি ব্যস্ত থাকি।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس وقت مجھے فرصت نہیں ہوتی۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Takrat nimam časa."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχω τότε χρόνο."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ సమయంలో నేను బిజీగా ఉంటాను."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那時候我在忙。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એ સમયે હું વ્યસ્ત હોઉં છું."
