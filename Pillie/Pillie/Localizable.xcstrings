    "onboarding.pack_sheet.footer": {
      "comment": "Onboarding pack type sheet footer hint [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure? The layout is printed on the back of the box."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لستِ متأكدة؟ الترتيب مطبوع على ظهر العلبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিশ্চিত নন? লেআউটটি বাক্সের পেছনে ছাপা থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No n’estàs segura? La distribució està impresa al dors de la capsa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevíš jistě? Rozložení je vytištěné na zadní straně krabičky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I tvivl? Opsætningen står bag på æsken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsicher? Die Anordnung steht hinten auf der Packung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είσαι σίγουρη; Η διάταξη είναι τυπωμένη πίσω στο κουτί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No estás segura? La distribución viene impresa detrás de la caja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkö ole varma? Asettelu on painettu rasian takapuolelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas sûre ? La disposition est imprimée au dos de la boîte."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખાતરી નથી? લેઆઉટ બૉક્સની પાછળ છાપેલું હોય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא בטוחה? הסידור מודפס על גב הקופסה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पक्का नहीं पता? लेआउट डिब्बे के पीछे छपा होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisi sigurna? Raspored je otisnut na poleđini kutije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem vagy biztos benne? Az elrendezés a doboz hátulján van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum yakin? Susunannya tercetak di bagian belakang kotak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sei sicura? Lo schema è stampato sul retro della scatola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わからないときは、箱の裏に並び方が印刷されています。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಖಚಿತವಿಲ್ಲವೇ? ಪೆಟ್ಟಿಗೆಯ ಹಿಂಭಾಗದಲ್ಲಿ ಮಾತ್ರೆಗಳ ಜೋಡಣೆ ಮುದ್ರಿತವಾಗಿರುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘 모르겠다면 상자 뒷면에 배열이 인쇄되어 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉറപ്പില്ലേ? പെട്ടിയുടെ പിൻവശത്ത് ഗുളികകളുടെ ക്രമം അച്ചടിച്ചിട്ടുണ്ടാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खात्री नाही? मांडणी खोक्याच्या मागे छापलेली असते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak pasti? Susunannya tercetak di belakang kotak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Usikker? Oppsettet står på baksiden av esken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twijfel je? De indeling staat op de achterkant van het doosje."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନିଶ୍ଚିତ ନୁହଁନ୍ତି? ବାକ୍ସର ପଛପଟେ ପିଲ୍‌ର ସଜ୍ଜା ଛପା ହୋଇଥାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੱਕਾ ਨਹੀਂ ਪਤਾ? ਲੇਆਉਟ ਡੱਬੇ ਦੇ ਪਿੱਛੇ ਛਪਿਆ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz pewności? Układ jest wydrukowany z tyłu pudełka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não tem certeza? O formato vem impresso no verso da caixa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não tens a certeza? A disposição vem impressa no verso da caixa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ești sigură? Aranjamentul e tipărit pe spatele cutiei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не уверена? Схема напечатана на обороте коробки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie si si istá? Rozloženie je vytlačené na zadnej strane škatuľky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisi prepričana? Razporeditev je natisnjena na hrbtni strani škatle."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Osäker? Uppställningen står på baksidan av kartongen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உறுதியாகத் தெரியவில்லையா? பெட்டியின் பின்புறம் மாத்திரைகளின் அமைப்பு அச்சிடப்பட்டிருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖచ్చితంగా తెలియదా? పెట్టె వెనుక మాత్రల అమరిక ముద్రించి ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่แน่ใจ ดูรูปแบบได้ที่ด้านหลังกล่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emin değil misin? Düzen kutunun arkasında yazar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не впевнена? Схему надруковано на звороті коробки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یقین نہیں؟ ترتیب ڈبے کی پشت پر چھپی ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa chắc? Cách sắp xếp được in ở mặt sau hộp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不确定？药板排列印在药盒背面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不確定？藥板排列印在藥盒背面。"
          }
        }
      }
    },
