        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大概就行。以后可以更改。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस एक मोटा अंदाज़ा। इसे बाद में बदला जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo otprilike. Kasnije to možeš promijeniti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak nagyjából. Később módosíthatod."
