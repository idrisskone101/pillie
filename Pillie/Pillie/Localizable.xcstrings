    "onboarding.ready.subtitle": {
      "comment": "No guarantee [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie follows the schedule you picked. You can change it anytime."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie segue il programma che hai scelto. Puoi cambiarlo quando vuoi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie folgt deinem ausgewählten Zeitplan. Du kannst ihn jederzeit ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie suit le planning que tu as choisi. Tu peux le modifier à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie sigue el horario que elegiste. Puedes cambiarlo cuando quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie segue o cronograma que você escolheu. Você pode mudar quando quiser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie volgt het schema dat je koos. Je kunt het altijd wijzigen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie följer det schema du valde. Du kan ändra det när du vill."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie følger den tidsplan, du valgte. Du kan ændre den når som helst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie følger tidsplanen du valgte. Du kan endre den når som helst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie noudattaa valitsemaasi aikataulua. Voit muuttaa sitä milloin tahansa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pillie segue o horário que escolheste. Podes alterá-lo quando quiseres."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie segueix l’horari que has triat. El pots canviar quan vulguis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie trzyma się wybranego harmonogramu. Możesz go zmienić w każdej chwili."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie se drží zvoleného rozvrhu. Kdykoliv ho můžeš změnit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie следует выбранному тобой графику. Изменить его можно в любой момент."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie дотримується вибраного тобою графіка. Змінити його можна будь-коли."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieは選んだスケジュールに従います。いつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie가 선택한 일정을 따라가요. 언제든 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ikut jadual yang kamu pilih. Kamu boleh ubah bila-bila masa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie urmează programul pe care l-ai ales. Îl poți schimba oricând."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie sa drží zvoleného rozvrhu. Kedykoľvek ho môžeš zmeniť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ทำตามตารางที่คุณเลือก คุณเปลี่ยนได้ทุกเมื่อ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 会按照你选择的时间表运行。你随时可以更改。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie आपके चुने हुए शेड्यूल पर चलता है। इसे कभी भी बदला जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie prati odabrani raspored. Možeš ga promijeniti kad god želiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pillie a kiválasztott beosztást követi. Bármikor módosíthatod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie seçtiğin programı takip eder. İstediğin zaman değiştirebilirsin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தேர்ந்தெடுத்த அட்டவணையை Pillie பின்பற்றும். எப்போது வேண்டுமானாலும் இதை மாற்றலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie mengikuti jadwal yang kamu pilih. Kamu bisa mengubahnya kapan saja."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع Pillie الجدول الذي اخترتِه. يمكنك تغييره في أي وقت."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie עוקבת אחרי לוח הזמנים שבחרת. אפשר לשנות אותו בכל עת."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie theo lịch bạn đã chọn. Bạn có thể đổi bất cứ lúc nào."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie আপনার বেছে নেওয়া সময়সূচি মেনে চলে। যেকোনো সময় বদলাতে পারেন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie آپ کے چنے ہوئے شیڈول پر چلتا ہے۔ اسے کبھی بھی بدلا جا سکتا ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie sledi izbranemu urniku. Kadar koli ga lahko spremeniš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pillie ακολουθεί το πρόγραμμα που διάλεξες. Μπορείς να το αλλάξεις όποτε θέλεις."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎంచుకున్న షెడ్యూల్‌ను Pillie అనుసరిస్తుంది. మీరు ఎప్పుడైనా మార్చవచ్చు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 會依照你選擇的時程運作。你隨時可以更改。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie તમે પસંદ કરેલા શેડ્યૂલને અનુસરે છે. તમે તેને ગમે ત્યારે બદલી શકો છો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆರಿಸಿದ ವೇಳಾಪಟ್ಟಿಯನ್ನು Pillie ಅನುಸರಿಸುತ್ತದೆ. ಯಾವಾಗ ಬೇಕಾದರೂ ನೀವು ಇದನ್ನು ಬದಲಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തിരഞ്ഞെടുത്ത ഷെഡ്യൂൾ Pillie പിന്തുടരും. നിങ്ങൾക്ക് എപ്പോൾ വേണമെങ്കിലും ഇത് മാറ്റാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही निवडलेल्या वेळापत्रकानुसार Pillie चालते. ते कधीही बदलता येते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ଆପଣ ବାଛିଥିବା ସୂଚୀ ଅନୁସରଣ କରେ। ଆପଣ ଯେକୌଣସି ସମୟରେ ଏହା ବଦଳାଇପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ਤੁਹਾਡੇ ਚੁਣੇ ਸ਼ਡਿਊਲ ਮੁਤਾਬਕ ਚੱਲਦਾ ਹੈ। ਤੁਸੀਂ ਇਸਨੂੰ ਕਦੇ ਵੀ ਬਦਲ ਸਕਦੇ ਹੋ।"
          }
        }
      }
    },
