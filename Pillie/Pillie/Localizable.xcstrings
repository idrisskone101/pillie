            "state": "translated",
            "value": "Unde ești în ciclu?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где ты сейчас в цикле?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kde v cykle práve si?"
