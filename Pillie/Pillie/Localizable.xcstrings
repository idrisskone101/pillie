    "settings.schedule.save_note.pill": {
      "comment": "Schedule sheet line above Save, same pill method; integer is the pill number [destructive]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving clears your history and restarts from pill %lld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي الحفظ إلى مسح سجلّك والبدء من جديد من الحبة %lld."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেভ করলে আপনার ইতিহাস মুছে যাবে এবং পিল %lld থেকে আবার শুরু হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si deses, s’esborra el teu historial i tornes a començar per la píndola %lld."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložením vymažeš historii a začneš znovu od pilulky %lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du gemmer, slettes din historik, og du starter forfra fra pille %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Speichern wird dein Verlauf gelöscht und du startest wieder bei Pille %lld."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με την αποθήκευση διαγράφεται το ιστορικό σου και ξεκινάς ξανά από το χάπι %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar, se borra tu historial y vuelves a empezar desde la píldora %lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentaminen poistaa historiasi, ja aloitat alusta pilleristä %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer efface ton historique et te fait repartir de la pilule %lld."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાચવવાથી તમારો ઇતિહાસ ભૂંસાઈ જશે અને ગોળી %lld થી ફરી શરૂઆત થશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירה תמחק את ההיסטוריה שלך ותתחילי מחדש מגלולה %lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव करने से आपका इतिहास मिट जाएगा और शुरुआत फिर से गोली %lld से होगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremanjem brišeš povijest i krećeš ispočetka od pilule %lld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentés törli az előzményeidet, és a %lld. tablettától kezded újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan akan menghapus riwayatmu dan memulai lagi dari pil %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvando cancelli la cronologia e riparti dalla pillola %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると履歴が消去され、%lld錠目からやり直します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಳಿಸಿದರೆ ನಿಮ್ಮ ಇತಿಹಾಸ ಅಳಿಸಿಹೋಗುತ್ತದೆ ಮತ್ತು ಮಾತ್ರೆ %lld ರಿಂದ ಮತ್ತೆ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하면 기록이 삭제되고 %lld번째 알약부터 다시 시작돼요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സേവ് ചെയ്താൽ നിങ്ങളുടെ ചരിത്രം മായ്ക്കപ്പെടും, ഗുളിക %lld മുതൽ വീണ്ടും തുടങ്ങും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव्ह केल्याने तुमचा इतिहास पुसला जाईल आणि गोळी %lld पासून पुन्हा सुरुवात होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan akan memadam sejarah kamu dan bermula semula dari pil %lld."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du lagrer, slettes historikken din, og du starter på nytt fra pille %lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslaan wist je geschiedenis en begint opnieuw bij pil %lld."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସେଭ୍ କଲେ ଆପଣଙ୍କ ଇତିହାସ ଲିଭିଯିବ ଏବଂ ପିଲ୍ %lld ରୁ ପୁଣି ଆରମ୍ଭ ହେବ।"
