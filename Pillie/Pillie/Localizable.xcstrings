    "onboarding.dial.a11y.hint": {
      "comment": "Accessibility hint for the dial's adjustable action. ENG-146 [health]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up or down to change the day."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحبي لأعلى أو لأسفل لتغيير اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিন বদলাতে উপরে বা নিচে সোয়াইপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llisca amunt o avall per canviar el dia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejeď nahoru nebo dolů a změň den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stryg op eller ned for at ændre dagen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisch nach oben oder unten, um den Tag zu ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σάρωσε πάνω ή κάτω για να αλλάξεις ημέρα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba o abajo para cambiar el día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäise ylös tai alas vaihtaaksesi päivää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie vers le haut ou le bas pour changer de jour."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દિવસ બદલવા ઉપર કે નીચે સ્વાઇપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החליקי למעלה או למטה כדי לשנות את היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन बदलने के लिए ऊपर या नीचे स्वाइप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci prema gore ili dolje za promjenu dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pöccints fel vagy le a nap módosításához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Usap ke atas atau bawah untuk mengubah hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri in su o in giù per cambiare giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下にスワイプして日を変更します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಿನ ಬದಲಿಸಲು ಮೇಲೆ ಅಥವಾ ಕೆಳಗೆ ಸ್ವೈಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위나 아래로 쓸어서 날짜를 바꾸세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദിവസം മാറ്റാൻ മുകളിലേക്കോ താഴേക്കോ സ്വൈപ്പ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दिवस बदलण्यासाठी वर किंवा खाली स्वाइप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret ke atas atau ke bawah untuk menukar hari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip opp eller ned for å endre dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg omhoog of omlaag om de dag te wijzigen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦିନ ବଦଳାଇବାକୁ ଉପରକୁ କିମ୍ବା ତଳକୁ ସ୍ୱାଇପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦਿਨ ਬਦਲਣ ਲਈ ਉੱਪਰ ਜਾਂ ਹੇਠਾਂ ਸਵਾਈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w górę lub w dół, aby zmienić dzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para cima ou para baixo para mudar o dia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para cima ou para baixo para mudar o dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisează în sus sau în jos pentru a schimba ziua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахни вверх или вниз, чтобы изменить день."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahni nahor alebo nadol a zmeň deň."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsaj gor ali dol, da spremeniš dan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep uppåt eller nedåt för att ändra dag."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேதியை மாற்ற மேலே அல்லது கீழே ஸ்வைப் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రోజు మార్చడానికి పైకి లేదా కిందికి స్వైప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดขึ้นหรือลงเพื่อเปลี่ยนวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günü değiştirmek için yukarı veya aşağı kaydır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведи вгору чи вниз, щоб змінити день."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دن بدلنے کے لیے اوپر یا نیچے سوائپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt lên hoặc xuống để đổi ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上或向下轻扫以更改日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向上或向下滑動以更改日期。"
          }
        }
      }
    },
    "onboarding.pack_sheet.title": {
      "comment": "Onboarding pack type sheet title [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which pack looks like yours?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي شريط يشبه شريطك؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোন প্যাকটি আপনার প্যাকের মতো দেখতে?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quin envàs s’assembla al teu?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Které balení vypadá jako to tvoje?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken pakke ligner din?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Packung sieht aus wie deine?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποια συσκευασία μοιάζει με τη δική σου;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué blíster se parece al tuyo?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikä liuska näyttää omaltasi?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle plaquette ressemble à la tienne ?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કયું પેક તમારા પેક જેવું લાગે છે?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איזו חפיסה נראית כמו שלך?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कौन-सा पैक आपके पैक जैसा दिखता है?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koje pakiranje izgleda kao tvoje?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Melyik levél hasonlít a tiédre?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemasan mana yang mirip punyamu?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale confezione somiglia alla tua?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのシートに近いのはどれですか？"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವ ಪ್ಯಾಕ್ ನಿಮ್ಮದರಂತೆ ಕಾಣುತ್ತದೆ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 팩이 내 것과 비슷해요?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏത് പാക്കാണ് നിങ്ങളുടേത് പോലെയുള്ളത്?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणते पॅक तुमच्या पॅकसारखे दिसते?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek mana yang mirip pek kamu?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilket brett ligner ditt?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke strip lijkt op die van jou?"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେଉଁ ପ୍ୟାକ୍ ଆପଣଙ୍କ ପ୍ୟାକ୍ ପରି ଦେଖାଯାଉଛି?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਹੜਾ ਪੈਕ ਤੁਹਾਡੇ ਪੈਕ ਵਰਗਾ ਲੱਗਦਾ ਹੈ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Które opakowanie wygląda jak twoje?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual cartela se parece com a sua?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Que embalagem se parece com a tua?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Care folie seamănă cu a ta?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какая упаковка похожа на твою?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoré balenie vyzerá ako to tvoje?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kateri zavitek je podoben tvojemu?"
