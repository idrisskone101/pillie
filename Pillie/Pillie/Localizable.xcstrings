    "plus_setup.reminders.sentence": {
      "comment": "Reminders setup sentence. %1$@ is the interval chip (e.g. 10 min), %2$@ the repeat chip (e.g. 3 times). Reorder freely; keep both placeholders [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind me again every %1$@ up to %2$@ until I check in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذكّرني مجددًا كل %1$@، بحد أقصى %2$@، إلى أن أسجّل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি টিক না দেওয়া পর্যন্ত প্রতি %1$@ পরপর আবার মনে করিয়ে দিন, সর্বোচ্চ %2$@।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna’m a avisar cada %1$@, com a màxim %2$@, fins que confirmi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připomeň mi to znovu každých %1$@, maximálně %2$@, dokud neodškrtnu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mind mig om det igen med %1$@ mellemrum, op til %2$@, indtil jeg har krydset af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnere mich alle %1$@ noch einmal, höchstens %2$@, bis ich abgehakt habe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θύμισέ μου ξανά κάθε %1$@, έως %2$@, μέχρι να το σημειώσω."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a avisarme cada %1$@, máximo %2$@, hasta que lo marque."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistuta minua uudelleen %1$@ välein, enintään %2$@, kunnes kuittaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relance-moi toutes les %1$@, jusqu’à %2$@, tant que je n’ai pas validé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હું નોંધ ન કરું ત્યાં સુધી દર %1$@ પછી, વધુમાં વધુ %2$@, ફરી યાદ અપાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להזכיר לי שוב כל %1$@, לכל היותר %2$@, עד שאסמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक मैं दर्ज न करूँ, मुझे हर %1$@ पर फिर से याद दिलाएँ, ज़्यादा से ज़्यादा %2$@।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjeti me ponovno svakih %1$@, najviše %2$@, dok se ne javim."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Emlékeztess újra minden %1$@ után, legfeljebb %2$@, amíg ki nem pipálom."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingatkan aku lagi setiap %1$@, maksimal %2$@, sampai aku check-in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricordamelo di nuovo ogni %1$@, fino a %2$@, finché non confermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録するまで、%1$@ごとに最大%2$@まで、くり返し知らせてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾನು ದಾಖಲಿಸುವವರೆಗೆ ಪ್ರತಿ %1$@ ಅಂತರದಲ್ಲಿ, ಗರಿಷ್ಠ %2$@, ಮತ್ತೆ ನೆನಪಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크할 때까지 %1$@마다 최대 %2$@ 다시 알려 주세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞാൻ രേഖപ്പെടുത്തുന്നതുവരെ ഓരോ %1$@ കൂടുമ്പോഴും, പരമാവധി %2$@, വീണ്ടും ഓർമ്മിപ്പിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मी नोंद करेपर्यंत दर %1$@ नंतर, जास्तीत जास्त %2$@, पुन्हा आठवण करून द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingatkan saya lagi setiap %1$@, maksimum %2$@, sehingga saya sahkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Minn meg på det igjen med %1$@ mellomrom, opptil %2$@, til jeg har krysset av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinner me elke %1$@ opnieuw, maximaal %2$@, tot ik heb afgevinkt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମୁଁ ଦର୍ଜ କରିବା ପର୍ୟ୍ୟନ୍ତ ପ୍ରତି %1$@ ରେ, ସର୍ବାଧିକ %2$@, ପୁଣି ମନେ ପକାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਮੈਂ ਦਰਜ ਨਾ ਕਰਾਂ, ਹਰ %1$@ ਬਾਅਦ, ਵੱਧ ਤੋਂ ਵੱਧ %2$@, ਮੈਨੂੰ ਮੁੜ ਯਾਦ ਕਰਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypominaj mi znowu co %1$@, maksymalnie %2$@, aż odhaczę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Me avise de novo a cada %1$@, no máximo %2$@, até eu registrar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa-me de novo a cada %1$@, no máximo %2$@, até eu registar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Amintește-mi din nou la fiecare %1$@, de maximum %2$@, până bifez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминай снова каждые %1$@, максимум %2$@, пока я не отмечусь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomeň mi to znova každých %1$@, najviac %2$@, kým neodškrtnem."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova me opomni vsakih %1$@, največ %2$@, dokler ne odkljukam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminn mig igen var %1$@, högst %2$@, tills jag har bockat av."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நான் பதிவு செய்யும் வரை ஒவ்வொரு %1$@ இடைவெளியிலும், அதிகபட்சம் %2$@, மீண்டும் நினைவூட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను నమోదు చేసే వరకు ప్రతి %1$@ కి, గరిష్ఠంగా %2$@, మళ్లీ గుర్తు చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตือนฉันอีกครั้งทุก %1$@ สูงสุด %2$@ จนกว่าฉันจะเช็กอิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretleyene kadar bana %1$@ arayla en fazla %2$@ yeniden hatırlat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадуй знову кожні %1$@, максимум %2$@, доки я не відмічуся."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک میں درج نہ کروں، مجھے ہر %1$@ بعد پھر سے یاد دلائیں، زیادہ سے زیادہ %2$@۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc lại cho tôi mỗi %1$@, tối đa %2$@, cho đến khi tôi điểm danh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在我打卡前，每 %1$@ 再提醒我一次，最多 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在我打卡前，每 %1$@ 再提醒我一次，最多 %2$@。"
          }
        }
      }
    },
