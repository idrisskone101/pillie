    "settings.custom_messages.blank": {
      "comment": "Locale-specific defaults [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave a field blank to use Pillie’s default wording."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia un campo vuoto per usare il testo predefinito di Pillie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass ein Feld leer, um Pillies Standardtext zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse un champ vide pour utiliser le texte par défaut de Pillie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja un campo en blanco para usar el texto predeterminado de Pillie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe um campo em branco para usar o texto padrão do Pillie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat een veld leeg om Pillies standaardtekst te gebruiken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna ett fält tomt för att använda Pillies standardtext."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad et felt stå tomt for at bruge Pillies standardtekst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La et felt stå tomt for å bruke standardteksten til Pillie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätä kenttä tyhjäksi käyttääksesi Pillien oletustekstiä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa um campo vazio para usar o texto padrão do Pillie."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa un camp en blanc per fer servir el text per defecte de Pillie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaw pole puste, aby użyć domyślnej treści Pillie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nech pole prázdné a použije se výchozí text Pillie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставь поле пустым, чтобы использовать стандартный текст Pillie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лиши поле порожнім, щоб використати стандартний текст Pillie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄にすると、Pillieのデフォルトの文言が使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 Pillie의 기본 문구가 사용돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan medan kosong untuk menggunakan teks lalai Pillie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasă un câmp gol pentru a folosi textul implicit Pillie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechaj pole prázdne a použije sa predvolený text Pillie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เว้นช่องว่างไว้เพื่อใช้ข้อความเริ่มต้นของ Pillie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空即可使用 Pillie 的默认文案。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie की डिफ़ॉल्ट भाषा इस्तेमाल करने के लिए फ़ील्ड खाली छोड़ दो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostavi polje prazno da se koristi zadani Pillie tekst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyd üresen a mezőt, hogy a Pillie alapszövege legyen érvényes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie'nin varsayılan metnini kullanmak için alanı boş bırak."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie-இன் இயல்பு வாசகத்தைப் பயன்படுத்த ஒரு புலத்தை வெறுமையாக விடு."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan kolom untuk memakai teks bawaan Pillie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتركي الحقل فارغًا لاستخدام صيغة Pillie الافتراضية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאירי שדה ריק כדי להשתמש בניסוח ברירת המחדל של Pillie."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống một ô để dùng nội dung mặc định của Pillie."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie-এর ডিফল্ট লেখা ব্যবহার করতে ঘরটি খালি রাখো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie کے ڈیفالٹ الفاظ استعمال کرنے کے لیے خانہ خالی چھوڑ دو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusti polje prazno, da Pillie uporabi privzeto besedilo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άφησε ένα πεδίο κενό για να χρησιμοποιηθεί το προεπιλεγμένο κείμενο του Pillie."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie డిఫాల్ట్ పదాలు వాడాలంటే ఫీల్డ్‌ను ఖాళీగా వదిలేయి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "欄位留空即可使用 Pillie 的預設文字。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie કી ડિફ઼ૉલ્ટ ભાષા ઇસ્તેમાલ કરને માટે ફ઼ીલ્ડ ખાલી છોડ઼ દો।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ಡಿಫಾಲ್ಟ್ ಪದಾಲು ವಾಡಾಲಂಟೇ ಫೀಲ್ಡ್‌ನು ಖಾಳೀಗಾ ವದಿಲೇಯಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie-യുടെ ഡിഫോൾട്ട് വാചകം ഉപയോഗിക്കാൻ ഒരു ഫീൽഡ് ശൂന്യമായി വിടൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie की डिफ़ॉल्ट भाषा इस्तेमाल करने के साठी फ़ील्ड खाली छोड़ दो।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ର ଡିଫଲ୍ଟ ଲେଖା ବ୍ୟବହାର କରିବାକୁ ଏକ ଫିଲ୍ଡ ଖାଲି ଛାଡ଼।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ਦੀ ਡਿਫ਼ੌਲ੍ਟ ਭਾ਷ਾ ਵਰਤੋਂ ਕਰਨੇ ਲਈ ਫ਼ੀਲ੍ਡ ਖਾਲੀ ਛੋਡ਼ ਦੋ।"
          }
        }
      }
    },
