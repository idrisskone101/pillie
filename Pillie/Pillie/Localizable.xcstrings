        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സേവ് ചെയ്താൽ നിങ്ങളുടെ രീതി ഗുളിക ആയി മാറും, റിംഗിന്റെ ചരിത്രം മായ്ക്കപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेव्ह केल्याने तुमची पद्धत गोळी होईल आणि तुमचा रिंगचा इतिहास पुसला जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan akan menukar kamu kepada pil dan memadam sejarah cincin kamu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du lagrer, bytter du til p-pille, og ringhistorikken din slettes."
          }
