    "settings.language.helper": {
      "comment": "Language override explainer [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overrides the iPhone language for Pillie only. Notifications stay on the system language."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschreibt die iPhone-Sprache nur für Pillie. Mitteilungen bleiben in der Systemsprache."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisce la lingua dell’iPhone solo in Pillie. Le notifiche restano nella lingua di sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça remplace la langue de l’iPhone pour Pillie seulement. Tes notifications restent dans la langue du système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplaza el idioma del iPhone solo en Pillie. Tus notificaciones siguen en el idioma del sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui o idioma do iPhone só no Pillie. Suas notificações continuam no idioma do sistema."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervangt de iPhone-taal alleen in Pillie. Je meldingen blijven in de systeemtaal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byter bara språket i Pillie. Notiser stannar på systemspråket."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skifter kun sproget i Pillie. Notifikationer bliver på systemsproget."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytter bare språket i Pillie. Varsler blir på systemspråket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihtaa kielen vain Pillie-sovelluksessa. Ilmoitukset jäävät järjestelmän kielelle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só muda o idioma no Pillie. As notificações ficam no idioma do sistema."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només canvia la llengua a Pillie. Les notificacions es queden en la del sistema."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmienia język tylko w Pillie. Powiadomienia zostają w języku systemu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změní jazyk jen v Pillie. Oznámení zůstanou v jazyce systému."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmení jazyk len v Pillie. Oznámenia ostanú v jazyku systému."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a Pillie nyelvét váltja. Az értesítések a rendszer nyelvén maradnak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbă limba doar în Pillie. Notificările rămân în limba sistemului."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijenja jezik samo u Pillie. Obavijesti ostaju na jeziku sustava."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremeni jezik samo v Pillie. Obvestila ostanejo v jeziku sistema."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάζει τη γλώσσα μόνο στο Pillie. Οι ειδοποιήσεις μένουν στη γλώσσα του συστήματος."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Pillie’nin dilini değiştirir. Bildirimler sistem dilinde kalır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняет язык только в Pillie. Уведомления остаются на языке системы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінює мову лише в Pillie. Сповіщення лишаються мовою системи."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחליף רק את השפה ב-Pillie. ההתראות נשארות בשפת המערכת."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغيّر لغة Pillie فقط. الإشعارات تبقى بلغة النظام."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieの言語だけ変わります。通知はシステムの言語のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie 언어만 바꿍니다. 알림은 시스템 언어로 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只改 Pillie 的语言。通知仍用系统语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只改 Pillie 的語言。通知仍用系統語言。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนภาษาเฉพาะใน Pillie การแจ้งเตือนยังเป็นภาษาของระบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ đổi ngôn ngữ trong Pillie. Thông báo vẫn theo ngôn ngữ hệ thống."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya ganti bahasa di Pillie. Notifikasi tetap pakai bahasa sistem."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar bahasa di Pillie sahaja. Pemberitahuan kekal dalam bahasa sistem."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ Pillie की भाषा बदलती है। नोटिफ़िकेशन सिस्टम भाषा पर रहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু Pillie-র ভাষা বদলায়। নোটিফিকেশন সিস্টেমের ভাষাতেই থাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف Pillie کی زبان بدلتی ہے۔ نوٹیفیکیشنز سسٹم کی زبان پر رہتی ہیں۔"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફક્ત Pillieની ભાષા બદલે છે. નોટિફિકેશન સિસ્ટમ ભાષામાં રહે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie ಭಾಷೆ ಮಾತ್ರ ಬದಲಾಗುತ್ತದೆ. ಅಧಿಸೂಚನೆಗಳು ಸಿಸ್ಟಂ ಭಾಷೆಯಲ್ಲೇ ಇರುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillieയുടെ ഭാഷ മാത്രം മാറും. അറിയിപ്പുകൾ സിസ്റം ഭാഷയിൽ തന്നെ നിൽക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फक्त Pillieची भाषा बदलते. सूचना सिस्टम भाषेतच राहतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କେବଳ Pillieର ଭାଷା ବଦଳେ। ବିଜ୍ଞପ୍ତି ସିଷ୍ଟମ୍ ଭାଷାରେ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਫ਼ Pillie ਦੀ ਭਾਸ਼ਾ ਬਦਲਦੀ ਹੈ। ਨੋਟੀਫਿਕੇਸ਼ਨ ਸਿਸਟਮ ਭਾਸ਼ਾ ’ਤੇ ਰਹਿੰਦੇ ਹਨ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie மொழி மட்டும் மாறும். அறிவிப்புகள் கணினி மொழியிலேயே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie భాష మాత్రమే మారుతుంది. నోటిఫికేషన్లు సిస్టమ్ భాషలోనే ఉంటాయి."
          }
        }
      }
    }
  },
  "version": "1.0"
}
