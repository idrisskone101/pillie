        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu với một giọng điệu"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি টোন দিয়ে শুরু করো"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی انداز سے شروع کرو"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začni s tonom"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκίνα με έναν τόνο"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక టోన్‌తో మొదలుపెట్టు"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從一種風格開始"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક અંદાજ઼ સે શુરૂ કર"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಕ ಟೋನ್‌ತೋ ಮೊದಲುಪೆಟ್ಟು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ശൈലിയിൽ തുടങ്ങൂ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक अंदाज़ पासून शुरू कर"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ଶୈଳୀରୁ ଆରମ୍ଭ କର"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਏਕ ਅਂਦਾਜ਼ ਸੇ ਸ਼ੁਰੂ ਕਰ"
          }
        }
      }
    },
    "settings.custom_messages.start_tone_body": {
      "comment": "Preset action [notification]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tap fills all reminder fields. You can edit each one below."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco compila tutti i campi dei promemoria. Puoi modificarli singolarmente qui sotto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tippen füllt alle Erinnerungsfelder aus. Du kannst jedes Feld unten bearbeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tap remplit tous les champs de rappel. Tu peux modifier chacun ci-dessous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque llena todos los campos de recordatorio. Puedes editar cada uno abajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque preenche todos os campos de lembrete. Você pode editar cada um abaixo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén tik vult alle herinneringsvelden. Je kunt elk veld hieronder bewerken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tryck fyller i alla påminnelsefält. Du kan ändra varje fält nedan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét tryk udfylder alle påmindelsesfelter. Du kan redigere hvert felt nedenfor."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett trykk fyller ut alle påminnelsesfeltene. Du kan redigere hvert felt nedenfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi napautus täyttää kaikki muistutuskentät. Voit muokata jokaista alla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque preenche todos os campos dos lembretes. Podes editar cada um abaixo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toc omple tots els camps dels recordatoris. Pots editar-ne cada un a sota."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno stuknięcie wypełnia wszystkie pola. Każde możesz edytować poniżej."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedním klepnutím vyplníš všechna pole. Každé můžeš níže upravit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно касание заполнит все поля напоминаний. Каждое можно отредактировать ниже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один дотик заповнить усі поля нагадувань. Кожне можна відредагувати нижче."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回タップするとすべてのリマインダー欄が埋まります。下で個別に編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 탭하면 모든 알림 칸이 채워져요. 아래에서 하나씩 편집할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu ketikan mengisi semua medan peringatan. Kamu boleh edit setiap satu di bawah."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O atingere completează toate câmpurile mementourilor. Poți edita fiecare câmp mai jos."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedným ťuknutím vyplníš všetky polia pripomienok. Každé môžeš nižšie upraviť."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะครั้งเดียวเพื่อเติมทุกช่องข้อความแจ้งเตือน แล้วแก้ไขแต่ละช่องด้านล่างได้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下即可填好所有提醒字段。你可以在下方逐条编辑。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टैप से सभी रिमाइंडर फ़ील्ड भर जाते हैं। नीचे तुम हर एक को बदल सकते हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedan dodir ispunjava sva polja podsjetnika. Svako možeš urediti u nastavku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy koppintás kitölti az összes emlékeztetőmezőt. Lent mindegyiket szerkesztheted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek dokunuş tüm hatırlatma alanlarını doldurur. Her birini aşağıda düzenleyebilirsin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு தட்டலில் எல்லா நினைவூட்டல் புலங்களும் நிரம்பும். கீழே ஒவ்வொன்றையும் திருத்தலாம்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu ketukan mengisi semua kolom pengingat. Kamu bisa mengedit tiap kolom di bawah."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقرة واحدة تملأ كل حقول التذكير. يمكنك تعديل كل حقل أدناه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקשה אחת ממלאת את כל שדות התזכורת. אפשר לערוך כל אחד מהם למטה."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần chạm điền tất cả các ô lời nhắc. Bạn có thể sửa từng ô bên dưới."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক ট্যাপে সব রিমাইন্ডার ঘর ভরে যায়। নিচে প্রতিটি সম্পাদনা করতে পারো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ٹیپ سے تمام یاد دہانی کے خانے بھر جاتے ہیں۔ نیچے ہر ایک میں ترمیم کی جا سکتی ہے۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "En dotik izpolni vsa polja opomnikov. Vsako lahko spodaj urediš."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πάτημα συμπληρώνει όλα τα πεδία υπενθυμίσεων. Μπορείς να επεξεργαστείς το καθένα παρακάτω."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక్క నొక్కుతో అన్ని రిమైండర్ ఫీల్డ్‌లు నిండుతాయి. కింద ఒక్కొక్కటీ సవరించుకోవచ్చు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下即可填好所有提醒欄位。你可以在下方逐一編輯。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક ટૈપ સે સભી રિમાઇંડર ફ઼ીલ્ડ ભર જાતે છે। નીચે તું હર એક કો બદલ શકો છો।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಕ್ಕ ನೊಕ್ಕುತೋ ಅನ್ನಿ ಜ್ಞಾಪನೆ ಫೀಲ್ಡ್‌ಲು ನಿಂಡುತಾಯಿ. ಕಿಂದ ಒಕ್ಕೊಕ್ಕಟೀ ಸವರಿಂಚುಕೋವಚ್ಚು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ടാപ്പിൽ എല്ലാ റിമൈൻഡർ ഫീൽഡുകളും നിറയും. ഓരോന്നും താഴെ എഡിറ്റ് ചെയ്യാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टैप पासून सभी आठवण फ़ील्ड भर जाते आहेत. नीचे तू हर एक ला बदल शकतोस।"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ଟିପ୍ ସବୁ ରିମାଇଣ୍ଡର୍ ଫିଲ୍ଡ ଭରିଦିଏ। ତୁମେ ତଳେ ପ୍ରତ୍ୟେକଟି ସମ୍ପାଦନା କରିପାରିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਏਕ ਟੈਪ ਸੇ ਸਭੀ ਰਿਮਾਇਂਡਰ ਫ਼ੀਲ੍ਡ ਭਰ ਜਾਂਦੀਆਂ ਹਨ। ਨੀਚੇ ਤੂੰ ਹਰ ਏਕ ਕੋ ਬਦਲ ਸਕਦੀ ਹੈਂ।"
          }
        }
      }
    },
