        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes začne nový cyklus. Stará historie zůstane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня начнётся новый цикл. Прежняя история сохранится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні почнеться новий цикл. Попередня історія збережеться."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日から新しい周期を始めます。これまでの履歴は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘부터 새 주기가 시작돼요. 이전 기록은 남아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memulakan kitaran baharu hari ini. Sejarah lama kamu kekal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asta începe azi un ciclu nou. Istoricul tău vechi rămâne."
