    "onboarding.mechanism.accessibility_summary": {
      "comment": "VoiceOver summary of the mechanism proof [standard]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At your reminder time, Pillie sends a reminder and pauses the apps you chose. Check in to open them again."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All’orario scelto, Pillie ti manda un promemoria e mette in pausa le app che hai scelto. Conferma per riaprirle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu deiner Erinnerungszeit schickt Pillie eine Erinnerung und pausiert die Apps, die du gewählt hast. Hake ab, um sie wieder zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’heure prévue, Pillie t’envoie un rappel et met en pause les apps que tu as choisies. Valide pour les rouvrir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la hora prevista, Pillie te envía un recordatorio y pausa las apps que elegiste. Marca lo de hoy para volver a abrirlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No horário que você escolheu, o Pillie te lembra e pausa os apps selecionados. Registre para abri-los de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op je herinneringstijd stuurt Pillie een herinnering en pauzeert de apps die je koos. Vink af om ze weer te openen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid din påminnelsetid skickar Pillie en påminnelse och pausar apparna du valde. Bocka av för att öppna dem igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På dit påmindelsestidspunkt sender Pillie en påmindelse og sætter de apps, du valgte, på pause. Kryds af for at åbne dem igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På påminnelsestidspunktet sender Pillie en påminnelse og pauser appene du valgte. Kryss av for å åpne dem igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistutusaikanasi Pillie lähettää muistutuksen ja laittaa valitsemasi sovellukset tauolle. Kuittaa, niin ne aukeavat taas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "À hora que escolheste, o Pillie lembra-te e pausa as apps selecionadas. Regista para as voltares a abrir."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A l’hora del recordatori, Pillie t’envia un recordatori i posa en pausa les apps que has triat. Confirma per tornar-les a obrir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O godzinie przypomnienia Pillie wysyła przypomnienie i wstrzymuje wybrane aplikacje. Odhacz dzień, aby znów je otworzyć."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V čas připomínky ti Pillie pošle připomínku a pozastaví vybrané aplikace. Odškrtni dnešek a zase je otevřeš."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В назначенное время Pillie присылает напоминание и ставит выбранные тобой приложения на паузу. Отметься, чтобы снова их открыть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У призначений час Pillie надсилає нагадування й ставить вибрані тобою застосунки на паузу. Відміться, щоб знову їх відкрити."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーの時間になると、Pillieがリマインダーを送り、選んだアプリを一時停止します。記録すると、また開けるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 시간이 되면 Pillie가 알림을 보내고 선택한 앱을 일시 중지해요. 체크하면 다시 열 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada waktu peringatan kamu, Pillie menghantar peringatan dan menjeda apl yang kamu pilih. Sahkan untuk membukanya semula."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La ora mementoului, Pillie îți trimite un memento și pune pe pauză aplicațiile alese. Bifează ziua ca să le deschizi din nou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V čase pripomienky ti Pillie pošle pripomienku a pozastaví vybrané aplikácie. Odškrtni dnešok a znova ich otvoríš."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อถึงเวลาแจ้งเตือน Pillie จะส่งการแจ้งเตือนและหยุดแอปที่คุณเลือกชั่วคราว เช็กอินเพื่อเปิดแอปอีกครั้ง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到了提醒时间，Pillie 会发送提醒，并暂停你选择的应用。打卡后就能重新打开。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर के समय Pillie एक रिमाइंडर भेजता है और आपके चुने हुए ऐप्स रोक देता है। उन्हें फिर से खोलने के लिए दर्ज करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U vrijeme podsjetnika Pillie šalje podsjetnik i pauzira odabrane aplikacije. Javi se da se ponovno otvore."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emlékeztető idején a Pillie emlékeztetőt küld, és szünetelteti a választott appokat. Pipáld ki, hogy újra megnyíljanak."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatma saatinde Pillie bir hatırlatma gönderir ve seçtiğin uygulamaları duraklatır. Yeniden açmak için işaretle."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நினைவூட்டல் நேரத்தில் Pillie ஒரு நினைவூட்டலை அனுப்பி, நீங்கள் தேர்ந்தெடுத்த ஆப்ஸை இடைநிறுத்தும். அவற்றை மீண்டும் திறக்க பதிவு செய்யுங்கள்."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada waktu pengingatmu, Pillie mengirim pengingat dan menjeda aplikasi yang kamu pilih. Check-in untuk membukanya lagi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في وقت تذكيرك، يرسل Pillie تذكيرًا ويوقف التطبيقات التي اخترتِها مؤقتًا. سجّلي لتُفتح من جديد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשעת התזכורת, Pillie שולחת תזכורת ומשהה את האפליקציות שבחרת. סמני כדי לפתוח אותן שוב."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đến giờ nhắc, Pillie gửi lời nhắc và tạm dừng các ứng dụng bạn chọn. Điểm danh để mở lại chúng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিমাইন্ডারের সময় হলে Pillie একটি রিমাইন্ডার পাঠায় এবং আপনার বেছে নেওয়া অ্যাপগুলো পজ করে। আবার খুলতে টিক দিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یاد دہانی کے وقت Pillie ایک یاد دہانی بھیجتا ہے اور آپ کی چنی ہوئی ایپس روک دیتا ہے۔ انہیں دوبارہ کھولنے کے لیے درج کریں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob času opomnika Pillie pošlje opomnik in začasno zaustavi izbrane aplikacije. Odkljukaj, da se spet odprejo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Την ώρα της υπενθύμισης, το Pillie στέλνει υπενθύμιση και βάζει σε παύση τις εφαρμογές που διάλεξες. Σημείωσέ το για να ανοίξουν ξανά."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రిమైండర్ సమయంలో Pillie రిమైండర్ పంపి, మీరు ఎంచుకున్న యాప్‌లను పాజ్ చేస్తుంది. వాటిని మళ్లీ తెరవడానికి నమోదు చేయండి."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到了提醒時間，Pillie 會傳送提醒，並暫停你選的 App。打卡後就能再次開啟。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇન્ડરના સમયે Pillie રિમાઇન્ડર મોકલે છે અને તમે પસંદ કરેલી ઍપ્સ થોભાવે છે. તેને ફરી ખોલવા નોંધ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಜ್ಞಾಪನೆಯ ಸಮಯದಲ್ಲಿ Pillie ಜ್ಞಾಪನೆ ಕಳುಹಿಸಿ, ನೀವು ಆರಿಸಿದ ಆ್ಯಪ್‌ಗಳನ್ನು ತಡೆಹಿಡಿಯುತ್ತದೆ. ಅವುಗಳನ್ನು ಮತ್ತೆ ತೆರೆಯಲು ದಾಖಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ റിമൈൻഡർ സമയത്ത് Pillie ഒരു റിമൈൻഡർ അയച്ച്, നിങ്ങൾ തിരഞ്ഞെടുത്ത ആപ്പുകൾ പോസ് ചെയ്യും. അവ വീണ്ടും തുറക്കാൻ രേഖപ്പെടുത്തൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडरच्या वेळी Pillie रिमाइंडर पाठवते आणि तुम्ही निवडलेली ॲप्स थांबवते. ती पुन्हा उघडण्यासाठी नोंद करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରିମାଇଣ୍ଡର୍ ସମୟରେ Pillie ଏକ ରିମାଇଣ୍ଡର୍ ପଠାଏ ଏବଂ ଆପଣ ବାଛିଥିବା ଆପ୍ ବିରାମ କରେ। ସେଗୁଡ଼ିକୁ ପୁଣି ଖୋଲିବାକୁ ଦର୍ଜ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਮਾਈਂਡਰ ਦੇ ਸਮੇਂ Pillie ਰਿਮਾਈਂਡਰ ਭੇਜਦਾ ਹੈ ਅਤੇ ਤੁਹਾਡੀਆਂ ਚੁਣੀਆਂ ਐਪਾਂ ਰੋਕ ਦਿੰਦਾ ਹੈ। ਉਹਨਾਂ ਨੂੰ ਮੁੜ ਖੋਲ੍ਹਣ ਲਈ ਦਰਜ ਕਰੋ।"
          }
        }
      }
    },
