{
  "sourceLanguage": "en",
  "strings": {
    "shield.blocking_reason": {
      "comment": "Shared app-group fallback [shield]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven’t checked in on Pillie yet today."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi non hai ancora confermato in Pillie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast heute in Pillie noch nicht abgehakt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n’as pas encore validé dans Pillie aujourd’hui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has marcado lo de hoy en Pillie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não registrou no Pillie hoje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt vandaag nog niet afgevinkt in Pillie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har inte bockat av i Pillie i dag än."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke krydset af i Pillie i dag endnu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ikke krysset av i Pillie ennå i dag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ole vielä kuitannut Pilliessä tänään."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não registaste no Pillie hoje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no has confirmat avui a Pillie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejszy dzień w Pillie czeka jeszcze na odhaczenie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnešek v Pillie ještě není odškrtnutý."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты ещё не отметилась в Pillie сегодня."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти ще не відмітилася в Pillie сьогодні."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はまだPillieで記録していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 아직 Pillie에서 체크하지 않았어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu belum sahkan di Pillie hari ini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă n-ai bifat ziua de azi în Pillie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnešok v Pillie ešte nie je odškrtnutý."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้คุณยังไม่ได้เช็กอินใน Pillie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你今天还没在 Pillie 打卡。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज आपने Pillie पर अभी दर्ज नहीं किया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U Pillie danas još nema tvog javljanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma még nem pipáltad ki a Pillie-ben."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün Pillie’de henüz işaretlemedin."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்று நீங்கள் இன்னும் Pillie-இல் பதிவு செய்யவில்லை."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu belum check-in di Pillie hari ini."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تسجّلي في Pillie اليوم بعد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוד לא סימנת היום ב-Pillie."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay bạn chưa điểm danh trên Pillie."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি আজ এখনো Pillie-এ টিক দেননি।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج آپ نے Pillie پر ابھی درج نہیں کیا۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V Pillie danes še ni tvoje kljukice."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν το έχεις σημειώσει ακόμα σήμερα στο Pillie."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు మీరు Pillieలో ఇంకా నమోదు చేయలేదు."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你今天還沒在 Pillie 打卡。"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે આજે હજુ Pillie પર નોંધ કરી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಂದು ನೀವು ಇನ್ನೂ Pillie ನಲ್ಲಿ ದಾಖಲಿಸಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇന്ന് നിങ്ങൾ ഇതുവരെ Pillie-യിൽ രേഖപ്പെടുത്തിയിട്ടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आज तुम्ही Pillie वर अजून नोंद केलेली नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଆଜି ଏପର୍ଯ୍ୟନ୍ତ Pillie ରେ ଦର୍ଜ କରିନାହାଁନ୍ତି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਅੱਜ ਅਜੇ Pillie ’ਤੇ ਦਰਜ ਨਹੀਂ ਕੀਤਾ।"
          }
        }
      }
