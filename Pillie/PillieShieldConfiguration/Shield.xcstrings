{
  "sourceLanguage": "en",
  "strings": {
    "shield.blocking_reason": {
      "comment": "Shared app-group fallback [shield]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s Pillie action is still open."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’azione Pillie di oggi è ancora da registrare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die heutige Aktion ist in Pillie noch offen."
          }
        }
      }
    },
    "shield.primary_action": {
      "comment": "Extension button [shield]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Pillie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Pillie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie öffnen"
          }
        }
      }
    },
    "shield.secondary": {
      "comment": "Extension secondary text [shield]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app will be waiting."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app ti aspetta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App wartet auf dich."
          }
        }
      }
    },
    "shield.secondary_action": {
      "comment": "Extension snooze button; uses the Settings blocking interval [shield]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snooze for %lld minutes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posponi di %lld minuti"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Minuten pausieren"
          }
        }
      }
    },
    "shield.subtitle": {
      "comment": "Extension subtitle; method-neutral [shield]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log today’s action, then return to this app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra l’azione di oggi, poi torna a questa app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolliere die heutige Aktion und kehre dann zu dieser App zurück."
          }
        }
      }
    },
    "shield.title": {
      "comment": "Extension title; neutral [shield]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time for a quick check-in"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il momento di registrare"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit für einen kurzen Check-in"
          }
        }
      }
    }
  },
  "version": "1.0"
}
