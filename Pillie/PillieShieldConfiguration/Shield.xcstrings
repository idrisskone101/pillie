{
  "sourceLanguage": "en",
  "strings": {
    "shield.blocking_reason": {
      "comment": "Shared app-group fallback [shield]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s Pillie action is still open."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’azione Pillie di oggi è ancora da registrare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die heutige Aktion ist in Pillie noch offen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'action Pillie du jour est encore en attente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción de hoy en Pillie sigue pendiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ação de hoje no Pillie ainda está aberta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De actie van vandaag staat in Pillie nog open."
          }
        }
      }
    },
    "shield.primary_action": {
      "comment": "Extension button [shield]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Pillie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Pillie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie öffnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir Pillie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Pillie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Pillie"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillie openen"
          }
        }
      }
    },
    "shield.secondary": {
      "comment": "Extension secondary text [shield]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app will be waiting."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app ti aspetta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App wartet auf dich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app t'attendra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app te estará esperando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app estará esperando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze app wacht op je."
          }
        }
      }
    },
    "shield.subtitle": {
      "comment": "Extension subtitle; method-neutral [shield]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log today’s action, then return to this app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra l’azione di oggi, poi torna a questa app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolliere die heutige Aktion und kehre dann zu dieser App zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inscris l'action du jour, puis reviens dans cette app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la acción de hoy y vuelve a esta app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre a ação de hoje e volte a este app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de actie van vandaag bij en ga terug naar deze app."
          }
        }
      }
    },
    "shield.title": {
      "comment": "Extension title; neutral [shield]",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time for a quick check-in"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il momento di registrare"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit für einen kurzen Check-in"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est l'heure d'un petit check-in"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora de un check-in rápido"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora de um check-in rápido"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd voor een snelle check-in"
          }
