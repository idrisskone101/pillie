{
  "permissions": {
    "allow": [
      "Bash(xcodebuild:*)",
      "Bash(xcrun simctl:*)",
      "Bash(xcodebuildmcp:*)",
      "Bash(axe describe-ui:*)",
      "Bash(axe tap:*)",
      "Bash(axe type:*)",
      "Bash(axe swipe:*)",
      "Bash(axe gesture:*)",
      "Bash(axe button:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(make:*)",
      "Bash(Pillie/scripts/mcp-build-and-run.sh:*)",
      "Bash(Pillie/scripts/build-and-run.sh:*)",
      "Bash(Pillie/scripts/mcp-test-focused.sh:*)",
      "Bash(Pillie/scripts/test-focused.sh:*)",
      "Bash(Pillie/scripts/diagnose.sh:*)",
      "Bash(Pillie/scripts/create-worktree.sh:*)",
      "Bash(python3 Pillie/scripts/namespace-mac-api.py exec:*)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__XcodeBuildMCP"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; command -v bun >/dev/null 2>&1 && exit 0; BUN_BIN=\"${BUN_INSTALL:-$HOME/.bun}/bin\"; [ -x \"$BUN_BIN/bun\" ] || curl -fsSL https://bun.sh/install | bash >/dev/null 2>&1; [ -z \"$CLAUDE_ENV_FILE\" ] || echo \"export PATH=\\\"$BUN_BIN:\\$PATH\\\"\" >> \"$CLAUDE_ENV_FILE\"; exit 0"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pstack-cc@pstack-cc": true
  },
  "extraKnownMarketplaces": {
    "pstack-cc": {
      "source": {
        "source": "github",
        "repo": "idrisskone101/pstack-cc"
      }
    }
  },
  "effortLevel": "high"
}
